# Where each keeper's shop is (Zachary, 24 Nov: "shop people can only sell while in their shop area"):
# area -> zones in that area ("" = anywhere in it). The keeper has to be there, and so do you.
const SHOP_AT := {
	"Bram": {"main": ["Bram's market", "Bram's supplies"], "bram": [""]},
	"Tikka": {"eng": [""]},
	"Rusk": {"bar": [""], "main": ["Rusk's bar"]},
	"Jasper": {"mess": [""], "main": ["Mess hall"]},
	"Sesska": {"main": ["Sesska's textiles"], "weaver": [""]},
	"Ix'ali": {"armoury": [""], "main": ["Armoury"]},
	"Maren": {"medbay": [""], "main": ["Medbay"]},
	"Job": {"mine": [""]},
	"Tobbin": {"main": ["Tobbin's workshop"]},
}


func _in_shop(who: String) -> bool:
	var r = _resident_named(who)
	if r == null or not SHOP_AT.has(who) or str(r.area) != current_area or not _at_workplace(who):
		return false
	var zones: Array = SHOP_AT[who].get(current_area, [])
	if zones.has(""):
		return true
	for z in MapData.AREAS[current_area].get("zones", []):
		if zones.has(str(z[0])) and r.tile.x >= int(z[1]) and r.tile.x <= int(z[3]) and r.tile.y >= int(z[2]) and r.tile.y <= int(z[4]):
			return true
	return false


func _shop_offer(who: String, first_today := false) -> void:
	var line: String = SHOP_HELLO[who]
	if who == "Tikka" and repair_stage < REPAIRS.size():
		_say(who, [line], Callable(shops, "open_later").bind(who), "Shop", Callable(self, "_tikka_repair"), "Ship repairs")
	else:
		_say(who, [line], Callable(shops, "open_later").bind(who), "Crack geodes" if who == "Job" else "Shop",
				Callable(self, "_chat").bind(who, first_today), "Just chat")


# A resident's birthday (scripts/datapad_bridge.gd RESIDENTS) lets you chat as much as you like.
func _special_day(who: String) -> bool:
	var facts: Array = BridgeScript.RESIDENTS.get(who, [])
	if facts.size() < 3:
		return false
	var date: Array = BridgeScript.season_date(day)
	return str(facts[2]) == "%s %d" % [date[0], date[1]]


# Whether a resident is at their place of work: near the first "work" stop of today's schedule (Bram's stall is
# "restock"). People who don't walk about (S.A.R.A.), or never have a work stop, always count as at work; someone
# who usually works but has no work stop today is on their day off (Bram's Thursdays, 23 Nov), so their shop is shut.
func _at_workplace(who: String) -> bool:
	var r = _resident_named(who)
	if r == null:
		return true
	for e in r.schedule:
		if e.size() > 6 and (str(e[6]) == "work" or str(e[6]) == "restock"):
			return str(r.area) == str(e[1]) and Vector2(r.tile).distance_to(Vector2(float(e[2]), float(e[3]))) <= 10.0
	for e in MapData.SCHEDULES.get(who, []):
		if e.size() > 6 and (str(e[6]) == "work" or str(e[6]) == "restock"):
			return false
	return true


func _plain_intro(who: String) -> String:
	var facts: Array = BridgeScript.RESIDENTS.get(who, [])
	var role: String = str(facts[0]).to_lower() if not facts.is_empty() else "one of the crew"
	return "[happy] You must be {name}, the pilot Sara pulled out of the wreck! I'm %s, %s. Come and find me at work some time and I'll say hello properly." % [who, role]


# What they say first on a day of the week that's different for them: their days off, or the days they
# cover for someone who's off (NpcData.DAY_LINES). A different line each week.
func _day_line(who: String) -> String:
	var weekday: int = (day - 1) % 7
	var entry = NpcData.DAY_LINES.get(who, {}).get(weekday, [])
	if entry is Dictionary:
		# {"flag": f, "lines": [...]}: a day that only changes once the story has got there (Vzz'ket's nights off);
		# "else": [...] is that day before it (Tikka's Sundays in Engineering, until her 8)
		entry = entry["lines"] if _flag(str(entry["flag"])) else entry.get("else", [])
	var lines: Array = entry
	if lines.is_empty():
		return ""
	return str(lines[floori((day - 1) / 7.0) % lines.size()])


func _next_repeat(who: String) -> String:
	var st: Dictionary = persons[who]
	var repeat: Array = st["repeat"]
	var n: int = st["next"]
	st["next"] = n + 1
	var line: String = repeat[n % repeat.size()]
	return line


# ---------------------------------------------------------------- ship repair

func _tikka_repair() -> void:
	var r: Dictionary = REPAIRS[repair_stage]
	var cost: int = r["cost"]
	var needs: Dictionary = r["needs"]
	var what: String = "%d credits and %s" % [cost, _needs_text(needs)]
	if credits >= cost and _has_all(needs):
		_say("Tikka", ["Next is the %s. That is %s. Shall I?" % [r["name"], what]],
				Callable(self, "_pay_repair"), "Hand it over")
	else:
		_say("Tikka", [
			"Next is the %s. I need %s." % [r["name"], what],
			"Plates come from iron bars and wire from copper bars. You can make both yourself, on the Crafting page of your pack.",
		])


func _pay_repair() -> void:
	var r: Dictionary = REPAIRS[repair_stage]
	var cost: int = r["cost"]
	var needs: Dictionary = r["needs"]
	_money(-(cost), "Ship repairs")
	for item in needs:
		_give(item, -int(needs[item]))
	repair_stage += 1
	sfx("repair_done")
	wreck_sprite.frame = repair_stage
	_toast("Ship repair %d of %d done" % [repair_stage, REPAIRS.size()])
	if repair_stage >= REPAIRS.size():
		_say("Tikka", [
			"[happy] That's everything. She will fly.",
			"Whether you should is not an engineering question.",
		])
	else:
		_say("Tikka", ["Done. Well, nearly done. Done enough to charge you for. Go and look, she's in the shuttle bay."])


func _look_at_ship() -> void:
	var lines: Array
	if repair_stage == 0:
		lines = ["What is left of it. The fold drive is gone and half the hull went with it.",
				"It isn't going anywhere. Not yet."]
	elif repair_stage == 1:
		lines = ["The hull is sealed. From some angles it looks like a ship again."]
	elif repair_stage == 2:
		lines = ["The fold drive hums when you put a hand on it. It still doesn't know where it is."]
	else:
		lines = ["She's whole. You could leave.", "Launch control is in the booth by the south-west wall."]
		if ship_hull < _hull_max():
			lines = ["Scorched plates and a dent in the engine bay. Freya can patch her up."]
	_say("Your ship", lines)


# ---------------------------------------------------------------- the ship: launching and space fights (21 Nov)
