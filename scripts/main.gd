				area_sprites.append([glow, area_name])


# The station dims its lights in the evening and overnight.
func _light_color() -> Color:
	var h: float = minutes / 60.0
	var day_tint := Color(1.0, 1.0, 1.0)
	var dusk := Color(1.0, 0.86, 0.74)
	var night := Color(0.56, 0.62, 0.86)
	var c: Color = day_tint
	if h < 7.0:
		c = night.lerp(day_tint, clampf(h - 6.0, 0.0, 1.0))
	elif h < 17.0:
		c = day_tint
	elif h < 19.5:
		c = day_tint.lerp(dusk, (h - 17.0) / 2.5)
	else:
		c = dusk.lerp(night, clampf((h - 19.5) / 2.5, 0.0, 1.0))
	if current_area == "mine":
		c = c * Color(0.8, 0.78, 0.86)
	elif current_area == "tunnels":
		c = c * Color(0.62, 0.6, 0.74)
	elif current_area.begins_with("cav_"):
		c = Color(0.58, 0.58, 0.7)          # no day and night down there
	elif current_area == "lake":
		c = Color(0.66, 0.74, 0.86)         # nor at the underground lake: cool, blue-green dark
	elif current_area == "crash_site":
		c = Color(0.56, 0.56, 0.72)         # the crash site (the prologue): a dark cave, lit by its own lights
	elif current_area == "tidelight":
		c = Color(1.0, 0.82, 0.68)          # Tidelight: tidally locked, so always the same low golden sunset
	return c


func _go_home() -> void:
	var start: Array = MapData.START
	var area_name: String = start[0]
	_go_to(area_name, Vector2i(int(start[1]), int(start[2])), false)
	# You wake in your own bed, under the covers, facing the room.
	for p in MapData.AREA_PROPS.get(area_name, []):
		if p[0] in BED_PROPS and str(p[5]) == "Your bed":
			var t := Vector2i(int(p[1]), int(p[2]) + int(p[4]) - 1)
			var slot = bed_slot(area_name, t)
			if slot != null:
				player.position = slot
				player._dir = 0
				bed_prompted = true     # no "Sleep?" until you have got out and back in
			break


func _zone_name() -> String:
	var data: Dictionary = MapData.AREAS[current_area]
	var zones: Array = data["zones"]
	var tile: Vector2i = _player_tile()
	for z in zones:
		if tile.x >= int(z[1]) and tile.x <= int(z[3]) and tile.y >= int(z[2]) and tile.y <= int(z[4]):
			var zone: String = z[0]
			return zone
	var area_title: String = data["title"]
	return area_title


# ---------------------------------------------------------------- people and things

func _spawn_things() -> void:
	for p in MapData.PEOPLE:
		var who: String = p[0]
		var area_name: String = p[1]
		_add_person(who, area_name, Vector2i(int(p[2]), int(p[3])), float(p[4]))

	for who in MapData.SCHEDULES:
		_add_resident(who, MapData.SCHEDULES[who])

	for item in MapData.THINGS:
		var pos: Array = item[4]
		things.append({
			"kind": item[0], "name": item[1], "hint": item[2], "area": item[3],
			"pos": Vector2(float(pos[0]), float(pos[1])), "radius": float(item[5]), "who": "",
		})

	# Eshu's crew board in the Shuttle Bay's booth (23 Nov), with a board picture standing there (CREW_BOARD).
	things.append({"kind": "look", "name": "Crew board", "hint": "Read the board", "area": "bay",
		"pos": Vector2(CREW_BOARD.x * 16 + 16, (CREW_BOARD.y + 3) * 16), "radius": 24.0, "who": ""})

	# Ore veins and rocks. Each art file has 2 frames: full, worked out.
	for entry in MapData.NODES:
		# an optional fifth number: refill every that many days (the North Cave's beds: 2)
		_add_node(str(entry[0]), str(entry[1]), Vector2i(int(entry[2]), int(entry[3])), int(entry[4]) if entry.size() > 4 else 1, false)
	cav_static_nodes = ore_nodes.size()

	# The wreck in the shuttle bay. art/wreck.png has 4 frames: wrecked -> repaired.
	var wreck: Array = MapData.WRECK
	wreck_sprite = Sprite2D.new()
	# The new ship (art/lunar/player_ship.png: 4 frames of 224 x 128, drawn at half size: 7 x 4 tiles).
	var ship_art := "res://art/lunar/player_ship.png" if ResourceLoader.exists("res://art/lunar/player_ship.png") else "res://art/wreck.png"
	wreck_sprite.texture = load(ship_art)
	wreck_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	wreck_sprite.hframes = 4
	wreck_sprite.centered = false
	_fit_sprite(wreck_sprite, 4, 1, wreck_sprite.texture.get_width() / 4.0 * ART if ship_art.ends_with("player_ship.png") else 64.0)
	wreck_sprite.position = Vector2(float(wreck[1]), float(wreck[2]))
	wreck_sprite.visible = false
	actors.add_child(wreck_sprite)
	area_sprites.append([wreck_sprite, wreck[0]])

	# Shop fronts on the main level: one big picture per shop, laid over its building at the door.
	for f in MapData.FRONTS:
		var front_key: String = f[0]
		var front_path: String = "res://art/front_%s.png" % front_key
		if not ResourceLoader.exists(front_path):
			continue
		var front := Sprite2D.new()
		front.texture = load(front_path)
		front.centered = false
		_fit_sprite(front, 1, 1, 80.0)          # always 5 tiles wide in the world, whatever size it is drawn at
		front.offset = Vector2.ZERO             # placed by its top-left corner
		front.position = Vector2(float(f[1]), float(f[2]))
		front.visible = false
		ground_fx.add_child(front)
		area_sprites.append([front, "main"])


# Creates the shared state for a person the first time they are needed. Returns their art id.
func _ensure_person(who: String) -> String:
	var info: Dictionary = NpcData.PEOPLE[who]
	var id: String = info["id"]
	if not persons.has(who):
		persons[who] = {
			"id": id, "first": info["first"], "repeat": info["repeat"], "pitch": float(info.get("pitch", 1.0)),
			"portrait": load(portrait_path(id)),
			"met": false, "talked_today": false, "friendship": 0, "next": 0, "talks_today": 0, "intro_due": false,
		}
	return id


# A resident who walks around on a schedule (see scripts/resident.gd).
func _add_resident(who: String, entries: Array) -> void:
	var id: String = _ensure_person(who)
	var t := {
		"kind": "person", "name": who, "hint": "Talk to %s" % who, "area": "",
		"pos": Vector2.ZERO, "radius": 26.0, "who": who,
	}
	things.append(t)
	var r = ResidentScript.new()
	# Hand-made activity frames are optional: art/npc_<id>_act.png
	var act_tex: Texture2D = null
	var act_path: String = "res://art/npc_%s_act.png" % id
	if ResourceLoader.exists(act_path):
		act_tex = load(act_path)
	var walk_id: String = id
	if not ResourceLoader.exists("res://art/npc_%s.png" % id):
		walk_id = "owen"
	r.setup(self, who, load("res://art/npc_%s.png" % walk_id), entries, t, act_tex)
	r.visible = false
	actors.add_child(r)
	residents.append(r)
	# An emote bubble over the head (overhead_emotes/). It is a child of the resident, so it follows them and
	# shares their two-thirds scale: one art pixel per screen pixel, the bubble's foot just above a 48-tall sprite.
	if emote_scene == null and ResourceLoader.exists(EMOTE_SCENE):
		emote_scene = load(EMOTE_SCENE)
	if emote_scene != null:
		r.emote = emote_scene.instantiate()
		r.add_child(r.emote)


# Shows an emote bubble over a resident's head: surprise, question, love, joy, sad, frustrated, hello, ready,
# no, wait, help, follow or cute (overhead_emotes/README.md).
func _emote(who: String, id: StringName, seconds: float = 1.4) -> void:
	for r in residents:
		if r.who == who and r.emote != null:
			r.emote.show_story(id, seconds)
			return


func _snap_residents() -> void:
	# Visitors (MapData.VISITOR_DAYS) are only here on their days of the week. The newcomers are not here at
	# all until they arrive, and some of their first days follow MapData.SCHEDULES_ALT (the Medbay, the terminal).
	var weekday: int = (day - 1) % 7
	for r in residents:
		var gone := not _arrived(r.who)
		if MapData.VISITOR_DAYS.has(r.who):
			var days: Array = MapData.VISITOR_DAYS[r.who]
			gone = gone or not (days.has(weekday) or days.has(float(weekday)))
		r.away = gone
		if MapData.SCHEDULES_ALT.has(r.who) and _first_days(r.who):
			r.schedule = MapData.SCHEDULES_ALT[r.who]
		else:
			r.schedule = _day_schedule(r.who)
		r.snap(minutes)


# A resident's day: their usual one (MapData.SCHEDULES), or the last of their MapData.SCHEDULE_DAYS that fits
# today: weekends off, seasons, places the story has opened (tools/build.py SCHEDULE_DAYS_RAW).
func _day_schedule(who: String) -> Array:
	var pick: Array = MapData.SCHEDULES[who]
	var weekday: int = (day - 1) % 7
	var season: String = str(BridgeScript.season_date(day)[0])
	var date: int = int(BridgeScript.season_date(day)[1])
	for v in MapData.SCHEDULE_DAYS.get(who, []):
		var cond: Dictionary = v[0]
		if cond.has("days") and not (cond["days"].has(weekday) or cond["days"].has(float(weekday))):
			continue
		if cond.has("seasons") and not cond["seasons"].has(season):
			continue
		# days of the season: the first Saturday of each season is {"days": [5], "dates": [1, ..., 7]}
		if cond.has("dates") and not (cond["dates"].has(date) or cond["dates"].has(float(date))):
			continue
		var fits := true
		for f in cond.get("flags", []):
			fits = fits and _flag(f)
		for f in cond.get("not", []):
			fits = fits and not _flag(f)
		if fits:
			pick = v[1]
	return pick


# A story flag: the ones the game already keeps, or story_flags.
func _flag(flag_name: String) -> bool:
	match flag_name:
		"ship_flown": return flights > 0
		"ivan_defeated": return artie_found_day >= 0
		"ana_rescued": return ana_found_day >= 0
		# Ana 0: she's still in the Medbay (her first two days after the rescue); afterwards it plays in the bay
		"ana_in_medbay": return ana_found_day >= 0 and day <= ana_found_day + 2
		"leviathan_slain": return leviathan_slain
		# Jasper 6: you've grown Moon wheat (set at the first harvest; older saves count wheat you're carrying)
		"moon_wheat_harvested": return bool(story_flags.get(flag_name, false)) or _count("moon_wheat") > 0
	return bool(story_flags.get(flag_name, false))


# ---------------------------------------------------------------- hearts and heart events
# Hearts (NPC Master 3.1): 100 points a heart; everyone caps at 8, the person you're dating at 10.
func _hearts(who: String) -> int:
	if not persons.has(who):
		return 0
	return int(persons[who]["friendship"]) / FRIEND_PER_HEART


func _add_friendship(who: String, points: int) -> void:
	if not persons.has(who):
		return
	var st: Dictionary = persons[who]
	var now: int = int(st["friendship"])
	var cap: int = (PARTNER_CAP if who == partner else HEART_CAP) * FRIEND_PER_HEART
	st["friendship"] = clampi(now + points, 0, maxi(cap, now))


# Checked each time you arrive in an area: the first event in HeartEvents.ORDER whose trigger fits plays.
func _check_heart_events() -> void:
	if cutscene == null or cutscene.running:
		return
	for id in HeartEvents.ORDER:
		if events_seen.has(id):
			continue
		var ev: Dictionary = _event_place(HeartEvents.EVENTS[id])
		if str(ev["area"]) == current_area and _event_ready(ev):
			cutscene.play(id)
			return


# Where an event plays today: its own place, or its backup place while the story flag its own place needs
# (backup "unless") isn't set yet. 8- and 10-heart events never wait for the story (NPC Master 3.7).
func _event_place(ev: Dictionary) -> Dictionary:
	if not ev.has("backup") or _flag(str(ev["backup"]["unless"])):
		return ev
	var out: Dictionary = ev.duplicate()
	for k in ev["backup"]:
		if k != "unless":
			out[k] = ev["backup"][k]
	return out


func _event_ready(ev: Dictionary) -> bool:
	var who: String = ev["who"]
	if not _arrived(who) or _hearts(who) < int(ev["hearts"]):
		return false
	# a scene for two (the Jasper & Evarra side arc): everyone in "with" needs the hearts too
	for w in ev.get("with", []):
		if not _arrived(str(w)) or _hearts(str(w)) < int(ev["hearts"]):
			return false
	if bool(ev.get("partner", false)) and partner != who:
		return false
	# "seasons": only in these seasons ("Autumn", "Winter"...)
	var seasons: Array = ev.get("seasons", [])
	if not seasons.is_empty() and not seasons.has(str(BridgeScript.season_date(day)[0])):
		return false
	for s in ev.get("seen", []):
		if not events_seen.has(s):
			return false
	for f in ev.get("flags", []):
		if not _flag(f):
			return false
	for f in ev.get("not", []):
		if _flag(f):
			return false
	var weekday: int = (day - 1) % 7
	for w in ev.get("windows", [[null, "06:00", "26:00"]]):
		var days = w[0]
		if days != null and not (days.has(weekday) or days.has(float(weekday))):
			continue
		if minutes >= _hm(str(w[1])) and minutes < _hm(str(w[2])):
			return true
	return false


func _hm(t: String) -> float:
	return float(int(t.get_slice(":", 0)) * 60 + int(t.get_slice(":", 1)))


# The cutscene calls this as it ends: remember the event, and put everyone back where their day says.
func _heart_event_done(id: String) -> void:
	if not events_seen.has(id):
		events_seen.append(id)
	_snap_residents()
	max_energy = _max_energy()      # Saffi's 8 makes the bar longer at once
	if id == "welcome":
		_save_game()      # the hoe, the can and the seeds
	elif id == "warden_found":
		if not custodians_found.has("warden"):
			custodians_found.append("warden")
		_save_game()
	elif id == "the_vision":
		story_flags["vision_seen"] = true
		_save_game()
	elif id == "shepherd_found":
		if not custodians_found.has("shepherd"):
			custodians_found.append("shepherd")
		_save_game()
		_back_to_map()
	elif id == "storm_ends":
		_back_to_map()
	elif id == "custodians_wake":
		for cid in ["sovereign", "chancellor", "forgemaster"]:
			if not custodians_found.has(cid):
				custodians_found.append(cid)
		_save_game()
	elif id == "prologue":
		# the quarantine is over: the first morning, in your own bed (the welcome waits outside your door)
		_go_home()
		minutes = float(DAY_START)
		_snap_residents()
		_save_game()


# Debug (F4): meet the next event's trigger (hearts, flags, partner, weekday, time, place) and play it.
func _debug_next_heart_event() -> void:
	for id in HeartEvents.ORDER:
		if events_seen.has(id):
			continue
		var ev: Dictionary = HeartEvents.EVENTS[id]
		var who: String = ev["who"]
		if not _arrived(who):
			# debug: bring the newcomer in, a few days after they arrived (out of the Medbay)
			if who == "Ana":
				ana_found_day = day - 5
			else:
				artie_found_day = day - 5
		for s in ev.get("seen", []):
			if not events_seen.has(s):
				events_seen.append(s)
		for f in ev.get("flags", []):
			if f == "ship_flown":
				flights = maxi(flights, 1)
			elif f == "leviathan_slain":
				leviathan_slain = true       # Zaas's 6 (the game keeps this one itself, not in story_flags)
			else:
				story_flags[f] = true
		if bool(ev.get("partner", false)):
			partner = who
		for w in [who] + Array(ev.get("with", [])):
			var st: Dictionary = persons[str(w)]
			st["friendship"] = maxi(int(st["friendship"]), int(ev["hearts"]) * FRIEND_PER_HEART)
		# a seasonal event: on to the first day of a season it plays in
		var seasons: Array = ev.get("seasons", [])
		for _i in 121:
			if seasons.is_empty() or seasons.has(str(BridgeScript.season_date(day)[0])):
				break
			day += 1
		ev = _event_place(ev)
		var w: Array = ev.get("windows", [[null, "06:00", "26:00"]])[0]
		if w[0] != null:
			day += posmod(int(w[0][0]) - (day - 1) % 7, 7)
		minutes = maxf(_hm(str(w[1])), float(DAY_START))
		var p: Array = ev.get("player", [0, 0, "d"])
		_go_to(str(ev["area"]), Vector2i(int(p[0]), int(p[1])))
		_event_area = current_area
		_snap_residents()
		cutscene.play(id)
		return
	debug_marathon = false
	_toast("Debug: no heart events left to play (Shift+F12 forgets the ones seen)")


# Debug (Ctrl+F12): when one heart event ends, the next one starts, a second later.
var debug_marathon := false


func _on_cutscene_finished(_id: String) -> void:
	if not debug_marathon:
		return
	await get_tree().create_timer(1.0).timeout
	if debug_marathon and not cutscene.running:
		_debug_next_heart_event()


# Wave 1 arrives after Ivan (artie_found_day = D): Artie wakes in the Medbay on D+1, the first visitor transport
# brings Stu on D+2, Eshu comes on D+4. Wave 2 is Ana, the day after you pull her out of her ship.
func _arrived(who: String) -> bool:
	match who:
		"Artie": return artie_found_day >= 0 and day >= artie_found_day + 1
		"Stu": return artie_found_day >= 0 and day >= artie_found_day + 2
		"Eshu": return artie_found_day >= 0 and day >= artie_found_day + 4
		"Ana": return ana_found_day >= 0 and day >= ana_found_day + 1
	return true


# True on the days a newcomer follows their SCHEDULES_ALT: Artie and Ana in the Medbay, Stu at the terminal.
func _first_days(who: String) -> bool:
	match who:
		"Artie": return day <= artie_found_day + 2
		"Ana": return day <= ana_found_day + 2
		"Stu": return day == artie_found_day + 2
	return false


# S.A.R.A.'s news in the morning, when someone new turns up.
func _morning_news() -> void:
	var news := ""
	if artie_found_day >= 0:
		match day - artie_found_day:
			1: news = "S.A.R.A.: the man from the stasis pod is awake. He's in the Medbay."
			2: news = "S.A.R.A.: the first visitor transport docked at the terminal overnight. Our first visitors in years."
			3: news = "S.A.R.A.: Artie is well enough to leave the Medbay. He has moved into East Home 1."
			4: news = "S.A.R.A.: a courier asked for a berth. Eshu, of the Post and Privateer Dispatch."
	if ana_found_day >= 0:
		match day - ana_found_day:
			1: news = "S.A.R.A.: Ana is awake in the Medbay. Garrick has posted himself by the door."
			3: news = "S.A.R.A.: Ana has moved into East Home 3. Garrick is not happy about it."
	if news != "":
		_toast(news)


# S.A.R.A.'s 8, Concierge: talk to her at any of her pads and she sends you to another (the datapad's Shop page
# lists them, scripts/shops.gd "Concierge"), and each morning she pings your datapad with what is waiting.
const SARA_PADS := {"top": "Her core, top of the station", "aptPlayer": "Your apartment", "west": "Reception, West Terminal",
	"main": "The plaza fountain"}


func concierge_rows() -> Array:
	var rows: Array = []
	for p in MapData.PEOPLE:
		if str(p[0]) != "Sara":
			continue
		var a: String = str(p[1])
		var here: bool = a == current_area
		rows.append(["p_Sara", str(SARA_PADS.get(a, a)), "You're here" if here else "", "", [["pad/" + a, "Go", not here]]])
	return rows


func sara_send(area_name: String) -> void:
	if not _flag("perk_concierge") or _sara_resting():
		return
	for p in MapData.PEOPLE:
		if str(p[0]) != "Sara" or str(p[1]) != area_name:
			continue
		var pad := Vector2i(int(p[2]), int(p[3]))
		var land := pad + Vector2i(0, 2)
		for off in [Vector2i(0, 2), Vector2i(0, 1), Vector2i(1, 1), Vector2i(-1, 1), Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 3)]:
			if _npc_walkable(area_name, pad + off, {}):
				land = pad + off
				break
		if datapad != null:
			datapad.open_page("HUD")
		sfx("sara_holo", 1.0, -4.0)
		_go_to(area_name, land)
		_toast("S.A.R.A. folds you across the station: %s." % str(SARA_PADS.get(area_name, area_name)).to_lower())
		return


func _sara_pings() -> void:
	if not _flag("perk_concierge"):
		return
	var notes: Array = []
	var ripe := 0
	for tile in farm:
		var c: Dictionary = CROPS.get(str(farm[tile].get("crop", "")), {})
		if not c.is_empty() and int(farm[tile]["age"]) >= int(c["days"]):
			ripe += 1
	if ripe > 0:
		notes.append("%d crop%s ready to pick" % [ripe, "" if ripe == 1 else "s"])
	if not rusk_cask.is_empty() and day >= int(rusk_cask.get("ready", day + 1)):
		notes.append("Rusk's wine is ready")
	if not notes.is_empty():
		_toast("S.A.R.A.: " + "; ".join(notes) + ".")


# Someone who stays in one place. One person can appear in several places
# (Sara's holograms) and shares one state.
# Art can be drawn at any size. This scales a sprite so one frame is `world_width` wide in the world,
# and puts its origin at the bottom centre of the frame.
func _fit_sprite(s: Sprite2D, columns: int, rows: int, world_width: float) -> void:
	var frame_w: float = s.texture.get_width() / float(columns)
	var frame_h: float = s.texture.get_height() / float(rows)
	s.scale = Vector2(world_width / frame_w, world_width / frame_w)
	s.offset = Vector2(-frame_w / 2.0, -frame_h)


# S.A.R.A. is the animated hologram from res://sara (33 clips, from Zachary's Survey Art Pack): one copy per
# pad. On her core she stands on the hologram dais.
var sara_nodes: Array = []
func _add_sara(area_name: String, tile: Vector2i, radius: float) -> void:
	_ensure_person("Sara")
	var h = load("res://sara/sara_hologram.tscn").instantiate()
	h.show_projector = false          # the dais or pad is already part of the map
	# The 19 Nov hologram art (SARA_Hologram_Game_Sprites.zip) stores each pixel as a 2x2 block, so half the
	# usual art scale keeps one of her pixels the size of everyone else's. She is now resident-sized (24x48).
	h.art_scale = ART / 2.0
	if area_name == "top":
		h.position = Vector2(23 * TILE + 8, 21 * TILE - 11)   # the centre of the dais (tools/survey.py)
	else:
		h.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 12)
	h.visible = false
	actors.add_child(h)
	area_sprites.append([h, area_name])
	sara_nodes.append([h, area_name])
	var here: Dictionary = blocked[area_name]
	here[tile] = true
	things.append({
		"kind": "person", "name": "Sara", "hint": "Talk to S.A.R.A.", "area": area_name,
		"pos": Vector2(tile.x * TILE + 8, tile.y * TILE + 10), "radius": radius, "who": "Sara",
	})


# The hologram in this area plays a clip (greeting, explain, laugh, ...), if it has one.
func _sara_play(clip: String) -> void:
	for pair in sara_nodes:
		if pair[1] == current_area:
			pair[0].play(clip)


func _add_person(who: String, area_name: String, tile: Vector2i, radius: float) -> void:
	if who == "Sara" and ResourceLoader.exists("res://sara/sara_hologram.tscn"):
		_add_sara(area_name, tile, radius)
		return
	var id: String = _ensure_person(who)
	var s := Sprite2D.new()
	s.texture = load("res://art/npc_%s.png" % id)
	s.hframes = 4
	s.vframes = WalkCycle.rows(s.texture)
	s.centered = false
	# Scaled so one frame is 16 wide in the world whatever size the art was drawn at.
	var frame_w: float = s.texture.get_width() / 4.0
	var frame_h: float = s.texture.get_height() / float(s.vframes)
	s.scale = Vector2(16.0 / frame_w, 16.0 / frame_w)
	s.offset = Vector2(-frame_w / 2.0, -frame_h)
	if who == "Sara":
		holos.append(s)       # a hologram: she hovers over her pad and flickers
	s.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 16)
	s.visible = false
	actors.add_child(s)
	area_sprites.append([s, area_name])
	var here: Dictionary = blocked[area_name]
	here[tile] = true
	things.append({
		"kind": "person", "name": who, "hint": "Talk to %s" % who, "area": area_name,
		"pos": Vector2(tile.x * TILE + 8, tile.y * TILE + 10), "radius": radius, "who": who,
	})


# ---------------------------------------------------------------- pathfinding for residents

func _npc_walkable(area_name: String, t: Vector2i, goal_set: Dictionary) -> bool:
	var data: Dictionary = MapData.AREAS[area_name]
	var floor_rows: Array = data["floor"]
	if t.y < 0 or t.y >= floor_rows.size():
		return false
	var frow: String = floor_rows[t.y]
	if t.x < 0 or t.x >= frow.length():
		return false
	var fch: String = frow[t.x]
	if MapData.SOLID_FLOOR.contains(fch):
		return false
	# Residents only get into a bed to sleep in it, never to cut across it.
	var bed_here: Dictionary = beds.get(area_name, {})
	if bed_here.has(t):
		return goal_set.has(t)
	var obj_rows: Array = data["obj"]
	var orow: String = obj_rows[t.y]
	var och: String = orow[t.x]
	if och != " " and not MapData.OPEN_OBJ.contains(och):
		return false
	var fixed_here: Dictionary = fixed[area_name]
	if fixed_here.has(t):
		return false
	# Residents only step on a lift or airlock pad when they mean to use it.
	var pads: Dictionary = warps[area_name]
	if pads.has(t) and not goal_set.has(t):
		return false
	return true


# Shortest walk from one tile to the nearest of the goal tiles. Returns the tiles to step on, in order.
# A resident's route across one area (A*). Each resident (walker, a seed from their name) has their own
# taste in routes: every 5x5 block of tiles costs them a little more or less to cross, so two people
# going the same way often take different aisles or sides of a room. Turning costs a little too, so
# routes run in long straight lines rather than staircases. walker 0: the plain shortest route.
const PATH_DIRS := [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]
const PATH_TURN := 0.35
const PATH_TASTE := 0.9
const PATH_BLOCK := 5
const PATH_GREED := 1.5      # how hard the search leans toward the goal: much faster, routes still near-shortest


func find_path(area_name: String, from: Vector2i, goals: Array, walker: int = 0) -> Array:
	var goal_set := {}
	for g in goals:
		goal_set[g] = true
	if goal_set.has(from):
		return []
	# states are a tile and the way the walker last stepped (4: not yet moved)
	var start := Vector3i(from.x, from.y, 4)
	var cost := {start: 0.0}
	var came := {}
	var heap: Array = []          # [f, order, state], a binary heap on f
	var order := 0
	_heap_push(heap, [PATH_GREED * _path_guess(from, goals), order, start])
	var found = null
	var seen := 0
	while not heap.is_empty() and seen < 40000:
		var top: Array = _heap_pop(heap)
		var cur: Vector3i = top[2]
		var so_far: float = cost[cur]
		if float(top[0]) > so_far + PATH_GREED * _path_guess(Vector2i(cur.x, cur.y), goals) + 0.001:
			continue                  # a better way here was already taken
		seen += 1
		var here := Vector2i(cur.x, cur.y)
		if goal_set.has(here):
			found = cur
			break
		for i in 4:
			var nb: Vector2i = here + PATH_DIRS[i]
			if not _npc_walkable(area_name, nb, goal_set):
				continue
			var step := 1.0
			if cur.z != 4 and cur.z != i:
				step += PATH_TURN
			if walker != 0:
				step += PATH_TASTE * _path_taste(walker, nb)
			var next := Vector3i(nb.x, nb.y, i)
			var ng: float = so_far + step
			if cost.has(next) and float(cost[next]) <= ng:
				continue
			cost[next] = ng
			came[next] = cur
			order += 1
			_heap_push(heap, [ng + PATH_GREED * _path_guess(nb, goals), order, next])
	if found == null:
		return []
	var path: Array = []
	var at: Vector3i = found
	while at != start:
		path.push_front(Vector2i(at.x, at.y))
		at = came[at]
	return path


func _path_guess(t: Vector2i, goals: Array) -> float:
	var best := INF
	for gl in goals:
		var goal: Vector2i = gl
		best = minf(best, float(absi(goal.x - t.x) + absi(goal.y - t.y)))
	return best


# 0..1, the same for every tile in a block, different for each walker.
func _path_taste(walker: int, t: Vector2i) -> float:
	var h: int = hash(Vector3i(floori(float(t.x) / PATH_BLOCK), floori(float(t.y) / PATH_BLOCK), walker))
	return float(absi(h) % 1000) / 1000.0


func _heap_push(heap: Array, item: Array) -> void:
	heap.append(item)
	var i := heap.size() - 1
	while i > 0:
		var up := (i - 1) / 2
		if _heap_less(heap[i], heap[up]):
			var tmp = heap[i]
			heap[i] = heap[up]
			heap[up] = tmp
			i = up
		else:
			break


func _heap_pop(heap: Array) -> Array:
	var top: Array = heap[0]
	var last: Array = heap.pop_back()
	if not heap.is_empty():
		heap[0] = last
		var i := 0
		var n := heap.size()
		while true:
			var l := 2 * i + 1
			var r := l + 1
			var m := i
			if l < n and _heap_less(heap[l], heap[m]):
				m = l
			if r < n and _heap_less(heap[r], heap[m]):
				m = r
			if m == i:
				break
			var tmp = heap[i]
			heap[i] = heap[m]
			heap[m] = tmp
			i = m
	return top


func _heap_less(a: Array, b: Array) -> bool:
	return float(a[0]) < float(b[0]) or (float(a[0]) == float(b[0]) and int(a[1]) < int(b[1]))


# Which neighbouring area to head for first when travelling between two areas.
func next_area(from_area: String, to_area: String) -> String:
	var prev := {}
	prev[from_area] = ""
	var queue: Array = [from_area]
	var head := 0
	while head < queue.size():
		var cur: String = queue[head]
		head += 1
		if cur == to_area:
			break
		var links: Dictionary = area_links[cur]
		for nxt in links:
			if not prev.has(nxt):
				prev[nxt] = cur
				queue.append(nxt)
	if not prev.has(to_area):
		return ""
	var at: String = to_area
	while prev[at] != from_area:
		at = prev[at]
	return at


func pads_to(from_area: String, to_area: String) -> Array:
	var links: Dictionary = area_links[from_area]
	var pads: Array = links.get(to_area, [])
	return pads


# True when the player is standing on (or partly on) a tile of the area they are in.
func player_overlaps_tile(area_name: String, t: Vector2i) -> bool:
	if area_name != current_area:
		return false
	var ppos: Vector2 = player.position
	var feet := Rect2(ppos.x - 6.0, ppos.y - 7.0, 12.0, 8.0)
	return feet.intersects(Rect2(t.x * TILE, t.y * TILE, TILE, TILE))


func _usable(t: Dictionary) -> bool:
	if t["area"] != current_area:
		return false
	var kind: String = t["kind"]
	if kind == "pickup" or kind == "drop":
		return false                 # Bram's crate-hauling job is gone (Zachary, 23 Nov)
	if kind == "forage":
		return int(forage_taken.get(_forage_key(t), -1)) != day
	if kind == "sealed":
		return not station_fixed.has(str(t["repair"]))
	return true


func _nearest_thing():
	var best = null
	var best_d := 99999.0
	var ppos: Vector2 = player.position
	var from: Vector2 = ppos + Vector2(0, -4)
	for t in things:
		if not _usable(t):
			continue
		var pos: Vector2 = t["pos"]
		var radius: float = t["radius"]
		var d: float = from.distance_to(pos)
		if d <= radius and d < best_d:
			best = t
			best_d = d
	return best


# Where to sit on each kind of seat (22-23 Nov), in its own art pixels: the facing (0 down, 1 up, 2 left,
# 3 right), each place's hip position, and whether the seat's back is between the sitter and the
# camera (SEAT_BEHIND: the sitter is drawn behind the seat, whose solid back hides all but head and
# shoulders; tools/solid_bench_backs.py filled the gaps between the slats). Several places on a bench
# or sofa: the one nearest the player is taken.
const SEAT_BEHIND := 1
const SEAT_SORT := 12.0
const SEATS := {
	"bench_s": [0, [Vector2(17, 28), Vector2(39, 28)], -1],
	"bench": [0, [Vector2(18, 26), Vector2(48, 26)], -1],
	"view_bench": [0, [Vector2(18, 22), Vector2(46, 22)], -1],
	"waiting_seat": [0, [Vector2(13, 22), Vector2(37, 22), Vector2(61, 22)], -1],
	"sofa": [0, [Vector2(18, 18), Vector2(38, 18)], -1],
	"armchair": [0, [Vector2(16, 19)], -1],
	"chair_s": [0, [Vector2(11, 17)], -1],
	"bench_n": [1, [Vector2(17, 17), Vector2(39, 17)], SEAT_BEHIND],
	"chair_n": [1, [Vector2(11, 12)], SEAT_BEHIND],
	"bar_stool": [1, [Vector2(8, 9)], -1],
	"cafe_table": [1, [Vector2(15, 26)], -1],
	"chair_e": [3, [Vector2(9, 15)], -1],
	"chair_w": [2, [Vector2(8, 15)], -1],
	"bench_e": [3, [Vector2(18, 24), Vector2(18, 38)], -1],
	"bench_w": [2, [Vector2(11, 24), Vector2(11, 38)], -1],
	"waiting_seat_w": [2, [Vector2(12, 15), Vector2(12, 33)], -1],
}


# The seat prop under a seat's spot (THINGS put the spot 8 units above the middle of the prop's bottom
# edge). Empty if there is none.
func _seat_prop(t: Dictionary) -> Array:
	var props: Array = MapData.CONCOURSE_PROPS if current_area == "main" else MapData.AREA_PROPS.get(current_area, [])
	var pos: Vector2 = t["pos"]
	var best: Array = []
	var best_d := 6.0
	for p in props:
		if not SEATS.has(str(p[0])):
			continue
		var spot := Vector2(float(p[1]) * TILE + float(p[3]) * TILE * 0.5, float(int(p[2]) + int(p[4])) * TILE - 8.0)
		# the same title wins a tie ("Dining chair left" sits on a "Dining chair [E]")
		var d := spot.distance_to(pos) + (0.0 if str(p[5]) == str(t["name"]) else 0.5)
		if d < best_d:
			best_d = d
			best = p
	return best


func _sit_on(t: Dictionary) -> void:
	var p := _seat_prop(t)
	var kind: String = str(p[0]) if not p.is_empty() else ""
	if not SEATS.has(kind) or not ResourceLoader.exists("res://art/lunar/%s.png" % kind):
		# a seat with no picture of its own: sit on the spot, facing the screen
		player.position = t["pos"]
		player.set_sitting(true, 0, t["pos"] + Vector2(0, -6))
		return
	var tex: Texture2D = load("res://art/lunar/%s.png" % kind)
	var left: float = float(p[1]) * TILE + (float(p[3]) * TILE - tex.get_width() * ART) * 0.5
	var bottom: float = float(int(p[2]) + int(p[4])) * TILE
	var top: float = bottom - tex.get_height() * ART
	var info: Array = SEATS[kind]
	var hip := Vector2.ZERO
	var nearest := INF
	for slot in info[1]:
		var at := Vector2(left, top) + Vector2(slot) * ART
		var d := at.distance_to(seat_return)
		if d < nearest:
			nearest = d
			hip = at
	# the sitter sorts just in front of the seat, or just behind it when its back faces the camera
	var sort_y: float = bottom - (SEAT_SORT if kind == "game_chair" or kind == "bar_stool" or kind.begins_with("chair_") or kind.begins_with("bench_") else 0.0)
	var behind: bool = int(info[2]) == SEAT_BEHIND
	player.position = Vector2(round(hip.x), sort_y + (-1.0 if behind else 1.0))
	player.set_sitting(true, int(info[0]), hip)


func _stand_from_seat() -> void:
	seated = false
	player.position = seat_return
	player.set_sitting(false)
	player.frozen = false

func _interact(t: Dictionary) -> void:
	var kind: String = t["kind"]
	sfx("click")
	if travelling or garden_busy: return
	if kind == "portal":
		_enter_portal(t)
	elif kind == "sealed" and not StationRepair.REPAIRS.has(str(t["repair"])):
		_say("Sara", ["[sad] The storage dome's seals are beyond my drones, I'm afraid. Precursor glass: nobody makes it any more.",
			"Tar'Besh insists the old crystals in his Sanctum could mend anything. I keep telling him they're rocks."], Callable(), "", Callable(), "Not now", "Sara")
	elif kind == "sealed":
		repair_view.open_at(str(t["repair"]))
	elif kind == "placed":
		_use_placed(t)
	elif kind == "garden":
		_water_garden(t)
	elif kind == "farm_tools":
		_say("Garden tools", ["Hooks for a hoe and a watering can. Bram and Jasper brought yours on your first morning."])
	elif kind == "seeds":
		_say("Seed rack", ["Empty. Bram sells seeds at his Sundries on the town square."])
	elif kind == "inspect" and current_area == "aptPlayer" and str(t["name"]) == "Kitchenette":
