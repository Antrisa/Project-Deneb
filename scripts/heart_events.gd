			["fade", 0.7, 1.0],
			["say", "", ["Star tomato soup. Crater potatoes roasted crisp. The last of the butter, on bread made from your wheat."]],
			["clock", 60],
			["fade", 0.0, 1.0],
			["say", "Jasper", ["[sad] For years I have set tables for everyone. A hundred plates a day. I never once set a table of my own.",
				"I always thought my dream was Paris. The bridges, the cafés, the tower of iron lace.",
				"But do you know which part of the holo-vid I watch the most? Not the cooking. The end, when he sits down and eats with someone."]],
			["if", {"dating_other": "Jasper"},
				# the friendship ending: you're dating someone else
				[["pose", "Jasper", "talk"],
				 ["say", "Jasper", ["[happy] That part is what I wanted all along. You helped me see it, my friend."]],
				 ["pose", "Jasper", ""],
				 ["place", "Evarra", 16, 23, "u"], ["walk", "Evarra", 13, 20], ["face", "Evarra", "l"], ["emote", "Evarra", "surprise"],
				 ["say", "Evarra", ["[surprised] Candlelight? In our kitchen? Jasper, is there a third plate?"]],
				 ["face", "Jasper", "Evarra"], ["pose", "Jasper", "laugh"], ["emote", "Evarra", "joy"],
				 ["say", "Jasper", ["[happy] There is always a third plate. A table needs more than two chairs. That is the whole secret, I think."]],
				 ["pose", "Jasper", ""]],
				[["pose", "Jasper", "talk"],
				 ["say", "Jasper", ["[bashful] And when you sit across from me, I do not miss Paris at all. Not even a little.",
					"[love] I would like this to be our table. Not as friends. Will you stay for dessert, and for a great many dinners after?"]],
				 ["pose", "Jasper", ""], ["emote", "Jasper", "love"],
				 ["choose", [
					{"text": "I'd love to share your table, Jasper.", "steps": [
						["partner", "Jasper"],
						["emote", "Jasper", "surprise"],
						["say", "Jasper", ["[surprised] Truly? Ha! Then dessert! Wait here. Do not move!"]],
						["pose", "Jasper", "jump"], ["emote", "Jasper", "joy"], ["wait", 0.8], ["pose", "Jasper", ""],
						["fade", 0.7, 1.0],
						["say", "", ["Dessert is a little burnt. Neither of you minds. The candle burns down to nothing before you leave."]],
						["fade", 0.0, 1.0]]},
					{"text": "You mean a lot to me, as a friend.", "steps": [
						["pose", "Jasper", "sad"], ["emote", "Jasper", "sad"],
						["say", "Jasper", ["[sad] Ah. Of course. Then you will always have a seat here, as my friend. That is not a small thing."]],
						["pose", "Jasper", ""],
						["say", "Jasper", ["[happy] Now eat. I did not cook all afternoon for you to look sad at my soup."]]]}]]]],
			["pose", "Jasper", "talk"],
			["say", "Jasper", ["[happy] And from now on, bring me what you cook. I will teach you how to make a good meal stay with you."]],
			["pose", "Jasper", ""],
			["perk", "sous_chefs_blessing", "Perk: Sous-Chef's Blessing (food buffs last 20% longer)"],
		],
	},
