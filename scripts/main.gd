func _setup_input() -> void:
	_add_keys("move_left", [KEY_A, KEY_LEFT])
	_add_keys("move_right", [KEY_D, KEY_RIGHT])
	_add_keys("move_up", [KEY_W, KEY_UP])
	_add_keys("move_down", [KEY_S, KEY_DOWN])
	_add_keys("interact", [KEY_E, KEY_ENTER])
	_add_keys("use", [KEY_SPACE, KEY_F])
	_add_keys("menu", [KEY_TAB, KEY_I])
	_add_keys("journal", [KEY_J])
	_add_keys("cancel", [KEY_Q, KEY_ESCAPE])
	_add_keys("new_game", [KEY_F9])
	_add_keys("music", [KEY_M])


func _add_keys(action: String, keys: Array) -> void:
	if InputMap.has_action(action):
		return
	InputMap.add_action(action)
	for k in keys:
		var ev := InputEventKey.new()
		ev.physical_keycode = k
		InputMap.action_add_event(action, ev)


# Screen size. The game is drawn at 640x360 and only ever scaled by whole numbers, so every art pixel is the
# same size on screen: 1080p is exactly 3x (3 screen pixels per art pixel), 1440p 4x, 4K 6x, 720p 2x.
# It starts in EXCLUSIVE fullscreen (project.godot, window/size/mode=4). Borderless fullscreen is not used: on
# Windows it deliberately makes the window a pixel off the screen's size, which can knock the whole-number
# scaling off (a smaller scale, or a half-pixel offset) and leave the picture soft (Zachary, 20 Nov: "everything
# looks fuzzy"). The project must not start windowed: Godot 4.4+ then runs it inside the editor's Game tab at
# 1280x720 (21 Nov: the intro played small). Godot 4.6 can't leave exclusive fullscreen for a window when the
# window size setting equals the monitor's (godotengine/godot#120283); ours is 1280x720, which avoids that. Alt+Enter switches to a window sized to the largest whole multiple that fits the
# desktop, so windowed play stays sharp too. F8 checks all this on the player's own screen (_display_check).
func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_ENTER and event.alt_pressed:
		_toggle_fullscreen()
		get_viewport().set_input_as_handled()

func _toggle_fullscreen() -> void:
	if _embedded(): return
	if DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN or DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
		_size_window()
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN)


# The project setting already starts it fullscreen; this only catches a start in a window (e.g. the setting reset).
func _start_fullscreen() -> void:
	if not _embedded() and DisplayServer.window_get_mode() != DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN)


# True when the game is running inside the editor's Game tab (Godot 4.4+), where the editor owns the window.
func _embedded() -> bool:
	return Engine.has_method("is_embedded_in_editor") and bool(Engine.call("is_embedded_in_editor"))


# F8: how the game is really being drawn on this screen, and a full-size screenshot to compare. Sharp means:
# a whole-number scale, one art pixel a whole number of screen pixels, and no half-pixel offset.
func _display_check() -> void:
	var screen_i: int = DisplayServer.window_get_current_screen()
	var screen: Vector2i = DisplayServer.screen_get_size(screen_i)
	var win: Vector2i = DisplayServer.window_get_size()
	var to_screen: Transform2D = get_viewport().get_screen_transform()
	var stretch: float = to_screen.get_scale().x
	var art_px: float = stretch * CAMERA_ZOOM * ART
	var mode_names := {0: "windowed", 1: "minimized", 2: "maximized", 3: "borderless fullscreen", 4: "exclusive fullscreen"}
	var mode_name: String = mode_names.get(DisplayServer.window_get_mode(), "?")
	if _embedded(): mode_name += ", inside the editor"
	var sharp: bool = is_equal_approx(art_px, roundf(art_px)) \
		and is_equal_approx(to_screen.origin.x, roundf(to_screen.origin.x)) and is_equal_approx(to_screen.origin.y, roundf(to_screen.origin.y))
	var shot := "user://display_check.png"
	get_viewport().get_texture().get_image().save_png(shot)
	var line := "Display check: screen %dx%d (OS scale %.2f), window %dx%d, %s. Game scale %.3fx, offset (%.2f, %.2f): one art pixel = %.3f screen pixels. %s Screenshot: %s" % [
		screen.x, screen.y, DisplayServer.screen_get_scale(screen_i), win.x, win.y, mode_name, stretch,
		to_screen.origin.x, to_screen.origin.y, art_px, "SHARP." if sharp else "NOT WHOLE PIXELS: this is the blur.",
		ProjectSettings.globalize_path(shot)]
	print(line)
	_toast("%s - %.2f screen px per art pixel. Details in the output log." % ["Sharp" if sharp else "Not whole pixels", art_px])

func _size_window() -> void:
	var screen: int = DisplayServer.window_get_current_screen()
	var usable: Rect2i = DisplayServer.screen_get_usable_rect(screen)
	# Leave room for the title bar, then take the biggest whole multiple of 320x180 that fits.
	var k: int = maxi(1, mini(int((usable.size.x - 16) / 640.0), int((usable.size.y - 48) / 360.0)))
	if k * 640 >= usable.size.x: k = maxi(1, k - 1)
	var size := Vector2i(640 * k, 360 * k)
	DisplayServer.window_set_size(size)
	DisplayServer.window_set_position(usable.position + (usable.size - size) / 2)

func _unhandled_input(event: InputEvent) -> void:
	if title != null and title.open:
		title.handle_input(event)
		get_viewport().set_input_as_handled()
		return
	if datapad != null and datapad.blocking():
		return                     # a datapad page is open; it takes its own keys
	if travelling or garden_busy: return
	if ship_store != null and ship_store.open:
		if dialogue.active:
			if event.is_action_pressed("interact") or event.is_action_pressed("use"):
				dialogue.advance()
		else:
			ship_store.handle_input(event)
		get_viewport().set_input_as_handled()
		return
	if ship_event != null and ship_event.open:
		if dialogue.active:
			if event.is_action_pressed("interact") or event.is_action_pressed("use"):
				dialogue.advance()
			elif event.is_action_pressed("cancel"):
				dialogue.cancel()
		else:
			ship_event.handle_input(event)
		get_viewport().set_input_as_handled()
		return
	if battle != null and battle.open:
		if dialogue.active:
			if event.is_action_pressed("interact") or event.is_action_pressed("use"):
				dialogue.advance()
			elif event.is_action_pressed("cancel"):
				dialogue.cancel()
		else:
			battle.handle_input(event)
		get_viewport().set_input_as_handled()
		return
	if ship_map != null and ship_map.open:
		if dialogue.active:
			if event.is_action_pressed("interact") or event.is_action_pressed("use"):
				dialogue.advance()
			elif event.is_action_pressed("cancel"):
				dialogue.cancel()
		else:
			ship_map.handle_input(event)
		get_viewport().set_input_as_handled()
		return
	if community_game != null and community_game.open:
		community_game.handle_input(event)
		get_viewport().set_input_as_handled()
		return
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F11 and OS.is_debug_build():
		if creator != null: creator.open = false; creator.visible = false
		if appearance.is_empty():
			appearance = maker.defaults(); player.set_sheet(maker.sheet(appearance), maker.action_sheet(appearance))
		minutes = 875.0
		review_stop = (review_stop+1)%10
		_go_to("main",[Vector2i(115,100),Vector2i(106,80),Vector2i(122,110),Vector2i(54,81),Vector2i(139,91),Vector2i(150,64),Vector2i(150,126),Vector2i(80,126),Vector2i(115,23),Vector2i(115,167)][review_stop])
		_snap_residents()
		return
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F8:
		_display_check()
		return
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F7 and OS.is_debug_build():
		_debug_ship_ready()
		return
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F6 and OS.is_debug_build():
		_debug_boarding()
		return
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F10:
		overview = not overview
		player._cam.zoom = Vector2.ONE * (0.08 if overview else 1.0) * CAMERA_ZOOM
		player._cam.position = Vector2(1848,1528)-player.position if overview and current_area == "main" else Vector2(0,-8)
		return
	if seated:
		if event.is_action_pressed("interact") or event.is_action_pressed("cancel") or event.is_action_pressed("move_left") or event.is_action_pressed("move_right") or event.is_action_pressed("move_up") or event.is_action_pressed("move_down"):
			_stand_from_seat()
		get_viewport().set_input_as_handled()
		return
	if station_calendar != null and station_calendar.open:
		station_calendar.handle_input(event)
		get_viewport().set_input_as_handled()
		return
	if event.is_action_pressed("new_game"):
		_new_game()                # F9
		return
	var click := event as InputEventMouseButton
	if click != null:
		if click.pressed:
			_mouse_button(click.button_index)
		return
	if event.is_action_pressed("music"):
		_toggle_music()
		return
	if creator != null and creator.open:
		creator.handle_input(event)
		return
	if ui.recap_open:
		if event.is_action_pressed("interact") or event.is_action_pressed("cancel") or event.is_action_pressed("use"):
			ui.recap_open = false
			sfx("click")
		return
	if ui.open:
		ui.handle_input(event)
		return
	if dialogue.active:
		if event.is_action_pressed("interact") or event.is_action_pressed("use"):
			dialogue.advance()
		elif event.is_action_pressed("cancel"):
			dialogue.cancel()
		return
	if event.is_action_pressed("menu"):
		if datapad != null:
			datapad.open_page("Inventory")
		else:
			ui.show_menu()
			sfx("click")
	elif event.is_action_pressed("journal"):
		if datapad != null:
			datapad.open_page("Journal")
		else:
			ui.show_menu(4)
			sfx("click")
	elif event.is_action_pressed("interact"):
		if not _try_harvest():
			_interact_nearest()
	elif event.is_action_pressed("use"):
		_use_tool()
	else:
		# Number keys 1-8 pick a hotbar slot.
		var key_event := event as InputEventKey
		if key_event != null and key_event.pressed and not key_event.echo:
			var key: int = key_event.physical_keycode
			if key >= KEY_1 and key <= KEY_8:
				selected = key - KEY_1
				sfx("click", 1.4, -6.0)


func _interact_nearest() -> void:
	if player.eating:
		return
	var t = _nearest_thing()
	if t != null:
		_interact(t)


# Mouse: left click uses the selected item (or interacts if it has no use), right click interacts,
# the wheel changes the hotbar slot. In the menu, clicks go to scripts/ui.gd.
func _mouse_button(button: int) -> void:
	if seated or travelling or garden_busy or (community_game != null and community_game.open): return
	if station_calendar != null and station_calendar.open:
		return
	if creator != null and creator.open:
		creator.handle_click(button)
		return
	if ui.recap_open:
		if button == MOUSE_BUTTON_LEFT:
			ui.recap_open = false
			sfx("click")
		return
	if ui.open:
		ui.handle_click(button)
		return
	if dialogue.active:
		if button == MOUSE_BUTTON_LEFT:
			dialogue.advance()
		elif button == MOUSE_BUTTON_RIGHT:
			dialogue.cancel()
		return
	if button == MOUSE_BUTTON_WHEEL_UP:
		selected = (selected + 7) % 8
	elif button == MOUSE_BUTTON_WHEEL_DOWN:
		selected = (selected + 1) % 8
	elif button == MOUSE_BUTTON_LEFT:
		var at: Vector2 = ui.mouse()
		var slot: int = ui.hotbar_slot_at(at) if datapad == null else -1
		if datapad == null and ui.menu_button_at(at):
			ui.show_menu()
			sfx("click")
		elif slot != -1:
			selected = slot
			sfx("click", 1.4, -6.0)
		elif _selected_use() != "":
			_use_tool()
		else:
			_interact_clicked()
	elif button == MOUSE_BUTTON_RIGHT:
		_interact_clicked()


# ---------------------------------------------------------------- areas and map

func map_pixel_size() -> Vector2i:
	var data: Dictionary = MapData.AREAS[current_area]
	var rows: Array = data["floor"]
	var first: String = rows[0]
	return Vector2i(first.length() * TILE, rows.size() * TILE)


func solid_at(p: Vector2) -> bool:
	var data: Dictionary = MapData.AREAS[current_area]
	var floor_rows: Array = data["floor"]
	var tx := int(floor(p.x / TILE))
	var ty := int(floor(p.y / TILE))
	if ty < 0 or ty >= floor_rows.size():
		return true
	var frow: String = floor_rows[ty]
	if tx < 0 or tx >= frow.length():
		return true
	var portal_key := _portal_key(current_area,Vector2i(tx,ty))
	if portals.has(portal_key) and portals[portal_key].opening < 0.95: return true
	for d in inner_doors:
		if d.area == current_area and d.blocks() and d.tiles.has(Vector2i(tx,ty)): return true
	var fch: String = frow[tx]
	if MapData.SOLID_FLOOR.contains(fch):
		return true
	var obj_rows: Array = data["obj"]
	var orow: String = obj_rows[ty]
	var och: String = orow[tx]
	if och != " " and not MapData.OPEN_OBJ.contains(och):
		return true
	var here: Dictionary = blocked[current_area]
	return here.has(Vector2i(tx, ty))


func _feet(tile: Vector2i) -> Vector2:
	return Vector2(tile.x * TILE + 8, tile.y * TILE + 12)


func player_tile() -> Vector2i:
	return _player_tile()


func _player_tile() -> Vector2i:
	var ppos: Vector2 = player.position
	return Vector2i(int(floor(ppos.x / TILE)), int(floor((ppos.y - 3.0) / TILE)))


func _go_to(area_name: String, tile: Vector2i, announce: bool = true) -> void:
	if seated: _stand_from_seat()
	if current_area != "":
		area_nodes[current_area].visible = false
		area_tops[current_area].visible = false
	current_area = area_name
	area_nodes[area_name].visible = true
	area_tops[area_name].visible = true
	for pair in area_sprites:
		var s: CanvasItem = pair[0]
		var where: String = pair[1]
		s.visible = where == area_name
	for r in residents:
		r.visible = r.area == area_name
	for en in enemies:
		en.visible = en.alive and en.area == area_name
	player.position = _feet(tile)
	player.set_limits(map_pixel_size(), MessWindow.HEADROOM if area_name == "mess" else 0)
	if announce:
		var data: Dictionary = MapData.AREAS[area_name]
		var area_title: String = data["title"]
		_toast(area_title)
		sfx("warp")


# Animated overlays. Each art file has 4 frames of 16x16, laid over the still tile.
# [art file, drawn over the tile above (true) or on the tile itself (false), frames per second]
const FX_OBJ := {
	"k": ["res://art/fx_console.png", true, 2.0],
	"K": ["res://art/fx_display.png", true, 6.0],
	"F": ["res://art/fx_furnace.png", false, 8.0],
	"G": ["res://art/fx_core.png", false, 4.0],
}
const FX_FLOOR := {
	"O": ["res://art/fx_water.png", false, 3.0],
}


func _add_fx() -> void:
	var ripple := Sprite2D.new()
	ripple.texture = preload("res://art/lunar/hotel/fountain_ripples.png")
	ripple.hframes = 8
	ripple.scale = Vector2.ONE * ART
	ripple.position = Vector2(60, 21.5) * TILE
	ripple.visible = false
	ground_fx.add_child(ripple)
	area_sprites.append([ripple, "hotel"])
	anim.append([ripple, "hotel", 6.5, 0])
	for area_name in MapData.AREAS:
		var data: Dictionary = MapData.AREAS[area_name]
		var floor_rows: Array = data["floor"]
		var obj_rows: Array = data["obj"]
		for y in floor_rows.size():
			var frow: String = floor_rows[y]
			var orow: String = obj_rows[y]
			for x in frow.length():
				var fch: String = frow[x]
				if FX_FLOOR.has(fch) and not (area_name in ["hotel", "agri"] and fch == "O"):
					_add_fx_sprite(FX_FLOOR[fch], area_name, x, y)
				var och: String = orow[x]
				if FX_OBJ.has(och):
					_add_fx_sprite(FX_OBJ[och], area_name, x, y)


func _add_fx_sprite(info: Array, area_name: String, x: int, y: int) -> void:
	var on_top: bool = info[1]
	var s := Sprite2D.new()
	s.texture = load(info[0])
	s.hframes = 4
	s.centered = false
	var fit: float = 16.0 / (s.texture.get_width() / 4.0)
	s.scale = Vector2(fit, fit)
	s.position = Vector2(x * TILE, (y - 1 if on_top else y) * TILE)
	s.visible = false
	if on_top:
		top_fx.add_child(s)
	else:
		ground_fx.add_child(s)
	area_sprites.append([s, area_name])
	# Screens stay in step with each other; everything else starts on a different frame.
	var start: int = 0 if on_top else (x * 3 + y * 5) % 4
	anim.append([s, area_name, float(info[2]), start])


func _animate() -> void:
	var now: float = Time.get_ticks_msec() / 1000.0
	for a in anim:
		if a[1] == current_area:
			var s: Sprite2D = a[0]
			s.frame = (int(now * float(a[2])) + int(a[3])) % (s.hframes * s.vframes)
	# Stationary projection; frame-local shader dissolves legs and animates light.
	for h in holos:
		var hs: Sprite2D = h
		if not hs.has_meta("sara_hologram_v5"):
			var holo_material := ShaderMaterial.new()
			holo_material.shader = load("res://shaders/sara_hologram.gdshader")
			holo_material.set_shader_parameter("sheet_grid", Vector2(hs.hframes, hs.vframes))
			holo_material.set_shader_parameter("phase", hs.position.x * 0.013)
			hs.material = holo_material
			hs.set_meta("sara_hologram_v5", true)
		hs.modulate = Color.WHITE
		hs.frame = 0
		hs.offset.y = -(hs.texture.get_height() / float(hs.vframes)) - 3.0 / hs.scale.y



# Soft glows on lamps, screens, furnaces and relics. They show up most in the evening.
const GLOWS := {
	"l": [Color(1.0, 0.82, 0.5), 1.5, -18.0],
	"F": [Color(1.0, 0.5, 0.2), 1.0, 2.0],
	"K": [Color(0.35, 0.8, 1.0), 1.0, -6.0],
	"k": [Color(0.35, 0.8, 1.0), 0.6, -2.0],
	"a": [Color(0.7, 0.4, 1.0), 0.8, -2.0],
	"f": [Color(0.3, 1.0, 0.8), 0.7, 2.0],
	"E": [Color(0.35, 0.8, 1.0), 0.9, -10.0],
}


func _add_glows() -> void:
	glow_tex = load("res://art/glow.png")
	glow_mat = CanvasItemMaterial.new()
	glow_mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	var mat: CanvasItemMaterial = glow_mat
	var lights := Node2D.new()
	add_child(lights)
	for area_name in MapData.AREAS:
		var data: Dictionary = MapData.AREAS[area_name]
		var obj_rows: Array = data["obj"]
		for y in obj_rows.size():
			var orow: String = obj_rows[y]
			for x in orow.length():
				var och: String = orow[x]
				if not GLOWS.has(och):
					continue
				var info: Array = GLOWS[och]
				var glow := Sprite2D.new()
				glow.texture = glow_tex
				glow.material = mat
				glow.modulate = info[0]
				glow.scale = Vector2(float(info[1]), float(info[1]))
				glow.position = Vector2(x * TILE + 8, y * TILE + 8 + float(info[2]))
				glow.visible = false
				lights.add_child(glow)
				area_sprites.append([glow, area_name])


# The station dims its lights in the evening and overnight.
func _light_color() -> Color:
	var h: float = minutes / 60.0
	var day_tint := Color(1.0, 1.0, 1.0)
	var dusk := Color(1.0, 0.86, 0.74)
	var night := Color(0.56, 0.62, 0.86)
	var c: Color = day_tint
	if h < 7.0:
		c = night.lerp(day_tint, clampf(h - 6.0, 0.0, 1.0))
	elif h < 17.0:
		c = day_tint
	elif h < 19.5:
		c = day_tint.lerp(dusk, (h - 17.0) / 2.5)
	else:
		c = dusk.lerp(night, clampf((h - 19.5) / 2.5, 0.0, 1.0))
	if current_area == "mine":
		c = c * Color(0.8, 0.78, 0.86)
	elif current_area == "tunnels":
		c = c * Color(0.62, 0.6, 0.74)
	elif current_area.begins_with("cav_"):
		c = Color(0.58, 0.58, 0.7)          # no day and night down there
	elif current_area == "lake":
		c = Color(0.66, 0.74, 0.86)         # nor at the underground lake: cool, blue-green dark
	return c


func _go_home() -> void:
	var start: Array = MapData.START
	var area_name: String = start[0]
	_go_to(area_name, Vector2i(int(start[1]), int(start[2])), false)


func _zone_name() -> String:
	var data: Dictionary = MapData.AREAS[current_area]
	var zones: Array = data["zones"]
	var tile: Vector2i = _player_tile()
	for z in zones:
		if tile.x >= int(z[1]) and tile.x <= int(z[3]) and tile.y >= int(z[2]) and tile.y <= int(z[4]):
			var zone: String = z[0]
			return zone
	var area_title: String = data["title"]
	return area_title


# ---------------------------------------------------------------- people and things

func _spawn_things() -> void:
	for p in MapData.PEOPLE:
		var who: String = p[0]
		var area_name: String = p[1]
		_add_person(who, area_name, Vector2i(int(p[2]), int(p[3])), float(p[4]))

	for who in MapData.SCHEDULES:
		_add_resident(who, MapData.SCHEDULES[who])

	for item in MapData.THINGS:
		var pos: Array = item[4]
		things.append({
			"kind": item[0], "name": item[1], "hint": item[2], "area": item[3],
			"pos": Vector2(float(pos[0]), float(pos[1])), "radius": float(item[5]), "who": "",
		})

	# Ore veins and rocks. Each art file has 2 frames: full, worked out.
	for entry in MapData.NODES:
		# an optional fifth number: refill every that many days (the North Cave's beds: 2)
		_add_node(str(entry[0]), str(entry[1]), Vector2i(int(entry[2]), int(entry[3])), int(entry[4]) if entry.size() > 4 else 1, false)
	cav_static_nodes = ore_nodes.size()

	# The wreck in the shuttle bay. art/wreck.png has 4 frames: wrecked -> repaired.
	var wreck: Array = MapData.WRECK
	wreck_sprite = Sprite2D.new()
	# The new ship (art/lunar/player_ship.png: 4 frames of 224 x 128, drawn at half size: 7 x 4 tiles).
	var ship_art := "res://art/lunar/player_ship.png" if ResourceLoader.exists("res://art/lunar/player_ship.png") else "res://art/wreck.png"
	wreck_sprite.texture = load(ship_art)
	wreck_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	wreck_sprite.hframes = 4
	wreck_sprite.centered = false
	_fit_sprite(wreck_sprite, 4, 1, wreck_sprite.texture.get_width() / 4.0 * ART if ship_art.ends_with("player_ship.png") else 64.0)
	wreck_sprite.position = Vector2(float(wreck[1]), float(wreck[2]))
	wreck_sprite.visible = false
	actors.add_child(wreck_sprite)
	area_sprites.append([wreck_sprite, wreck[0]])

	# Shop fronts on the main level: one big picture per shop, laid over its building at the door.
	for f in MapData.FRONTS:
		var front_key: String = f[0]
		var front_path: String = "res://art/front_%s.png" % front_key
		if not ResourceLoader.exists(front_path):
			continue
		var front := Sprite2D.new()
		front.texture = load(front_path)
		front.centered = false
		_fit_sprite(front, 1, 1, 80.0)          # always 5 tiles wide in the world, whatever size it is drawn at
		front.offset = Vector2.ZERO             # placed by its top-left corner
		front.position = Vector2(float(f[1]), float(f[2]))
		front.visible = false
		ground_fx.add_child(front)
		area_sprites.append([front, "main"])


# Creates the shared state for a person the first time they are needed. Returns their art id.
func _ensure_person(who: String) -> String:
	var info: Dictionary = NpcData.PEOPLE[who]
	var id: String = info["id"]
	if not persons.has(who):
		persons[who] = {
			"id": id, "first": info["first"], "repeat": info["repeat"], "pitch": float(info.get("pitch", 1.0)),
			"portrait": load("res://art/portrait_%s.png" % id),
			"met": false, "talked_today": false, "friendship": 0, "next": 0,
		}
	return id


# A resident who walks around on a schedule (see scripts/resident.gd).
func _add_resident(who: String, entries: Array) -> void:
	var id: String = _ensure_person(who)
	var t := {
		"kind": "person", "name": who, "hint": "Talk to %s" % who, "area": "",
		"pos": Vector2.ZERO, "radius": 26.0, "who": who,
	}
	things.append(t)
	var r = ResidentScript.new()
	# Hand-made activity frames are optional: art/npc_<id>_act.png
	var act_tex: Texture2D = null
	var act_path: String = "res://art/npc_%s_act.png" % id
	if ResourceLoader.exists(act_path):
		act_tex = load(act_path)
	var walk_id: String = id
	if not ResourceLoader.exists("res://art/npc_%s.png" % id):
		walk_id = "owen"
	r.setup(self, who, load("res://art/npc_%s.png" % walk_id), entries, t, act_tex)
	r.visible = false
	actors.add_child(r)
	residents.append(r)
	# An emote bubble over the head (overhead_emotes/). It is a child of the resident, so it follows them and
	# shares their two-thirds scale: one art pixel per screen pixel, the bubble's foot just above a 48-tall sprite.
	if emote_scene == null and ResourceLoader.exists(EMOTE_SCENE):
		emote_scene = load(EMOTE_SCENE)
	if emote_scene != null:
		r.emote = emote_scene.instantiate()
		r.add_child(r.emote)


# Shows an emote bubble over a resident's head: surprise, question, love, joy, sad, frustrated, hello, ready,
# no, wait, help, follow or cute (overhead_emotes/README.md).
func _emote(who: String, id: StringName, seconds: float = 1.4) -> void:
	for r in residents:
		if r.who == who and r.emote != null:
			r.emote.show_story(id, seconds)
			return


func _snap_residents() -> void:
	# Visitors (MapData.VISITOR_DAYS) are only here on their days of the week. The newcomers are not here at
	# all until they arrive, and some of their first days follow MapData.SCHEDULES_ALT (the Medbay, the terminal).
	var weekday: int = (day - 1) % 7
	for r in residents:
		var gone := not _arrived(r.who)
		if MapData.VISITOR_DAYS.has(r.who):
			var days: Array = MapData.VISITOR_DAYS[r.who]
			gone = gone or not (days.has(weekday) or days.has(float(weekday)))
		r.away = gone
		if MapData.SCHEDULES_ALT.has(r.who):
			r.schedule = MapData.SCHEDULES_ALT[r.who] if _first_days(r.who) else MapData.SCHEDULES[r.who]
		r.snap(minutes)


# Wave 1 arrives after Ivan (artie_found_day = D): Artie wakes in the Medbay on D+1, the first visitor transport
# brings Stu on D+2, Tally comes on D+4. Wave 2 is Ana, the day after you pull her out of her ship.
func _arrived(who: String) -> bool:
	match who:
		"Artie": return artie_found_day >= 0 and day >= artie_found_day + 1
		"Stu": return artie_found_day >= 0 and day >= artie_found_day + 2
		"Tally": return artie_found_day >= 0 and day >= artie_found_day + 4
		"Ana": return ana_found_day >= 0 and day >= ana_found_day + 1
	return true


# True on the days a newcomer follows their SCHEDULES_ALT: Artie and Ana in the Medbay, Stu at the terminal.
func _first_days(who: String) -> bool:
	match who:
		"Artie": return day <= artie_found_day + 2
		"Ana": return day <= ana_found_day + 2
		"Stu": return day == artie_found_day + 2
	return false


# S.A.R.A.'s news in the morning, when someone new turns up.
func _morning_news() -> void:
	var news := ""
	if artie_found_day >= 0:
		match day - artie_found_day:
			1: news = "S.A.R.A.: the man from the stasis pod is awake. He's in the Medbay."
