# F6 (editor and debug builds only): the boarding test (Zachary, 22 Nov). The covered fighter with Freya and two
# hired hands against a Chernobog cutter that boards back. Each press flips the emergency tether on or off. In the
# real game other ships come from Freya's quest and Eshu's capture contracts.
var debug_tether := false


func _debug_boarding() -> void:
	if battle == null or battle.open:
		return
	debug_tether = not debug_tether
	battle.start({"enemy": "rabble_cutter", "story": false, "player_ship": "covered_fighter", "tether": debug_tether,
		"foe_pods": true, "crew": [
			{"name": "Freya", "kind": "freya", "named": true, "room": "pods"},
			{"name": "Dax", "kind": "human", "room": "pods"},
			{"name": "Rook", "kind": "zaash", "room": "weapons"},
		]}, Callable(self, "_after_debug_boarding"), 99)
	_toast("Debug: boarding test, tether %s (F6 again flips it)" % ("on" if debug_tether else "off"))


func _after_debug_boarding(_result: String, _hull_left: int) -> void:
	battle.close()


func _launch_console() -> void:
	if repair_stage < REPAIRS.size():
		_say("Launch control", ["The launch doors won't open for a ship that can't fly.", "Tikka is still repairing yours."])
	elif ship_hull <= 0:
		_say("Launch control", ["[sad] The board shows your ship in red from nose to engines.", "Freya can patch her up before she flies again."])
	elif flights == 0 and not said_goodbye:
		_say("Launch control", ["The board shows your ship in green. The launch doors are waiting on your code.",
			"Once you go, you're gone. Have you said your goodbyes?", "Take her out?"],
			Callable(self, "_send_off"), "Launch")
	elif flights == 0:
		_say("Launch control", ["The Chernobog are still out there, and the Landing is still in their way.", "Take her out again?"],
			Callable(self, "_lift_off"), "Launch")
	elif flights == 1:
		_say("Launch control", ["The board shows your ship in green.", "Take her out?"], Callable(self, "_second_flight"), "Launch")
	else:
		_say("Launch control", ["The board shows your ship in green. Fuel: %d cells." % fuel,
			"Take her out into the neutral zone?"], Callable(self, "_start_run"), "Launch")


# ---------------------------------------------------------------- free flights (normal runs, 22 Nov)
# scripts/ship_runs.gd makes the day's map; here the ship goes stop to stop. A run ends when you fold home (free
# outside a fight), or when your ship is beaten (the Medbay, as always).
const RUN_FUEL := 3                  # Freya tops the tank up to this much when you launch with less
# Time stands still while you're out in space (the clock only runs on the station), and you always get home at
# 8pm, or when you left if that was later (Zachary, 23 Nov).
const RETURN_TIME := 20 * 60
var run_enemy := ""                  # the ship being fought on a run
var nest_stage := 0                  # which of the Nest raid's fights you're on
var nest_news := false               # the Nest fell on this run: Freya says so when you get home
var run_stops: Array = []
var run_used: Array = []             # events already drawn this run
var run_rng := RandomNumberGenerator.new()
var run_stop := -1                   # the stop the ship is at


func _start_run() -> void:
	var full_tank: int = RUN_FUEL + int(_ups().get("tank", 0))
	if fuel < full_tank:
		_toast("Freya tops up the tank: %d fuel" % full_tank)
		fuel = full_tank
	run_stops = ShipRuns.make_run(day, ShipData.RING_STOPS, _rings_open(), nest_done, _ooma_out())
	if _flag("perk_pioneer_stabilizer"):
		for st in run_stops:
			if str(st.get("hazard", "")) == "ion_storm":
				st["about"] = str(st["about"]).replace(str(ShipRuns.HAZARD_ABOUT["ion_storm"]),
						"An ion storm, but Jorvik's stabilizer keeps your reactor whole.")
	ShipRuns.place_contracts(run_stops, contracts, run_rng)
	if _flag("kit_beacon") and not _flag("kit_cache_found"):
		ShipRuns.place_cache(run_stops, run_rng)          # Kit's 4: the smuggler's beacon he saw
	ShipRuns.place_storm(run_stops, run_rng, _flag("storm_ends"))     # the Shepherd's storm, or Tidelight after it
	run_used = []
	run_rng.seed = 104729 * day + Time.get_ticks_msec()
	run_stop = -1
	sfx("launch")
	ship_map.open_run(run_stops, Callable(self, "_arrive_run"), Callable(self, "_fold_home"), _rings_open())
	if not bool(said_run_hint):
		said_run_hint = true
		_say("Sara", [
			"Free flight. Today's stops are on your map, rings one to %s. Further out stays shut until you've a bigger tank." % ["one", "two", "three", "four", "five"][_rings_open() - 1],
			"Each jump follows a gold line and uses one fuel cell. You choose the way.",
			"[happy] And whenever you've had enough, fold home. It's free outside a fight, and you keep what you found.",
		])


# Bram's 8 (Zachary, 23 Nov): the Moogli trade beacon (ship_map.gd's "Call trader" button, perk
# moogli_trade_beacon). One fuel cell calls the Ollo family's trader (Bram's cousins, a Moogli trader) to the stop
# you're at; it stays there for the rest of the run, so going back to it is free.
func _call_trader() -> void:
	if run_stop < 0 or run_stop >= run_stops.size():
		return
	var stop: Dictionary = run_stops[run_stop]
	if not bool(stop.get("trader", false)):
		if fuel <= 0:
			sfx("deny")
			_toast("Out of fuel")
			return
		fuel -= 1
		stop["trader"] = true
		sfx("warp", 1.2, -4.0)
		_toast("Trade beacon: the Ollo family trader comes alongside  (-1 fuel)")
	ship_map.visible = false
	ship_event.show_backdrop(stop)
	ship_store.open_store(ShipData.STORES["moogli_trader"].merged({"name": "Ollo family trader"}, true), Callable(self, "_back_to_map"))


# Arrived at a stop on a free flight.
func _arrive_run(i: int) -> void:
	if augments.has("fuel_recycler") and run_rng.randf() < 0.2:
		_toast("The fuel recycler covers that jump.")
	else:
		fuel = maxi(0, fuel - 1)
	run_stop = i
	var stop: Dictionary = run_stops[i]
	var kind: String = str(stop["kind"])
	if bool(stop["seen"]) and not (kind == "store" or kind == "ooma" or kind == "storm" or kind == "tidelight" or (kind == "nest" and not nest_done)):
		_toast("Nothing new here.")
		return
	var first_visit: bool = not bool(stop["seen"])
	stop["seen"] = true
	ship_map.visible = false
	ship_event.show_backdrop(stop)
	var ring: int = int(stop["ring"])
	var zone: String = str(stop["zone"])
	match kind:
		"store":
			var store_id: String = str(stop.get("store", ShipData.ZONE_STORE.get(zone, "moogli_trader")))
			ship_store.open_store(ShipData.STORES[store_id].merged({"name": str(stop["name"])}, true), Callable(self, "_back_to_map"))
		"ooma":
			ship_store.open_store(ShipData.STORES["ooma"], Callable(self, "_back_to_map"))
			if first_visit:
				_say("Ooma", ["[happy] Well, look who's out past the lamp-posts! Off-station prices, off-station stock, dearie.",
					"Rare guns, rare goods. Don't tell Bram where you saw me."])
		"nest":
			_nest_arrive()
		"wreck":
			var got: Dictionary = apply_space_effects(ShipRuns.reward(ring + 1, false, run_rng, "", relics_found).slice(1))
			ship_event.show_result(str(stop["name"]), "Nobody's here but the dead hulls. Your drone goes over them for anything worth taking.",
					got["gains"], Callable(self, "_after_salvage"))
		"quiet":
			var rest: Dictionary = apply_space_effects(["+1 fuel", "+3 hull"])
			ship_event.show_result(str(stop["name"]), "Silence, and stars. You shut everything down for an hour, and the drone patches what it can.",
					rest["gains"], Callable(self, "_after_salvage"))
		"special":
			ship_event.close()
			_run_fight("pirate_stronghold")
		"cache":
			# Kit's 4: the smuggler's cache, once (a stronghold's haul, two rings further out)
			story_flags["kit_cache_found"] = true
			var haul: Dictionary = apply_space_effects(ShipRuns.reward(ring + 1, true, run_rng, "", relics_found))
			ship_event.show_result(str(stop["name"]), "Three long blinks, two short. The beacon is bolted to a battered cargo pod, tethered to a rock and dusted over. Whoever left it never came back. Kit will want to hear everything.",
					haul["gains"], Callable(self, "_after_salvage"))
		"contract":
			if not contracts.any(func(k): return str(k["id"]) == str(stop.get("contract", ""))):
				_toast("Someone else got to the wanted ship first.")
				_back_to_map()
			else:
				ship_event.close()
				_run_fight(str(stop["enemy"]))
		"storm":
			_storm_arrive()
		"tidelight":
			_tidelight_arrive()
		"distress":
			_run_event("distress", zone, ring)
		_:
			if run_rng.randf() < float(ShipRuns.FIGHT_CHANCE[ring]):
				ship_event.close()
				_run_fight(ShipRuns.pick_enemy(zone, run_rng))
			else:
				_run_event("beacon", zone, ring)


func _run_event(kind: String, zone: String, ring: int) -> void:
	var id: String = ShipRuns.pick_event(kind, zone, ring, run_used, run_rng)
	if id == "" and kind == "distress":
		id = ShipRuns.pick_event("beacon", zone, ring, run_used, run_rng)
	if id == "":
		ship_event.open_event({"title": "Static", "text": "Nothing here but static and a long way to the next star.",
			"choices": [{"text": "Move on.", "outcomes": [{"text": "You move on.", "effects": ["nothing"]}]}]},
			Callable(self, "_after_run_event"))
		return
	run_used.append(id)
	ship_event.open_event(SpaceEvents.EVENTS[id], Callable(self, "_after_run_event"))


func _after_run_event(fight: String) -> void:
	if fight != "":
		ship_event.close()
		_run_fight(fight)
		return
	_back_to_map()


# The scene a fight is fought against (24 Nov, Zachary's Space Backgrounds pack, art/ships/backdrops): the stop's
# hazard if it has one, home orbit on the first ring, otherwise one of its zone's scenes, always the same one for
# the same stop.
const BACKDROP_HAZARD := {"asteroids": "asteroids", "nebula": "nebula", "ion_storm": "ion_storm", "flare": "eclipse"}
const BACKDROP_ZONE := {"Terran": ["ocean_planet", "moons", "empty"], "Zaa'sh": ["comet", "moons", "empty"],
	"Reach": ["ringed_planet", "ice_field", "empty"], "Collective": ["ice_moon", "ice_field", "empty"]}
func _backdrop_for(stop: Dictionary) -> String:
	var hz := str(stop.get("hazard", ""))
	if BACKDROP_HAZARD.has(hz):
		return BACKDROP_HAZARD[hz]
	var ring := int(stop.get("ring", 1))
	if ring <= 1:
		return "home"
	var zone := str(stop.get("zone", ShipRuns.zone_of(float(stop.get("angle", 0.0)), ring, float(stop.get("off", 0.0)))))
	var pool: Array = BACKDROP_ZONE.get(zone, ["empty"])
	return str(pool[(int(absf(float(stop.get("angle", 0.0))) * 7) + ring) % pool.size()])


func _run_fight(enemy_id: String) -> void:
	ship_map.visible = false
	run_enemy = enemy_id
	var stop: Dictionary = run_stops[run_stop] if run_stop >= 0 and run_stop < run_stops.size() else {}
	var base := {"enemy": enemy_id, "story": false, "hazard": str(stop.get("hazard", "")), "backdrop": _backdrop_for(stop)}
	# Some ships give up at 30% hull and pay to be let go; traders and patrols run for it at half hull (23 Nov).
	var ring: int = int(stop.get("ring", 1))
	var hard: bool = enemy_id == "pirate_stronghold" or enemy_id == "rabble_nest"
	if not hard and run_rng.randf() < 0.4:
		var offer: Array = ["+%d Scrip" % (25 + 15 * ring + run_rng.randi_range(0, 10))]
		if run_rng.randf() < 0.5:
			offer.append("+1 fuel")
		if run_rng.randf() < 0.4:
			offer.append("+%d missiles" % run_rng.randi_range(1, 2))
		base["surrender"] = offer
	if not enemy_id.contains("rabble") and not hard and str(stop.get("kind", "")) != "contract" and run_rng.randf() < 0.5:
		base["flee"] = true
	battle.start(_my_fight(base), Callable(self, "_after_run_fight"), ship_hull)


func _after_run_fight(result: String, hull_left: int) -> void:
	ship_hull = hull_left
	_crew_after_fight()
	if result == "lost":
		run_stops = []
		_ship_lost()
		return
	var was_captured: bool = battle.captured
	var offer: Array = battle.fight.get("surrender", [])
	battle.close()
	var stop: Dictionary = run_stops[run_stop] if run_stop >= 0 else {"ring": 1, "kind": "beacon"}
	if result == "spared":
		var paid: Dictionary = apply_space_effects(offer)
		ship_event.show_backdrop(stop)
		ship_event.show_result("They yield", "They power down their guns and send the payment across. You let them limp away.",
				paid["gains"], Callable(self, "_after_salvage"))
		return
	if result == "escaped":
		ship_event.show_backdrop(stop)
		ship_event.show_result("They got away", "Their fold drive flares and they're gone, with everything they were carrying.",
				[["Nothing to salvage", Color("a8a69e")]], Callable(self, "_after_salvage"))
		return
	if result == "won":
		var special: bool = str(stop["kind"]) == "special"
		var loot: Array = ShipRuns.reward(int(stop["ring"]), special, run_rng, run_enemy, relics_found)
		var words: String = "The stronghold's guns fall silent. Your crew strip what they can carry before its reactor goes." if special \
				else "Their ship drifts dark. Your crew cross over in suits and strip what they can carry."
		if was_captured:
			# a whole ship to strip: a second helping of salvage (no second Scrip roll)
			loot.append_array(ShipRuns.reward(int(stop["ring"]), special, run_rng, "", relics_found).slice(1))
			words = "Their crew are down and their ship is yours, whole. You strip it from bow to stern, then cut it loose for Eshu's tugs."
		loot = _augment_loot(loot)
		loot.append_array(_contract_done(str(stop.get("contract", "")), was_captured))
		var got: Dictionary = apply_space_effects(loot)
		# The salvage shows in the event window over the stop, like an event's outcome.
		ship_event.show_backdrop(stop)
		ship_event.show_result("Captured" if was_captured else "Salvage", words, got["gains"], Callable(self, "_after_salvage"))
		return
	_back_to_map()


# Augments that change a fight's pay: Bram's salvage arm (+25% Scrip and scrap), the nano-patch swarm (+2 hull).
func _augment_loot(loot: Array) -> Array:
	var out: Array = []
	for e in loot:
		var t: String = str(e)
		if augments.has("salvage_arm") and t.begins_with("+") and t.ends_with(" Scrip"):
			t = "+%d Scrip" % int(round(int(t.trim_prefix("+").trim_suffix(" Scrip")) * 1.25))
		elif augments.has("salvage_arm") and t.begins_with("item: scrap x"):
			t = "item: scrap x%d" % int(ceil(int(t.trim_prefix("item: scrap x")) * 1.25))
		out.append(t)
	if augments.has("nano_patch"):
		out.append("+2 hull")
	return out


# ---------------------------------------------------------------- Eshu's contracts (23 Nov)
# Eshu's crew board also carries contracts, two every three days: a bounty (beat the wanted ship any way) or a
# capture (down its crew with the ship whole: board it, or gas and fire it out). Taking one puts the wanted ship on
# your map on every run until it's done (ShipRuns.place_contracts). Two at a time. Pay comes as soon as it's done.
const CONTRACT_MAX := 2

func contract_offers() -> Array:
	var block: int = (day - 1) / 3
	var rng := RandomNumberGenerator.new()
	rng.seed = 9173 * block + 11
	var out: Array = []
	for i in 2:
		var cid := "c%d_%d" % [block, i]
		var zone: String = ["Reach", "Reach", "Terran", "Zaa'sh", "Collective"][rng.randi() % 5]
		var enemy_id: String = ShipRuns.pick_enemy(zone, rng)
		var ring: int = rng.randi_range(2, maxi(2, _rings_open()))
		var capture: bool = rng.randf() < 0.5
		var reward: int = (180 + 60 * ring) if capture else (90 + 40 * ring)
		var c := {"id": cid, "kind": "capture" if capture else "bounty", "enemy": enemy_id, "zone": zone, "ring": ring,
			"reward": reward, "target_name": str(ShipData.enemy(enemy_id).get("name", enemy_id))}
		if contracts_done.has(cid) or contracts.any(func(k): return str(k["id"]) == cid):
			continue
		out.append(c)
	return out


func take_contract(c: Dictionary) -> String:
	if contracts.size() >= CONTRACT_MAX:
		return "Two contracts at a time. Finish or drop one first."
	contracts.append(c)
	sfx("quest")
	return "Taken: %s. It'll be on your map in the %s." % [str(c["target_name"]), "Rabble's Reach" if str(c["zone"]) == "Reach" else str(c["zone"]) + " zone"]


func drop_contract(i: int) -> void:
	if i >= 0 and i < contracts.size():
		contracts_done.append(str(contracts[i]["id"]))
		contracts.remove_at(i)


# A fight at a contract stop is won: pay out if it counts (a capture contract needs the ship whole).
func _contract_done(cid: String, was_captured: bool) -> Array:
	if cid == "":
		return []
	for i in contracts.size():
		var c: Dictionary = contracts[i]
		if str(c["id"]) != cid:
			continue
		if str(c["kind"]) == "capture" and not was_captured:
			return ["note: Eshu wanted it whole. The contract stands; it'll be back on your map."]
		contracts.remove_at(i)
		contracts_done.append(cid)
		return ["+%d Scrip" % int(c["reward"]), "note: Eshu's contract paid"]
	return []


func _after_salvage(_fight: String) -> void:
	_back_to_map()


func _home_at_eight() -> void:
	minutes = clampf(maxf(minutes, float(RETURN_TIME)), float(DAY_START), DAY_END - 1.0)


# Rings you can reach on a run: three with the starting tank; each fuel tank upgrade adds one.
func _rings_open() -> int:
	return mini(5, ShipRuns.MAX_RING + int(_ups().get("tank", 0)))


# ---------------------------------------------------------------- ships and upgrades (23 Nov)

# A ship's upgrade levels (the flying ship's if no id), made on first use.
func _ups(id := "") -> Dictionary:
	var sid: String = active_ship if id == "" else id
	if not ship_ups.has(sid):
		ship_ups[sid] = {"systems": {}, "reactor": 0, "hull": 0, "tank": 0, "tether": false}
	return ship_ups[sid]


# The ship as it flies: its definition with its upgrades applied.
func _ship_def(id := "") -> Dictionary:
	var sid: String = active_ship if id == "" else id
	var d: Dictionary = (ShipData.SHIP_DEFS[sid] as Dictionary).duplicate(true)
	var u: Dictionary = _ups(sid)
	d["reactor"] = int(d["reactor"]) + int(u["reactor"])
	d["hull"] = int(d["hull"]) + ShipData.HULL_STEP * int(u["hull"])
	var systems: Dictionary = d["systems"]
	for key in u["systems"]:
		if systems.has(key):
			var pair: Array = systems[key]
			systems[key] = [maxi(int(pair[0]), int(u["systems"][key])), int(pair[1])]
	return d


func _hull_max() -> int:
	return int(_ship_def()["hull"])


func _system_level(key: String, id := "") -> int:
	var d: Dictionary = _ship_def(id)
	return int((d["systems"] as Dictionary).get(key, [0, 0])[0])


# Change which ship flies. Its hull and guns come out of storage; the other's go in.
func switch_ship(id: String) -> void:
	if id == active_ship or not ships_owned.has(id):
		return
	ship_hulls[active_ship] = ship_hull
	ship_loadouts[active_ship] = ship_weapons
	active_ship = id
	ship_hull = int(ship_hulls.get(id, int(_ship_def(id)["hull"])))
	ship_weapons = ship_loadouts.get(id, (ShipData.SHIP_DEFS[id]["weapons"] as Array).duplicate())


# The courier Eshu is here from four days after Artie is found (_arrived; upstream's helper, kept for its callers).
func _courier_here() -> bool:
	return _arrived("Eshu")


# Eshu's crew board (Zachary 23 Nov: hire at a board in the Shuttle Bay until the Dispatch has a room).
func _crew_board() -> void:
	if not _courier_here():
		_say("Crew board", ["An empty board with a hand-written card: POST & PRIVATEER DISPATCH. CREW FOR HIRE. OPENING SOON."])
		return
	ship_upgrades.open_at("board")


# Today's hirelings: three names, new every three days, minus anyone you've already signed from this board.
func crew_board_offers() -> Array:
	var block: int = (day - 1) / 3
	var rng := RandomNumberGenerator.new()
	rng.seed = 6151 * block + 3
	var kinds: Array = ShipData.HIRE_KINDS.keys()
	var out: Array = []
	var names: Array = ShipData.HIRE_NAMES.duplicate()
	for i in 3:
		var nm: String = str(names.pop_at(rng.randi() % names.size()))
		var kind: String = str(kinds[rng.randi() % kinds.size()])
		var row: Array = ShipData.HIRE_KINDS[kind]
		if board_hired.has(nm) or crew_roster.any(func(c): return str(c["name"]) == nm):
			continue
		out.append({"id": "%s_%d" % [nm.to_lower(), block], "name": nm, "kind": kind, "fee": int(row[0]), "trait": str(row[1])})
	return out


# The covered fighter: Freya's restoration, stage by stage.
func _covered_fighter() -> void:
	if ships_owned.has("covered_fighter"):
		_say("Covered fighter", ["Uncovered now, and yours. Pick which ship flies at Freya's bench."])
		return
	ship_upgrades.open_at("restore")


# The restoration page's Hand it over: pays for the next stage. Returns the status line.
func restore_covered() -> String:
	if covered_stage >= COVERED_REPAIRS.size():
		return ""
	var r: Dictionary = COVERED_REPAIRS[covered_stage]
	if credits < int(r["cost"]) or not _has_all(r["needs"]):
		sfx("deny")
		return "Freya: \"Not yet. I need everything on the list.\""
	_pay_covered()
	if ships_owned.has("covered_fighter"):
		return "Freya: \"She's done. Pick which ship flies at my bench.\""
	return "Freya: \"Stage %d done. She's starting to look like a ship again.\"" % covered_stage


func _pay_covered() -> void:
	var r: Dictionary = COVERED_REPAIRS[covered_stage]
	_money(-int(r["cost"]), "Covered fighter repairs")
	var needs: Dictionary = r["needs"]
	for item in needs:
		_give(item, -int(needs[item]))
	covered_stage += 1
	sfx("quest")
	if covered_stage >= COVERED_REPAIRS.size():
		ships_owned.append("covered_fighter")
		ship_hulls["covered_fighter"] = int(_ship_def("covered_fighter")["hull"])
		_say("Freya", ["[happy] She's done. A real ship, crew deck and all. Boarding pods, a medbay...",
			"Choose which one flies at my bench. And you'll want hands aboard: Eshu pins hirelings on the crew board."])
	_save_game()


# Adds what this ship brings to a fight's settings: its upgraded definition, and on a crewed ship the crew, the
# tether and enemy boarders from Chernobog ships.
func _my_fight(base: Dictionary) -> Dictionary:
	var f: Dictionary = base.duplicate()
	f["player_def"] = _ship_def()
	f["augments"] = augments.duplicate()
	f["self_defence"] = _flag("perk_self_defence")      # Garrick's 8: boarders on your ship take more (ship_battle.gd)
	f["wingmate"] = _flag("perk_wingmate")              # Ana's 8: more evasion, a faster fold drive
	f["stabilizer"] = _flag("perk_pioneer_stabilizer")  # Freya's 6: an ion storm doesn't halve your reactor
	if active_ship != "starter":
		f["player_ship"] = active_ship
		f["crew"] = _crew_for_run()
		f["tether"] = bool(_ups().get("tether", false))
		f["foe_pods"] = str(base.get("enemy", "")).contains("rabble") or str(base.get("enemy", "")) == "pirate_stronghold"
	return f


# Who flies with you on a crewed ship: Freya and Ana first if you're taking them (6 hearts; better at 8), then
# hired crew, up to the ship's seats.
func _crew_for_run() -> Array:
	var seats: int = int(ShipData.CREW_SEATS.get(active_ship, 0))
	var out: Array = []
	for who in ["Freya", "Ana"]:
		if out.size() < seats and bool(crew_taking.get(who, false)) and _crew_hearts(who) >= 6:
			var eight: bool = _crew_hearts(who) >= 8
			if who == "Freya":
				out.append({"name": "Freya", "kind": "freya", "named": true, "id": "Freya", "repair_x": 2.5 if eight else 2.0})
			else:
				out.append({"name": "Ana", "kind": "ana", "named": true, "id": "Ana", "room": "cockpit", "pilot_bonus": 15 if eight else 10})
	for c in crew_roster:
		if out.size() >= seats:
			break
		var k: Array = ShipData.HIRE_KINDS.get(str(c["kind"]), ShipData.HIRE_KINDS["human"])
		var sk: Array = crew_skill(c)
		out.append({"name": str(c["name"]), "kind": str(c["kind"]), "id": str(c["id"]),
			"fight_x": float(k[2]) * (1.0 + sk[1]), "repair_x": float(k[3]) * (1.0 + sk[0]), "heal_x": float(k[4])})
	return out


# A hired hand's skill from experience: [repair bonus, fight bonus], each up to +50%. 25 repairs or a minute
# and a half of fighting gets you there.
func crew_skill(c: Dictionary) -> Array:
	return [minf(0.5, int(c.get("xp_repair", 0)) * 0.02), minf(0.5, float(c.get("xp_fight", 0.0)) / 180.0)]


func _crew_hearts(who: String) -> int:
	if not persons.has(who) or (who == "Ana" and not _arrived("Ana")):
		return 0
	return _hearts(who)    # 100 points a heart (NPC Master 3.1), like the heart events


# After a fight on a crewed ship: hired crew who didn't make it are gone; Freya or Ana knocked out go home.
func _crew_after_fight() -> void:
	if battle == null or not battle.crew_mode:
		return
	for c in battle.my_crew:
		if bool(c.get("you", false)):
			continue
		var cid: String = str(c.get("id", ""))
		if not bool(c.get("gone", false)):
			# crew skills (23 Nov): hired hands get better at what they do, up to half again
			for r in crew_roster:
				if str(r["id"]) == cid:
					r["xp_repair"] = int(r.get("xp_repair", 0)) + int(c.get("xp_repair", 0))
					r["xp_fight"] = float(r.get("xp_fight", 0.0)) + float(c.get("xp_fight", 0.0))
			continue
		if bool(c.get("named", false)):
			crew_taking[cid] = false
			crew_cross[cid] = day
		else:
			crew_roster = crew_roster.filter(func(r): return str(r["id"]) != cid)


# Ooma is out on her ship on the days she isn't on the station (not Wednesdays or Saturdays).
func _ooma_out() -> bool:
	var weekday: int = (day - 1) % 7
	return weekday != 2 and weekday != 5


# ---------------------------------------------------------------- the Rabble's Nest (23 Nov)
# A one-time raid (claude/echo-landing-ship-combat.md): the Nest stop on the outer ring of the Reach until it falls.
# Three fights in a row, as Claude suggested: the picket, the gun platform, then the Nest itself, with only what
# your drone can patch in between (2 hull). Fleeing or losing ends the raid; you can try again another day. When
# it falls you get a big haul, and from then on each run has a smaller pirate stronghold instead.
const NEST_FIGHTS := ["rabble_cutter", "pirate_stronghold", "rabble_nest"]
const NEST_LINES := [
	"Their picket turns to meet you: a cutter, guns already hot.",
	"Behind it, the Nest's gun platform swings round. No time to rest.",
	"The way is open. The Nest itself lights up every gun it has.",
]

func _nest_arrive() -> void:
	nest_stage = 0
	ship_event.open_event({"title": "The Rabble's Nest",
		"text": "A hollowed asteroid ringed with lights and docking arms: home of the Chernobog pirates, and Ivan's own. Pickets circle it, and a gun platform hangs off its flank. Three fights, one after another, and no store between.",
		"choices": [
			{"text": "Attack the Nest.", "outcomes": [{"text": NEST_LINES[0], "effects": ["fight: " + NEST_FIGHTS[0]]}]},
			{"text": "Not today. Pull back.", "outcomes": [{"text": "You turn away before their pickets notice you. The Nest will keep.", "effects": ["nothing"]}]},
		]}, Callable(self, "_after_nest_choice"))


func _after_nest_choice(fight: String) -> void:
	if fight == "":
		run_stops[run_stop]["seen"] = false      # you can come back to it this run
		_back_to_map()
		return
	ship_event.close()
	_nest_fight()


func _nest_fight() -> void:
	ship_map.visible = false
	run_enemy = NEST_FIGHTS[nest_stage]
	battle.start(_my_fight({"enemy": run_enemy, "story": false, "backdrop": "ringed_planet"}), Callable(self, "_after_nest_fight"), ship_hull)


func _after_nest_fight(result: String, hull_left: int) -> void:
	ship_hull = hull_left
	_crew_after_fight()
	if result == "lost":
		run_stops = []
		_ship_lost()
		return
	battle.close()
	var stop: Dictionary = run_stops[run_stop]
	if result != "won":
		stop["seen"] = false
		_toast("You break off the raid. The Nest will keep.")
		_back_to_map()
		return
	nest_stage += 1
	ship_event.show_backdrop(stop)
	if nest_stage < NEST_FIGHTS.size():
		ship_hull = mini(ship_hull + 2, _hull_max())
		ship_event.show_result("The Nest: %d of %d" % [nest_stage, NEST_FIGHTS.size()],
				NEST_LINES[nest_stage] + " Your drone patches what it can on the way in.", [["+2 hull", Color("5adc6e")]],
				Callable(self, "_next_nest_fight"))
		return
	nest_done = true
	nest_news = true
	var loot: Array = ShipRuns.reward(int(stop["ring"]) + 2, true, run_rng, "rabble_nest", relics_found)
	loot.append_array(["+150 Scrip", "+2 fuel", "item: void_sapphire x1"])
	var got: Dictionary = apply_space_effects(loot)
	ship_event.show_result("The Nest falls",
			"The Nest goes dark, then breaks apart. What the Chernobog hoarded for years drifts free, and your crew take all they can carry. Without their home, they'll scatter to smaller strongholds.",
			got["gains"], Callable(self, "_after_salvage"))
	_save_game()


func _next_nest_fight(_f: String) -> void:
	ship_event.close()
	_nest_fight()


# Fold home: the run ends and you're back in the Shuttle Bay with what you found.
func _fold_home() -> void:
	ship_map.close()
	ship_event.close()
	ship_store.close()
	run_stops = []
	sfx("sh_fold")
	_home_at_eight()
	_snap_residents()
	var lines: Array = ["[happy] Welcome back. The fold drive's still warm."]
	if nest_news:
		nest_news = false
		lines = ["[surprised] The Nest? The whole Nest? S.A.R.A.'s had every channel on the station playing it.",
			"[happy] Welcome home. Nobody's going to call the Chernobog a threat to the Landing for a while."]
	if ship_hull < _hull_max():
		lines.append("She's taken some knocks. Come and see me and I'll patch the hull.")
	_say("Freya", lines)
	_save_game()


