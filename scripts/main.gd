# Can the player take an event choice that needs something? ("" needs nothing.)
func space_need_met(needs: String) -> bool:
	var n: String = needs.strip_edges()
	if n == "":
		return true
	if n == "drone":
		return true                      # the starter ship always carries its repair drone
	if n == "missiles":
		return missiles > 0
	if n == "drone parts":
		return drone_parts > 0
	if n.ends_with(" Scrip"):
		return credits >= int(n.trim_suffix(" Scrip"))
	if n.begins_with("item: "):
		return int(items.get(n.trim_prefix("item: ").strip_edges(), 0)) > 0
	return false


# Applies an event outcome's effects (written as in the event template). Returns what the window shows:
# {"gains": [[text, colour], ...], "fight": enemy id or ""}.
func apply_space_effects(effects: Array) -> Dictionary:
	var gains: Array = []
	var fight := ""
	var good := Color("5adc6e")
	var bad := Color("e6463c")
	var note := Color("fadc5a")
	for e in effects:
		var t: String = str(e).strip_edges()
		var parts: PackedStringArray = t.split(" ", false)
		if t == "nothing" or t == "":
			continue
		elif t.begins_with("item: "):
			var spec: String = t.trim_prefix("item: ").strip_edges()
			var n := 1
			var x: int = spec.rfind(" x")
			if x > 0:
				n = int(spec.substr(x + 2))
				spec = spec.substr(0, x)
			_give(spec, n)
			var item_name: String = str(ItemData.ITEMS[spec]["name"]) if ItemData.ITEMS.has(spec) else spec
			if ItemData.ITEMS.has(spec) and ItemData.ITEMS[spec].has("relic") and n > 0:
				gains.append(["Relic: %s (for Tar'Besh's museum)" % item_name, note])
			else:
				gains.append(["%s%d %s" % ["+" if n >= 0 else "", n, item_name], good if n >= 0 else bad])
		elif t.begins_with("fight: "):
			fight = t.trim_prefix("fight: ").strip_edges()
			gains.append(["They attack!", bad])
		elif t.begins_with("relic: "):
			var relic_name: String = t.trim_prefix("relic: ").strip_edges()
			var relic_id: String = ItemData.relic_named(relic_name)
			if relic_id != "" and relics_found.has(relic_id):
				# You found this one before: a trader on the next beacon buys the spare.
				_money(40, "Sold a spare relic")
				gains.append(["Another %s. A trader buys the spare: +40 Scrip" % relic_name.to_lower(), good])
			else:
				if relic_id != "":
					_give(relic_id, 1)
				gains.append(["Relic: %s (for Tar'Besh's museum)" % relic_name, note])
		elif t.begins_with("note: "):
			gains.append([t.trim_prefix("note: "), note])
		elif t.begins_with("reveal: "):
			var reveal: String = t.trim_prefix("reveal: ").strip_edges()
			if not run_stops.is_empty():
				ShipRuns.add_hidden(run_stops, run_stop, reveal, run_rng, _rings_open())
				gains.append(["Marked on your map: %s" % reveal, note])
			else:
				gains.append(["Noted for another day: %s" % reveal, note])
		elif parts.size() >= 2 and (parts[0].begins_with("+") or parts[0].begins_with("-")):
			var amount: int = int(parts[0])
			var what: String = " ".join(parts.slice(1)).to_lower()
			if what.begins_with("scrip"):
				_money(amount, "Out in the zone")
			elif what.begins_with("fuel"):
				fuel = maxi(0, fuel + amount)
			elif what.begins_with("hull"):
				ship_hull = clampi(ship_hull + amount, 0, _hull_max())
			elif what.begins_with("missile"):
				missiles = maxi(0, missiles + amount)
			elif what.begins_with("drone part"):
				drone_parts = maxi(0, drone_parts + amount)
			gains.append(["%s%d %s" % ["+" if amount >= 0 else "", amount, " ".join(parts.slice(1))], good if amount >= 0 else bad])
	if gains.is_empty():
		gains.append(["Nothing gained, nothing lost.", Color("969cb0")])
	return {"gains": gains, "fight": fight}


func _stop_fight(stop: Dictionary) -> void:
	ship_map.visible = false
	battle.start({"enemy": str(stop["enemy"]), "story": true, "tutorial": true, "player_def": _ship_def("starter"), "backdrop": "ringed_planet"}, Callable(self, "_after_picket"), ship_hull)
	_say("Sara", [
		"That's a Chernobog Cutter, scouting ahead of the others. You'll have to go through it.",
		"Space pauses the fight. You can give every order while it's paused.",
		"The bars at the bottom left move power from the reactor to shields, engines, weapons and oxygen.",
		"Click your Burst laser, then a room on their ship. Hit their Shields room first, then the rest.",
		"Your bays are sealed, so you can't reach them, but your drone can. It's your crew today: click it, then click a bay to send it there.",
		"Press Space when you're ready.",
	])
	_say_then(Callable(self, "_hold_battle"))


func _hold_battle() -> void:
	battle.paused = true


func _flight_reward(enemy_id: String) -> void:
	var reward: Array = ShipData.REWARDS.get(enemy_id, [0, {}])
	var cash: int = int(reward[0])
	if cash > 0:
		_money(cash, "Salvage from the fight")
	var loot: Dictionary = reward[1]
	var got := PackedStringArray()
	for item in loot:
		_give(item, int(loot[item]))
		got.append("%d %s" % [int(loot[item]), str(ItemData.ITEMS[item]["name"]) if ItemData.ITEMS.has(item) else str(item)])
	_toast("Salvage: %d credits%s" % [cash, (", " + ", ".join(got)) if not got.is_empty() else ""])


func _after_picket(result: String, hull_left: int) -> void:
	ship_hull = hull_left
	if result != "won":
		_ship_lost()
		return
	_flight_reward("rabble_cutter")
	battle.close()
	ship_map.visible = true
	_say("Sara", [
		"[happy] One down. Their main force is still coming, and Ivan is with it.",
		"There's a Moogli trader keeping out of the way on your course. If you're hurt, stop and patch up.",
	])


func _stop_ivan(stop: Dictionary) -> void:
	ship_map.visible = false
	battle.start({"enemy": str(stop["enemy"]), "story": true, "uplink": true, "player_def": _ship_def("starter"), "backdrop": "eclipse"}, Callable(self, "_after_ivan"), ship_hull)
	_say("Ivan", [
		"[angry] You. The one who got away from me at the jump.",
