	# ---------------------------------------------------------------- Tikka (Zachary, 24 Nov)
	# The engineer who can't put the station down. Her overworking is slightly linked to Jorvik, "but not the main
	# reason" (Zachary): she has listened to the station for forty years, and quiet sounds wrong to her. Her 8 is the
	# NPC Master's Smelter Overclock; afterwards her Sundays are really off (tikka_sundays_off, tools/build.py).
	"tikka_2": {
		"who": "Tikka", "hearts": 2, "title": "Tuning the Manifold",
		# Engineering's geothermal core, late, when she should be home: a valve on the manifold is a hair out
		"area": "eng", "windows": [[null, "21:45", "23:30"]],
		"player": [70, 42, "u"],
		"cast": [["Tikka", 62, 35, "u", "console u"]],
		"steps": [
			["wait", 0.6],
			["fx", "steam", 70, 36, 2],
			["say", "", ["Engineering, late. The geothermal core hums in its cage of light. Tikka is alone at a control panel, humming back at it."]],
			["say", "Tikka", ["Mmm-mm. Mm-mmm. No. Mmmm..."]],
			["walk", "player", 64, 36], ["face", "player", "l"],
			["pose", "Tikka", ""], ["face", "Tikka", "player"],
			["emote", "Tikka", "surprise"], ["pose", "Tikka", "jump"],
			["say", "Tikka", ["[surprised] {name}! It's late. Why are you here? ...Why am I here? Don't answer that."]],
			["pose", "Tikka", "talk"],
			["say", "Tikka", ["Listen. Under the hum. Hear it? One flat note. A valve on the manifold is a hair out, and the whole station is singing a quarter-tone flat.",
				"S.A.R.A. says the readings are fine. The readings are fine. The note is not."]],
			["pose", "Tikka", ""],
			["emote", "player", "question"],
			["say", "Tikka", ["My ears are busy. Go to the coolant tank by the west wall. Third wheel from the top. When I say turn, turn. Slowly."]],
			["walks", [["player", 58, 38], ["Tikka", 67, 38]]],
			["face", "player", "l"], ["face", "Tikka", "r"],
			["emote", "Tikka", "wait"],
			["say", "Tikka", ["Turn."]],
			["sfx", "valve_spray"], ["fx", "spray", 57, 37, 1], ["wait", 0.7],
			["emote", "Tikka", "frustrated"],
			["say", "Tikka", ["[angry] Too far! Back. Half of that. Half of half."]],
			["sfx", "valve_spray"], ["wait", 0.6], ["fx", "spray", "off"],
			["emote", "Tikka", "joy"], ["pose", "Tikka", "laugh"],
			["say", "", ["The hum smooths out, like a held breath let go. You never heard the flat note. Now that it's gone, you can hear that it was there."]],
			["pose", "Tikka", ""],
			["walk", "Tikka", 60, 38], ["face", "Tikka", "player"], ["face", "player", "r"],
			["pose", "Tikka", "talk"],
			["say", "Tikka", ["[happy] There. Forty years I've listened to this station. When it's right, I can't hear it at all. That's the best sound there is.",
				"When it's wrong, I hear it from my bed. Sesska says I married the core first. I didn't. I met it a week before I met her."]],
			["pose", "Tikka", ""],
			["sfx", "hail"],
			["say", "Sesska", ["Tikka. It is late. Your dinner has become a sculpture."], "Sesska (comm)"],
			["emote", "Tikka", "sad"],
			["say", "Tikka", ["[sad] Coming, love. ...One more valve. Then home."]],
			["choose", [
				{"text": "Go home, Tikka. The valve will still be here tomorrow.", "friendship": 60, "steps": [
					["emote", "Tikka", "surprise"],
					["say", "Tikka", ["[surprised] It will. It's a valve. They're very patient.", "[happy] Coming, love. Tell the sculpture I'm sorry."]],
					["walk", "Tikka", 51, 38]]},
				{"text": "One more valve, then. I'll help.", "steps": [
					["emote", "Tikka", "joy"],
					["say", "Tikka", ["[happy] Good! Third wheel again. No, the other third wheel."]],
					["fade", 1.0, 0.5], ["wait", 0.6], ["fade", 0.0, 0.5],
					["say", "", ["One more valve becomes four. By the time Tikka lets go of the manifold, your arms ache."]],
					["energy", -15],
					["say", "Tikka", ["[sad] ...Sesska will be very polite to me tomorrow. That is the worst thing she does."]]]}]],
			["flag", "tikka_manifold"],
		],
	},
