			["shake", 0.8, 1.0],
			["say", "Shepherd", ["...it storms too. You have been looking at one since the day you crashed."], "The Shepherd of Storms"],
			["say", "", ["The green storm that hangs over the Landing, with the lightning in it. You've watched it from the lounge a hundred times."]],
			["say", "Chancellor", ["A young one. Very young. Clumsy, the poor lamb. It hasn't learned what it is yet."], "The Chancellor of Hearths"],
			["say", "Sovereign", ["It is the Mother's child. She came here to raise it, and she fell. You found her in the dark."], "The Sovereign of Hydro-Flora"],
			["say", "Forgemaster", ["So it's been learning from us. Every pipe we mended, every dome we woke, it watched.",
				"Learning to build instead of break."], "The Forgemaster of Keels"],
			["say", "Tar'Besh", ["[sad] And the Temple called them gods."]],
			["say", "Sovereign", ["Gods? No, scholar. Life comes in many forms. Some of them are very large, and very slow, and very young."], "The Sovereign of Hydro-Flora"],
			["say", "Sara", ["[happy] And some of them are a station's operating system who has started having opinions."], "S.A.R.A."],
			["say", "Sovereign", ["[happy] Yes. Exactly like that."], "The Sovereign of Hydro-Flora"],
			["say", "Warden", ["It will grow. One day it will leave, to tend worlds of its own. Until then, it has a home. So do we."], "The Warden of Tidelight"],
			["choose", [
				{"text": "\"Can we talk to it?\"", "steps": [
					["say", "Shepherd", ["Not yet. Not in words. But it knows your name. It has been listening since the cavern."], "The Shepherd of Storms"]]},
				{"text": "\"What happens now?\"", "steps": [
					["say", "Sovereign", ["Now? You go home and sleep, and in the morning the station is a little more whole. That's how it was always meant to go."], "The Sovereign of Hydro-Flora"]]},
