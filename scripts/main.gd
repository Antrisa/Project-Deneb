			if portals.has(key): portals[key].locked = bool(saved_locks[key])


# Frontages and landmarks are separate sprites, not painted into giant roof tiles.
func _spawn_concourse() -> void:
	var fountain = preload("res://scripts/lunar_fountain.gd").new()
	fountain.name = "LayeredFountain"
	fountain.position = Vector2(1848,1528)
	fountain.visible = false
	actors.add_child(fountain)
	area_sprites.append([fountain,"main"])
	var window = preload("res://scripts/lunar_observatory.gd").new()
	window.position = Vector2(47*16,75*16)
	window.visible = false
	actors.add_child(window)
	area_sprites.append([window,"main"])
	for p in MapData.ROOF_PROPS:
		var roof_sprite := Sprite2D.new()
		roof_sprite.texture = load("res://art/lunar/%s.png" % p[0])
		roof_sprite.centered = false
		roof_sprite.scale = Vector2.ONE*ART
		roof_sprite.position = Vector2(p[1]*16+(p[3]*16-roof_sprite.texture.get_width()*ART)*0.5,(p[2]+p[4])*16-16)
		roof_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		roof_sprite.offset = Vector2(0,-roof_sprite.texture.get_height())
		roof_sprite.visible = false
		actors.add_child(roof_sprite)
		area_sprites.append([roof_sprite,"main"])
	for e in MapData.ENTRANCES:
		var facade: Array = []
		if e[0] == "main":
			for f in MapData.CONCOURSE_FRONTS:
				if f[1] == e[1] and f[2] == e[2]: facade = f; break
		var door = preload("res://scripts/lunar_portal.gd").new()
		door.setup(e,facade)
		door.visible = false
		actors.add_child(door)
		area_sprites.append([door,e[0]])
		if false and door.facing != "S":   # wayfinding squares by side doors read as glitches (Zachary, 17 Nov); off until there is real art
			var marker = preload("res://scripts/lunar_marker.gd").new()
			marker.setup(e,facade)
			marker.position += Vector2(0,-40) if door.facing == "N" else Vector2(-24 if door.facing == "W" else 24,-8)
			marker.visible = false
			ground_fx.add_child(marker)
			area_sprites.append([marker,e[0]])
		var key := _portal_key(e[0],Vector2i(e[1],e[2]))
		portals[key] = door
		door_locks[key] = bool(e[8])
		things.append({"kind":"portal","name":e[7],"hint":"Right-click to open" if door.kind != "lift" else "Right-click to ride", "area":e[0],"pos":Vector2(e[1]*16+8,e[2]*16+8),"radius":44.0,"who":"","entry":e,"key":key})
	for e in MapData.INNER_DOORS:
		var inner = preload("res://scripts/inner_door.gd").new()
		inner.setup(e)
		inner.visible = false
		actors.add_child(inner)
		area_sprites.append([inner,e[0]])
		inner_doors.append(inner)
		if str(e[6]).begins_with("repair:"):
			# a door sealed until S.A.R.A. repairs what is behind it: using it opens her repairs page
			things.append({"kind": "sealed", "name": "Sealed door", "hint": "Ask S.A.R.A.", "area": e[0], "pos": inner.center(),
				"radius": 34.0, "who": "", "repair": str(e[6]).substr(7)})
	for p in MapData.CONCOURSE_PROPS:
		_spawn_prop(p,"main")
	# Other levels drawn in the promenade style (the Survey Level, ...): their props and roof machinery.
	for area_name in MapData.AREA_PROPS:
		for p in MapData.AREA_PROPS[area_name]:
			_spawn_prop(p,area_name)
	_spawn_prop(["crew_board", CREW_BOARD.x, CREW_BOARD.y, 2, 3, "Crew board"], "bay")   # Eshu's crew board (art 23 Nov)
	# What the museum's cases hold (Tar'Besh's own pieces to start with); donations add more with show_exhibit().
	for i in MapData.MUSEUM_SLOTS.size():
		var slot: Array = MapData.MUSEUM_SLOTS[i]
		if slot.size() > 4 and str(slot[4]) != "":
			show_exhibit(i, str(slot[4]))
	_show_museum_gifts()
	for area_name in MapData.AREA_ROOF_PROPS:
		for p in MapData.AREA_ROOF_PROPS[area_name]:
			var roof_sprite := Sprite2D.new()
			roof_sprite.texture = load("res://art/lunar/%s.png" % p[0])
			roof_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			roof_sprite.centered = false
			roof_sprite.scale = Vector2.ONE*ART
			roof_sprite.position = Vector2(p[1]*16+(p[3]*16-roof_sprite.texture.get_width()*ART)*0.5,(p[2]+p[4])*16-16)
			roof_sprite.offset = Vector2(0,-roof_sprite.texture.get_height())
			roof_sprite.visible = false
			actors.add_child(roof_sprite)
			area_sprites.append([roof_sprite,area_name])

# One prop picture ([name, x, y, w, h, title] in tiles), standing on the bottom of its tiles.
func _spawn_prop(p: Array, area_name: String) -> void:
	var sprite: Sprite2D = preload("res://scripts/lunar_terminal.gd").new() if p[0] == "terminal" else Sprite2D.new()
	if p[0] == "terminal": sprite.title = p[5]
	sprite.texture = load("res://art/lunar/%s.png" % p[0])
	var fw: int = sprite.texture.get_width()
	# Machinery with a looping strip (same size frames side by side) animates; the frame count is the
	# strip's width over the still picture's width, so no list is needed.
	var strip_path := "res://art/lunar/anim/%s.png" % p[0]
	if ResourceLoader.exists(strip_path):
		var strip: Texture2D = load(strip_path)
		var frames: int = maxi(1, int(round(float(strip.get_width()) / float(fw))))
		sprite.texture = strip
		sprite.hframes = frames
		anim_props.append([sprite, frames, randf() * frames])
	sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	sprite.centered = false
	if p[0] == "game_chair" and "left" in p[5]: sprite.flip_h = true
	# Art on the 24-pixel grid, shown at two-thirds (see ART). Never stretch X/Y.
	sprite.scale = Vector2.ONE * ART
	sprite.offset = Vector2(0,-sprite.texture.get_height())
	# Centred on its tiles and standing on its bottom edge.
	sprite.position = Vector2(p[1]*16+(p[3]*16-fw*ART)*0.5,(p[2]+p[4])*16)
	if p[0] == "game_chair" or p[0] == "bar_stool" or p[0].begins_with("chair_") or p[0].begins_with("bench_"):
		# The back of a chair sorts behind its occupant without moving the artwork (12 world units is
		# 18 art pixels; it was 24, which drew these seats 4 units low).
		sprite.position.y -= SEAT_SORT
		sprite.offset.y += SEAT_SORT / ART
	if p[0] in BED_PROPS:
		_spawn_bed(sprite, p, area_name)
	if p[0] == "crystal_pedestal_empty" and area_name == "sanctum":
		cradle_sprites[Vector2i(int(p[1]), int(p[2]))] = sprite     # filled as far Custodians come home (_sync_cradles)
	sprite.visible = false
	actors.add_child(sprite)
	area_sprites.append([sprite,area_name])
	if p[0] in ["rubble", "glass_shards"]:
		# wreckage in a broken dome: S.A.R.A.'s drones clear it when they repair the dome (_sync_station)
		for id in MapData.SEALED_ROOMS:
			var box: Array = MapData.SEALED_ROOMS[id]
			if str(box[0]) == area_name and int(p[1]) >= int(box[1]) and int(p[1]) <= int(box[3]) and int(p[2]) >= int(box[2]) and int(p[2]) <= int(box[4]):
				wreck_props.append([sprite, str(id)])
	if p[0] == "terminal" and str(p[5]) == "Message pad":
		# your mailbox: its screen shows an envelope (scripts/lunar_terminal.gd), and another bobs over it while a
		# letter waits (drawn over the walls, like the other overlays)
		sprite.set("mail_world", self)
		var flag := MailFlag.new()
		flag.world = self
		flag.position = Vector2(float(p[1]) * TILE + float(p[3]) * TILE * 0.5, (float(p[2]) + float(p[4])) * TILE - sprite.texture.get_height() * ART)
		flag.visible = false
		top_fx.add_child(flag)
		area_sprites.append([flag, area_name])
	if p[0] in ["fountain","terminal"]:
		var water := ShaderMaterial.new()
		water.shader = load("res://shaders/fountain_water.gdshader" if p[0] == "fountain" else "res://shaders/mess_lights.gdshader")
		sprite.material = water
	if area_name == "museum" and p[0] == "case_empty":
		museum_cases["%d:%d" % [int(p[1]), int(p[2])]] = sprite
	# Props drawn for each season (park trees: green, teal, orange, bare with snow) swap pictures as the year turns.
	if ResourceLoader.exists("res://art/lunar/%s_winter.png" % p[0]):
		seasonal_props.append([sprite, p[0]])
		prop_season = ""
	# Ground shadow, lamp glow and leaf sway (cozy art pass).
	var glow: Sprite2D = PropFx.decorate(sprite, p[0], fw, sprite.texture.get_height())
	if glow != null:
		prop_glows.append(glow)

# A bed ([name, x, y, w, h, title] in tiles): the whole bed sorts behind whoever is in it and its covers
# (<name>_blanket.png) in front, so a sleeper shows from the chest up, as in Stardew Valley. The foot
# row of tiles can be walked into; each tile there has the spot a sleeper stands on (one in the middle of
# a single bed, two side by side in a double).
func _spawn_bed(sprite: Sprite2D, p: Array, area_name: String) -> void:
	var bottom: float = float(int(p[2]) + int(p[4])) * TILE
	# sort the bed itself a little above any sleeper's feet (the artwork does not move)
	sprite.position.y -= 20.0
	sprite.offset.y += 20.0 / ART
	var path := "res://art/lunar/%s_blanket.png" % p[0]
	if ResourceLoader.exists(path):
		var covers := Sprite2D.new()
		covers.texture = load(path)
		covers.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		covers.centered = false
		covers.scale = Vector2.ONE * ART
		covers.position = Vector2(sprite.position.x, bottom + 2.0)
		covers.offset = Vector2(0, -covers.texture.get_height() - 2.0 / ART)
		covers.visible = false
		actors.add_child(covers)
		area_sprites.append([covers, area_name])
	var x0: int = int(p[1])
	var w: int = int(p[3])
	var row: int = int(p[2]) + int(p[4]) - 1
	var middle: float = x0 * TILE + w * TILE * 0.5
	var bed_here: Dictionary = beds[area_name]
	for x in range(x0, x0 + w):
		var cx: float = x * TILE + TILE * 0.5
		var sx: float = middle
		if w >= 3 and absf(cx - middle) > 1.0:
			sx = middle + (8.0 if cx > middle else -8.0)
		bed_here[Vector2i(x, row)] = Vector2(sx, bottom - BED_SLEEPER_Y)


func _resident_named(who: String):
	for r in residents:
		if r.who == who:
			return r
	return null


# Where a sleeper stands in the bed at this tile, or null if it is not a bed. The spot suits your own
# height; eye_row (the row of someone's eyes in their 48-high standing frame, at `art_scale` world units
# per art pixel) moves anyone else so their eyes land in the same place, the middle of the pillow.
func bed_slot(area_name: String, t: Vector2i, eye_row: int = 13, art_scale: float = ART):
	var bed_here: Dictionary = beds.get(area_name, {})
	if not bed_here.has(t):
		return null
	var slot: Vector2 = bed_here[t]
	return slot + Vector2(0, BED_SLEEPER_Y - (eye_row - 3) * art_scale)


# Your own bed: getting in asks whether to sleep (once each time you get in).
func _check_bed() -> void:
	var t: Vector2i = _player_tile()
	var slot = bed_slot(current_area, t)
	if slot == null:
		bed_prompted = false
		return
	if bed_prompted:
		return
	var start: Array = MapData.START
	if current_area != str(start[0]) or not _is_own_bed(t):
		return
	bed_prompted = true
	_say("Your bunk", ["Sleep until morning?"], Callable(self, "_end_day"), "Sleep")


func _is_own_bed(t: Vector2i) -> bool:
	for p in MapData.AREA_PROPS.get(current_area, []):
		if p[0] in BED_PROPS and str(p[5]) == "Your bed":
			if t.x >= int(p[1]) and t.x < int(p[1]) + int(p[3]) and t.y == int(p[2]) + int(p[4]) - 1:
				return true
	return false


# A resident's portrait strip for today's season (24 Nov): summer and winter outfits live in art/summer/ and
# art/winter/; spring and autumn wear the usual clothes (art/portrait_<id>.png).
func portrait_path(id: String) -> String:
	var season: String = str(BridgeScript.season_date(day)[0]).to_lower()
	if season == "summer" or season == "winter":
		var path := "res://art/%s/portrait_%s.png" % [season, id]
		if ResourceLoader.exists(path):
			return path
	return "res://art/portrait_%s.png" % id


# When the season turns, everyone met so far changes into that season's portrait, and the datapad's copies
# of their faces are made again from the new pictures.
func _apply_portrait_season() -> void:
	var season: String = str(BridgeScript.season_date(day)[0]).to_lower()
	if season == portrait_season:
		return
	portrait_season = season
	for who in persons:
		var st: Dictionary = persons[who]
		if not ResourceLoader.exists("res://art/portrait_%s.png" % st["id"]):
			continue
		st["portrait"] = load(portrait_path(str(st["id"])))
		if datapad != null and datapad.pad.extra_textures.has("p_" + str(who)):
			datapad.pad.extra_textures.erase("p_" + str(who))


# Spring uses the plain picture; summer, autumn and winter use <name>_<season>.png when it exists.
func _apply_prop_season() -> void:
	var season: String = str(BridgeScript.season_date(day)[0]).to_lower()
	if season == prop_season:
		return
	prop_season = season
	for e in seasonal_props:
		var sp: Sprite2D = e[0]
		if not is_instance_valid(sp):
			continue
		var path := "res://art/lunar/%s.png" % e[1]
		if season != "spring" and ResourceLoader.exists("res://art/lunar/%s_%s.png" % [e[1], season]):
			path = "res://art/lunar/%s_%s.png" % [e[1], season]
		sp.texture = load(path)
		sp.offset.y = -sp.texture.get_height()

# ---------------------------------------------------------------- museum donations (23 Nov)
# Relics from space (item_data.gd, "relic") go in Tar'Besh's museum. Talking to Tar'Besh in the museum with a relic,
# or using his desk, opens the placing view (scripts/museum_donate.gd), as in Stardew Valley: the camera pulls back
# over the cases and you choose where each relic goes, and can move your own around to group them (Zachary, 23 Nov).
# Tar'Besh's own pieces stay put. Looking at a case with one of your relics in it shows what it is.

# The relic to start with: the one selected on the hotbar, or the first in the bag, or "".
func _relic_to_place() -> String:
	var held: String = slots[selected] if selected < slots.size() else ""
	if held != "" and ItemData.ITEMS.has(held) and ItemData.ITEMS[held].has("relic") and _count(held) > 0:
		return held
	return _first_relic()


func _first_relic() -> String:
	for id in ItemData.relics():
		if _count(id) > 0:
			return id
	return ""


# Tar'Besh (or his desk) offers the placing view.
func _offer_relic(speaker: String) -> void:
	var have: String = _first_relic()
	if current_area != "museum":
		_say(speaker, ["[happy] Is that a %s? Bring it to the museum and find me there. Or leave it at my desk." % str(ItemData.ITEMS[have]["name"]).to_lower()])
		return
	var lines: Array
	if speaker == "Tar'Besh":
		lines = ["[happy] Is that... a %s? Where did you find it? No, tell me later." % str(ItemData.ITEMS[have]["name"]).to_lower(),
			"Choose a case for it yourself. Group things however you like; I trust your eye."]
	elif have != "":
		lines = ["Tar'Besh isn't here. A card on the desk says: DONATIONS: choose any empty case and place your find inside."]
	else:
		lines = ["Tar'Besh's desk. A card says: DONORS MAY ARRANGE THEIR OWN PIECES.", "Move the relics you've given?"]
	_say(speaker, lines, Callable(self, "_open_museum_view"), "Choose a case" if have != "" else "Arrange")


func _open_museum_view() -> void:
	museum_view.start()


# Called by the placing view.
func museum_place(id: String, slot: int) -> void:
	if _count(id) <= 0 or museum_gifts.has(str(slot)) or str(MapData.MUSEUM_SLOTS[slot][4]) != "":
		return
	_give(id, -1)
	museum_gifts[str(slot)] = id
	show_exhibit(slot, str(ItemData.ITEMS[id]["relic"]))
	sfx("museum_place")
	_museum_thanks()


# The museum's thanks (Zachary, 24 Nov: "every 5 relics you get something for donations"): at 5 relics in the cases,
# then 10, 15..., Tar'Besh pays Scrip there and then and writes the next morning, with a gift. Each comes once:
# taking a relic back out doesn't undo it. Tar'Besh's 8, Relic Appraisal, adds a quarter to the Scrip.
const MUSEUM_STEP := 5
const MUSEUM_SCRIP := [250, 500]     # at 5 and 10 relics; after that, 50 a relic (15 relics: 750)
const RELIC_APPRAISAL := 1.25
var museum_thanked: Array = []     # the counts already thanked (5, 10...), saved


func _museum_thanks() -> void:
	var m := MUSEUM_STEP
	while m <= museum_gifts.size():
		if not museum_thanked.has(m):
			museum_thanked.append(m)
			var k: int = m / MUSEUM_STEP - 1
			var scrip: int = int(MUSEUM_SCRIP[k]) if k < MUSEUM_SCRIP.size() else m * 50
			if _flag("perk_relic_appraisal"):
				scrip = int(round(scrip * RELIC_APPRAISAL))
			_money(scrip, "The museum's thanks")
			sfx("quest")
			_toast("Tar'Besh: %d relics in the cases. The museum's thanks: +%d scrip%s" % [m, scrip,
					" (appraised)" if _flag("perk_relic_appraisal") else ""])
			if m == 5:
				send_mail("tarbesh_museum_5", 1)
			elif m == 10:
				send_mail("tarbesh_museum_10", 1)
		m += MUSEUM_STEP


func museum_take(slot: int) -> void:
	var key := str(slot)
	if not museum_gifts.has(key):
		return
	_give(str(museum_gifts[key]), 1)
	museum_gifts.erase(key)
	_clear_exhibit(slot)


# Looking at a case that holds one of your relics.
func _look_museum_case(at: Vector2) -> bool:
	var slot: int = _case_at(at)
	if slot < 0 or not museum_gifts.has(str(slot)):
		return false
	var gift: String = str(museum_gifts[str(slot)])
	_say(str(ItemData.ITEMS[gift]["name"]), [str(ItemData.ITEMS[gift]["desc"]).trim_suffix(" For Tar'Besh's museum."),
			"The card under it reads: 'Found out in the Reach, and given to the Landing.'"])
	return true


func _show_museum_gifts() -> void:
	for key in museum_gifts:
		var id: String = str(museum_gifts[key])
		if ItemData.ITEMS.has(id):
			show_exhibit(int(key), str(ItemData.ITEMS[id]["relic"]))


# The museum case whose Look spot is at `at` (THINGS puts it at the case's tile + (16, 24)), or -1.
func _case_at(at: Vector2) -> int:
	for i in MapData.MUSEUM_SLOTS.size():
		var slot: Array = MapData.MUSEUM_SLOTS[i]
		if at.distance_to(Vector2(int(slot[0]) * 16 + 16, int(slot[1]) * 16 + 24)) < 6.0:
			return i
	return -1


func _clear_exhibit(slot: int) -> void:
	var at: Array = MapData.MUSEUM_SLOTS[slot]
	var case_sprite: Sprite2D = museum_cases.get("%d:%d" % [int(at[0]), int(at[1])])
	if case_sprite != null and case_sprite.get_node_or_null("Exhibit") != null:
		case_sprite.get_node("Exhibit").queue_free()


# Puts a picture (art/museum/<picture>.png, 24x24) on the cushion inside museum case number `slot`
# (an index into MapData.MUSEUM_SLOTS). The case's glass is see-through, so the exhibit is drawn behind it.
# For donations: call this when the player gives Tar'Besh something, and save which slot holds what.
func show_exhibit(slot: int, picture: String) -> void:
	if slot < 0 or slot >= MapData.MUSEUM_SLOTS.size():
		return
	var at: Array = MapData.MUSEUM_SLOTS[slot]
	var case_sprite: Sprite2D = museum_cases.get("%d:%d" % [int(at[0]), int(at[1])])
	var path := "res://art/museum/%s.png" % picture
	if case_sprite == null or not ResourceLoader.exists(path):
		return
	var old_item := case_sprite.get_node_or_null("Exhibit")
	if old_item != null:
		old_item.queue_free()
	var item := Sprite2D.new()
	item.name = "Exhibit"
	item.texture = load(path)
	item.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	item.centered = true
	# The case picture is 46 x 58 art pixels and its cushion top is 25 pixels above its bottom edge.
	item.position = Vector2(case_sprite.texture.get_width() * 0.5 - 2, case_sprite.offset.y + case_sprite.texture.get_height() - 25 - 12)
	item.show_behind_parent = true
	case_sprite.add_child(item)

func _animate_props() -> void:
	# Each machine loops at 8 frames a second from its own random start, so twins don't pulse together.
	var t: float = Time.get_ticks_msec() / 1000.0 * PROP_ANIM_FPS
	for a in anim_props:
		var sp: Sprite2D = a[0]
		if is_instance_valid(sp) and sp.visible:
			sp.frame = int(t + a[2]) % int(a[1])

func _portal_key(area_name: String,tile: Vector2i) -> String:
	return "%s:%d:%d" % [area_name,tile.x,tile.y]

# Quest scripts can call this before access is earned; lock state is saved.
func set_door_locked(area_name: String,tile: Vector2i,value: bool) -> void:
	var key := _portal_key(area_name,tile)
	door_locks[key] = value
	if portals.has(key): portals[key].locked = value

func _enter_portal(t: Dictionary) -> void:
	var key: String = t.key
	if door_locks.get(key,false):
		if str(t.entry[3]) == "aptCoop":
			_toast("Player 2's apartment: kept for a second player (co-op comes later)")
		else:
			_toast("Locked — access is not available yet")
		sfx("door_locked")
		return
	var e: Array = t.entry
	var door = portals[key]
	sfx("lift" if e.size() > 7 and str(e[7]).to_lower().contains("lift") else "door_slide")
	travelling = true
	player.frozen = true
	var tween := create_tween()
	tween.tween_property(door,"opening",1.0,0.35)
	await tween.finished
	var step := create_tween()
	step.tween_property(player,"position",Vector2(e[1]*16+8,e[2]*16+12),0.25)
	await step.finished
	var layer := CanvasLayer.new()
	layer.layer = 30
	layer.scale = Vector2.ONE * UI_SCALE
	add_child(layer)
	var fade := ColorRect.new()
	fade.color = Color(0.08,0.1,0.15,0)
	fade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(fade)
	var is_lift: bool = door.kind == "lift"
	if is_lift:
		var close := create_tween()
		close.tween_property(door,"opening",0.0,0.35)
		await close.finished
		_toast("Lift moving…")
	var out := create_tween()
	out.tween_property(fade,"color:a",1.0,0.22)
	await out.finished
	if is_lift: await get_tree().create_timer(0.7).timeout
	_go_to(e[3],Vector2i(e[4],e[5]))
	door.opening = 0.0
	var inside := create_tween()
	inside.tween_property(fade,"color:a",0.0,0.25)
	await inside.finished
	layer.queue_free()
	travelling = false
	player.frozen = false

