func _load_game() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SAVE_PATH) != OK:
		return
	day = int(cfg.get_value("game", "day", 1))
	credits = int(cfg.get_value("game", "credits", 0))
	repair_stage = clampi(int(cfg.get_value("game", "repair_stage", 0)), 0, REPAIRS.size())
	var saved_items = cfg.get_value("game", "items", {})
	if saved_items is Dictionary:
		items = saved_items
	weapon = str(cfg.get_value("game", "weapon", ""))
	# Saves from before the hotbar kept the laser and weapon as flags; turn them into items.
	if bool(cfg.get_value("game", "has_laser", false)):
		items["laser"] = 1
	if weapon != "":
		items[weapon] = 1
	var saved_slots = cfg.get_value("game", "slots", [])
	if saved_slots is Array:
		slots = saved_slots
	# The Harbinger's scale became the Leviathan's (22 Nov).
	if items.has("harbinger_scale"):
		items["leviathan_scale"] = int(items.get("leviathan_scale", 0)) + int(items["harbinger_scale"])
		items.erase("harbinger_scale")
	for i in slots.size():
		if str(slots[i]) == "harbinger_scale":
			slots[i] = "leviathan_scale"
	selected = clampi(int(cfg.get_value("game", "selected", 0)), 0, 7)
	_sync_slots()
	job_quest = int(cfg.get_value("game", "job_quest", 0))
	tunnel_kills = int(cfg.get_value("game", "tunnel_kills", 0))
	cav_lift = int(cfg.get_value("game", "cav_lift", 0))
	cav_deepest = int(cfg.get_value("game", "cav_deepest", 0))
	# saves from before 22 Nov called the floor-45 monster the Harbinger
	leviathan_slain = bool(cfg.get_value("game", "leviathan_slain", cfg.get_value("game", "harbinger_slain", false)))
	story_flags = cfg.get_value("game", "story_flags", {})
	max_energy = _max_energy()
	rusk_cask = cfg.get_value("game", "rusk_cask", {})
	var saved_seen = cfg.get_value("game", "events_seen", [])
	events_seen = saved_seen if saved_seen is Array else []
	partner = str(cfg.get_value("game", "partner", ""))
	board_taken_day = int(cfg.get_value("game", "board_taken_day", 0))
	board_done_day = int(cfg.get_value("game", "board_done_day", 0))
	# Saves from before Vzz'ket's letter (23 Nov): if you had cleared the tunnels, the gate was already open.
	caverns_open = bool(cfg.get_value("game", "caverns_open", job_quest >= 5))
	var saved_waiting = cfg.get_value("mail", "waiting", [])
	mail_waiting = saved_waiting if saved_waiting is Array else []
	var saved_days = cfg.get_value("mail", "days", {})
	mail_days = saved_days if saved_days is Dictionary else {}
	var saved_due = cfg.get_value("mail", "due", {})
	mail_due = saved_due if saved_due is Dictionary else {}
	var saved_shipping = cfg.get_value("farm", "shipping", {})
	shipping = saved_shipping if saved_shipping is Dictionary else {}
	var saved_found = cfg.get_value("custodians", "found", [])
	custodians_found = saved_found if saved_found is Array else []
	var saved_given = cfg.get_value("custodians", "given", {})
	relic_given = saved_given if saved_given is Dictionary else {}
	var saved_bdue = cfg.get_value("custodians", "due", [])
	bundles_due = saved_bdue if saved_bdue is Array else []
	var saved_bdone = cfg.get_value("custodians", "done", [])
	bundles_done = saved_bdone if saved_bdone is Array else []
	var saved_forage = cfg.get_value("tidelight", "forage", {})
	forage_taken = saved_forage if saved_forage is Dictionary else {}
	var saved_fixed = cfg.get_value("station", "fixed", [])
	station_fixed = saved_fixed if saved_fixed is Array else []
	var saved_repairs = cfg.get_value("station", "due", [])
	station_due = saved_repairs if saved_repairs is Array else []
	var saved_look = cfg.get_value("game", "appearance", {})
	if saved_look is Dictionary and not saved_look.is_empty() and maker != null:
		appearance = maker.tidy(saved_look)
	for who in persons:
		var st: Dictionary = persons[who]
		var section: String = "npc_%s" % st["id"]
		st["met"] = bool(cfg.get_value(section, "met", false))
		st["friendship"] = int(cfg.get_value(section, "friendship", 0))
		st["next"] = int(cfg.get_value(section, "next", 0))
		st["intro_due"] = bool(cfg.get_value(section, "intro_due", false))
		# Saves from before 22 Nov counted 10 points a heart; hearts are 100 points now.
		var scale_was: int = int(cfg.get_value("game", "hearts_scale", 10))
		if scale_was != FRIEND_PER_HEART and scale_was > 0:
			st["friendship"] = int(st["friendship"]) * FRIEND_PER_HEART / scale_was

	garden_watered_day = int(cfg.get_value("access", "garden_watered_day", -1))
	var saved_farm = cfg.get_value("farm", "tiles", {})
	if saved_farm is Dictionary:
		farm = saved_farm
	seeds_taken_day = int(cfg.get_value("farm", "seeds_taken_day", -1))
	# Saves from before the welcome visit (23 Nov) are past day one or already have their tools.
	hotel.load_from(cfg)
	can_water = maxi(0, int(cfg.get_value("farm", "can_water", CAN_CAPACITY)))
	welcomed = bool(cfg.get_value("game", "welcomed", day > 1 or int(items.get("hoe", 0)) > 0))
	var saved_recipes = cfg.get_value("shops", "known_recipes", [])
	shops.known_recipes = saved_recipes if saved_recipes is Array else []
	var saved_wearing = cfg.get_value("shops", "wearing", {})
	shops.wearing = saved_wearing if saved_wearing is Dictionary else {}
	var saved_placed = cfg.get_value("home", "placed", [])
	var saved_chests = cfg.get_value("home", "chests", {})
	chests = saved_chests if saved_chests is Dictionary else {}
	var saved_machines = cfg.get_value("home", "machines", {})
	machines = saved_machines if saved_machines is Dictionary else {}
	placed.clear()
	if saved_placed is Array:
		for e in saved_placed:
			if e is Dictionary and PLACEABLE.has(str(e.get("item", ""))) and MapData.AREAS.has(str(e.get("area", ""))):
				placed.append(e)
				_spawn_placed(e)
	var saved_owned = cfg.get_value("ships", "owned", ["starter"])
	ships_owned = saved_owned if saved_owned is Array and not (saved_owned as Array).is_empty() else ["starter"]
	active_ship = str(cfg.get_value("ships", "active", "starter"))
	if not ships_owned.has(active_ship):
		active_ship = "starter"
	for key in ["ups", "hulls", "loadouts", "taking"]:
		var v = cfg.get_value("ships", key, {})
		if v is Dictionary:
			match key:
				"ups": ship_ups = v
				"hulls": ship_hulls = v
				"loadouts": ship_loadouts = v
				"taking": crew_taking = v
	covered_stage = int(cfg.get_value("ships", "covered_stage", 0))
	said_covered = bool(cfg.get_value("ships", "said_covered", false))
	var saved_roster = cfg.get_value("ships", "crew", [])
	crew_roster = saved_roster if saved_roster is Array else []
	var saved_hired = cfg.get_value("ships", "board_hired", [])
	board_hired = saved_hired if saved_hired is Array else []
	for key2 in ["augments", "contracts", "contracts_done"]:
		var v2 = cfg.get_value("ships", key2, [])
		if v2 is Array:
			match key2:
				"augments": augments = v2
				"contracts": contracts = v2
				"contracts_done": contracts_done = v2
	var saved_cross = cfg.get_value("ships", "crew_cross", {})
	crew_cross = saved_cross if saved_cross is Dictionary else {}
	ship_hull = clampi(int(cfg.get_value("ship", "hull", _hull_max())), 0, _hull_max())
	flights = int(cfg.get_value("ship", "flights", 0))
	artie_found_day = int(cfg.get_value("ship", "artie_found_day", -1))
	fuel = int(cfg.get_value("ship", "fuel", 6))
