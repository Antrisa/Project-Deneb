func _after_ana(result: String, hull_left: int) -> void:
	ship_hull = hull_left
	if result == "lost":
		_ship_lost()
		return
	_say("Sensors", ["Her guns go quiet. Then her turrets swing round, inward, toward her own bridge."])
	_say_then(Callable(self, "_ana_betrayed"))


func _ana_betrayed() -> void:
	_say("Ana", ["[shocked] What are you doing? Stand down. That's an order!"])
	_say_then(Callable(self, "_loyalists_speak"))


func _loyalists_speak() -> void:
	_say("Loyalist", [
		"[angry] You weren't there when he needed you. You don't give orders any more.",
		"We always knew you were weak. Never once fired on a transport. Ivan covered for you. Ivan's gone.",
		"And you, Terran. You're next.",
	])
	_say_then(Callable(self, "_loyalist_fight"))


func _loyalist_fight() -> void:
	battle.start({"enemy": "loyalist_gunship", "story": true, "player_def": _ship_def("starter"), "backdrop": "moons"}, Callable(self, "_after_loyalists"), ship_hull)
	_say("Sara", [
		"[surprised] A gunship just undocked from her. They've shot out her engines and they're coming for you.",
		"Ana's ship is adrift. Deal with them first.",
	])
	_say_then(Callable(self, "_hold_battle"))


func _after_loyalists(result: String, hull_left: int) -> void:
	ship_hull = hull_left
	if result != "won":
		_ship_lost()
		return
	_flight_reward("loyalist_gunship")
	flights = 2
	ana_found_day = day
	_say("Sensors", [
		"The gunship breaks apart. Ana's corsair tumbles slowly, venting air, her bridge dark.",
		"One life sign aboard, and it's fading.",
	])
	_say_then(Callable(self, "_ana_rescue"))


func _ana_rescue() -> void:
	_say("Sara", [
		"[sad] It's your choice. But I would go.",
		"You match her spin. The drone cuts through her airlock, and you pull her out by the collar of her flight jacket.",
		"She rides home curled in the duct behind your seat, still holding a pistol she never raises.",
	])
	_say_then(Callable(self, "_ana_aboard"))


func _ana_aboard() -> void:
	_say("Ana", ["[sad] ...Why?"])
	_say_then(Callable(self, "_land_after_second_flight"))


func _land_after_second_flight() -> void:
	battle.close()
	ship_map.close()
	_home_at_eight()
	_snap_residents()
	_say("Garrick", [
		"[angry] Ivan's sister. In our Medbay. On my station.",
		"...Fine. Maren says she stays until she can walk. I'll be standing by the door.",
	])
	_save_game()


func _freya_ship_repair() -> void:
	var full: int = _hull_max()
	var missing: int = full - ship_hull
	var cost: int = missing * HULL_REPAIR_PRICE
	var needs_plate: bool = ship_hull <= 0
	_say("Freya", [
		"[sad] She took a beating. %d hull points to patch." % missing,
		"%d credits%s. Want me to start?" % [cost, " and one hull plate" if needs_plate else ""],
	], Callable(self, "_do_freya_repair"), "Repair (%d cr)" % cost)


func _do_freya_repair() -> void:
	var full: int = _hull_max()
	var cost: int = (full - ship_hull) * HULL_REPAIR_PRICE
	var needs_plate: bool = ship_hull <= 0
	if credits < cost:
		sfx("deny")
		_say("Freya", ["[sad] That's %d credits, and you're short. I'll keep her safe till you have it." % cost])
		return
	if needs_plate and int(items.get("hull_plate", 0)) < 1:
		sfx("deny")
		_say("Freya", ["I need one hull plate for the worst of it. You can make them at a workbench."])
		return
	_money(-(cost), "Ship repairs")
	if needs_plate:
		_give("hull_plate", -1)
	ship_hull = full
	sfx("quest")
	_say("Freya", ["[happy] There. Good as I can make her. Try not to bring her back in pieces."])


# ---------------------------------------------------------------- sounds

func _setup_sounds() -> void:
	for sound_name in SOUND_NAMES + SHIP_SOUNDS:
		var stream = _sound_stream(sound_name)
		if stream == null:
			continue                    # no file yet: sfx() of this name stays quiet
		if SHIP_SOUNDS.has(sound_name):
			var pool: Array = []        # a few players, so quick repeats in a fight overlap
			for k in 3:
				var sp := AudioStreamPlayer.new()
				sp.stream = stream
				add_child(sp)
				pool.append(sp)
			sounds[sound_name] = pool
		else:
			var p := AudioStreamPlayer.new()
			p.stream = stream
			add_child(p)
			sounds[sound_name] = p
	music = AudioStreamPlayer.new()
	add_child(music)
	music_director = MusicDirector.new()
	add_child(music_director)
	music_director.setup(self, music)


# The sound for a name: several takes (audio/<name>_1.ogg, _2.ogg …) are kept in sound_takes and played at random,
# so steps and hits don't repeat; otherwise a real audio/<name>.ogg wins over the made-up .wav. null: no file yet.
func _sound_stream(sound_name: String):
	var takes: Array = []
	for k in range(1, 9):
		var take_path := "res://audio/%s_%d.ogg" % [sound_name, k]
		if not ResourceLoader.exists(take_path):
			break
		takes.append(load(take_path))
	if not takes.is_empty():
		sound_takes[sound_name] = takes
		return takes[0]
	for ext in ["ogg", "wav"]:
		var path := "res://audio/%s.%s" % [sound_name, ext]
		if ResourceLoader.exists(path):
			return load(path)
	return null


# Which footsteps fit the floor under you (Zachary's recordings, 24 Nov): rock in the mine and caverns, carpet in
# homes, the hotel and the lounge, wet tiles in the bath house, soil on the dug field, the soft steps round the
# farm, metal deck plates everywhere else.
func step_sound() -> String:
	var a := current_area
	if a.begins_with("cav_") or a == "mine" or a == "tunnels" or a == "lake":
		return "step_rock"
	if a == "bathhouse":
		return "step_water"
	if a.begins_with("home") or a == "hotel" or a == "lounge" or a == "aptPlayer" or a == "aptCoop":
		return "step_carpet"
	if a == "agri":
		var tile := Vector2i(int(player.position.x) / TILE, int(player.position.y) / TILE)
		return "step_soil" if farm.has(tile) or farmable(tile) else "step_soft"
	return "step_deck"


# The music director stops or restarts the song on its next update.
func _toggle_music() -> void:
	music_on = not music_on
	_toast("Music on" if music_on else "Music off  (M turns it back on)")


func sfx(sound_name: String, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	if not sounds.has(sound_name):
		return
	var p: AudioStreamPlayer
	if sounds[sound_name] is Array:
		var pool: Array = sounds[sound_name]
		p = pool[0]
		for sp in pool:                 # a free player, else the one that started first
			if not (sp as AudioStreamPlayer).playing:
				p = sp
				break
		if p.playing:
			pool.push_back(pool.pop_front())
	else:
		p = sounds[sound_name]
	if sound_takes.has(sound_name):
		var takes: Array = sound_takes[sound_name]
		var k := randi() % takes.size()
		if takes.size() > 1 and takes[k] == last_take.get(sound_name):     # never the same take twice in a row
			k = (k + 1) % takes.size()
		p.stream = takes[k]
		last_take[sound_name] = takes[k]
	p.pitch_scale = pitch
	p.volume_db = volume_db
	p.play()


# ---------------------------------------------------------------- items

func _count(item: String) -> int:
	return int(items.get(item, 0))


func count_of(item: String) -> int:
	return _count(item)


# Adds (or with a negative number, removes) items, and keeps the inventory slots in step.
func _give(item: String, n: int) -> void:
	items[item] = maxi(0, _count(item) + n)
	if n > 0 and ItemData.ITEMS.has(item) and ItemData.ITEMS[item].has("relic") and not relics_found.has(item):
		relics_found.append(item)
	_sync_slots()


# Every item you hold sits in exactly one slot; items you run out of leave their slot.
func _sync_slots() -> void:
	while slots.size() < SLOT_COUNT:
		slots.append("")
	for i in slots.size():
		var held_item: String = slots[i]
		if held_item != "" and (_count(held_item) <= 0 or not ItemData.ITEMS.has(held_item) or slots.find(held_item) != i):
			slots[i] = ""
	for item in items:
		if _count(item) > 0 and ItemData.ITEMS.has(item) and not slots.has(item):
			var free: int = slots.find("")
			if free != -1:
				slots[free] = item


# Trade one of an item for another in the same slot (Tikka's tool upgrades): the new tool sits where the old one was.
func _swap_item(old: String, new_item: String) -> void:
	var at: int = slots.find(old)
	items[old] = maxi(0, _count(old) - 1)
	items[new_item] = _count(new_item) + 1
	if at != -1 and _count(old) <= 0 and not slots.has(new_item):
		slots[at] = new_item
	_sync_slots()


func swap_slots(a: int, b: int) -> void:
	var moved: String = slots[a]
	slots[a] = slots[b]
	slots[b] = moved


func _item_name(item: String) -> String:
	var info: Dictionary = ItemData.ITEMS[item]
	var item_name: String = info["name"]
	return item_name


func _has_all(needs: Dictionary) -> bool:
	for item in needs:
		if _count(item) < int(needs[item]):
			return false
	return true


func _needs_text(needs: Dictionary) -> String:
	var parts := PackedStringArray()
	for item in needs:
		parts.append("%d %s" % [int(needs[item]), _item_name(item).to_lower()])
	return " and ".join(parts)


# Called from the Crafting page of the menu.
func craft(index: int) -> bool:
	var recipe: Dictionary = ItemData.RECIPES[index]
	var needs: Dictionary = recipe["needs"]
	var station: String = str(recipe.get("station", ""))
	if station != "" and not nearby_stations().has(station):
		sfx("deny")
		return false
	if recipe.has("learn") and not _flag(str(recipe["learn"])):     # someone has to teach you first (Tobbin's 8)
		sfx("deny")
		return false
	if not _has_all(needs):
		sfx("deny")
		return false
	for item in needs:
		_give(item, -int(needs[item]))
	var makes: String = recipe["makes"]
	_give(makes, int(recipe["n"]))
	sfx("craft")
	return true


# ---------------------------------------------------------------- using the selected hotbar item (Space)

func _selected_use() -> String:
	var item: String = slots[selected]
	if item == "":
		return ""
	var info: Dictionary = ItemData.ITEMS[item]
	var use: String = info["use"]
	return use


func _nearest_of_kind(kind: String):
	var best = null
	var best_d := 99999.0
	var ppos: Vector2 = player.position
	var from: Vector2 = ppos + Vector2(0, -4)
	for t in things:
		if t["kind"] != kind or t["area"] != current_area:
			continue
		var pos: Vector2 = t["pos"]
		var radius: float = t["radius"]
		var d: float = from.distance_to(pos)
		if d <= radius and d < best_d:
			best = t
			best_d = d
	return best


func _use_tool() -> void:
	if player.eating:
		return
	var use: String = _selected_use()
	var item: String = slots[selected]
	if use == "mine":
		# Cut the vein under the mouse pointer if it is in reach, otherwise the nearest one.
		var vein = _thing_under_mouse()
		if vein == null or vein["kind"] != "ore" or not _in_reach(vein):
			vein = _nearest_of_kind("ore")
		if vein != null:
			_start_cut(vein)
		elif swing_cd <= 0.0:
			# Nothing in reach: the laser still fires, like a pickaxe swung at the ground (and costs the same).
			swing_cd = 0.4
			if not player.tool_action(_tool_art(item), "laser"):
				player.show_tool(_item_icon(item))
			sfx("zap", 0.7, -6.0)
			energy = maxi(0, energy - _mining_energy())
	elif use == "weapon":
		if swing_cd > 0.0:
			return
		swing_cd = 0.32
		player.swing(item)
		sfx("weapon_swing", randf_range(0.92, 1.08))
		_swing_hits(item)
	elif use == "eat":
		_eat(item)
	elif use in ["hoe", "water", "plant", "place"]:
		_farm_use(use, item)
	elif use == "build":
		_build(item)


# The tool art folder for an item (art/tools/<id>), for the hand animations. "" if it has none.
func _tool_art(item: String) -> String:
	return {"hoe": "hoe_basic", "watering_can": "watering_can_basic", "laser": "mining_laser_basic",
		"steel_laser": "mining_laser_steel", "titanium_laser": "mining_laser_titanium", "precursor_laser": "mining_laser_precursor",
		"steel_hoe": "hoe_steel", "titanium_hoe": "hoe_titanium", "precursor_hoe": "hoe_precursor",
		"steel_can": "watering_can_steel", "titanium_can": "watering_can_titanium",
		"precursor_can": "watering_can_precursor"}.get(item, "")


func _item_icon(item: String) -> int:
	var info: Dictionary = ItemData.ITEMS[item]
	var icon: int = info["icon"]
	return icon


# ---------------------------------------------------------------- mining and smelting

func _start_cut(t: Dictionary) -> void:
	# Mining is held, like swinging a pickaxe: keep Space or the left button down on a vein or rock.
	if not _can_cut(t):
		return
	if cutting != t:
		cutting = t
		cut_time = 0.0
		cut_buzz = 0.0


func _can_cut(t: Dictionary) -> bool:
	var node: Dictionary = ore_nodes[int(t["node"])]
	if not ["laser", "steel_laser", "titanium_laser", "precursor_laser"].any(func(l): return _count(l) > 0):
		sfx("deny")
		_say("Ore vein", ["A seam of ore in solid rock. You would need a mining laser to cut it. Job might have a spare."])
		return false
	if _selected_use() != "mine":
		sfx("deny")
		_toast("Select the mining laser on your hotbar (number keys) first")
		return false
	if _laser_tier() < int(NEEDS_TIER.get(str(node["item"]), 1)):
		sfx("deny")
		_toast("Too hard for this laser. A titanium laser would cut it (Manufacturing Hub)." if int(NEEDS_TIER.get(str(node["item"]), 1)) >= 3
				else "Too hard for the basic laser. Steel would cut it: see the Crafting page.")
		return false
	if int(node["hits"]) <= 0:
		sfx("deny")
		_toast("Nothing left to cut here today" if node["item"] == "stone" else "Worked out for now")
		return false
	if energy < CUT_ENERGY:
		sfx("deny")
		_toast("Too tired to hold the laser steady. Eat something, or sleep.")
		return false
	return true


func _cut_seconds(item: String) -> float:
	return float(CUT_TIME.get(item, DEFAULT_CUT_TIME)) * float(TIER_SPEED.get(_laser_tier(), 1.0))


func _laser_tier() -> int:
	var item: String = slots[selected]
	if item == "" or _selected_use() != "mine":
		return 0
	return int(ItemData.ITEMS[item].get("tier", 1))


# Called every frame: carries on a held cut, or stops it if the button is let go or you walk away.
func _update_cut(delta: float, paused: bool) -> void:
	if cutting == null:
		cut_bar.visible = false
		return
	var held: bool = Input.is_action_pressed("use") or Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
	var t: Dictionary = cutting
	if paused or not held or _selected_use() != "mine" or t["area"] != current_area or not _in_reach(t):
		cutting = null
		cut_bar.visible = false
		return
	var node: Dictionary = ore_nodes[int(t["node"])]
	var need: float = _cut_seconds(node["item"])
	cut_time += delta
	cut_buzz -= delta
	player.fire_laser(t["pos"], _item_icon(slots[selected]), _tool_art(slots[selected]))
	if cut_buzz <= 0.0:
		sfx("zap", randf_range(0.85, 1.05), -8.0)
		cut_buzz = 0.35
	cut_bar.visible = true
	cut_bar.position = Vector2(t["pos"]) + Vector2(-8, -16)
	cut_bar.set_meta("f", clampf(cut_time / need, 0.0, 1.0))
	cut_bar.queue_redraw()
	if cut_time >= need:
		_mine(t)
		cut_time = 0.0
		# keep cutting while the button is held, if there is anything left and the energy for it
		if int(node["hits"]) <= 0 or energy < CUT_ENERGY:
			cutting = null
			cut_bar.visible = false


func _mine(t: Dictionary) -> void:
	var node: Dictionary = ore_nodes[int(t["node"])]
	var item: String = str(node.get("give", node["item"]))
	var amount: int = int(node.get("yield", 1))
	if item == "geode":
		item = "cavern_geode"            # Job cracks it open at his bench (scripts/shops.gd, Zachary 23 Nov)
	node["hits"] = int(node["hits"]) - 1
	if int(node["hits"]) <= 0:
		var s: Sprite2D = node["sprite"]
		if bool(node.get("boulder", false)):
			s.visible = false                       # a boulder breaks up completely and frees its tiles
			s.set_meta("gone", true)
			for tt in node["tiles"]:
				blocked[current_area].erase(tt)
				fixed[current_area].erase(tt)
			things.erase(t)
		else:
			s.frame = 1
	_give(item, amount)
	energy = maxi(0, energy - _mining_energy())
	if current_area == "mine" or current_area == "tunnels":
		shops.maybe_geode(current_area)
	if bool(node.get("cav", false)) and item == "stone" and int(node["hits"]) <= 0:
		cav_rocks_left -= 1
		_maybe_open_shaft(t, node)
	sfx("rock_break" if int(node["hits"]) <= 0 else "rock_crack", randf_range(0.92, 1.08))
	if item in ["cavern_geode", "quartz", "thermal_quartz", "moon_opal", "fire_opal", "void_sapphire"]:
		sfx("ore_find", 1.0, -3.0)
	var vein_pos: Vector2 = t["pos"]
	_pop_item(item, vein_pos + Vector2(0, -10))
	_toast("+%d %s  (%d)" % [amount, _item_name(item), _count(item)])
	if energy < CUT_ENERGY:
		_toast("You're worn out. Eat something, or call it a day.")


# ---------------------------------------------------------------- things you build at home (23 Nov)
# A furnace (arc smelter), a manufacturing hub and storage chests are crafted, then set down from the hotbar (Space)
# on the tile in front of you, in your Agri complex or your hotel rooms. They block their tiles, are saved, and
# can be picked up again (a chest only when empty, a furnace only when idle). At a hub the Crafting page makes the
# hub's recipes (ItemData.RECIPES "station"). A furnace is a machine, Stardew-style: see _furnace_use.
const BASE_PLACEABLE := {
	"arc_smelter": {"art": "home_furnace", "w": 2, "h": 1, "name": "Furnace", "station": ""},
	"manufacturing_hub": {"art": "home_hub", "w": 3, "h": 1, "name": "Manufacturing hub", "station": "Manufacturing Hub"},
	"storage_chest": {"art": "home_chest", "w": 1, "h": 1, "name": "Storage chest", "station": ""},
	# furniture to look at (Pip's 8, Nub's 8, Kit's 8): no station, no storage
	"toy_rocket": {"art": "toy_rocket", "w": 1, "h": 1, "name": "Pip's toy rocket", "station": "", "decor": true},
	"nub_drawing": {"art": "nub_drawing", "w": 1, "h": 1, "name": "Nub's drawing", "station": "", "decor": true},   # Nub's 8
	"deputy_badge": {"art": "deputy_badge", "w": 1, "h": 1, "name": "Kit's deputy badge", "station": "", "decor": true},   # Kit's 8
}
# Everything you can set down: BASE_PLACEABLE and the hotel's walls, doors and furniture (scripts/hotel.gd).
var PLACEABLE: Dictionary = BASE_PLACEABLE.merged(HotelScript.FURNITURE)
const BUILD_AREAS := ["agri", "hotel"]
const STATION_REACH := 40.0         # how near a station you must stand to use its recipes (world units)
var placed: Array = []              # [{"item", "area", "x", "y"}], saved
var chests := {}                    # "area:x:y" -> {item: count}, saved
var placed_nodes := {}              # "area:x:y" -> {"sprite", "thing", "tiles"}
var open_chest := ""


func _placed_key(e: Dictionary) -> String:
	return "%s:%d:%d" % [str(e["area"]), int(e["x"]), int(e["y"])]


func _build(item: String) -> void:
	if not current_area in BUILD_AREAS:
		sfx("deny")
		_toast("Set it up at home: your Agri complex, or your rooms in the hotel")
		return
	var spec: Dictionary = PLACEABLE[item]
	var t0: Vector2i = farm_target()
	var here: Vector2i = _player_tile()
	for dy in int(spec["h"]):
		for dx in int(spec["w"]):
			var tt := t0 + Vector2i(dx, dy)
			if tt == here or farm.has(tt) or beds.get(current_area, {}).has(tt) \
					or solid_at(Vector2(tt.x * TILE + 8, tt.y * TILE + 8)):
				sfx("deny")
				_toast("No room there (it needs %d x %d clear tiles, going right)" % [int(spec["w"]), int(spec["h"])])
				return
	var e := {"item": item, "area": current_area, "x": t0.x, "y": t0.y}
	placed.append(e)
	_spawn_placed(e)
	_give(item, -1)
	sfx("crate_hit", 1.1, -6.0)
	_toast("%s set down. Right-click it to use it." % str(spec["name"]))


func _spawn_placed(e: Dictionary) -> void:
	var spec: Dictionary = PLACEABLE[str(e["item"])]
	var area: String = str(e["area"])
	var x: int = int(e["x"])
	var y: int = int(e["y"])
	var w: int = int(spec["w"])
	var h: int = int(spec["h"])
	_spawn_prop([str(spec["art"]), x, y, w, h, str(spec["name"])], area)
	var sprite: Sprite2D = area_sprites.back()[0]
	sprite.visible = area == current_area
	var tiles: Array = []
	for dy in h:
		for dx in w:
			var tt := Vector2i(x + dx, y + dy)
			tiles.append(tt)
			if not spec.get("walk", false):      # hotel doors and rugs can be walked over
				blocked[area][tt] = true
	var th := {"kind": "placed", "name": str(spec["name"]), "hint": "Use", "area": area,
		"pos": Vector2(x * TILE + w * 8, y * TILE + h * 8), "radius": 26.0 + 8.0 * (w - 1), "who": "", "key": _placed_key(e),
		"item": str(e["item"])}
	things.append(th)
	placed_nodes[_placed_key(e)] = {"sprite": sprite, "thing": th, "tiles": tiles}
	if str(e["item"]) == "arc_smelter":
		_furnace_look(_placed_key(e))
	if str(e["item"]) == "hotel_wall":
		_hotel_wall_looks(area)


# Hotel walls join up, seen from above: a wall with another wall just below it shows only its top (a cap with trim
# down the sides); a wall with open floor below shows its full face. Both pictures are the same size, so swapping
# keeps them standing on their tile. Called whenever a hotel wall is set down or picked up.
func _hotel_wall_looks(area: String) -> void:
	var walls := {}
	for e in placed:
		if str(e["area"]) == area and str(e["item"]) == "hotel_wall":
			walls[Vector2i(int(e["x"]), int(e["y"]))] = _placed_key(e)
	var face: Texture2D = load("res://art/lunar/hotel_wall_piece.png")
	var cap: Texture2D = load("res://art/lunar/hotel_wall_cap.png")
	for t in walls:
		var info: Dictionary = placed_nodes.get(walls[t], {})
		if info.has("sprite"):
			(info["sprite"] as Sprite2D).texture = cap if walls.has(t + Vector2i(0, 1)) else face


func _use_placed(t: Dictionary) -> void:
	var key: String = str(t["key"])
	var spec: Dictionary = PLACEABLE[str(t["item"])]
	if str(t["item"]) == "arc_smelter":
		var in_hand: String = slots[selected]
		if machines.has(key) or ItemData.FURNACE.has(in_hand):
			_furnace_use(key, str(t["area"]), t["pos"])
		else:
			_say("Furnace", ["Cold and empty. Hold ore (or stone, sand, salts) and use the furnace to load it."],
					Callable(self, "_pick_up").bind(key), "Pick it up")
		return
	if spec.get("decor", false):
		_say(str(spec["name"]), [str(ItemData.ITEMS.get(str(t["item"]), {}).get("desc", ""))],
				Callable(self, "_pick_up").bind(key), "Pick it up")
		return
	if str(spec["station"]) != "":
		_say(str(spec["name"]), ["The %s hums, ready for work." % str(spec["name"]).to_lower()],
				Callable(self, "_open_station"), "Craft here", Callable(self, "_pick_up").bind(key), "Pick it up")
	else:
		var n: int = 0
		for id in chest_items(key): n += int(chest_items(key)[id])
		_say(str(spec["name"]), ["Empty." if n == 0 else "%d thing%s inside." % [n, "" if n == 1 else "s"]],
				Callable(self, "_open_chest").bind(key), "Open", Callable(self, "_pick_up").bind(key), "Pick it up")


func _open_station() -> void:
	if datapad != null:
		datapad.open_page("Crafting")


func _open_chest(key: String) -> void:
	open_chest = key
	sfx("chest_open")
	if datapad != null:
		datapad.open_storage("Storage chest")
	else:
		_toast("The chest needs the datapad (datapad/ folder)")


func _pick_up(key: String) -> void:
	if not placed_nodes.has(key):
		return
	var info: Dictionary = placed_nodes[key]
	var th: Dictionary = info["thing"]
	var item: String = str(th["item"])
	if item == "storage_chest" and not chest_items(key).is_empty():
		sfx("deny")
		_toast("Empty the chest first")
		return
	if machines.has(key):
		sfx("deny")
		_toast("Wait for the furnace to finish, then take out what's inside")
		return
	var sprite: Sprite2D = info["sprite"]
	area_sprites = area_sprites.filter(func(pair): return pair[0] != sprite)
	anim_props = anim_props.filter(func(a): return a[0] != sprite)
	prop_glows = prop_glows.filter(func(g): return g.get_parent() != sprite)
	sprite.queue_free()
	things.erase(th)
	var area: String = str(th["area"])
	for tt in info["tiles"]:
		blocked[area].erase(tt)
	placed_nodes.erase(key)
	placed = placed.filter(func(e): return _placed_key(e) != key)
	chests.erase(key)
	if item == "hotel_wall":
		_hotel_wall_looks(area)
	_give(item, 1)
	sfx("item_pickup")
	_toast("Picked up: %s" % _item_name(item))


# The crafting stations within reach of the player: "Manufacturing Hub" beside a hub you built. The datapad's Crafting page reads this (datapad_bridge.gd).
func nearby_stations() -> Array:
	var out: Array = []
	if player == null:
		return out
	var p: Vector2 = player.position
	for t in things:
		if str(t.get("area", "")) != current_area or p.distance_to(t["pos"]) > STATION_REACH + float(t.get("radius", 26.0)) - 26.0:
			continue
		var st := ""
		if t["kind"] == "placed":
			st = str(PLACEABLE[str(t["item"])]["station"])
		if st != "" and not out.has(st):
			out.append(st)
	out.sort()
	return out


# ---------------------------------------------------------------- furnaces as machines (23 Nov, Zachary)
# Stardew-style: hold what you want smelted and use a furnace. It takes ItemData.FURNACE[input]["n"] (4 copper ore
# for a copper bar, and so on, plus any "also"), cooks for "mins" game minutes, then shows the bar over the furnace
# until you use it again to take it out. One load at a time. The clock is day * 1440 + minutes, so a night's sleep
# finishes anything cooking. Saved in [home] machines: key -> {"makes", "ready", "area", "pos"}.
var machines := {}
var machine_icons := {}             # key -> Sprite2D of the finished item, bobbing over the furnace
const FURNACE_ON := "res://art/lunar/home_furnace_on.png"   # three lit frames side by side; home_furnace.png is cold


func clock_now() -> float:
	return float(day) * 1440.0 + minutes


func _furnace_use(key: String, area: String, at: Vector2) -> void:
	if machines.has(key):
		var m: Dictionary = machines[key]
		var left: float = float(m["ready"]) - clock_now()
		if left > 0.0:
			sfx("deny")
			var mins := int(ceil(left))
			_toast("Cooking %s: %s left" % [_item_name(str(m["makes"])).to_lower(),
					("%d min" % mins) if mins < 60 else ("%dh %02dm" % [mins / 60, mins % 60])])
			return
		var made: String = str(m["makes"])
		machines.erase(key)
		_give(made, 1)
		sfx("machine_done")
		_flash(at + Vector2(0, 2), Color(1.0, 0.6, 0.25), 1.6)
		_pop_item(made, at + Vector2(0, -22))
		_toast("+1 %s  (%d)" % [_item_name(made), _count(made)])
		if job_quest == 2:
			job_quest = 3
			sfx("quest")
		_furnace_look(key)
		return
	var in_hand: String = slots[selected]
	if not ItemData.FURNACE.has(in_hand):
		sfx("deny")
		_toast("Hold ore, stone, sand or salts to load the furnace")
		return
	var r: Dictionary = ItemData.FURNACE[in_hand]
	var needs := {in_hand: int(r["n"])}
	var also: Dictionary = r.get("also", {})
	for id in also:
		needs[id] = int(needs.get(id, 0)) + int(also[id])
	if not _has_all(needs):
		sfx("deny")
		var parts: Array = []
		for id in needs:
			parts.append("%d %s" % [int(needs[id]), _item_name(id).to_lower()])
		_toast("%s needs %s" % [_item_name(str(r["makes"])), " + ".join(parts)])
		return
	for id in needs:
		_give(id, -int(needs[id]))
	# Tikka's 8 (Smelter Overclock): her regulators on every furnace, so everything smelts in half the time
	var cook_mins: float = float(r["mins"]) * (0.5 if _flag("perk_smelter_overclock") else 1.0)
	machines[key] = {"makes": str(r["makes"]), "ready": clock_now() + cook_mins, "area": area, "pos": at}
	sfx("furnace_load")
	_flash(at + Vector2(0, 2), Color(1.0, 0.55, 0.2), 1.2)
	_toast("Smelting %s, ready in %d min" % [_item_name(str(r["makes"])).to_lower(), int(ceil(cook_mins))])
	_furnace_look(key)


# A furnace you built shows lit and animated while it cooks, cold when idle.
func _furnace_look(key: String) -> void:
	if not placed_nodes.has(key):
		return
	var sprite: Sprite2D = placed_nodes[key]["sprite"]
	var on: bool = machines.has(key)
	anim_props = anim_props.filter(func(a): return a[0] != sprite)
	if on and ResourceLoader.exists(FURNACE_ON):
		var strip: Texture2D = load(FURNACE_ON)
		var frames: int = 3
		sprite.texture = strip
		sprite.hframes = frames
		anim_props.append([sprite, frames, randf() * frames])
	else:
		sprite.hframes = 1
		sprite.frame = 0
		sprite.texture = load("res://art/lunar/home_furnace.png")
	for g in prop_glows:
		if is_instance_valid(g) and g.get_parent() == sprite:
			g.visible = on


# Each frame: a finished load shows its item bobbing over the furnace (in the area you're in).
func _machines_tick() -> void:
	var now: float = clock_now()
	for key in machines:
		var m: Dictionary = machines[key]
		var done: bool = now >= float(m["ready"])
		if done and not machine_icons.has(key):
			var info: Dictionary = ItemData.ITEMS.get(str(m["makes"]), {})
			if info.is_empty():
				continue
			var s := Sprite2D.new()
			s.texture = items_tex
			s.region_enabled = true
			var sz: float = items_tex.get_height()
			s.region_rect = Rect2(int(info["icon"]) * sz, 0, sz, sz)
			s.scale = Vector2.ONE * (14.0 / sz)
			s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			top_fx.add_child(s)
			machine_icons[key] = s
	for key in machine_icons.keys():
		var s: Sprite2D = machine_icons[key]
		if not machines.has(key):
			s.queue_free()
			machine_icons.erase(key)
			continue
		var m: Dictionary = machines[key]
		var p: Vector2 = m["pos"]
		s.visible = str(m["area"]) == current_area
		s.position = p + Vector2(0, -34 + sin(Time.get_ticks_msec() / 260.0) * 1.5)


func chest_items(key: String) -> Dictionary:
	var c = chests.get(key, {})
	return c if c is Dictionary else {}


# Move a whole stack between the bag and a chest.
func chest_move(key: String, item: String, to_chest: bool) -> void:
	if key == "" or not placed_nodes.has(key):
		return
	var c: Dictionary = chest_items(key).duplicate()
	if to_chest:
		var n: int = _count(item)
		if n <= 0:
			return
		_give(item, -n)
		c[item] = int(c.get(item, 0)) + n
	else:
		var n: int = int(c.get(item, 0))
		if n <= 0:
			return
		c.erase(item)
		_give(item, n)
	chests[key] = c


# One ore vein or rock: its sprite, its tile blocked, and a thing to cut. Cavern ones (cav) go when you leave the floor.
func _add_node(item: String, node_area: String, tile: Vector2i, every: int, cav: bool, art: String = "") -> void:
	var vein := Sprite2D.new()
	vein.texture = load("res://art/%s.png" % (art if art != "" else item))
	vein.hframes = 2
	vein.centered = false
	_fit_sprite(vein, 2, 1, 16.0)
	vein.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 16)
	vein.visible = node_area == current_area
	actors.add_child(vein)
	area_sprites.append([vein, node_area])
	var here: Dictionary = blocked[node_area]
	here[tile] = true
	var fixed_here: Dictionary = fixed[node_area]
	fixed_here[tile] = true
	var index: int = ore_nodes.size()
	ore_nodes.append({"item": item, "hits": _node_hits(item), "sprite": vein, "every": every, "cav": cav, "tile": tile})
	things.append({
		"kind": "ore", "name": "Rock" if item == "stone" else _item_name(item), "hint": "Hold to cut %s" % ("rock" if item == "stone" else _item_name(item).to_lower()), "area": node_area,
		"pos": Vector2(tile.x * TILE + 8, tile.y * TILE + 8), "radius": 26.0, "who": "", "node": index, "cav": cav,
	})
	if cav:
		cav_sprites.append(vein)


# A cavern boulder (23 Nov, like Stardew's): 2 x 2 tiles with `tile` its top-left, cut with the steel laser in one long
# cut for BOULDER_STONE stone. It goes when cut (no rubble) and frees its tiles.
func _add_boulder(node_area: String, tile: Vector2i, band: String) -> void:
	var s := Sprite2D.new()
	s.texture = load("res://art/boulder_%s.png" % band)
	s.centered = false
	_fit_sprite(s, 1, 1, 32.0)
	s.position = Vector2(tile.x * TILE + 16, tile.y * TILE + 32)
	s.visible = node_area == current_area
	actors.add_child(s)
	area_sprites.append([s, node_area])
	var tiles: Array = [tile, tile + Vector2i(1, 0), tile + Vector2i(0, 1), tile + Vector2i(1, 1)]
	var here: Dictionary = blocked[node_area]
	var fixed_here: Dictionary = fixed[node_area]
	for tt in tiles:
		here[tt] = true
		fixed_here[tt] = true
	var index: int = ore_nodes.size()
	ore_nodes.append({"item": "boulder", "give": "stone", "yield": BOULDER_STONE, "hits": 1, "sprite": s, "every": 1,
		"cav": true, "tile": tile, "tiles": tiles, "boulder": true})
	things.append({
		"kind": "ore", "name": "Boulder", "hint": "Hold to cut the boulder", "area": node_area,
		"pos": Vector2(tile.x * TILE + 16, tile.y * TILE + 16), "radius": 34.0, "who": "", "node": index, "cav": true,
	})
	cav_sprites.append(s)


func _node_hits(item: String) -> int:
	return 1 if item == "stone" else NODE_HITS     # a rock breaks in one cut; a vein gives NODE_HITS


func _reset_nodes() -> void:
	for node in ore_nodes:
		if day % maxi(1, int(node.get("every", 1))) != 0 or bool(node.get("boulder", false)):
			continue
		node["hits"] = _node_hits(str(node["item"]))
		var s: Sprite2D = node["sprite"]
		s.frame = 0


# ---------------------------------------------------------------- Job's quest and the weapon

func _job_quest_talk() -> void:
	if job_quest == 0:
		_say("Job", [
			"[happy] Say, you lookin' for work? I got more rock than I got hands.",
			"Take my spare laser. Cut me %d iron ore and %d copper ore out them veins, and I'll show you what we do with it." % [JOB_IRON, JOB_COPPER],
		], Callable(self, "_take_laser"), "Take the laser")
	elif job_quest == 1:
		if _count("iron_ore") >= JOB_IRON and _count("copper_ore") >= JOB_COPPER:
			job_quest = 2
			_money(40, "Job")
			sfx("quest")
			_toast("Job's request done  +40 cr")
			_say("Job", [
				"[happy] Well look at that. Clean cuts, too. Here, 40 credits, and you keep the ore, cher.",
				"Smelter's up in ore processing, engineering level, far left. Hold your ore and load a furnace: four ore cooks down to one bar, give it an hour. Bram buys bars.",
				"Once you poured your first, go see Vzz'ket down at the gate. There's old tunnels north of here I want opened, and you ain't goin' in bare-handed.",
			])
		else:
			_say("Job", ["Iron's the red veins, copper's the green. You got %d of %d iron and %d of %d copper."
					% [_count("iron_ore"), JOB_IRON, _count("copper_ore"), JOB_COPPER]])
	elif job_quest == 4:
		if tunnel_kills >= TUNNEL_GOAL:
			job_quest = 5
			_money(80, "Job")
			sfx("quest")
			_toast("The north tunnels are open  +80 cr")
			_say("Job", [
				"[happy] I heard the ruckus clear down here. That's the tunnels safe enough to work. Here, 80 credits.",
				"Veins up there ain't been touched in years, and Bram'll buy them shells and hides off you.",
				"[sad] The caverns under the gate, now, that's another matter. That's Vzz'ket's call, not mine.",
				"He'll send word when he's ready to talk. Keep an eye on your mail, cher.",
			])
			send_mail("vzzket_caverns", 1)
		else:
			_say("Job", ["Way up's at the top of the dig, north wall. Thin them critters out some. You got %d of %d." % [tunnel_kills, TUNNEL_GOAL]])
	else:
		_say("Job", ["Smelter's in ore processing, engineering level, far left. Four ore, one bar, and it takes a while. Then go see Vzz'ket at the gate."])


func _take_laser() -> void:
	_give("laser", 1)
	job_quest = 1
	sfx("tool_upgrade")
	_toast("Got: mining laser")
	_say("Job", [
		"Point the bright end at the rock. Veins give out after a couple cuts, but they settle back by mornin'.",
		"(Pick the laser on your hotbar with the number keys, then press Space next to a vein.)",
	])


func _vzzket_weapon() -> void:
	_say("Vzz'ket", [
		"[angry] Job wants the north tunnels opened. Bugs and rock lizards. Small, but they bite. You will not go unarmed.",
		"These are old Zaa'sh arms. The spear stabs, far and narrow. The sword swings, near and wide. Choose.",
	], Callable(self, "_choose_weapon").bind("spear"), "Spear", Callable(self, "_choose_weapon").bind("sword"), "Sword")


func _choose_weapon(kind: String) -> void:
	weapon = kind
	_give(kind, 1)
	job_quest = 4
	sfx("tool_upgrade")
	_toast("Got: Zaa'sh %s" % kind)
	_say("Vzz'ket", ["[sad] It was my clutch-brother's. Bring it back clean.",
			"The way up is at the top of the main dig. Clear out six of them, then tell Job.",
			"(Select it on your hotbar and press Space or click to swing. A ration pack from Jasper mends you.)"])


# ---------------------------------------------------------------- Rusk's cask
# From his 8 (23 Nov, Zachary: a special seed to grow, ferment or plant again, for drinks that sell high): bring
# Rusk Nebula grapes and he ferments them in his cask, a bottle of Nebula wine for every five, ready in three days.
# Not counted as one of the day's chats (business). The Fermenter in the economy plan could do the same at home.
const CASK_GRAPES := 5
const CASK_DAYS := 3


func _rusk_cask_talk() -> bool:
	if not _flag("rusk_first_page"):
		return false
	if not rusk_cask.is_empty():
		if day < int(rusk_cask["ready"]):
			return false
		var n: int = int(rusk_cask["bottles"])
		rusk_cask = {}
		_give("nebula_wine", n)
		sfx("quest")
		_toast("+%d Nebula wine" % n)
		_say("Rusk", ["[happy] There she is. %s of Nebula wine, the way Ilsa made it." % ("One bottle" if n == 1 else "%d bottles" % n),
			"Ship it, and Bram's cousins will pay what it's worth. Or keep one back for a night that deserves it."])
		return true
	if _count("nebula_grape") < CASK_GRAPES:
		return false
	var bottles: int = _count("nebula_grape") / CASK_GRAPES
	_say("Rusk", ["Nebula grapes! Give them here and I'll put them down in the cask.",
		"%d grapes makes %d bottle%s. Come back in %d days." % [bottles * CASK_GRAPES, bottles, "" if bottles == 1 else "s", CASK_DAYS]],
		Callable(self, "_rusk_cask_fill"), "Leave them with Rusk", Callable(self, "_rusk_cask_keep"), "Keep them")
	return true


func _rusk_cask_fill() -> void:
	var bottles: int = _count("nebula_grape") / CASK_GRAPES
	_give("nebula_grape", -bottles * CASK_GRAPES)
	rusk_cask = {"bottles": bottles, "ready": day + CASK_DAYS}
	sfx("click")
	_toast("Rusk's cask: %d bottle%s in %d days" % [bottles, "" if bottles == 1 else "s", CASK_DAYS])


func _rusk_cask_keep() -> void:
	_say("Rusk", ["[happy] Planting more? Good. She'd have liked a whole field of them."])


# ---------------------------------------------------------------- Saffi's 8, Well Fed (Zachary, 24 Nov: "saffi
# increase max energy perk"): your energy bar is WELL_FED_ENERGY longer. MAX_ENERGY stays the base; _max_energy() is
# what you can have, and max_energy (the HUD's) follows it.
const WELL_FED_ENERGY := 30


func _max_energy() -> int:
	return MAX_ENERGY + (WELL_FED_ENERGY if _flag("perk_well_fed") else 0)


# Quill's 8, Guardian Medic: two more hearts of health (and collapsing costs nothing, in _collapse).
const GUARDIAN_HP := 2


func _max_hp() -> int:
	return MAX_HP + (GUARDIAN_HP if _flag("perk_guardian_medic") else 0)


# Job's 8, Bedrock Strength: mining costs a fifth less energy. Energy is whole points, so the fifth saved on each
# cut adds up and comes off a point at a time.
var _mining_saved := 0.0


func _mining_energy() -> int:
	var cost: int = shops.tool_energy(CUT_ENERGY)
	if _flag("perk_bedrock_strength"):
		_mining_saved += cost * 0.2
		if _mining_saved >= 1.0:
			_mining_saved -= 1.0
			cost -= 1
	return cost


# Cooked meals: dishes from your kitchenette, and Jasper's French dishes (for Jasper & Evarra's Family Table).
func _cooked(item: String) -> bool:
	return not ShopData.cooking_for(item).is_empty() or ShopData.RECIPE_NAMES.has(item)


# ---------------------------------------------------------------- the shipping crate (Zachary, 23 Nov)
# The crate by your front door, as in Stardew Valley: put in anything that sells (ShopData.VALUE) and Bram collects
# it overnight. The crate pays full value, the most anything sells for (Zachary, 23 Nov: "shipping bin pays most");
# the day's recap shows it as "Shipped to Bram". Use the crate with something that sells picked on your hotbar to put
# that whole stack in, or with nothing that sells picked to ship everything you carry that sells.

# What everything you carry that sells is worth at the crate (worn clothes and armour stay on you).
func _bars_value() -> int:
	var total := 0
	for item in items:
		if ShopData.VALUE.has(item):
			total += (_count(str(item)) - shops._worn(str(item))) * ShopData.value(str(item))
	return total


func _shipping_value() -> int:
	var total := 0
	for item in shipping:
		total += int(shipping[item]) * ShopData.value(str(item))
	return total


func _shipping_crate() -> void:
	var held: String = slots[selected]
	if held != "" and ShopData.VALUE.has(held) and _count(held) > 0:
		_ship(held, _count(held))
		_toast("Shipped %d %s  (Bram pays %d cr in the morning)" % [int(shipping[held]), _item_name(held).to_lower(), _shipping_value()])
		return
	var lines: Array = ["Bram empties this crate overnight into his cargo pod, for the Moogli traders, and pays full value for whatever is in it."]
	if not shipping.is_empty():
		lines.append("In it so far: %d credits' worth." % _shipping_value())
	if _bars_value() > 0:
		lines.append("Put in everything you carry that sells? That's %d credits more." % _bars_value())
		_say("Shipping crate", lines, Callable(self, "_ship_all"), "Ship it all")
	else:
		lines.append("(Pick something that sells on your hotbar, then use the crate to put it in.)")
		_say("Shipping crate", lines)


func _ship(item: String, n: int) -> void:
	_give(item, -n)
	shipping[item] = int(shipping.get(item, 0)) + n
	sfx("ship_crate")


func _ship_all() -> void:
	for item in items.keys():
		var n: int = _count(str(item)) - shops._worn(str(item))
		if n > 0 and ShopData.VALUE.has(item):
			_ship(str(item), n)
	_toast("Shipped  (Bram pays %d cr in the morning)" % _shipping_value())


# Bram's overnight round: called as the day ends, so the money is on that day's recap.
func _collect_shipping() -> void:
	var value: int = _shipping_value()
	shipping = {}
	if value > 0:
		_money(value, "Shipped to Bram")


# The porch workbench: the Crafting page of the menu.
func _open_crafting() -> void:
	sfx("datapad_open")
	if datapad != null:
		datapad.open_page("Crafting")
	else:
		ui.show_menu(1)


# ---------------------------------------------------------------- station repairs (23 Nov)
# Zachary: the fish ponds dome is "broken and closed off untill you do the harbinger quest and then pay sara to fix
# it", and the storage dome is "also broken untill you pay sara with scrip and materials to reopen". The repairs
# and their prices are in scripts/station_repair.gd, which also draws the page you pay on. You pay; her drones work
# overnight; the sealed doors open and the wreckage is gone in the morning.

# "open" (repaired), "due" (paid for, opens tomorrow), "locked" (has to wait, e.g. for the Leviathan) or "ready".
func repair_state(id: String) -> String:
	if station_fixed.has(id):
		return "open"
	if station_due.has(id):
		return "due"
	var r: Dictionary = StationRepair.REPAIRS.get(id, {})
	var after: String = str(r.get("after", ""))
	if after != "" and not bool(get(after)):
		return "locked"
	return "ready"


func can_pay_repair(id: String) -> bool:
	var r: Dictionary = StationRepair.REPAIRS.get(id, {})
	return not r.is_empty() and repair_state(id) == "ready" and credits >= int(r["cost"]) and _has_all(r["needs"])


# The repairs page's Pay S.A.R.A.: takes the Scrip and materials and books her drones for tonight. Returns the
# status line.
func pay_station_repair(id: String) -> String:
	var r: Dictionary = StationRepair.REPAIRS.get(id, {})
	if r.is_empty():
		return ""
	match repair_state(id):
		"open":
			return "S.A.R.A.: \"That one is done.\""
		"due":
			return "S.A.R.A.: \"My drones are on it tonight.\""
		"locked":
			sfx("deny")
			return "S.A.R.A.: \"%s\"" % str(r.get("wait", "Not yet."))
	if not can_pay_repair(id):
		sfx("deny")
		return "S.A.R.A.: \"Not yet. I need everything on the list.\""
	_money(-int(r["cost"]), "Repairs: " + str(r["name"]).to_lower())
	var needs: Dictionary = r["needs"]
	for item in needs:
		_give(item, -int(needs[item]))
	station_due.append(id)
	sfx("repair_done")
	_save_game()
	return "S.A.R.A.: \"Thank you. My drones start tonight. It will be open in the morning.\""


# The night's work: what was paid for is repaired. Returns the ids repaired.
func _finish_repairs() -> Array:
	var done: Array = []
	for id in station_due:
		if not station_fixed.has(id):
			station_fixed.append(id)
			done.append(id)
	station_due.clear()
	_sync_station()
	return done


# Clears the wreckage out of the domes S.A.R.A. has repaired (the sealed doors open by themselves:
# _update_inner_doors asks _inner_locked).
func _sync_station() -> void:
	for i in range(wreck_props.size() - 1, -1, -1):
		var pair: Array = wreck_props[i]
		if not station_fixed.has(str(pair[1])):
			continue
		var sprite: Node = pair[0]
		for j in range(area_sprites.size() - 1, -1, -1):
			if area_sprites[j][0] == sprite:
				area_sprites.remove_at(j)
		sprite.queue_free()
		wreck_props.remove_at(i)


# A repair S.A.R.A. could start today, if she hasn't brought one up yet today.
func _repair_to_mention() -> String:
	for id in StationRepair.ORDER:
		if repair_state(str(id)) == "ready":
			return str(id)
	return ""


func _sara_repairs(id: String) -> void:
	repairs_said_day = day
	var r: Dictionary = StationRepair.REPAIRS[id]
	_say("Sara", [str(r["mention"])], Callable(repair_view, "open_at").bind(id), "Show me")


# F3 (editor and debug builds only): enough Scrip and materials for every station repair.
func _debug_repair_kit() -> void:
	for id in StationRepair.REPAIRS:
		var r: Dictionary = StationRepair.REPAIRS[id]
		_money(int(r["cost"]), "Debug: repairs")
		var needs: Dictionary = r["needs"]
		for item in needs:
			_give(item, int(needs[item]))
	# and what the Custodians you've found still need (24 Nov)
	for cid in custodians_found:
		for b in CustodianData.CUSTODIANS[cid]["bundles"]:
			if bundle_state(str(cid), str(b["id"])) != "open":
				continue
			for item in b["items"]:
				var key := "%s/%s/%s" % [cid, str(b["id"]), str(item)]
				var short: int = int(b["items"][item]) - int(relic_given.get(key, 0)) - _count(str(item))
				if short > 0:
					_give(str(item), short)
	_toast("Debug: Scrip and materials for every station repair and Custodian bundle.")


# ---------------------------------------------------------------- bulletin board
# One request is posted each day. Take it at the board, then bring the items to whoever asked.

func _board_request() -> Dictionary:
	var req: Dictionary = BOARD[(day - 1) % BOARD.size()]
	return req


func _read_board() -> void:
	var req: Dictionary = _board_request()
	var today: String = "Day %d, %s. Dinner in the mess hall at 6:00 pm, every day." % [day, WEEKDAYS[(day - 1) % 7]]
	if board_done_day == day:
		_say("Bulletin board", [today, "Nothing else is posted today."])
	elif board_taken_day == day:
		_say("Bulletin board", [today, "You took today's request: %s" % req["text"]])
	else:
		_say("Bulletin board", [today, req["text"], "Take this request?"], Callable(self, "_take_request"), "Take it")


func _take_request() -> void:
	board_taken_day = day
	sfx("click")
	_toast("Request taken. It comes down at the end of the day.")


func _board_delivery(who: String) -> bool:
	if board_taken_day != day or board_done_day == day:
		return false
	var req: Dictionary = _board_request()
	var asker: String = req["who"]
	var item: String = req["item"]
	var n: int = req["n"]
	var pay: int = req["pay"]
	if asker != who or _count(item) < n:
		return false
	_give(item, -n)
	_money(pay, "Requests")
	board_done_day = day
	_add_friendship(who, REQUEST_POINTS)
	sfx("quest")
	_toast("Request done  +%d cr, +%d friendship" % [pay, REQUEST_POINTS])
	var thanks: String = req["thanks"]
	_say(who, [thanks])
	return true


# What the player is working on, for the line under the clock.
func _objective() -> String:
	var parts := PackedStringArray()
	if job_quest == 1:
		parts.append("Job: iron ore %d/%d, copper ore %d/%d" % [_count("iron_ore"), JOB_IRON, _count("copper_ore"), JOB_COPPER])
	elif job_quest == 2:
		parts.append("Job: smelt a bar in ore processing (Engineering)")
	elif job_quest == 3:
		parts.append("Job: see Vzz'ket at the cavern gate")
	elif job_quest == 4 and tunnel_kills < TUNNEL_GOAL:
		parts.append("Job: clear the north tunnels, top of the main dig (%d/%d)" % [tunnel_kills, TUNNEL_GOAL])
	elif job_quest == 4:
		parts.append("Job: tell him the tunnels are clear")
	elif job_quest >= 5 and not caverns_open and mail_days.has("vzzket_caverns"):
		parts.append("Vzz'ket: meet him at the cavern gate")
	if board_taken_day == day and board_done_day != day:
		var req: Dictionary = _board_request()
		var item: String = req["item"]
		parts.append("Board: %d %s for %s" % [int(req["n"]), _item_name(item).to_lower(), req["who"]])
	return "   ".join(parts)


# ---------------------------------------------------------------- combat

func _spawn_enemies() -> void:
	for e in MapData.ENEMIES:
		var kind: String = e[0]
		var enemy_area: String = e[1]
		var en = EnemyScript.new()
		en.setup(self, kind, enemy_area, Vector2(int(e[2]) * TILE + 8, int(e[3]) * TILE + 12))
		en.visible = false
		actors.add_child(en)
		enemies.append(en)


func _reset_enemies() -> void:
	for en in enemies:
		en.reset()
		en.visible = en.area == current_area


# The spear stabs far and narrow; the sword swings near and wide.
func _swing_hits(kind: String) -> void:
	var dir: Vector2 = player.facing()
	var ppos: Vector2 = player.position
	var origin: Vector2 = ppos + Vector2(0, -8)
	var reach: float = 38.0 if kind == "spear" else 26.0
	var half_angle: float = 0.45 if kind == "spear" else 1.25
	for en in enemies:
		if not en.alive or en.area != current_area:
			continue
		var epos: Vector2 = en.position
		var v: Vector2 = epos + Vector2(0, -6) - origin
		if v.length() <= reach and absf(dir.angle_to(v)) <= half_angle:
			en.hurt(WEAPON_DAMAGE, dir)


func enemy_died(en) -> void:
	sfx("enemy_die", randf_range(0.9, 1.1))
	var drop: String = en.drop_item()
	var epos: Vector2 = en.position
	_give(drop, 1)
	_pop_item(drop, epos + Vector2(0, -8))
	if en.kind == "leviathan":
		_leviathan_slain()
	if en.area == "tunnels" and job_quest == 4:
		tunnel_kills += 1
		if tunnel_kills == TUNNEL_GOAL:
			sfx("quest")
			_toast("The tunnels are quieter. Tell Job.")


func hurt_player(amount: int, from: Vector2) -> void:
	if hurt_cd > 0.0 or dialogue.active or ui.open or (datapad != null and datapad.blocking()):
		return
	hurt_cd = 0.9
	amount = shops.damage_taken(amount)      # armour and the Anchor tonic can turn a bite aside
	if amount <= 0:
		sfx("click")
		player.flash()
		return
	hp -= amount
	sfx("hurt")
	var ppos: Vector2 = player.position
	player.knock((ppos - from).normalized() * 14.0)
	player.flash()
	if hp <= 0:
		_collapse()


# Out of health: you wake up in the medbay, two hours later and a little poorer.
func _collapse() -> void:
	sfx("pass_out")
	_clear_cavern()
	hp = _max_hp() / 2
	energy = maxi(energy, MAX_ENERGY / 4)
	var guardian: bool = _flag("perk_guardian_medic")       # Quill's 8: no charge for the stitches
	var lost: int = 0 if guardian else credits / 10
	_money(-(lost), "Dropped when you collapsed")
	minutes = minf(minutes + 120.0, DAY_END - 1.0)
	player.set_carrying(false)
	# You wake up in the medbay.
	var bed: Array = MapData.MEDBAY
	var bed_area: String = bed[0]
	_go_to(bed_area, Vector2i(int(bed[1]), int(bed[2])), false)
	_snap_residents()
	_reset_enemies()
	if persons.has("Maren"):
		persons["Maren"]["met"] = true
	if guardian:
		_say("Maren", [
			"[sad] Easy. Vzz'ket carried you in from the tunnels. You have been out for two hours.",
			"No charge. Quill has you on his list, and he looked in every ten minutes. He would like you to stop doing this.",
		])
		return
	_say("Maren", [
		"[sad] Easy. Vzz'ket carried you in from the tunnels. You have been out for two hours.",
		"[angry] I have taken %d credits for the stitches. Buy a medpack next time. It is cheaper than I am." % lost,
	])


# Drinks gulp, the medpack hisses, everything else crunches.
func _eat_sound(item: String) -> String:
	if item == "medpack":
		return "medpack"
	return "drink" if bool(ItemData.ITEMS.get(item, {}).get("drink", false)) else "eat"


func _eat(item: String) -> void:
	var info: Dictionary = ItemData.ITEMS[item]
	var gives_energy: int = int(info.get("energy", 0))
	if hp >= _max_hp() and (gives_energy == 0 or energy >= _max_energy()) and not ShopData.DRINK_EFFECTS.has(item):
		_toast("You're not hurt" if gives_energy == 0 else "You're not hungry")
		return
	_give(item, -1)
	var heal: int = int(info.get("heal", 5))
	if item == "medpack" and _flag("perk_advanced_med_stims"):
		heal *= 2                    # Maren's 8: she tops up your medpacks the old ship's way
	if _flag("perk_family_table") and _cooked(item):
		heal = int(ceil(heal * 1.25))                  # Jasper & Evarra's 10: cooked meals do a quarter more
		gives_energy = int(ceil(gives_energy * 1.25))
	hp = mini(_max_hp(), hp + heal)
	energy = mini(_max_energy(), energy + gives_energy)
	sfx(_eat_sound(item))
	# Food is eaten with the Stardew-style animation (player.play_eating); the medpack is held up instead.
	var animated := false
	if gives_energy > 0 and creator != null:
		animated = player.play_eating(appearance if not appearance.is_empty() else maker.defaults(), _held_item_picture(item))
	if not animated:
		player.show_tool(_item_icon(item))
	if bool(info.get("drink", false)):
		shops.start_drink(item)
	if item == "medpack":
		_toast("The medpack hisses. Everything stops hurting at once.")
	elif item == "ration":
		_toast("Ration pack six. It restores you, and that is all that can be said for it.")
	else:
		_toast("%s: %s" % [_item_name(item), str(info.get("desc", "")).get_slice(". ", 0).trim_suffix(".")])


# Meals and hand-picked crops use their inventory icon cropped to its painted pixels.
# Returning null for the ration selects its hand-drawn picture (player_eating/ration_6.png).
func _held_item_picture(item: String) -> Texture2D:
	if item == "ration":
		return null
	var size: int = items_tex.get_height()
	var icon: int = _item_icon(item)
	var img: Image = items_tex.get_image()
	if img.is_compressed():
		img.decompress()
	var used: Rect2i = img.get_region(Rect2i(icon * size, 0, size, size)).get_used_rect()
	if used.size.x <= 0 or used.size.y <= 0:
		used = Rect2i(0, 0, size, size)
	var pic := AtlasTexture.new()
	pic.atlas = items_tex
	pic.region = Rect2(icon * size + used.position.x, used.position.y, used.size.x, used.size.y)
	return pic


# ---------------------------------------------------------------- little effects

# An item's picture that floats up and fades (when you gain something).
func _pop_item(item: String, at: Vector2) -> void:
	var info: Dictionary = ItemData.ITEMS[item]
	var icon: int = info["icon"]
	var s := Sprite2D.new()
	s.texture = items_tex
	s.region_enabled = true
	var icon_size: float = items_tex.get_height()     # icons can be any size; shown 16 wide
	s.region_rect = Rect2(icon * icon_size, 0, icon_size, icon_size)
	s.scale = Vector2.ONE * (16.0 / icon_size)
	s.position = at
	top_fx.add_child(s)
	pops.append([s, 0.9, 18.0])


# A burst of light that fades (the furnace when you smelt).
func _flash(at: Vector2, color: Color, size: float) -> void:
	var s := Sprite2D.new()
	s.texture = glow_tex
	s.material = glow_mat
	s.modulate = color
	s.scale = Vector2(size, size)
	s.position = at
	top_fx.add_child(s)
	pops.append([s, 0.7, 0.0])


func _update_pops(delta: float) -> void:
	for i in range(pops.size() - 1, -1, -1):
		var entry: Array = pops[i]
		var s: Sprite2D = entry[0]
		var left: float = float(entry[1]) - delta
		entry[1] = left
		s.position.y -= float(entry[2]) * delta
		s.modulate.a = clampf(left / 0.4, 0.0, 1.0)
		if left <= 0.0:
			s.queue_free()
			pops.remove_at(i)


# ---------------------------------------------------------------- clicking on things

# The thing under the mouse pointer, if there is one.
func _thing_under_mouse():
	var at: Vector2 = get_global_mouse_position()
	for t in things:
		if not _usable(t):
			continue
		var pos: Vector2 = t["pos"]
		var radius: float = t["radius"]
		if radius >= 40.0:
			if at.distance_to(pos) <= radius * 0.6:
				return t
		elif absf(at.x - pos.x) <= 9.0 and at.y - pos.y >= -26.0 and at.y - pos.y <= 8.0:
			return t
	return null


func _in_reach(t: Dictionary) -> bool:
	var ppos: Vector2 = player.position
	var pos: Vector2 = t["pos"]
	var radius: float = t["radius"]
	return (ppos + Vector2(0, -4)).distance_to(pos) <= radius + 6.0


# Interact with what was clicked if it is close enough; otherwise with whatever is nearest.
func _interact_clicked() -> void:
	var t = _thing_under_mouse()
	if t == null:
		_interact_nearest()
	elif _in_reach(t):
		_interact(t)
	else:
		_toast("Too far away")


# ---------------------------------------------------------------- UI and clock

func _build_ui() -> void:
	var hud := CanvasLayer.new()
	hud.layer = 5
	hud.scale = Vector2.ONE * UI_SCALE
	add_child(hud)
	hud_clock = _hud_label(hud, Vector2(4, 2), Vector2(150, 12))
	hud_goal = _hud_label(hud, Vector2(156, 2), Vector2(160, 12))
	hud_goal.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	hud_zone = _hud_label(hud, Vector2(4, 166), Vector2(150, 12))
	hud_zone.add_theme_color_override("font_color", Color("9fdcff"))
	hud_toast = _hud_label(hud, Vector2(4, 14), Vector2(312, 12))
	hud_toast.add_theme_color_override("font_color", Color("ffd27f"))
	hud_quest = _hud_label(hud, Vector2(4, 26), Vector2(312, 12))
	hud_quest.add_theme_color_override("font_color", Color("b8f0b0"))
	hud_hint = _hud_label(hud, Vector2(4, 146), Vector2(312, 12))
	hud_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

	dialogue = DialogueScript.new()
	dialogue.world = self
	add_child(dialogue)
	cutscene = CutsceneScript.new()
	cutscene.world = self
	add_child(cutscene)
	cutscene.finished.connect(_on_cutscene_finished)

	var ui_layer := CanvasLayer.new()
	ui_layer.layer = 8
	ui_layer.scale = Vector2.ONE * UI_SCALE
	add_child(ui_layer)
	ui = UiScript.new()
	ui.world = self
	ui_layer.add_child(ui)

	# The Terran datapad (datapad/, 20 Nov) draws the HUD and the menu pages: health and energy, the clock and
	# scrip, the quick slots, Inventory, Crafting, NPC relations, Map, Quests and Settings. The old hotbar,
	# menu and day summary (scripts/ui.gd) are only used if the datapad folder is missing.
	var bridge = BridgeScript.new()
	add_child(bridge)
	if bridge.setup(self):
		datapad = bridge
		ui.visible = false
		hud_clock.visible = false            # the datapad's clock shows the time, date and scrip
		hud_toast.visible = false            # messages show on the datapad
		# Keep the zone, goal and [E] hint clear of the datapad's corner plates, item label and messages.
		hud_zone.position = Vector2(4, 33)
		hud_goal.position = Vector2(156, 33)
		hud_hint.position = Vector2(4, 120)
	else:
		bridge.queue_free()

	# The character screen, if the layered player art is installed (art/player/).
	maker = MakerScript.new()
	if maker.load_layers():
		# its own layer, drawn in the datapad style at the window's size (scripts/creator.gd)
		creator = CreatorScript.new()
		creator.world = self
		creator.maker = maker
		add_child(creator)


# Wipe the save and start again, on the character screen (F9, or Settings > New game on the title screen).
func _new_game() -> void:
	var empty := ConfigFile.new()
	empty.save(SAVE_PATH)
	get_tree().reload_current_scene()


func _open_wardrobe() -> void:
	creator.show_for(appearance if not appearance.is_empty() else maker.defaults(), false)


# Called by the character screen when the player is happy with their look.
func set_appearance(look: Dictionary) -> void:
	appearance = maker.tidy(look)
	player.set_sheet(maker.sheet(appearance), maker.action_sheet(appearance))
	_save_game()
	# A new game: the prologue plays once you have a face (scripts/story_scenes.gd "prologue", 24 Nov).
	if creator != null and creator.first_time and not events_seen.has("prologue") and cutscene != null:
		cutscene.play("prologue")


func _hud_label(parent: Node, pos: Vector2, size: Vector2) -> Label:
	var l := Label.new()
	l.position = pos
	l.size = size
	l.add_theme_font_size_override("font_size", 8)
	l.add_theme_color_override("font_outline_color", Color.BLACK)
	l.add_theme_constant_override("outline_size", 3)
	parent.add_child(l)
	return l


func _toast(msg: String) -> void:
	hud_toast.text = msg
	toast_time = 3.5
	if datapad != null:
		datapad.notify(msg)


func _process(delta: float) -> void:
	if music_director != null:
		music_director.update(delta)
	var paused: bool = (title != null and title.open) or (community_game != null and community_game.open) or (battle != null and battle.open) or (ship_map != null and ship_map.open) or (ship_event != null and ship_event.open) or (ship_store != null and ship_store.open) or dialogue.active or ui.open or ui.recap_open or (creator != null and creator.open) or (station_calendar != null and station_calendar.open) or (museum_view != null and museum_view.open) or (mail_view != null and mail_view.open) or (repair_view != null and repair_view.open) or (ship_upgrades != null and ship_upgrades.open) or (datapad != null and datapad.blocking()) or (cutscene != null and cutscene.running)
	if datapad != null:
		# The datapad leaves the keys alone while one of the game's own windows is open.
		datapad.sync((title != null and title.open) or dialogue.active or (creator != null and creator.open) or (community_game != null and community_game.open) or (battle != null and battle.open) or (ship_map != null and ship_map.open) or (ship_event != null and ship_event.open) or (ship_store != null and ship_store.open) or (station_calendar != null and station_calendar.open) or (museum_view != null and museum_view.open) or (mail_view != null and mail_view.open) or (repair_view != null and repair_view.open) or (ship_upgrades != null and ship_upgrades.open) or travelling or garden_busy or (cutscene != null and cutscene.running))
	player.frozen = paused or seated or travelling or garden_busy
	tint.color = _light_color()
	if not seasonal_props.is_empty():
		_apply_prop_season()
	_apply_portrait_season()
	var glow_a: float = PropFx.glow_strength(tint.color)
	for g in prop_glows:
		g.modulate.a = glow_a
	_animate()
	_update_pops(delta)
	_animate_props()
	_machines_tick()
	_update_cut(delta, paused or travelling or garden_busy)
	_update_inner_doors(delta)

	if not paused and not travelling and not garden_busy and current_area != _event_area:
		# Heart events are checked each time you arrive somewhere (Stardew-style).
		_event_area = current_area
		_check_heart_events()
		paused = cutscene != null and cutscene.running
	if not paused and not travelling and not garden_busy:
		shops.tick(delta)
		hotel.tick(delta)
		if _welcome_due():
			_welcome_visit()
		elif _custodians_due():
			cutscene.play("custodians_wake")
		elif _warden_due():
			cutscene.play("warden_found")
		elif _vision_due():
			cutscene.play("the_vision")
		minutes += delta / SECONDS_PER_GAME_MINUTE
		if minutes >= DAY_END:
			_pass_out()
		for r in residents:
			r.tick(delta, minutes)
		_sara_rest_tick()
		for en in enemies.duplicate():       # a bite can end the day and clear a cavern floor mid-loop
			en.tick(delta)
		hurt_cd = maxf(0.0, hurt_cd - delta)
		swing_cd = maxf(0.0, swing_cd - delta)

		# Lifts, the airlock and the mine ramp: step on the pad to travel.
		var here: Dictionary = warps[current_area]
		var tile: Vector2i = _player_tile()
		if here.has(tile) and not portals.has(_portal_key(current_area,tile)):
			var dest: Array = here[tile]
			var dest_area: String = dest[0]
			if dest_area == "tunnels" and weapon == "":
				# Not without a weapon: step back down.
				player.position += Vector2(0, 24)
				_toast("Job: \"Not up there bare-handed, cher. See Vzz'ket first.\"")
				sfx("deny")
			elif dest_area == "lake" and not (_flag("blast") or leviathan_slain):
				# The old flooded stair stays sealed until the Harbinger's blast opens the sea (24 Nov; it was the
				# Leviathan before): step back up.
				player.position += Vector2(0, -24)
				_toast("Sealed: the old stair to the flooded galleries. Rock and old water behind it. Something has to break first.")
				sfx("deny")
			else:
				_go_to(dest_area, Vector2i(int(dest[1]), int(dest[2])))
		_check_bed()

	var m := int(minutes)
	hud_clock.text = "Day %d   %s   %d cr" % [day, clock_text(m), credits]
	hud_zone.text = _zone_name()
	hud_quest.text = ""          # quests are in the journal now (J)

	var goal: String = "Ship %d/%d" % [repair_stage, REPAIRS.size()]
	hud_goal.text = goal

	if toast_time > 0.0:
		toast_time -= delta
		if toast_time <= 0.0:
			hud_toast.text = ""

	# No "[E] ..." prompt on screen (Zachary, 23 Nov): you right-click things to use them.
	hud_hint.text = ""


# The time as people say it: 12-hour clock, counted in ten-minute steps ("6:10 am").
func clock_text(total_minutes: int) -> String:
	var t: int = (total_minutes / 10) * 10
	var hour24: int = (t / 60) % 24
	var hour12: int = hour24 % 12
	if hour12 == 0:
		hour12 = 12
	return "%d:%02d %s" % [hour12, t % 60, "am" if hour24 < 12 else "pm"]


# Still up at 1:00 am: you pass out where you stand and wake in your own bed.
func _pass_out() -> void:
	sfx("pass_out")
	var lost: int = mini(credits / 10, 100)
	_money(-(lost), "Dropped when you passed out")
	_end_day()
	hp = _max_hp() / 2
	energy = MAX_ENERGY / 2
	var lines: Array = ["[sad] You were found asleep on your feet at one in the morning. Someone carried you to bed."]
	if lost > 0:
		lines.append("[angry] You dropped %d credits on the way. You start today tired. Be in bed before one." % lost)
	else:
		lines.append("You start today tired. Be in bed before one.")
	_say("Sara", lines)


# Every change to your credits goes through here, so the end-of-day recap can say where it came from.
func _money(amount: int, source: String) -> void:
	credits += amount
	ledger[source] = int(ledger.get(source, 0)) + amount


# The day is over (you slept, or passed out): show the recap, then start tomorrow.
func _end_day() -> void:
	sfx("sleep")
	_collect_shipping()
	hotel.night_pay()                  # Friday to Sunday nights: the hotel's guests pay (scripts/hotel.gd)
	var lines: Array = []
	var net := 0
	for source in ledger:
		var amount: int = ledger[source]
		if amount != 0:
			lines.append([source, amount])
			net += amount
	var talked := 0
	for who in persons:
		if persons[who]["talked_today"]:
			talked += 1
	var finished: int = day
	ledger = {}
	_next_day()
	if datapad != null:
		datapad.show_recap(finished, lines, net, credits, talked)
	else:
		ui.show_recap(finished, lines, net, credits, talked)


# What the Journal page shows: [title, [lines], finished?]
func journal() -> Array:
	var out: Array = []
	# getting off the moon
	if repair_stage < REPAIRS.size():
		var r: Dictionary = REPAIRS[repair_stage]
		var needs: Dictionary = r["needs"]
		out.append(["Get off this moon", [
			"Your ship is in the shuttle bay on the Engineering Level. Tikka can repair it.",
			"Repairs done: %d of %d.   Next: the %s." % [repair_stage, REPAIRS.size(), r["name"]],
			"She needs %d credits and %s." % [int(r["cost"]), _needs_text(needs)],
		], false])
	else:
		out.append(["Get off this moon", ["Tikka has finished your ship. It is ready when you are."], true])
		if flights == 0:
			out.append(["Take her out", ["Say your goodbyes, then launch from the booth in the Shuttle Bay, by the south-west wall."], false])
		else:
			out.append(["Take her out", ["You turned back for the Landing, and Ivan went down with his ship.",
				"Something was in his wreck: a stasis pod, and a man asleep inside it. He is in the Medbay."], true])
		if ship_hull < _hull_max():
			out.append(["Patch up the ship", ["Hull %d of %d. Freya can repair it for credits (and a hull plate if she's wrecked)." % [ship_hull, _hull_max()]], false])
	# Job's chain
	if job_quest == 0:
		out.append(["A hand in the mine", ["Job, the miner, could use some help. He is in the main dig, down the south lift and past Engineering."], false])
	elif job_quest == 1:
		out.append(["A hand in the mine", ["Mine ore for Job with the laser: select it and use it on a vein.",
			"Iron ore %d of %d.   Copper ore %d of %d." % [_count("iron_ore"), JOB_IRON, _count("copper_ore"), JOB_COPPER]], false])
	elif job_quest == 2:
		out.append(["A hand in the mine", ["Smelt a bar: hold ore and use a furnace in ore processing, on the Engineering Level."], false])
	elif job_quest == 3:
		out.append(["A hand in the mine", ["Job says to see Vzz'ket at the cavern gate, at the bottom of the mine, about a weapon."], false])
	elif job_quest == 4 and tunnel_kills < TUNNEL_GOAL:
		out.append(["Clear the north tunnels", ["Creatures are coming down from the tunnels above the main dig.",
			"Cleared: %d of %d." % [tunnel_kills, TUNNEL_GOAL]], false])
	elif job_quest == 4:
		out.append(["Clear the north tunnels", ["The tunnels are quiet. Tell Job."], false])
	else:
		out.append(["A hand in the mine", ["You mined, smelted and cleared the tunnels for Job."], true])
		if not caverns_open and not mail_days.has("vzzket_caverns"):
			out.append(["The caverns", ["Vzz'ket guards the gate under the mine. Job says he'll send word when he's ready to talk.",
				"Letters come with the morning post: check the message pad on your front porch."], false])
		elif not caverns_open:
			out.append(["The caverns", ["Vzz'ket wrote. He wants to see you at the cavern gate, at the bottom of the mine."], false])
		else:
			out.append(["The caverns", ["Vzz'ket opened the cavern gate for you. Every fifth floor has a lift stop."], true])
	out.append_array(hotel.journal())
	# today
	if board_taken_day == day and board_done_day != day:
		var req: Dictionary = _board_request()
		var item: String = req["item"]
		out.append(["Today's request", ["%s wants %d %s. Bring it to them today." % [req["who"], int(req["n"]), _item_name(item).to_lower()]], false])
	elif board_done_day == day:
		out.append(["Today's request", ["Done for today."], true])
	else:
		out.append(["Today's request", ["There is a new request on the bulletin board in the town square each day."], false])
	return out


func _next_day() -> void:
	_grow_crops()
	day += 1
	minutes = float(DAY_START)
	_run_sprinklers()
	player.set_carrying(false)
	shops.drink_left = 0.0             # a drink wears off overnight
	shops.drink = ""
	shops._apply_drink()
	hp = _max_hp()
	max_energy = _max_energy()
	energy = max_energy
	_clear_cavern()
	_reset_enemies()
	hotel.new_day()
	_reset_nodes()
	for who in persons:
		persons[who]["talked_today"] = false
		persons[who]["talks_today"] = 0
	var mended: Array = _custodian_rewards()
	_sync_forage()
	var post: int = _deliver_mail()
	var repaired: Array = _finish_repairs()
	_go_home()
	_snap_residents()
	# You wake at home: check its heart events again, as if you'd just arrived.
	_event_area = ""
	_save_game()
	_toast("Day %d  (saved)" % day + ("   You've got mail." if post > 0 else ""))
	if post > 0:
		sfx("mail_waiting")
	_morning_news()
	_sara_pings()
	for id in repaired:
		if StationRepair.REPAIRS.has(id):          # (an old save may have the storage dome, the Sovereign's now)
			_toast("S.A.R.A.: repairs finished overnight. %s: open." % str(StationRepair.REPAIRS[id]["name"]))
	for b in mended:
		_toast("Overnight, the Custodians mended it: %s" % str(b["reward"]))


# ---------------------------------------------------------------- mail
# Letters (scripts/mail_data.gd) come with the morning post and wait in your mailbox on the agri complex's front
# porch until you read them (scripts/mail_reader.gd); an envelope bobs over the box meanwhile (scripts/mail_flag.gd).

# Send a letter: it comes with the post `days` mornings from now. A letter only ever comes once.
func send_mail(id: String, days: int = 1) -> void:
	if not MailData.LETTERS.has(id) or mail_days.has(id) or mail_due.has(id):
		return
	mail_due[id] = day + maxi(days, 0)


# The morning post: every letter due by today goes in your mailbox. Returns how many came.
func _deliver_mail() -> int:
	for id in MailData.DATED:
		if not mail_days.has(id) and not mail_due.has(id):
			mail_due[id] = int(MailData.DATED[id])
	var came := 0
	for id in mail_due.keys():
		if int(mail_due[id]) > day:
			continue
		mail_due.erase(id)
		if MailData.LETTERS.has(id) and not mail_days.has(id):
			mail_days[id] = day
			mail_waiting.append(id)
			came += 1
	return came


func _check_mailbox() -> void:
	if mail_view.letters().is_empty():
		_say("Message pad", ["No mail yet. The post comes in the morning."])
		return
	mail_view.start()


# The reader calls this when a letter is on screen. The first time you open one with a gift in it (its "gift" in
# scripts/mail_data.gd), the gift goes in your pack: Quill's medpacks, Jasper's wheat seeds.
func read_letter(id: String) -> void:
	if not mail_waiting.has(id):
		return
	mail_waiting.erase(id)
	var letter: Dictionary = MailData.LETTERS.get(id, {})
	var gift: Dictionary = letter.get("gift", {})
	if gift.is_empty():
		return
	var got := PackedStringArray()
	for item in gift:
		_give(str(item), int(gift[item]))
		got.append("%s x%d" % [_item_name(str(item)), int(gift[item])])
	sfx("quest")
	_toast("In the envelope: " + ", ".join(got))


