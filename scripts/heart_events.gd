			["say", "Sara", ["[happy] I'll take that."], "S.A.R.A. (the sensors)"],
			["face", "Vzz'ket", "player"],
			["choose", [
				{"text": "Let her keep watch tonight. Get some sleep.", "friendship": 60, "steps": [
