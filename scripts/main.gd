# ---------------------------------------------------------------- items

func _count(item: String) -> int:
	return int(items.get(item, 0))


func count_of(item: String) -> int:
	return _count(item)


# Adds (or with a negative number, removes) items, and keeps the inventory slots in step.
func _give(item: String, n: int) -> void:
	items[item] = maxi(0, _count(item) + n)
	_sync_slots()


# Every item you hold sits in exactly one slot; items you run out of leave their slot.
func _sync_slots() -> void:
	while slots.size() < SLOT_COUNT:
		slots.append("")
	for i in slots.size():
		var held_item: String = slots[i]
		if held_item != "" and (_count(held_item) <= 0 or not ItemData.ITEMS.has(held_item) or slots.find(held_item) != i):
			slots[i] = ""
	for item in items:
		if _count(item) > 0 and ItemData.ITEMS.has(item) and not slots.has(item):
			var free: int = slots.find("")
			if free != -1:
				slots[free] = item


func swap_slots(a: int, b: int) -> void:
	var moved: String = slots[a]
	slots[a] = slots[b]
	slots[b] = moved


func _item_name(item: String) -> String:
	var info: Dictionary = ItemData.ITEMS[item]
	var item_name: String = info["name"]
	return item_name


func _has_all(needs: Dictionary) -> bool:
	for item in needs:
		if _count(item) < int(needs[item]):
			return false
	return true


func _needs_text(needs: Dictionary) -> String:
	var parts := PackedStringArray()
	for item in needs:
		parts.append("%d %s" % [int(needs[item]), _item_name(item).to_lower()])
	return " and ".join(parts)


# Called from the Crafting page of the menu.
func craft(index: int) -> bool:
	var recipe: Dictionary = ItemData.RECIPES[index]
	var needs: Dictionary = recipe["needs"]
	if not _has_all(needs):
		sfx("deny")
		return false
	for item in needs:
		_give(item, -int(needs[item]))
	var makes: String = recipe["makes"]
	_give(makes, int(recipe["n"]))
	sfx("quest", 1.3)
	return true


# ---------------------------------------------------------------- using the selected hotbar item (Space)

func _selected_use() -> String:
	var item: String = slots[selected]
	if item == "":
		return ""
	var info: Dictionary = ItemData.ITEMS[item]
	var use: String = info["use"]
	return use


func _nearest_of_kind(kind: String):
	var best = null
	var best_d := 99999.0
	var ppos: Vector2 = player.position
	var from: Vector2 = ppos + Vector2(0, -4)
	for t in things:
		if t["kind"] != kind or t["area"] != current_area:
			continue
		var pos: Vector2 = t["pos"]
		var radius: float = t["radius"]
		var d: float = from.distance_to(pos)
		if d <= radius and d < best_d:
			best = t
			best_d = d
	return best


func _use_tool() -> void:
	if player.eating:
		return
	var use: String = _selected_use()
	var item: String = slots[selected]
	if use == "mine":
		# Cut the vein under the mouse pointer if it is in reach, otherwise the nearest one.
		var vein = _thing_under_mouse()
		if vein == null or vein["kind"] != "ore" or not _in_reach(vein):
			vein = _nearest_of_kind("ore")
		if vein != null:
			_start_cut(vein)
		elif swing_cd <= 0.0:
			# Nothing in reach: the laser still fires, like a pickaxe swung at the ground (and costs the same).
			swing_cd = 0.4
			if not player.tool_action(_tool_art(item), "laser"):
				player.show_tool(_item_icon(item))
			sfx("zap", 0.7, -6.0)
			energy = maxi(0, energy - CUT_ENERGY)
	elif use == "weapon":
		if swing_cd > 0.0:
			return
		swing_cd = 0.32
		player.swing(item)
		sfx("swing", randf_range(0.9, 1.1))
		_swing_hits(item)
	elif use == "eat":
		_eat(item)
	elif use in ["hoe", "water", "plant"]:
		_farm_use(use, item)


# The tool art folder for an item (art/tools/<id>), for the hand animations. "" if it has none.
func _tool_art(item: String) -> String:
	return {"hoe": "hoe_basic", "watering_can": "watering_can_basic", "laser": "mining_laser_basic",
		"steel_laser": "mining_laser_steel"}.get(item, "")


func _item_icon(item: String) -> int:
	var info: Dictionary = ItemData.ITEMS[item]
	var icon: int = info["icon"]
	return icon


# ---------------------------------------------------------------- mining and smelting

func _start_cut(t: Dictionary) -> void:
	# Mining is held, like swinging a pickaxe: keep Space or the left button down on a vein or rock.
	if not _can_cut(t):
		return
	if cutting != t:
		cutting = t
		cut_time = 0.0
		cut_buzz = 0.0


func _can_cut(t: Dictionary) -> bool:
	var node: Dictionary = ore_nodes[int(t["node"])]
	if _count("laser") <= 0 and _count("steel_laser") <= 0:
		sfx("deny")
		_say("Ore vein", ["A seam of ore in solid rock. You would need a mining laser to cut it. Job might have a spare."])
		return false
	if _selected_use() != "mine":
		sfx("deny")
		_toast("Select the mining laser on your hotbar (number keys) first")
		return false
	if _laser_tier() < int(NEEDS_TIER.get(str(node["item"]), 1)):
		sfx("deny")
		_toast("Too hard for the basic laser. Steel would cut it: see the Crafting page.")
		return false
	if int(node["hits"]) <= 0:
		sfx("deny")
		_toast("Nothing left to cut here today" if node["item"] == "stone" else "Worked out for now")
		return false
	if energy < CUT_ENERGY:
		sfx("deny")
		_toast("Too tired to hold the laser steady. Eat something, or sleep.")
		return false
	return true


func _cut_seconds(item: String) -> float:
	return float(CUT_TIME.get(item, DEFAULT_CUT_TIME)) * float(TIER_SPEED.get(_laser_tier(), 1.0))


func _laser_tier() -> int:
	var item: String = slots[selected]
	if item == "" or _selected_use() != "mine":
		return 0
	return int(ItemData.ITEMS[item].get("tier", 1))


# Called every frame: carries on a held cut, or stops it if the button is let go or you walk away.
func _update_cut(delta: float, paused: bool) -> void:
	if cutting == null:
		cut_bar.visible = false
		return
	var held: bool = Input.is_action_pressed("use") or Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
	var t: Dictionary = cutting
	if paused or not held or _selected_use() != "mine" or t["area"] != current_area or not _in_reach(t):
		cutting = null
		cut_bar.visible = false
		return
	var node: Dictionary = ore_nodes[int(t["node"])]
	var need: float = _cut_seconds(node["item"])
	cut_time += delta
	cut_buzz -= delta
	player.fire_laser(t["pos"], _item_icon(slots[selected]), _tool_art(slots[selected]))
	if cut_buzz <= 0.0:
		sfx("zap", randf_range(0.85, 1.05), -8.0)
		cut_buzz = 0.35
	cut_bar.visible = true
	cut_bar.position = Vector2(t["pos"]) + Vector2(-8, -16)
	cut_bar.set_meta("f", clampf(cut_time / need, 0.0, 1.0))
	cut_bar.queue_redraw()
	if cut_time >= need:
		_mine(t)
		cut_time = 0.0
		# keep cutting while the button is held, if there is anything left and the energy for it
		if int(node["hits"]) <= 0 or energy < CUT_ENERGY:
			cutting = null
			cut_bar.visible = false


func _mine(t: Dictionary) -> void:
	var node: Dictionary = ore_nodes[int(t["node"])]
	var item: String = node["item"]
	node["hits"] = int(node["hits"]) - 1
	if int(node["hits"]) <= 0:
		var s: Sprite2D = node["sprite"]
		s.frame = 1
	_give(item, 1)
	energy = maxi(0, energy - CUT_ENERGY)
	if bool(node.get("cav", false)) and item == "stone" and int(node["hits"]) <= 0:
		cav_rocks_left -= 1
		_maybe_open_shaft(t, node)
	sfx("zap", randf_range(0.9, 1.1))
	var vein_pos: Vector2 = t["pos"]
	_pop_item(item, vein_pos + Vector2(0, -10))
	_toast("+1 %s  (%d)" % [_item_name(item), _count(item)])
	if energy < CUT_ENERGY:
		_toast("You're worn out. Eat something, or call it a day.")


# One ore vein or rock: its sprite, its tile blocked, and a thing to cut. Cavern ones (cav) go when you leave the floor.
func _add_node(item: String, node_area: String, tile: Vector2i, every: int, cav: bool) -> void:
	var vein := Sprite2D.new()
	vein.texture = load("res://art/%s.png" % item)
	vein.hframes = 2
	vein.centered = false
	_fit_sprite(vein, 2, 1, 16.0)
	vein.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 16)
	vein.visible = node_area == current_area
	actors.add_child(vein)
	area_sprites.append([vein, node_area])
	var here: Dictionary = blocked[node_area]
	here[tile] = true
	var fixed_here: Dictionary = fixed[node_area]
	fixed_here[tile] = true
	var index: int = ore_nodes.size()
	ore_nodes.append({"item": item, "hits": _node_hits(item), "sprite": vein, "every": every, "cav": cav, "tile": tile})
	things.append({
		"kind": "ore", "name": "Rock" if item == "stone" else _item_name(item), "hint": "Hold to cut %s" % ("rock" if item == "stone" else _item_name(item).to_lower()), "area": node_area,
		"pos": Vector2(tile.x * TILE + 8, tile.y * TILE + 8), "radius": 26.0, "who": "", "node": index, "cav": cav,
	})
	if cav:
		cav_sprites.append(vein)


func _node_hits(item: String) -> int:
	return 1 if item == "stone" else NODE_HITS     # a rock breaks in one cut; a vein gives NODE_HITS


func _reset_nodes() -> void:
	for node in ore_nodes:
		if day % maxi(1, int(node.get("every", 1))) != 0:
			continue
		node["hits"] = _node_hits(str(node["item"]))
		var s: Sprite2D = node["sprite"]
		s.frame = 0


func _smelt(ore: String, bar: String) -> void:
	if job_quest < 2:
		sfx("deny")
		_say("Furnace", ["The furnaces are cold. Job runs ore processing. Ask him about it."])
		return
	if _count(ore) < ORE_PER_BAR:
		sfx("deny")
		_say("Furnace", ["You need %d %s to pour a bar. You have %d." % [ORE_PER_BAR, _item_name(ore).to_lower(), _count(ore)]])
		return
	_say("Furnace", ["Smelt %d %s into 1 %s?" % [ORE_PER_BAR, _item_name(ore).to_lower(), _item_name(bar).to_lower()]],
			Callable(self, "_do_smelt").bind(ore, bar), "Smelt")


func _do_smelt(ore: String, bar: String) -> void:
	_give(ore, -ORE_PER_BAR)
	_give(bar, 1)
	minutes += 20.0
	sfx("smelt")
	_flash(smelt_pos + Vector2(0, 2), Color(1.0, 0.6, 0.25), 2.2)
	_pop_item(bar, smelt_pos + Vector2(0, -14))
	_toast("+1 %s  (%d)" % [_item_name(bar), _count(bar)])
	if job_quest == 2:
		job_quest = 3
		sfx("quest")


# ---------------------------------------------------------------- Job's quest and the weapon

func _job_quest_talk() -> void:
	if job_quest == 0:
		_say("Job", [
			"[happy] Say, you lookin' for work? I got more rock than I got hands.",
			"Take my spare laser. Cut me %d iron ore and %d copper ore out them veins, and I'll show you what we do with it." % [JOB_IRON, JOB_COPPER],
		], Callable(self, "_take_laser"), "Take the laser")
	elif job_quest == 1:
		if _count("iron_ore") >= JOB_IRON and _count("copper_ore") >= JOB_COPPER:
			job_quest = 2
			_money(40, "Job")
			sfx("quest")
			_toast("Job's request done  +40 cr")
			_say("Job", [
				"[happy] Well look at that. Clean cuts, too. Here, 40 credits, and you keep the ore, cher.",
				"Smelter's up in ore processing, engineering level, far left. Two ore pours one bar. Bram buys bars.",
				"Once you poured your first, go see Vzz'ket down at the gate. There's old tunnels north of here I want opened, and you ain't goin' in bare-handed.",
			])
		else:
			_say("Job", ["Iron's the red veins, copper's the green. You got %d of %d iron and %d of %d copper."
					% [_count("iron_ore"), JOB_IRON, _count("copper_ore"), JOB_COPPER]])
	elif job_quest == 4:
		if tunnel_kills >= TUNNEL_GOAL:
			job_quest = 5
			_money(80, "Job")
			sfx("quest")
			_toast("The north tunnels are open  +80 cr")
			_say("Job", [
				"[happy] I heard the ruckus clear down here. That's the tunnels safe enough to work. Here, 80 credits.",
				"Veins up there ain't been touched in years, and Bram'll buy them shells and hides off you.",
				"[sad] The caverns under the gate, now, that's another matter. Vzz'ket won't hear of it yet, and he's right.",
			])
		else:
			_say("Job", ["Way up's at the top of the dig, north wall. Thin them critters out some. You got %d of %d." % [tunnel_kills, TUNNEL_GOAL]])
	else:
		_say("Job", ["Smelter's in ore processing, engineering level, far left. Two ore, one bar. Then go see Vzz'ket at the gate."])


func _take_laser() -> void:
	_give("laser", 1)
	job_quest = 1
	sfx("quest")
	_toast("Got: mining laser")
	_say("Job", [
		"Point the bright end at the rock. Veins give out after a couple cuts, but they settle back by mornin'.",
		"(Pick the laser on your hotbar with the number keys, then press Space next to a vein.)",
	])


func _vzzket_weapon() -> void:
	_say("Vzz'ket", [
		"[angry] Job wants the north tunnels opened. Bugs and rock lizards. Small, but they bite. You will not go unarmed.",
		"These are old Zaa'sh arms. The spear stabs, far and narrow. The sword swings, near and wide. Choose.",
	], Callable(self, "_choose_weapon").bind("spear"), "Spear", Callable(self, "_choose_weapon").bind("sword"), "Sword")


func _choose_weapon(kind: String) -> void:
	weapon = kind
	_give(kind, 1)
	job_quest = 4
	sfx("quest")
	_toast("Got: Zaa'sh %s" % kind)
	_say("Vzz'ket", ["[sad] It was my clutch-brother's. Bring it back clean.",
			"The way up is at the top of the main dig. Clear out six of them, then tell Job.",
			"(Select it on your hotbar and press Space or click to swing. A ration pack from Jasper mends you.)"])


# ---------------------------------------------------------------- selling to Bram

func _bars_value() -> int:
	var total := 0
	for item in SELL:
		total += _count(item) * int(SELL[item])
	return total


func _bram_sell() -> void:
	_say("Bram", ["[happy] Now those I can move. %d bars, %d shells and hides. I'll give you %d credits for the lot."
			% [_count("iron_bar") + _count("copper_bar"), _count("chitin") + _count("hide"), _bars_value()]],
			Callable(self, "_do_sell"), "Sell all", Callable(self, "_bram_default"), "Keep them")


func _do_sell() -> void:
	var value: int = _bars_value()
	for item in SELL:
		items[item] = 0
	_sync_slots()
	_money(value, "Sold to Bram")
	sfx("coin")
	_toast("Sold  +%d cr" % value)


func _bram_default() -> void:
	if not job_done_today:
		_bram_job()
	else:
		_say("Bram", [_next_repeat("Bram")])


# ---------------------------------------------------------------- bulletin board
# One request is posted each day. Take it at the board, then bring the items to whoever asked.

func _board_request() -> Dictionary:
	var req: Dictionary = BOARD[(day - 1) % BOARD.size()]
	return req


func _read_board() -> void:
	var req: Dictionary = _board_request()
	var today: String = "Day %d, %s. Dinner in the mess hall at 6:00 pm, every day." % [day, WEEKDAYS[(day - 1) % 7]]
	if board_done_day == day:
		_say("Bulletin board", [today, "Nothing else is posted today."])
	elif board_taken_day == day:
		_say("Bulletin board", [today, "You took today's request: %s" % req["text"]])
	else:
		_say("Bulletin board", [today, req["text"], "Take this request?"], Callable(self, "_take_request"), "Take it")


func _take_request() -> void:
	board_taken_day = day
	sfx("click")
	_toast("Request taken. It comes down at the end of the day.")


func _board_delivery(who: String) -> bool:
	if board_taken_day != day or board_done_day == day:
		return false
	var req: Dictionary = _board_request()
	var asker: String = req["who"]
	var item: String = req["item"]
	var n: int = req["n"]
	var pay: int = req["pay"]
	if asker != who or _count(item) < n:
		return false
	_give(item, -n)
	_money(pay, "Requests")
	board_done_day = day
	var st: Dictionary = persons[who]
	st["friendship"] = int(st["friendship"]) + 2
	sfx("quest")
	_toast("Request done  +%d cr, +2 friendship" % pay)
	var thanks: String = req["thanks"]
	_say(who, [thanks])
	return true


# What the player is working on, for the line under the clock.
func _objective() -> String:
	var parts := PackedStringArray()
	if job_quest == 1:
		parts.append("Job: iron ore %d/%d, copper ore %d/%d" % [_count("iron_ore"), JOB_IRON, _count("copper_ore"), JOB_COPPER])
	elif job_quest == 2:
		parts.append("Job: smelt a bar in ore processing (Engineering)")
	elif job_quest == 3:
		parts.append("Job: see Vzz'ket at the cavern gate")
	elif job_quest == 4 and tunnel_kills < TUNNEL_GOAL:
		parts.append("Job: clear the north tunnels, top of the main dig (%d/%d)" % [tunnel_kills, TUNNEL_GOAL])
	elif job_quest == 4:
		parts.append("Job: tell him the tunnels are clear")
	if board_taken_day == day and board_done_day != day:
		var req: Dictionary = _board_request()
		var item: String = req["item"]
		parts.append("Board: %d %s for %s" % [int(req["n"]), _item_name(item).to_lower(), req["who"]])
	return "   ".join(parts)


# ---------------------------------------------------------------- combat

func _spawn_enemies() -> void:
	for e in MapData.ENEMIES:
		var kind: String = e[0]
		var enemy_area: String = e[1]
		var en = EnemyScript.new()
		en.setup(self, kind, enemy_area, Vector2(int(e[2]) * TILE + 8, int(e[3]) * TILE + 12))
		en.visible = false
		actors.add_child(en)
		enemies.append(en)


func _reset_enemies() -> void:
	for en in enemies:
		en.reset()
		en.visible = en.area == current_area


# The spear stabs far and narrow; the sword swings near and wide.
func _swing_hits(kind: String) -> void:
	var dir: Vector2 = player.facing()
	var ppos: Vector2 = player.position
	var origin: Vector2 = ppos + Vector2(0, -8)
	var reach: float = 38.0 if kind == "spear" else 26.0
	var half_angle: float = 0.45 if kind == "spear" else 1.25
	for en in enemies:
		if not en.alive or en.area != current_area:
			continue
		var epos: Vector2 = en.position
		var v: Vector2 = epos + Vector2(0, -6) - origin
		if v.length() <= reach and absf(dir.angle_to(v)) <= half_angle:
			en.hurt(WEAPON_DAMAGE, dir)


func enemy_died(en) -> void:
	sfx("die", randf_range(0.9, 1.1))
	var drop: String = en.drop_item()
	var epos: Vector2 = en.position
	_give(drop, 1)
	_pop_item(drop, epos + Vector2(0, -8))
	if en.kind == "harbinger":
		_harbinger_slain()
	if en.area == "tunnels" and job_quest == 4:
		tunnel_kills += 1
		if tunnel_kills == TUNNEL_GOAL:
			sfx("quest")
			_toast("The tunnels are quieter. Tell Job.")


func hurt_player(amount: int, from: Vector2) -> void:
	if hurt_cd > 0.0 or dialogue.active or ui.open or (datapad != null and datapad.blocking()):
		return
	hurt_cd = 0.9
	hp -= amount
	sfx("hurt")
	var ppos: Vector2 = player.position
	player.knock((ppos - from).normalized() * 14.0)
	player.flash()
	if hp <= 0:
		_collapse()


# Out of health: you wake up back in your quarters, two hours later and a little poorer.
func _collapse() -> void:
	_clear_cavern()
	hp = MAX_HP / 2
	energy = maxi(energy, MAX_ENERGY / 4)
	var lost: int = credits / 10
	_money(-(lost), "Dropped when you collapsed")
	minutes = minf(minutes + 120.0, DAY_END - 1.0)
	player.set_carrying(false)
	# You wake up in the medbay.
	var bed: Array = MapData.MEDBAY
	var bed_area: String = bed[0]
	_go_to(bed_area, Vector2i(int(bed[1]), int(bed[2])), false)
	_snap_residents()
	_reset_enemies()
	if persons.has("Maren"):
		persons["Maren"]["met"] = true
	_say("Maren", [
		"[sad] Easy. Vzz'ket carried you in from the tunnels. You have been out for two hours.",
		"[angry] I have taken %d credits for the stitches. Buy a medpack next time. It is cheaper than I am." % lost,
	])


func _eat(item: String) -> void:
	var info: Dictionary = ItemData.ITEMS[item]
	var gives_energy: int = int(info.get("energy", 0))
	if hp >= MAX_HP and (gives_energy == 0 or energy >= MAX_ENERGY):
		_toast("You're not hurt" if gives_energy == 0 else "You're not hungry")
		return
	_give(item, -1)
	hp = mini(MAX_HP, hp + int(info.get("heal", 5)))
	energy = mini(MAX_ENERGY, energy + gives_energy)
	sfx("eat")
	# The eating animation (player_eating/) needs the layered player art; the medpack is held up instead.
	var animated := false
	if gives_energy > 0 and creator != null:
		animated = player.play_eating(appearance if not appearance.is_empty() else maker.defaults(), _held_item_picture(item))
	if not animated:
		player.show_tool(_item_icon(item))
	if item == "medpack":
		_toast("The medpack hisses. Everything stops hurting at once.")
	else:
		_toast("Ration pack six. It restores you, and that is all that can be said for it.")


# Meals and hand-picked crops use their inventory icon cropped to its painted pixels.
# Returning null for the ration selects the eating scene's hand-drawn ration.
func _held_item_picture(item: String) -> Texture2D:
	if item == "ration":
		return null
	var size: int = items_tex.get_height()
	var icon: int = _item_icon(item)
	var img: Image = items_tex.get_image()
	if img.is_compressed():
		img.decompress()
	var used: Rect2i = img.get_region(Rect2i(icon * size, 0, size, size)).get_used_rect()
	if used.size.x <= 0 or used.size.y <= 0:
		used = Rect2i(0, 0, size, size)
	var pic := AtlasTexture.new()
	pic.atlas = items_tex
	pic.region = Rect2(icon * size + used.position.x, used.position.y, used.size.x, used.size.y)
	return pic


# ---------------------------------------------------------------- little effects

# An item's picture that floats up and fades (when you gain something).
func _pop_item(item: String, at: Vector2) -> void:
	var info: Dictionary = ItemData.ITEMS[item]
	var icon: int = info["icon"]
	var s := Sprite2D.new()
	s.texture = items_tex
	s.region_enabled = true
	var icon_size: float = items_tex.get_height()     # icons can be any size; shown 16 wide
	s.region_rect = Rect2(icon * icon_size, 0, icon_size, icon_size)
	s.scale = Vector2.ONE * (16.0 / icon_size)
	s.position = at
	top_fx.add_child(s)
	pops.append([s, 0.9, 18.0])


# A burst of light that fades (the furnace when you smelt).
func _flash(at: Vector2, color: Color, size: float) -> void:
	var s := Sprite2D.new()
	s.texture = glow_tex
	s.material = glow_mat
	s.modulate = color
	s.scale = Vector2(size, size)
	s.position = at
	top_fx.add_child(s)
	pops.append([s, 0.7, 0.0])


func _update_pops(delta: float) -> void:
	for i in range(pops.size() - 1, -1, -1):
		var entry: Array = pops[i]
		var s: Sprite2D = entry[0]
		var left: float = float(entry[1]) - delta
		entry[1] = left
		s.position.y -= float(entry[2]) * delta
		s.modulate.a = clampf(left / 0.4, 0.0, 1.0)
		if left <= 0.0:
			s.queue_free()
			pops.remove_at(i)


# ---------------------------------------------------------------- clicking on things

# The thing under the mouse pointer, if there is one.
func _thing_under_mouse():
	var at: Vector2 = get_global_mouse_position()
	for t in things:
		if not _usable(t):
			continue
		var pos: Vector2 = t["pos"]
		var radius: float = t["radius"]
		if radius >= 40.0:
			if at.distance_to(pos) <= radius * 0.6:
				return t
		elif absf(at.x - pos.x) <= 9.0 and at.y - pos.y >= -26.0 and at.y - pos.y <= 8.0:
			return t
	return null


func _in_reach(t: Dictionary) -> bool:
	var ppos: Vector2 = player.position
	var pos: Vector2 = t["pos"]
	var radius: float = t["radius"]
	return (ppos + Vector2(0, -4)).distance_to(pos) <= radius + 6.0


# Interact with what was clicked if it is close enough; otherwise with whatever is nearest.
func _interact_clicked() -> void:
	var t = _thing_under_mouse()
	if t == null:
		_interact_nearest()
	elif _in_reach(t):
		_interact(t)
	else:
		_toast("Too far away")


# ---------------------------------------------------------------- UI and clock

func _build_ui() -> void:
	var hud := CanvasLayer.new()
	hud.layer = 5
	hud.scale = Vector2.ONE * UI_SCALE
	add_child(hud)
	hud_clock = _hud_label(hud, Vector2(4, 2), Vector2(150, 12))
	hud_goal = _hud_label(hud, Vector2(156, 2), Vector2(160, 12))
	hud_goal.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	hud_zone = _hud_label(hud, Vector2(4, 166), Vector2(150, 12))
	hud_zone.add_theme_color_override("font_color", Color("9fdcff"))
	hud_toast = _hud_label(hud, Vector2(4, 14), Vector2(312, 12))
	hud_toast.add_theme_color_override("font_color", Color("ffd27f"))
	hud_quest = _hud_label(hud, Vector2(4, 26), Vector2(312, 12))
	hud_quest.add_theme_color_override("font_color", Color("b8f0b0"))
	hud_hint = _hud_label(hud, Vector2(4, 146), Vector2(312, 12))
	hud_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

	dialogue = DialogueScript.new()
	add_child(dialogue)

	var ui_layer := CanvasLayer.new()
	ui_layer.layer = 8
	ui_layer.scale = Vector2.ONE * UI_SCALE
	add_child(ui_layer)
	ui = UiScript.new()
	ui.world = self
	ui_layer.add_child(ui)

	# The Terran datapad (datapad/, 20 Nov) draws the HUD and the menu pages: health and energy, the clock and
	# scrip, the quick slots, Inventory, Crafting, NPC relations, Map, Quests and Settings. The old hotbar,
	# menu and day summary (scripts/ui.gd) are only used if the datapad folder is missing.
	var bridge = BridgeScript.new()
	add_child(bridge)
	if bridge.setup(self):
		datapad = bridge
		ui.visible = false
		hud_clock.visible = false            # the datapad's clock shows the time, date and scrip
		hud_toast.visible = false            # messages show on the datapad
		# Keep the zone, goal and [E] hint clear of the datapad's corner plates, item label and messages.
		hud_zone.position = Vector2(4, 33)
		hud_goal.position = Vector2(156, 33)
		hud_hint.position = Vector2(4, 120)
	else:
		bridge.queue_free()

	# The character screen, if the layered player art is installed (art/player/).
	maker = MakerScript.new()
	if maker.load_layers():
		var top_layer := CanvasLayer.new()
		top_layer.layer = 12
		top_layer.scale = Vector2.ONE * UI_SCALE
		add_child(top_layer)
		creator = CreatorScript.new()
		creator.world = self
		creator.maker = maker
		top_layer.add_child(creator)


# Wipe the save and start again, on the character screen (F9, or Settings > New game on the title screen).
func _new_game() -> void:
	var empty := ConfigFile.new()
	empty.save(SAVE_PATH)
	get_tree().reload_current_scene()


func _open_wardrobe() -> void:
	creator.show_for(appearance if not appearance.is_empty() else maker.defaults(), false)


# Called by the character screen when the player is happy with their look.
func set_appearance(look: Dictionary) -> void:
	appearance = maker.tidy(look)
	player.set_sheet(maker.sheet(appearance), maker.action_sheet(appearance))
	_save_game()


func _hud_label(parent: Node, pos: Vector2, size: Vector2) -> Label:
	var l := Label.new()
	l.position = pos
	l.size = size
	l.add_theme_font_size_override("font_size", 8)
	l.add_theme_color_override("font_outline_color", Color.BLACK)
	l.add_theme_constant_override("outline_size", 3)
	parent.add_child(l)
	return l


func _toast(msg: String) -> void:
	hud_toast.text = msg
	toast_time = 3.5
	if datapad != null:
		datapad.notify(msg)


func _process(delta: float) -> void:
	if music_director != null:
		music_director.update(delta)
	var paused: bool = (title != null and title.open) or (community_game != null and community_game.open) or (battle != null and battle.open) or (ship_map != null and ship_map.open) or (ship_event != null and ship_event.open) or (ship_store != null and ship_store.open) or dialogue.active or ui.open or ui.recap_open or (creator != null and creator.open) or (station_calendar != null and station_calendar.open) or (datapad != null and datapad.blocking())
	if datapad != null:
		# The datapad leaves the keys alone while one of the game's own windows is open.
		datapad.sync((title != null and title.open) or dialogue.active or (creator != null and creator.open) or (community_game != null and community_game.open) or (battle != null and battle.open) or (ship_map != null and ship_map.open) or (ship_event != null and ship_event.open) or (ship_store != null and ship_store.open) or (station_calendar != null and station_calendar.open) or travelling or garden_busy)
	player.frozen = paused or seated or travelling or garden_busy
	tint.color = _light_color()
	if not seasonal_props.is_empty():
		_apply_prop_season()
	var glow_a: float = PropFx.glow_strength(tint.color)
	for g in prop_glows:
		g.modulate.a = glow_a
	_animate()
	_update_pops(delta)
	_animate_props()
	_update_cut(delta, paused or travelling or garden_busy)
	_update_inner_doors(delta)

	if not paused and not travelling and not garden_busy:
		minutes += delta / SECONDS_PER_GAME_MINUTE
		if minutes >= DAY_END:
			_pass_out()
		for r in residents:
			r.tick(delta, minutes)
		for en in enemies.duplicate():       # a bite can end the day and clear a cavern floor mid-loop
			en.tick(delta)
		hurt_cd = maxf(0.0, hurt_cd - delta)
		swing_cd = maxf(0.0, swing_cd - delta)

		# Lifts, the airlock and the mine ramp: step on the pad to travel.
		var here: Dictionary = warps[current_area]
		var tile: Vector2i = _player_tile()
		if here.has(tile) and not portals.has(_portal_key(current_area,tile)):
			var dest: Array = here[tile]
			var dest_area: String = dest[0]
			if dest_area == "tunnels" and weapon == "":
				# Not without a weapon: step back down.
				player.position += Vector2(0, 24)
				_toast("Job: \"Not up there bare-handed, cher. See Vzz'ket first.\"")
				sfx("deny")
			elif dest_area == "lake" and not harbinger_slain:
				# The old flooded stair stays sealed until the Harbinger is dead: step back up.
				player.position += Vector2(0, -24)
				_toast("Sealed — the old stair to the flooded galleries. Not while the Harbinger lives.")
				sfx("deny")
			else:
				_go_to(dest_area, Vector2i(int(dest[1]), int(dest[2])))

	var m := int(minutes)
	hud_clock.text = "Day %d   %s   %d cr" % [day, clock_text(m), credits]
	hud_zone.text = _zone_name()
	hud_quest.text = ""          # quests are in the journal now (J)

	var goal: String = "Ship %d/%d" % [repair_stage, REPAIRS.size()]
	if job_active:
		goal = "Crates %d/%d   %s" % [job_delivered, JOB_CRATES, goal]
	hud_goal.text = goal

	if toast_time > 0.0:
		toast_time -= delta
		if toast_time <= 0.0:
			hud_toast.text = ""

	var t = null
	if not paused:
		t = _nearest_thing()
	if t != null:
		hud_hint.text = "[E]  %s" % t["hint"]
	else:
		hud_hint.text = ""


# The time as people say it: 12-hour clock, counted in ten-minute steps ("6:10 am").
func clock_text(total_minutes: int) -> String:
	var t: int = (total_minutes / 10) * 10
	var hour24: int = (t / 60) % 24
	var hour12: int = hour24 % 12
	if hour12 == 0:
		hour12 = 12
	return "%d:%02d %s" % [hour12, t % 60, "am" if hour24 < 12 else "pm"]


# Still up at 1:00 am: you pass out where you stand and wake in your own bed.
func _pass_out() -> void:
	var lost: int = mini(credits / 10, 100)
	_money(-(lost), "Dropped when you passed out")
	_end_day()
	hp = MAX_HP / 2
	energy = MAX_ENERGY / 2
	var lines: Array = ["[sad] You were found asleep on your feet at one in the morning. Someone carried you to bed."]
	if lost > 0:
		lines.append("[angry] You dropped %d credits on the way. You start today tired. Be in bed before one." % lost)
	else:
		lines.append("You start today tired. Be in bed before one.")
	_say("Sara", lines)


# Every change to your credits goes through here, so the end-of-day recap can say where it came from.
func _money(amount: int, source: String) -> void:
	credits += amount
	ledger[source] = int(ledger.get(source, 0)) + amount


# The day is over (you slept, or passed out): show the recap, then start tomorrow.
func _end_day() -> void:
	var lines: Array = []
	var net := 0
	for source in ledger:
		var amount: int = ledger[source]
		if amount != 0:
			lines.append([source, amount])
			net += amount
	var talked := 0
	for who in persons:
		if persons[who]["talked_today"]:
			talked += 1
	var finished: int = day
	ledger = {}
	_next_day()
	if datapad != null:
		datapad.show_recap(finished, lines, net, credits, talked)
	else:
		ui.show_recap(finished, lines, net, credits, talked)


# What the Journal page shows: [title, [lines], finished?]
func journal() -> Array:
	var out: Array = []
	# getting off the moon
	if repair_stage < REPAIRS.size():
		var r: Dictionary = REPAIRS[repair_stage]
		var needs: Dictionary = r["needs"]
		out.append(["Get off this moon", [
			"Your ship is in the shuttle bay on the Engineering Level. Tikka can repair it.",
			"Repairs done: %d of %d.   Next: the %s." % [repair_stage, REPAIRS.size(), r["name"]],
			"She needs %d credits and %s." % [int(r["cost"]), _needs_text(needs)],
		], false])
	else:
		out.append(["Get off this moon", ["Tikka has finished your ship. It is ready when you are."], true])
		if flights == 0:
			out.append(["Take her out", ["Say your goodbyes, then launch from the booth in the Shuttle Bay, by the south-west wall."], false])
		else:
			out.append(["Take her out", ["You turned back for the Landing, and Ivan went down with his ship.",
				"Something was in his wreck: a stasis pod, and a man asleep inside it. He is in the Medbay."], true])
		if ship_hull < int(ShipData.STARTER["hull"]):
			out.append(["Patch up the ship", ["Hull %d of %d. Freya can repair it for credits (and a hull plate if she's wrecked)." % [ship_hull, int(ShipData.STARTER["hull"])]], false])
	# Job's chain
	if job_quest == 0:
		out.append(["A hand in the mine", ["Job, the miner, could use some help. He is in the main dig, down the south lift and past Engineering."], false])
	elif job_quest == 1:
		out.append(["A hand in the mine", ["Mine ore for Job with the laser: select it and use it on a vein.",
			"Iron ore %d of %d.   Copper ore %d of %d." % [_count("iron_ore"), JOB_IRON, _count("copper_ore"), JOB_COPPER]], false])
	elif job_quest == 2:
		out.append(["A hand in the mine", ["Smelt a bar: hold ore and use a furnace in ore processing, on the Engineering Level."], false])
	elif job_quest == 3:
		out.append(["A hand in the mine", ["Job says to see Vzz'ket at the cavern gate, at the bottom of the mine, about a weapon."], false])
	elif job_quest == 4 and tunnel_kills < TUNNEL_GOAL:
		out.append(["Clear the north tunnels", ["Creatures are coming down from the tunnels above the main dig.",
			"Cleared: %d of %d." % [tunnel_kills, TUNNEL_GOAL]], false])
	elif job_quest == 4:
		out.append(["Clear the north tunnels", ["The tunnels are quiet. Tell Job."], false])
	else:
		out.append(["A hand in the mine", ["You mined, smelted and cleared the tunnels for Job."], true])
	# today
	if board_taken_day == day and board_done_day != day:
		var req: Dictionary = _board_request()
		var item: String = req["item"]
		out.append(["Today's request", ["%s wants %d %s. Bring it to them today." % [req["who"], int(req["n"]), _item_name(item).to_lower()]], false])
	elif board_done_day == day:
		out.append(["Today's request", ["Done for today."], true])
	else:
		out.append(["Today's request", ["There is a new request on the bulletin board in the town square each day."], false])
	if job_active:
		out.append(["Bram's crates", ["Carry crates from the fabrication shop to the yellow pad in the cargo bay. %d of %d delivered." % [job_delivered, JOB_CRATES]], false])
	elif job_done_today:
		out.append(["Bram's crates", ["Done for today."], true])
	else:
		out.append(["Bram's crates", ["Bram pays for hauling, once a day. Ask him at Bram's Sundries."], false])
	return out


func _next_day() -> void:
	_grow_crops()
	day += 1
	minutes = float(DAY_START)
	job_active = false
	job_delivered = 0
	job_done_today = false
	player.set_carrying(false)
	hp = MAX_HP
	energy = MAX_ENERGY
	_clear_cavern()
	_reset_enemies()
	_reset_nodes()
	for who in persons:
		persons[who]["talked_today"] = false
	_go_home()
	_snap_residents()
	_save_game()
	_toast("Day %d  (saved)" % day)
	_morning_news()


# ---------------------------------------------------------------- saving
# The game saves each morning. F9 wipes the save.

func _save_game() -> void:
	var cfg := ConfigFile.new()
	cfg.set_value("game", "day", day)
	cfg.set_value("game", "credits", credits)
	cfg.set_value("game", "repair_stage", repair_stage)
	cfg.set_value("game", "items", items)
	cfg.set_value("game", "slots", slots)
	cfg.set_value("game", "selected", selected)
	cfg.set_value("game", "weapon", weapon)
	cfg.set_value("game", "job_quest", job_quest)
	cfg.set_value("game", "tunnel_kills", tunnel_kills)
	cfg.set_value("game", "cav_lift", cav_lift)
	cfg.set_value("game", "cav_deepest", cav_deepest)
	cfg.set_value("game", "harbinger_slain", harbinger_slain)
	cfg.set_value("game", "board_taken_day", board_taken_day)
	cfg.set_value("game", "board_done_day", board_done_day)
	if not appearance.is_empty():
		cfg.set_value("game", "appearance", appearance)
	for who in persons:
		var st: Dictionary = persons[who]
		var section: String = "npc_%s" % st["id"]
		cfg.set_value(section, "met", st["met"])
		cfg.set_value(section, "friendship", st["friendship"])
		cfg.set_value(section, "next", st["next"])
	cfg.set_value("access", "garden_watered_day", garden_watered_day)
	cfg.set_value("farm", "tiles", farm)
	cfg.set_value("farm", "seeds_taken_day", seeds_taken_day)
	cfg.set_value("access", "doors", door_locks)
	cfg.set_value("ship", "hull", ship_hull)
	cfg.set_value("ship", "flights", flights)
	cfg.set_value("ship", "artie_found_day", artie_found_day)
	cfg.set_value("ship", "fuel", fuel)
	cfg.set_value("ship", "missiles", missiles)
	cfg.set_value("ship", "drone_parts", drone_parts)
	cfg.set_value("ship", "weapons", ship_weapons)
	cfg.set_value("ship", "said_goodbye", said_goodbye)
	cfg.set_value("ship", "ana_found_day", ana_found_day)
	cfg.save(SAVE_PATH)


func _load_game() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SAVE_PATH) != OK:
		return
	day = int(cfg.get_value("game", "day", 1))
	credits = int(cfg.get_value("game", "credits", 0))
	repair_stage = clampi(int(cfg.get_value("game", "repair_stage", 0)), 0, REPAIRS.size())
	var saved_items = cfg.get_value("game", "items", {})
	if saved_items is Dictionary:
		items = saved_items
	weapon = str(cfg.get_value("game", "weapon", ""))
	# Saves from before the hotbar kept the laser and weapon as flags; turn them into items.
	if bool(cfg.get_value("game", "has_laser", false)):
		items["laser"] = 1
	if weapon != "":
		items[weapon] = 1
	var saved_slots = cfg.get_value("game", "slots", [])
	if saved_slots is Array:
		slots = saved_slots
	selected = clampi(int(cfg.get_value("game", "selected", 0)), 0, 7)
	_sync_slots()
	job_quest = int(cfg.get_value("game", "job_quest", 0))
	tunnel_kills = int(cfg.get_value("game", "tunnel_kills", 0))
	cav_lift = int(cfg.get_value("game", "cav_lift", 0))
	cav_deepest = int(cfg.get_value("game", "cav_deepest", 0))
	harbinger_slain = bool(cfg.get_value("game", "harbinger_slain", false))
	board_taken_day = int(cfg.get_value("game", "board_taken_day", 0))
	board_done_day = int(cfg.get_value("game", "board_done_day", 0))
	var saved_look = cfg.get_value("game", "appearance", {})
	if saved_look is Dictionary and not saved_look.is_empty() and maker != null:
		appearance = maker.tidy(saved_look)
	for who in persons:
		var st: Dictionary = persons[who]
		var section: String = "npc_%s" % st["id"]
		st["met"] = bool(cfg.get_value(section, "met", false))
		st["friendship"] = int(cfg.get_value(section, "friendship", 0))
		st["next"] = int(cfg.get_value(section, "next", 0))

	garden_watered_day = int(cfg.get_value("access", "garden_watered_day", -1))
	var saved_farm = cfg.get_value("farm", "tiles", {})
	if saved_farm is Dictionary:
		farm = saved_farm
	seeds_taken_day = int(cfg.get_value("farm", "seeds_taken_day", -1))
	ship_hull = clampi(int(cfg.get_value("ship", "hull", int(ShipData.STARTER["hull"]))), 0, int(ShipData.STARTER["hull"]))
	flights = int(cfg.get_value("ship", "flights", 0))
	artie_found_day = int(cfg.get_value("ship", "artie_found_day", -1))
	fuel = int(cfg.get_value("ship", "fuel", 6))
	missiles = int(cfg.get_value("ship", "missiles", 0))
	drone_parts = int(cfg.get_value("ship", "drone_parts", 0))
	var saved_weapons = cfg.get_value("ship", "weapons", ["burst_laser", ""])
	if saved_weapons is Array and saved_weapons.size() == ShipData.STARTER["weapons"].size():
		ship_weapons = saved_weapons
	said_goodbye = bool(cfg.get_value("ship", "said_goodbye", false))
	ana_found_day = int(cfg.get_value("ship", "ana_found_day", -1))
	if farm_view != null: farm_view.sync_crops()
	var saved_locks = cfg.get_value("access", "doors", {})
	if saved_locks is Dictionary:
		for key in saved_locks:
			door_locks[key] = bool(saved_locks[key])
			if portals.has(key): portals[key].locked = bool(saved_locks[key])


# Frontages and landmarks are separate sprites, not painted into giant roof tiles.
func _spawn_concourse() -> void:
	var fountain = preload("res://scripts/lunar_fountain.gd").new()
	fountain.name = "LayeredFountain"
	fountain.position = Vector2(1848,1528)
	fountain.visible = false
	actors.add_child(fountain)
	area_sprites.append([fountain,"main"])
	var window = preload("res://scripts/lunar_observatory.gd").new()
	window.position = Vector2(47*16,75*16)
	window.visible = false
	actors.add_child(window)
	area_sprites.append([window,"main"])
	for p in MapData.ROOF_PROPS:
		var roof_sprite := Sprite2D.new()
		roof_sprite.texture = load("res://art/lunar/%s.png" % p[0])
		roof_sprite.centered = false
		roof_sprite.scale = Vector2.ONE*ART
		roof_sprite.position = Vector2(p[1]*16+(p[3]*16-roof_sprite.texture.get_width()*ART)*0.5,(p[2]+p[4])*16-16)
		roof_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		roof_sprite.offset = Vector2(0,-roof_sprite.texture.get_height())
		roof_sprite.visible = false
		actors.add_child(roof_sprite)
		area_sprites.append([roof_sprite,"main"])
	for e in MapData.ENTRANCES:
		var facade: Array = []
		if e[0] == "main":
			for f in MapData.CONCOURSE_FRONTS:
				if f[1] == e[1] and f[2] == e[2]: facade = f; break
		var door = preload("res://scripts/lunar_portal.gd").new()
		door.setup(e,facade)
		door.visible = false
		actors.add_child(door)
		area_sprites.append([door,e[0]])
		if false and door.facing != "S":   # wayfinding squares by side doors read as glitches (Zachary, 17 Nov); off until there is real art
			var marker = preload("res://scripts/lunar_marker.gd").new()
			marker.setup(e,facade)
			marker.position += Vector2(0,-40) if door.facing == "N" else Vector2(-24 if door.facing == "W" else 24,-8)
			marker.visible = false
			ground_fx.add_child(marker)
			area_sprites.append([marker,e[0]])
		var key := _portal_key(e[0],Vector2i(e[1],e[2]))
		portals[key] = door
		door_locks[key] = bool(e[8])
		things.append({"kind":"portal","name":e[7],"hint":"Right-click to open" if door.kind != "lift" else "Right-click to ride", "area":e[0],"pos":Vector2(e[1]*16+8,e[2]*16+8),"radius":44.0,"who":"","entry":e,"key":key})
	for e in MapData.INNER_DOORS:
		var inner = preload("res://scripts/inner_door.gd").new()
		inner.setup(e)
		inner.visible = false
		actors.add_child(inner)
		area_sprites.append([inner,e[0]])
		inner_doors.append(inner)
	for p in MapData.CONCOURSE_PROPS:
		_spawn_prop(p,"main")
	# Other levels drawn in the promenade style (the Survey Level, ...): their props and roof machinery.
	for area_name in MapData.AREA_PROPS:
		for p in MapData.AREA_PROPS[area_name]:
			_spawn_prop(p,area_name)
	# What the museum's cases hold (Tar'Besh's own pieces to start with); donations add more with show_exhibit().
	for i in MapData.MUSEUM_SLOTS.size():
		var slot: Array = MapData.MUSEUM_SLOTS[i]
		if slot.size() > 4 and str(slot[4]) != "":
			show_exhibit(i, str(slot[4]))
	for area_name in MapData.AREA_ROOF_PROPS:
		for p in MapData.AREA_ROOF_PROPS[area_name]:
			var roof_sprite := Sprite2D.new()
			roof_sprite.texture = load("res://art/lunar/%s.png" % p[0])
			roof_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			roof_sprite.centered = false
			roof_sprite.scale = Vector2.ONE*ART
			roof_sprite.position = Vector2(p[1]*16+(p[3]*16-roof_sprite.texture.get_width()*ART)*0.5,(p[2]+p[4])*16-16)
			roof_sprite.offset = Vector2(0,-roof_sprite.texture.get_height())
			roof_sprite.visible = false
			actors.add_child(roof_sprite)
			area_sprites.append([roof_sprite,area_name])

# One prop picture ([name, x, y, w, h, title] in tiles), standing on the bottom of its tiles.
func _spawn_prop(p: Array, area_name: String) -> void:
	var sprite: Sprite2D = preload("res://scripts/lunar_terminal.gd").new() if p[0] == "terminal" else Sprite2D.new()
	if p[0] == "terminal": sprite.title = p[5]
	sprite.texture = load("res://art/lunar/%s.png" % p[0])
	var fw: int = sprite.texture.get_width()
	# Machinery with a looping strip (same size frames side by side) animates; the frame count is the
	# strip's width over the still picture's width, so no list is needed.
	var strip_path := "res://art/lunar/anim/%s.png" % p[0]
	if ResourceLoader.exists(strip_path):
		var strip: Texture2D = load(strip_path)
		var frames: int = maxi(1, int(round(float(strip.get_width()) / float(fw))))
		sprite.texture = strip
		sprite.hframes = frames
		anim_props.append([sprite, frames, randf() * frames])
	sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	sprite.centered = false
	if p[0] == "game_chair" and "left" in p[5]: sprite.flip_h = true
	# Art on the 24-pixel grid, shown at two-thirds (see ART). Never stretch X/Y.
	sprite.scale = Vector2.ONE * ART
	sprite.offset = Vector2(0,-sprite.texture.get_height())
	# Centred on its tiles and standing on its bottom edge.
	sprite.position = Vector2(p[1]*16+(p[3]*16-fw*ART)*0.5,(p[2]+p[4])*16)
	if p[0] == "game_chair" or p[0] == "bar_stool" or p[0].begins_with("chair_") or p[0].begins_with("bench_"):
		# The back of a chair sorts behind its occupant without moving the artwork.
		sprite.position.y -= 12
		sprite.offset.y += 24
	sprite.visible = false
	actors.add_child(sprite)
	area_sprites.append([sprite,area_name])
	if p[0] in ["fountain","terminal"]:
		var water := ShaderMaterial.new()
		water.shader = load("res://shaders/fountain_water.gdshader" if p[0] == "fountain" else "res://shaders/mess_lights.gdshader")
		sprite.material = water
	if area_name == "museum" and p[0] == "case_empty":
		museum_cases["%d:%d" % [int(p[1]), int(p[2])]] = sprite
	# Props drawn for each season (park trees: green, teal, orange, bare with snow) swap pictures as the year turns.
	if ResourceLoader.exists("res://art/lunar/%s_winter.png" % p[0]):
		seasonal_props.append([sprite, p[0]])
		prop_season = ""
	# Ground shadow, lamp glow and leaf sway (cozy art pass).
	var glow: Sprite2D = PropFx.decorate(sprite, p[0], fw, sprite.texture.get_height())
	if glow != null:
		prop_glows.append(glow)

# Spring uses the plain picture; summer, autumn and winter use <name>_<season>.png when it exists.
func _apply_prop_season() -> void:
	var season: String = str(BridgeScript.season_date(day)[0]).to_lower()
	if season == prop_season:
		return
	prop_season = season
	for e in seasonal_props:
		var sp: Sprite2D = e[0]
		if not is_instance_valid(sp):
			continue
		var path := "res://art/lunar/%s.png" % e[1]
		if season != "spring" and ResourceLoader.exists("res://art/lunar/%s_%s.png" % [e[1], season]):
			path = "res://art/lunar/%s_%s.png" % [e[1], season]
		sp.texture = load(path)
		sp.offset.y = -sp.texture.get_height()

# Puts a picture (art/museum/<picture>.png, 24x24) on the cushion inside museum case number `slot`
# (an index into MapData.MUSEUM_SLOTS). The case's glass is see-through, so the exhibit is drawn behind it.
# For donations: call this when the player gives Tar'Besh something, and save which slot holds what.
func show_exhibit(slot: int, picture: String) -> void:
	if slot < 0 or slot >= MapData.MUSEUM_SLOTS.size():
		return
	var at: Array = MapData.MUSEUM_SLOTS[slot]
	var case_sprite: Sprite2D = museum_cases.get("%d:%d" % [int(at[0]), int(at[1])])
	var path := "res://art/museum/%s.png" % picture
	if case_sprite == null or not ResourceLoader.exists(path):
		return
	var old_item := case_sprite.get_node_or_null("Exhibit")
	if old_item != null:
		old_item.queue_free()
	var item := Sprite2D.new()
	item.name = "Exhibit"
	item.texture = load(path)
	item.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	item.centered = true
	# The case picture is 46 x 58 art pixels and its cushion top is 25 pixels above its bottom edge.
	item.position = Vector2(case_sprite.texture.get_width() * 0.5 - 2, case_sprite.offset.y + case_sprite.texture.get_height() - 25 - 12)
	item.show_behind_parent = true
	case_sprite.add_child(item)

func _animate_props() -> void:
	# Each machine loops at 8 frames a second from its own random start, so twins don't pulse together.
	var t: float = Time.get_ticks_msec() / 1000.0 * PROP_ANIM_FPS
	for a in anim_props:
		var sp: Sprite2D = a[0]
		if is_instance_valid(sp) and sp.visible:
			sp.frame = int(t + a[2]) % int(a[1])

func _portal_key(area_name: String,tile: Vector2i) -> String:
	return "%s:%d:%d" % [area_name,tile.x,tile.y]

# Quest scripts can call this before access is earned; lock state is saved.
func set_door_locked(area_name: String,tile: Vector2i,value: bool) -> void:
	var key := _portal_key(area_name,tile)
	door_locks[key] = value
	if portals.has(key): portals[key].locked = value

func _enter_portal(t: Dictionary) -> void:
	var key: String = t.key
	if door_locks.get(key,false):
		_toast("Locked — access is not available yet")
		sfx("deny")
		return
	var e: Array = t.entry
	var door = portals[key]
	travelling = true
	player.frozen = true
	var tween := create_tween()
	tween.tween_property(door,"opening",1.0,0.35)
	await tween.finished
	var step := create_tween()
	step.tween_property(player,"position",Vector2(e[1]*16+8,e[2]*16+12),0.25)
	await step.finished
	var layer := CanvasLayer.new()
	layer.layer = 30
	layer.scale = Vector2.ONE * UI_SCALE
	add_child(layer)
	var fade := ColorRect.new()
	fade.color = Color(0.08,0.1,0.15,0)
	fade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(fade)
	var is_lift: bool = door.kind == "lift"
	if is_lift:
		var close := create_tween()
		close.tween_property(door,"opening",0.0,0.35)
		await close.finished
		_toast("Lift moving…")
	var out := create_tween()
	out.tween_property(fade,"color:a",1.0,0.22)
	await out.finished
	if is_lift: await get_tree().create_timer(0.7).timeout
	_go_to(e[3],Vector2i(e[4],e[5]))
	door.opening = 0.0
	var inside := create_tween()
	inside.tween_property(fade,"color:a",0.0,0.25)
	await inside.finished
	layer.queue_free()
	travelling = false
	player.frozen = false

func _inspection(thing_title: String) -> String:
	var descriptions := {
		"Water-recycling fountain":"Reclaimed water rises through the illuminated column. The south plinth holds the community board and calendar.",
		"Dining table":"A shared table, mugs and a small hydroponic plant. Right-click a chair nearby to sit.",
		"Mess hall menu":"Community dinner at 18:00. Warm bowls, fresh greens and a place at the table for everyone.",
		"Community activities":"The next gathering is posted on the fountain calendar. The community room is just inside.",
		"Manufacturing work orders":"Repair requests, fabrication queues and tool checkouts. Follow the gear-marked threshold into the hub.",
