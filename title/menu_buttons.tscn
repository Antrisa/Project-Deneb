[ext_resource type="Texture2D" path="res://title/art/quit_pressed.png" id="quit_pressed"]

[node name="MenuButtons" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("overlay")

[node name="Stack" type="VBoxContainer" parent="."]
layout_mode = 0
offset_right = 150.0
offset_bottom = 150.0
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Play" type="TextureButton" parent="Stack"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 33)
layout_mode = 2
focus_mode = 2
mouse_default_cursor_shape = 2
texture_filter = 1
ignore_texture_size = true
stretch_mode = 0
accessibility_name = "Play"
texture_normal = ExtResource("play_idle")
texture_pressed = ExtResource("play_pressed")
script = ExtResource("button")
active_texture = ExtResource("play_focus")

[node name="Coop" type="TextureButton" parent="Stack"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 33)
layout_mode = 2
focus_mode = 2
mouse_default_cursor_shape = 2
texture_filter = 1
ignore_texture_size = true
stretch_mode = 0
