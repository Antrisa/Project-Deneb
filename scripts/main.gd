func _ready() -> void:
	RenderingServer.set_default_clear_color(Color("0b1026"))
	_start_fullscreen()
	_setup_input()
	_setup_sounds()
	tiles_tex = load("res://art/tiles.png")
	items_tex = load("res://art/items.png")

	for area_name in MapData.AREAS:
		var data: Dictionary = MapData.AREAS[area_name]
		var node = AreaScript.new()
		node.setup(data, tiles_tex)
		if area_name == "lounge":
			var glass := LoungeSky.new()
			glass.setup(self)
			node.add_child(glass)
		elif area_name == "bay":
			var window := BayWindow.new()
			window.setup(self, data["floor"])
			node.add_child(window)
		elif area_name == "agri":
			var terrain := preload("res://scripts/agri_terrain.gd").new()
			terrain.setup(self, data["floor"])
			node.add_child(terrain)
			farm_view = terrain
		elif area_name == "mess":
			var dining_view := MessWindow.new()
			dining_view.setup(self, data["floor"][0].length())
			node.add_child(dining_view)
		node.visible = false
		add_child(node)
		area_nodes[area_name] = node
		blocked[area_name] = {}
		fixed[area_name] = {}
		var w := {}
		var links := {}
		var list: Array = data["warps"]
		for item in list:
			var pad := Vector2i(int(item[0]), int(item[1]))
			var to_area: String = item[2]
			w[pad] = [to_area, int(item[3]), int(item[4])]
			if not links.has(to_area):
				links[to_area] = []
			links[to_area].append(pad)
		warps[area_name] = w
		area_links[area_name] = links

	ground_fx = Node2D.new()
	add_child(ground_fx)

	actors = Node2D.new()
	actors.y_sort_enabled = true
	add_child(actors)

	for area_name in MapData.AREAS:
		var top = AreaScript.new()
		top.setup(MapData.AREAS[area_name], tiles_tex, true)
		top.visible = false
		add_child(top)
		area_tops[area_name] = top
	top_fx = Node2D.new()
	add_child(top_fx)
	_add_fx()
	_add_glows()
	tint = CanvasModulate.new()
	add_child(tint)

	_spawn_things()
	_spawn_enemies()

	player = PlayerScript.new()
	player.world = self
	actors.add_child(player)
	cut_bar = load("res://scripts/cut_bar.gd").new()
	cut_bar.z_index = 50
	cut_bar.visible = false
	add_child(cut_bar)
	_spawn_concourse()

	_sync_slots()
	_build_ui()
	community_game = preload("res://scripts/community_game.gd").new()
	add_child(community_game)
	ship_map = MapScript.new()
	ship_map.world = self
	add_child(ship_map)
	battle = BattleScript.new()
	battle.world = self
	add_child(battle)
	ship_event = EventScript.new()
	ship_event.world = self
	add_child(ship_event)
	ship_store = StoreScript.new()
	ship_store.world = self
	add_child(ship_store)
	station_calendar = CalendarScript.new()
	add_child(station_calendar)
	_load_game()
	wreck_sprite.frame = repair_stage
	_go_home()
	_snap_residents()
	_toast("Day %d" % day)
	# A new game starts on the character screen.
	if creator != null:
		if appearance.is_empty():
			creator.show_for(maker.defaults(), true)
		else:
			player.set_sheet(maker.sheet(appearance), maker.action_sheet(appearance))
	# The title screen covers everything (the character screen included) until Play is pressed.
	title = TitleScript.new()
	title.world = self
	title.play_requested.connect(_on_title_play)
	add_child(title)


func _on_title_play() -> void:
	title = null
	_toast("Day %d" % day)


