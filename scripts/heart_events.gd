			["pose", "Garrick", ""],
			["face", "Ix'ali", "player"],
			["say", "Ix'ali", ["[happy] I am the boarder. I have been told not to enjoy this. I will enjoy it a little."]],
			["emote", "player", "joy"],
			["sfx", "sh_door"], ["walk", "Ix'ali", 22, 20], ["face", "Ix'ali", "l"],
			["pose", "Freya", ""],
			["choose", [
				{"text": "Hold the door with Freya: two on one.", "friendship": 60, "steps": [
