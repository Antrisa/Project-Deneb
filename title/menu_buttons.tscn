[gd_scene format=3]

[ext_resource type="Script" path="res://title/menu_buttons.gd" id="overlay"]
[ext_resource type="Script" path="res://title/menu_button.gd" id="button"]
[ext_resource type="Texture2D" path="res://title/art/play_idle.png" id="play_idle"]
[ext_resource type="Texture2D" path="res://title/art/play_focus.png" id="play_focus"]
[ext_resource type="Texture2D" path="res://title/art/play_pressed.png" id="play_pressed"]
[ext_resource type="Texture2D" path="res://title/art/coop_idle.png" id="coop_idle"]
[ext_resource type="Texture2D" path="res://title/art/coop_focus.png" id="coop_focus"]
[ext_resource type="Texture2D" path="res://title/art/coop_pressed.png" id="coop_pressed"]
[ext_resource type="Texture2D" path="res://title/art/settings_idle.png" id="settings_idle"]
[ext_resource type="Texture2D" path="res://title/art/settings_focus.png" id="settings_focus"]
[ext_resource type="Texture2D" path="res://title/art/settings_pressed.png" id="settings_pressed"]
