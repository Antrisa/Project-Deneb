			["emote", "Kit", "joy"], ["pose", "Kit", "jump"],
			["say", "Kit", ["[happy] And then you punch them!"]],
			["emote", "player", "joy"],
			["pose", "Kit", ""],
			["walk", "Garrick", 122, 95], ["face", "Garrick", "player"], ["face", "player", "Garrick"],
			["say", "Garrick", ["And then you get gone, Kit."]],
			["sfx", "sara_holo"], ["sara", "warning"],
