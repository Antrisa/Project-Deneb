func _activity_near(pos: Vector2,radius: float,activities: Array) -> Array[String]:
	var names: Array[String]=[]
	for r in residents:
		if r.area==current_area and r._settled and (activities.is_empty() or r._act in activities) and r.position.distance_to(pos)<radius:names.append(r.who)
	return names

func _activity_dialogue(who: String) -> String:
	for r in residents:
		if r.who != who or not r._settled:continue
		return {"garden":"These flowers make the base feel like a place to live. The irrigation tank recycles every drop.","chess":"One more move. Pull up a chair when this round is finished.","hologame":"The glowing pieces are easy to learn. Winning takes a little more practice.","observe":"Look at those shadows along the crater rim. The view never stays quite the same.","read":"Someone left notes in this book. It has travelled farther than most of us.","browse":"I only came for one thing. Now I’m looking at the seed packets too.","restock":"Fresh stock on the counter. Let me know if you need work or have metal to sell."}.get(r._act,"")
	return ""

func _water_garden(t: Dictionary) -> void:
	if current_area == "agri":
		_irrigate(t)
		return
	if garden_watered_day==day:
		_toast("The garden has enough water for today")
		return
	garden_busy=true
	player.frozen=true
	var effect:=preload("res://scripts/watering_effect.gd").new()
	effect.position=t.pos+Vector2(0,-12)
	actors.add_child(effect)
	_toast("Watering the crop beds…" if current_area == "agri" else "Watering the community flowers…")
	await get_tree().create_timer(1.4).timeout
	garden_watered_day=day
	garden_busy=false
	player.frozen=false
	_toast("Crop beds watered" if current_area == "agri" else "Flowers watered — the reservoir will recirculate the excess")


# ---------------------------------------------------------------- farming (21 Nov)
# Stardew-style, one tile at a time on the field in the Agri dome (MapData.FARM_FIELDS): dig a tile with the hoe,
# plant seeds on it, water it, and each night a watered crop grows a day. Press E on a ripe crop to pick it.
# One tile is one character wide. The crops are placeholders until the economy chat's crop list.
const FARM_ENERGY := 2              # energy per dig or watering, as in Stardew
const SEED_HANDFUL := 5             # what the seed rack gives of each kind, once a day (until shops open)
const CROPS := {
	"crater_potato": {"days": 4, "stages": 4, "regrow": 0, "item": "crater_potato"},
	"moon_wheat": {"days": 3, "stages": 3, "regrow": 0, "item": "moon_wheat"},
	"star_tomato": {"days": 6, "stages": 4, "regrow": 3, "item": "star_tomato"},
}


func farm_field() -> Rect2i:
	var f: Array = MapData.FARM_FIELDS.get(current_area, [])
	if f.size() != 4: return Rect2i()
	return Rect2i(int(f[0]), int(f[1]), int(f[2]), int(f[3]))


# The tile a farm tool works on: the one under the mouse if it touches yours, otherwise the one you face.
func farm_target() -> Vector2i:
	var here: Vector2i = _player_tile()
	var m: Vector2 = player.get_global_mouse_position()
	var under := Vector2i(floori(m.x / TILE), floori(m.y / TILE))
	if under != here and absi(under.x - here.x) <= 1 and absi(under.y - here.y) <= 1:
		return under
	var f: Vector2 = player.facing()
	return here + Vector2i(roundi(f.x), roundi(f.y))


# For the field drawing: the tile to outline, or (-1, -1) when no farm tool is in hand.
func farm_cursor() -> Vector2i:
	if not _selected_use() in ["hoe", "water", "plant"] or not farm_field().has_point(farm_target()):
		return Vector2i(-1, -1)
	return farm_target()


func crop_stage(t: Dictionary) -> int:
	var c: Dictionary = CROPS.get(str(t.get("crop", "")), {})
	if c.is_empty(): return -1
	var days: int = int(c["days"])
	if int(t["age"]) >= days: return int(c["stages"])          # ripe
	return mini(int(c["stages"]) - 1, int(t["age"]) * int(c["stages"]) / days)


# Like Stardew, the hoe and the can always swing (and cost their energy), whatever they hit; only a dug field
# tile changes. Seeds go in only where they can grow, and otherwise nothing happens. (Zachary, 21 Nov: "just let
# the action play".) The equipped tool follows the hands through its action poses.
func _farm_use(use: String, item: String) -> void:
	var tile: Vector2i = farm_target()
	var on_field: bool = farm_field().has_point(tile)
	if use == "plant":
		if on_field and farm.has(tile) and str(farm[tile]["crop"]) == "":
			farm[tile]["crop"] = str(ItemData.ITEMS[item].get("crop", ""))
			farm[tile]["age"] = 0
			_give(item, -1)
			sfx("click", 0.8)
			if farm_view != null: farm_view.sync_crops()
		return
	if swing_cd > 0.0:
		return
	swing_cd = 0.4
	if not _farm_energy(): return
	player.face(Vector2(tile.x * TILE + 8, tile.y * TILE + 12))
	var animated: bool = player.tool_action(_tool_art(item), "hoe" if use == "hoe" else "water")
	if not animated:
		player.show_tool(_item_icon(item))
	if use == "hoe":
		sfx("step", 0.7)
		if on_field and not farm.has(tile):
			farm[tile] = {"crop": "", "age": 0, "watered": -1}
	elif use == "water":
		sfx("blip", 0.6)
		var splash := preload("res://scripts/watering_effect.gd").new()
		splash.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 4)
		if animated:
			splash.spout = player.watering_spout
		actors.add_child(splash)
		if on_field and farm.has(tile):
			farm[tile]["watered"] = day
	if farm_view != null: farm_view.sync_crops()


func _farm_energy() -> bool:
	if energy < FARM_ENERGY:
		sfx("deny")
		_toast("Too tired. Eat something, or sleep.")
		return false
	energy -= FARM_ENERGY
	return true


# E on a ripe crop in front of you (or under the mouse, next to you) picks it.
func _try_harvest() -> bool:
	if not farm_field().has_point(farm_target()): return false
	var tile: Vector2i = farm_target()
	if not farm.has(tile) or crop_stage(farm[tile]) < 0: return false
	var t: Dictionary = farm[tile]
	var c: Dictionary = CROPS[str(t["crop"])]
	if int(t["age"]) < int(c["days"]):
		_toast("Not ready yet: %d more watered day%s" % [int(c["days"]) - int(t["age"]), "" if int(c["days"]) - int(t["age"]) == 1 else "s"])
		return true
	var got: String = str(c["item"])
	player.face(Vector2(tile.x * TILE + 8, tile.y * TILE + 12))
	if got == "moon_wheat":
		player.tool_action("scythe", "scythe")
	else:
		player.show_pickup(_held_item_picture(got))
	_give(got, 1)
	sfx("coin", 1.2)
	_toast("+1 %s" % _item_name(got))
	if int(c["regrow"]) > 0:
		t["age"] = int(c["days"]) - int(c["regrow"])   # fruits again after a few more watered days
	else:
		t["crop"] = ""
		t["age"] = 0
	if farm_view != null: farm_view.sync_crops()
	return true


# Overnight: a crop watered today grows a day.
func _grow_crops() -> void:
	for tile in farm:
		var t: Dictionary = farm[tile]
		if str(t["crop"]) != "" and int(t["watered"]) == day:
			t["age"] = int(t["age"]) + 1
	if farm_view != null: farm_view.sync_crops()


# The irrigation valve in the Agri dome waters every dug tile at once.
func _irrigate(t: Dictionary) -> void:
	if farm.is_empty():
		_toast("Nothing dug to water yet. Take a hoe from the shed.")
		return
	garden_busy = true
	player.frozen = true
	var effect := preload("res://scripts/watering_effect.gd").new()
	effect.position = t.pos + Vector2(0, -12)
	actors.add_child(effect)
	_toast("Opening the irrigation valve…")
	await get_tree().create_timer(1.4).timeout
	effect.queue_free()
	for tile in farm:
		farm[tile]["watered"] = day
	garden_busy = false
	player.frozen = false
	if farm_view != null: farm_view.sync_crops()
	_toast("Every dug tile is watered")


func _take_farm_tools() -> void:
	if _count("hoe") > 0 and _count("watering_can") > 0:
		_toast("You already have a hoe and a watering can")
		return
	if _count("hoe") == 0: _give("hoe", 1)
	if _count("watering_can") == 0: _give("watering_can", 1)
	sfx("quest")
	_toast("You take a hoe and a watering can. Evarra won't miss them.")


# Until the shops open, the seed rack gives a handful of each seed once a day, so farming can be tried out.
func _take_seeds() -> void:
	if seeds_taken_day == day:
		_toast("You've had today's seeds. The rack refills overnight.")
		return
	seeds_taken_day = day
	for seed_id in ["crater_potato_seeds", "moon_wheat_seeds", "star_tomato_seeds"]:
		_give(seed_id, SEED_HANDFUL)
	sfx("quest")
	_toast("+%d each: crater potato, moon wheat and star tomato seeds" % SEED_HANDFUL)


# ---------------------------------------------------------------- the Caverns
# Floors under the mine (tools/caverns.py). Each visit to a floor picks one of its band's ten maps and scatters
# rocks, ore and creatures over it. The way down is under a rock: each rock you break has a small chance to show the
# shaft, rising as fewer are left, and the last rock always shows it. Every fifth floor becomes a lift stop.

func _cav_band(n: int) -> String:
	return "rock" if n <= 15 else ("lush" if n <= 30 else "steam")


func _cavern_gate() -> void:
	if job_quest < 5:
		_say("Vzz'ket", ["[angry] The caverns stay shut. Job wants the north tunnels cleared first.", "Clear them. Then we will see what you are."])
		return
	if cav_lift > 0:
		_say("Cavern gate", ["Vzz'ket unbolts the barricade. The old cage lift still runs.", "Take the lift down to floor %d?" % cav_lift],
				Callable(self, "_enter_cavern").bind(cav_lift), "Floor %d" % cav_lift, Callable(self, "_enter_cavern").bind(1), "Floor 1")
	else:
		_say("Cavern gate", ["Vzz'ket unbolts the barricade. A ladder drops away into the dark.", "Climb down into the Caverns?"],
				Callable(self, "_enter_cavern").bind(1), "Climb down")


func _enter_cavern(n: int) -> void:
	_clear_cavern()
	var data: Dictionary = MapData.CAVERNS
	var last: int = int(data["last"])
	n = clampi(n, 1, last)
	cav_floor = n
	var band: String = _cav_band(n)
	var key := "cav_45"
	if n < last:
		var keys: Array = data["bands"][band]
		key = keys[randi() % keys.size()]
		if key == cav_key and keys.size() > 1:            # never the same layout twice running
			key = keys[(keys.find(key) + 1) % keys.size()]
	cav_key = key
	var info: Dictionary = data["maps"][key]
	var up: Array = info["up"]
	_go_to(key, Vector2i(int(up[0]), int(up[1])), false)
	sfx("warp")
	cav_deepest = maxi(cav_deepest, n)
	var note := "The Caverns, floor %d" % n
	if n % 5 == 0 and n > cav_lift and n < last:
		cav_lift = n
		note += "  (the lift stops here now)"
	_toast(note)
	if n < last:
		_fill_cavern(key, info, n, band)
	elif not harbinger_slain:
		_wake_harbinger(key)
	else:
		_toast("The water is still. Somewhere far out, something is not breathing.")


func _fill_cavern(key: String, info: Dictionary, n: int, band: String) -> void:
	var spots: Array = info["spots"].duplicate()
	spots.shuffle()
	var mobs: int = mini(3 + n / 8, 8)
	var veins: int = randi_range(5, 8)
	cav_rocks = randi_range(22, 30)
	cav_rocks_left = cav_rocks
	cav_shaft = false
	var weights: Array = CAV_ORES[band]
	var total := 0
	for w in weights:
		total += int(w[1])
	var power: Array = CAV_POWER[band]
	var i := 0
	for s in spots:
		var tile := Vector2i(int(s[0]), int(s[1]))
		if i < mobs:
			var en = EnemyScript.new()
			var kinds: Array = CAV_MOBS[band]
			en.setup(self, kinds[randi() % kinds.size()], key, Vector2(tile.x * TILE + 8, tile.y * TILE + 12))
			en.boost(float(power[0]), int(power[1]), float(power[2]))
			actors.add_child(en)
			enemies.append(en)
			cav_enemies.append(en)
			en.visible = true
		elif i < mobs + veins:
			var roll: int = randi() % total
			var item := "stone"
			for w in weights:
				roll -= int(w[1])
				if roll < 0:
					item = str(w[0])
					break
			_add_node(item, key, tile, 1, true)
		elif i < mobs + veins + cav_rocks:
			_add_node("stone", key, tile, 1, true)
		else:
			break
		i += 1


func _maybe_open_shaft(t: Dictionary, node: Dictionary) -> void:
	if cav_shaft or cav_floor <= 0 or cav_floor >= int(MapData.CAVERNS["last"]):
		return
	var chance: float = 0.04 + 0.3 * (1.0 - float(cav_rocks_left) / float(maxi(1, cav_rocks)))
	if cav_rocks_left > 0 and randf() >= chance:
		return
	cav_shaft = true
	var tile: Vector2i = node["tile"]
	var s: Sprite2D = node["sprite"]
	s.visible = false
	var here: Dictionary = blocked[current_area]
	here.erase(tile)
	var fixed_here: Dictionary = fixed[current_area]
	fixed_here.erase(tile)
	things.erase(t)
	var hole := Sprite2D.new()
	hole.texture = load("res://art/lunar/cavern_shaft.png")
	hole.scale = Vector2.ONE * (16.0 / float(hole.texture.get_width()))
	hole.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 8)
	hole.z_index = -1
	actors.add_child(hole)
	area_sprites.append([hole, current_area])
	cav_sprites.append(hole)
	things.append({"kind": "shaft", "name": "Shaft down", "hint": "Climb down to floor %d" % (cav_floor + 1), "area": current_area,
		"pos": Vector2(tile.x * TILE + 8, tile.y * TILE + 8), "radius": 22.0, "who": "", "cav": true})
	sfx("quest")
	_toast("A shaft down! It leads to floor %d." % (cav_floor + 1))


func _leave_caverns() -> void:
	_clear_cavern()
	var gate: Array = MapData.CAVERNS["gate"]
	_go_to("mine", Vector2i(int(gate[0]), int(gate[1])))


# Takes away everything placed for the current floor (its rocks, veins, creatures and shaft).
func _clear_cavern() -> void:
	cutting = null
	cav_floor = 0
	if cav_sprites.is_empty() and cav_enemies.is_empty():
		return
	area_sprites = area_sprites.filter(func(pair): return not cav_sprites.has(pair[0]))
	things = things.filter(func(th): return not bool(th.get("cav", false)))
	for sp in cav_sprites:
		sp.queue_free()
	cav_sprites.clear()
	for en in cav_enemies:
		enemies.erase(en)
		en.queue_free()
	cav_enemies.clear()
	ore_nodes.resize(cav_static_nodes)
	if cav_key != "":
		blocked[cav_key] = {}
		fixed[cav_key] = {}


# Floor 45: the Harbinger heaves itself out of the water onto the shore and comes for you.
func _wake_harbinger(key: String) -> void:
	var spot: Array = MapData.CAVERNS["boss"]
	var en = EnemyScript.new()
	en.setup(self, "harbinger", key, Vector2(int(spot[0]) * TILE + 8, int(spot[1]) * TILE + 12))
	en.boost(1.0, 0, 4.0)
	actors.add_child(en)
	enemies.append(en)
	cav_enemies.append(en)
	en.visible = true
	sfx("hurt", 0.4)
	_say("The Harbinger", ["The black water bulges. Something the size of a shuttle drags itself up onto the shore.",
		"Its eyes are the colour of the power core. It has seen you."])


func _harbinger_slain() -> void:
	harbinger_slain = true
	sfx("quest")
	_money(500, "The Harbinger, defeated")
	_say("Underground ocean", ["The Harbinger sinks back into the dark water, and does not rise again.",
		"For the first time, the ocean is quiet. Zaas is going to want to see this.",
		"You pull a scale the size of a dinner plate from the shingle. (+500 credits)",
		"Somewhere above, water drains away. The old flooded stair under the copper bay will be open now: there is a lake down there, and fish."])


# Doors between rooms: open for whoever is near, shut again behind them. A bedroom with an owner stays
# locked to the player until they have BEDROOM_HEARTS hearts with that owner. A couple's room ("Maren|Owen")
# opens once you are friends with either of them; an owner who has not arrived on the station yet locks nothing.
func _bedroom_locked(owners: String) -> bool:
	if owners == "": return false
	var known := false
	for who in owners.split("|"):
		if not persons.has(who): continue
		known = true
		if int(persons[who]["friendship"]) >= BEDROOM_HEARTS * FRIEND_PER_HEART: return false
	return known

func _update_inner_doors(delta: float) -> void:
	for d in inner_doors:
		if d.area != current_area: continue
		var c: Vector2 = d.center()
		var reach: float = 22.0 + maxf(d.size_px.x, d.size_px.y) * 0.5
		d.locked = _bedroom_locked(d.room_owner)
		var player_near: bool = player.position.distance_to(c) < reach
		var want: bool = player_near and not d.locked
		for r in residents:
			if r.area == current_area and r.position.distance_to(c) < reach: want = true
		if player_near and d.locked and not d.has_meta("warned"):
			d.set_meta("warned", true)
			var names: String = d.room_owner.replace("|", " and ")
			_toast("%s's room — locked. Get to know %s better first." % [names, "them" if "|" in d.room_owner else names])
			sfx("deny")
		elif not player_near and d.has_meta("warned"):
			d.remove_meta("warned")
		var target: float = 1.0 if want else 0.0
		if not is_equal_approx(d.opening, target):
			d.opening = move_toward(d.opening, target, delta * 4.0)
			d.queue_redraw()

