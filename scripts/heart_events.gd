			["say", "Jasper", ["[happy] Ah! Right on time. Well, you did not know you were invited. But you were. Evarra has the mess hall tonight."]],
			["walks", [["Jasper", 11, 19], ["player", 11, 21]]], ["face", "Jasper", "d"], ["face", "player", "u"],
