func _ready() -> void:
	RenderingServer.set_default_clear_color(Color("0b1026"))
	_setup_input()
	_setup_sounds()
	tiles_tex = load("res://art/tiles.png")
	items_tex = load("res://art/items.png")

	for area_name in MapData.AREAS:
		var data: Dictionary = MapData.AREAS[area_name]
		var node = AreaScript.new()
		node.setup(data, tiles_tex)
		node.visible = false
		add_child(node)
		area_nodes[area_name] = node
		blocked[area_name] = {}
		fixed[area_name] = {}
		var w := {}
		var links := {}
		var list: Array = data["warps"]
		for item in list:
			var pad := Vector2i(int(item[0]), int(item[1]))
			var to_area: String = item[2]
			w[pad] = [to_area, int(item[3]), int(item[4])]
			if not links.has(to_area):
				links[to_area] = []
			links[to_area].append(pad)
		warps[area_name] = w
		area_links[area_name] = links

	ground_fx = Node2D.new()
	add_child(ground_fx)

	actors = Node2D.new()
	actors.y_sort_enabled = true
	add_child(actors)

	for area_name in MapData.AREAS:
		var top = AreaScript.new()
		top.setup(MapData.AREAS[area_name], tiles_tex, true)
		top.visible = false
		add_child(top)
		area_tops[area_name] = top
	top_fx = Node2D.new()
	add_child(top_fx)
	_add_fx()
	_add_glows()
	tint = CanvasModulate.new()
	add_child(tint)

	_spawn_things()
	_spawn_enemies()

	player = PlayerScript.new()
	player.world = self
	actors.add_child(player)

	_sync_slots()
	_build_ui()
	_load_game()
	wreck_sprite.frame = repair_stage
	_go_home()
	_snap_residents()
	_toast("Day %d" % day)
	# A new game starts on the character screen.
	if creator != null:
		if appearance.is_empty():
			creator.show_for(maker.defaults(), true)
		else:
			player.set_sheet(maker.sheet(appearance))


# ---------------------------------------------------------------- input

func _setup_input() -> void:
	_add_keys("move_left", [KEY_A, KEY_LEFT])
	_add_keys("move_right", [KEY_D, KEY_RIGHT])
	_add_keys("move_up", [KEY_W, KEY_UP])
	_add_keys("move_down", [KEY_S, KEY_DOWN])
	_add_keys("interact", [KEY_E, KEY_ENTER])
	_add_keys("use", [KEY_SPACE, KEY_F])
	_add_keys("menu", [KEY_TAB, KEY_I])
	_add_keys("cancel", [KEY_Q, KEY_ESCAPE])
	_add_keys("new_game", [KEY_F9])
	_add_keys("music", [KEY_M])


func _add_keys(action: String, keys: Array) -> void:
	if InputMap.has_action(action):
		return
	InputMap.add_action(action)
	for k in keys:
		var ev := InputEventKey.new()
		ev.physical_keycode = k
		InputMap.action_add_event(action, ev)


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("new_game"):
		# F9: wipe the save and start again.
		var empty := ConfigFile.new()
		empty.save(SAVE_PATH)
		get_tree().reload_current_scene()
		return
	var click := event as InputEventMouseButton
	if click != null:
		if click.pressed:
			_mouse_button(click.button_index)
		return
	if event.is_action_pressed("music"):
		_toggle_music()
		return
	if creator != null and creator.open:
		creator.handle_input(event)
		return
	if ui.open:
		ui.handle_input(event)
		return
	if dialogue.active:
		if event.is_action_pressed("interact") or event.is_action_pressed("use"):
			dialogue.advance()
		elif event.is_action_pressed("cancel"):
			dialogue.cancel()
		return
	if event.is_action_pressed("menu"):
		ui.show_menu()
		sfx("click")
	elif event.is_action_pressed("interact"):
		_interact_nearest()
	elif event.is_action_pressed("use"):
		_use_tool()
	else:
		# Number keys 1-8 pick a hotbar slot.
		var key_event := event as InputEventKey
		if key_event != null and key_event.pressed and not key_event.echo:
			var key: int = key_event.physical_keycode
			if key >= KEY_1 and key <= KEY_8:
				selected = key - KEY_1
				sfx("click", 1.4, -6.0)


func _interact_nearest() -> void:
	var t = _nearest_thing()
	if t != null:
		_interact(t)


# Mouse: left click uses the selected item (or interacts if it has no use), right click interacts,
# the wheel changes the hotbar slot. In the menu, clicks go to scripts/ui.gd.
func _mouse_button(button: int) -> void:
	if creator != null and creator.open:
		creator.handle_click(button)
		return
	if ui.open:
		ui.handle_click(button)
		return
	if dialogue.active:
		if button == MOUSE_BUTTON_LEFT:
			dialogue.advance()
		elif button == MOUSE_BUTTON_RIGHT:
			dialogue.cancel()
		return
	if button == MOUSE_BUTTON_WHEEL_UP:
		selected = (selected + 7) % 8
	elif button == MOUSE_BUTTON_WHEEL_DOWN:
		selected = (selected + 1) % 8
	elif button == MOUSE_BUTTON_LEFT:
		var at: Vector2 = ui.mouse()
		var slot: int = ui.hotbar_slot_at(at)
		if ui.menu_button_at(at):
			ui.show_menu()
			sfx("click")
		elif slot != -1:
			selected = slot
			sfx("click", 1.4, -6.0)
		elif _selected_use() != "":
			_use_tool()
		else:
			_interact_clicked()
	elif button == MOUSE_BUTTON_RIGHT:
		_interact_clicked()


# ---------------------------------------------------------------- areas and map

func map_pixel_size() -> Vector2i:
	var data: Dictionary = MapData.AREAS[current_area]
	var rows: Array = data["floor"]
	var first: String = rows[0]
	return Vector2i(first.length() * TILE, rows.size() * TILE)


func solid_at(p: Vector2) -> bool:
	var data: Dictionary = MapData.AREAS[current_area]
	var floor_rows: Array = data["floor"]
	var tx := int(floor(p.x / TILE))
	var ty := int(floor(p.y / TILE))
	if ty < 0 or ty >= floor_rows.size():
		return true
	var frow: String = floor_rows[ty]
	if tx < 0 or tx >= frow.length():
		return true
	var fch: String = frow[tx]
	if MapData.SOLID_FLOOR.contains(fch):
		return true
	var obj_rows: Array = data["obj"]
	var orow: String = obj_rows[ty]
	var och: String = orow[tx]
	if och != " " and not MapData.OPEN_OBJ.contains(och):
		return true
	var here: Dictionary = blocked[current_area]
	return here.has(Vector2i(tx, ty))


func _feet(tile: Vector2i) -> Vector2:
	return Vector2(tile.x * TILE + 8, tile.y * TILE + 12)


func player_tile() -> Vector2i:
	return _player_tile()


func _player_tile() -> Vector2i:
	var ppos: Vector2 = player.position
	return Vector2i(int(floor(ppos.x / TILE)), int(floor((ppos.y - 3.0) / TILE)))


func _go_to(area_name: String, tile: Vector2i, announce: bool = true) -> void:
	if current_area != "":
		area_nodes[current_area].visible = false
		area_tops[current_area].visible = false
	current_area = area_name
	area_nodes[area_name].visible = true
	area_tops[area_name].visible = true
	for pair in area_sprites:
		var s: Sprite2D = pair[0]
		var where: String = pair[1]
		s.visible = where == area_name
	for r in residents:
		r.visible = r.area == area_name
	for en in enemies:
		en.visible = en.alive and en.area == area_name
	player.position = _feet(tile)
	player.set_limits(map_pixel_size())
	var track: String = MUSIC.get(area_name, "town")
	_play_music(track)
	if announce:
		var data: Dictionary = MapData.AREAS[area_name]
		var title: String = data["title"]
		_toast(title)
		sfx("warp")


# Animated overlays. Each art file has 4 frames of 16x16, laid over the still tile.
# [art file, drawn over the tile above (true) or on the tile itself (false), frames per second]
const FX_OBJ := {
	"k": ["res://art/fx_console.png", true, 2.0],
	"K": ["res://art/fx_display.png", true, 6.0],
	"F": ["res://art/fx_furnace.png", false, 8.0],
	"G": ["res://art/fx_core.png", false, 4.0],
}
const FX_FLOOR := {
	"O": ["res://art/fx_water.png", false, 3.0],
}


func _add_fx() -> void:
	for area_name in MapData.AREAS:
		var data: Dictionary = MapData.AREAS[area_name]
		var floor_rows: Array = data["floor"]
		var obj_rows: Array = data["obj"]
		for y in floor_rows.size():
			var frow: String = floor_rows[y]
			var orow: String = obj_rows[y]
			for x in frow.length():
				var fch: String = frow[x]
				if FX_FLOOR.has(fch):
					_add_fx_sprite(FX_FLOOR[fch], area_name, x, y)
				var och: String = orow[x]
				if FX_OBJ.has(och):
					_add_fx_sprite(FX_OBJ[och], area_name, x, y)


func _add_fx_sprite(info: Array, area_name: String, x: int, y: int) -> void:
	var on_top: bool = info[1]
	var s := Sprite2D.new()
	s.texture = load(info[0])
	s.hframes = 4
	s.centered = false
	var fit: float = 16.0 / (s.texture.get_width() / 4.0)
	s.scale = Vector2(fit, fit)
	s.position = Vector2(x * TILE, (y - 1 if on_top else y) * TILE)
	s.visible = false
	if on_top:
		top_fx.add_child(s)
	else:
		ground_fx.add_child(s)
	area_sprites.append([s, area_name])
	# Screens stay in step with each other; everything else starts on a different frame.
	var start: int = 0 if on_top else (x * 3 + y * 5) % 4
	anim.append([s, area_name, float(info[2]), start])


func _animate() -> void:
	var now: float = Time.get_ticks_msec() / 1000.0
	for a in anim:
		if a[1] == current_area:
			var s: Sprite2D = a[0]
			s.frame = (int(now * float(a[2])) + int(a[3])) % 4
	# Sara's holograms: see-through, flickering, bobbing a little above the projector pad.
	for h in holos:
		var hs: Sprite2D = h
		var glitch: float = 0.12 if int(now * 11.0) % 23 == 0 else 0.0
		hs.modulate = Color(0.85, 1.0, 1.0, 0.74 + 0.08 * sin(now * 6.0) - glitch)
		var lift: float = (3.0 + sin(now * 1.6)) / hs.scale.y
		hs.offset.y = -(hs.texture.get_height() / 3.0) - lift


# Soft glows on lamps, screens, furnaces and relics. They show up most in the evening.
const GLOWS := {
	"l": [Color(1.0, 0.82, 0.5), 1.5, -18.0],
	"F": [Color(1.0, 0.5, 0.2), 1.0, 2.0],
	"K": [Color(0.35, 0.8, 1.0), 1.0, -6.0],
	"k": [Color(0.35, 0.8, 1.0), 0.6, -2.0],
	"a": [Color(0.7, 0.4, 1.0), 0.8, -2.0],
	"f": [Color(0.3, 1.0, 0.8), 0.7, 2.0],
	"E": [Color(0.35, 0.8, 1.0), 0.9, -10.0],
}


func _add_glows() -> void:
	glow_tex = load("res://art/glow.png")
	glow_mat = CanvasItemMaterial.new()
	glow_mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	var mat: CanvasItemMaterial = glow_mat
	var lights := Node2D.new()
	add_child(lights)
	for area_name in MapData.AREAS:
		var data: Dictionary = MapData.AREAS[area_name]
		var obj_rows: Array = data["obj"]
		for y in obj_rows.size():
			var orow: String = obj_rows[y]
			for x in orow.length():
				var och: String = orow[x]
				if not GLOWS.has(och):
					continue
				var info: Array = GLOWS[och]
				var glow := Sprite2D.new()
				glow.texture = glow_tex
				glow.material = mat
				glow.modulate = info[0]
				glow.scale = Vector2(float(info[1]), float(info[1]))
				glow.position = Vector2(x * TILE + 8, y * TILE + 8 + float(info[2]))
				glow.visible = false
				lights.add_child(glow)
				area_sprites.append([glow, area_name])


# The station dims its lights in the evening and overnight.
func _light_color() -> Color:
	var h: float = minutes / 60.0
	var day := Color(1.0, 1.0, 1.0)
	var dusk := Color(1.0, 0.86, 0.74)
	var night := Color(0.56, 0.62, 0.86)
	var c: Color = day
	if h < 7.0:
		c = night.lerp(day, clampf(h - 6.0, 0.0, 1.0))
	elif h < 17.0:
		c = day
	elif h < 19.5:
		c = day.lerp(dusk, (h - 17.0) / 2.5)
	else:
		c = dusk.lerp(night, clampf((h - 19.5) / 2.5, 0.0, 1.0))
	if current_area == "mine":
		c = c * Color(0.8, 0.78, 0.86)
	elif current_area == "tunnels":
		c = c * Color(0.62, 0.6, 0.74)
	return c


func _go_home() -> void:
	var start: Array = MapData.START
	var area_name: String = start[0]
	_go_to(area_name, Vector2i(int(start[1]), int(start[2])), false)


func _zone_name() -> String:
	var data: Dictionary = MapData.AREAS[current_area]
	var zones: Array = data["zones"]
	var tile: Vector2i = _player_tile()
	for z in zones:
		if tile.x >= int(z[1]) and tile.x <= int(z[3]) and tile.y >= int(z[2]) and tile.y <= int(z[4]):
			var zone: String = z[0]
			return zone
	var title: String = data["title"]
	return title


# ---------------------------------------------------------------- people and things

func _spawn_things() -> void:
	for p in MapData.PEOPLE:
		var who: String = p[0]
		var area_name: String = p[1]
		_add_person(who, area_name, Vector2i(int(p[2]), int(p[3])), float(p[4]))

	for who in MapData.SCHEDULES:
		_add_resident(who, MapData.SCHEDULES[who])

	for item in MapData.THINGS:
		var pos: Array = item[4]
		things.append({
			"kind": item[0], "name": item[1], "hint": item[2], "area": item[3],
			"pos": Vector2(float(pos[0]), float(pos[1])), "radius": float(item[5]), "who": "",
		})

	# Ore veins. Each art file has 2 frames: full, worked out.
	for i in MapData.NODES.size():
		var entry: Array = MapData.NODES[i]
		var item: String = entry[0]
		var node_area: String = entry[1]
		var tile := Vector2i(int(entry[2]), int(entry[3]))
		var vein := Sprite2D.new()
		vein.texture = load("res://art/%s.png" % item)
		vein.hframes = 2
		vein.centered = false
		_fit_sprite(vein, 2, 1, 16.0)
		vein.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 16)
		vein.visible = false
		actors.add_child(vein)
		area_sprites.append([vein, node_area])
		var here: Dictionary = blocked[node_area]
		here[tile] = true
		var fixed_here: Dictionary = fixed[node_area]
		fixed_here[tile] = true
		ore_nodes.append({"item": item, "hits": NODE_HITS, "sprite": vein})
		things.append({
			"kind": "ore", "name": _item_name(item), "hint": "Mine %s" % _item_name(item).to_lower(), "area": node_area,
			"pos": Vector2(tile.x * TILE + 8, tile.y * TILE + 8), "radius": 26.0, "who": "", "node": i,
		})

	# The wreck in the shuttle bay. art/wreck.png has 4 frames: wrecked -> repaired.
	var wreck: Array = MapData.WRECK
	wreck_sprite = Sprite2D.new()
	wreck_sprite.texture = load("res://art/wreck.png")
	wreck_sprite.hframes = 4
	wreck_sprite.centered = false
	_fit_sprite(wreck_sprite, 4, 1, 64.0)
	wreck_sprite.position = Vector2(float(wreck[1]), float(wreck[2]))
	wreck_sprite.visible = false
	actors.add_child(wreck_sprite)
	area_sprites.append([wreck_sprite, wreck[0]])


# Creates the shared state for a person the first time they are needed. Returns their art id.
func _ensure_person(who: String) -> String:
	var info: Dictionary = NpcData.PEOPLE[who]
	var id: String = info["id"]
	if not persons.has(who):
		persons[who] = {
			"id": id, "first": info["first"], "repeat": info["repeat"], "pitch": float(info.get("pitch", 1.0)),
			"portrait": load("res://art/portrait_%s.png" % id),
			"met": false, "talked_today": false, "friendship": 0, "next": 0,
		}
	return id


# A resident who walks around on a schedule (see scripts/resident.gd).
func _add_resident(who: String, entries: Array) -> void:
	var id: String = _ensure_person(who)
	var t := {
		"kind": "person", "name": who, "hint": "Talk to %s" % who, "area": "",
		"pos": Vector2.ZERO, "radius": 26.0, "who": who,
	}
	things.append(t)
	var r = ResidentScript.new()
	# Hand-made activity frames are optional: art/npc_<id>_act.png
	var act_tex: Texture2D = null
	var act_path: String = "res://art/npc_%s_act.png" % id
	if ResourceLoader.exists(act_path):
		act_tex = load(act_path)
	r.setup(self, who, load("res://art/npc_%s.png" % id), entries, t, act_tex)
	r.visible = false
	actors.add_child(r)
	residents.append(r)


func _snap_residents() -> void:
	for r in residents:
		r.snap(minutes)


# Someone who stays in one place. One person can appear in several places
# (Sara's holograms) and shares one state.
# Art can be drawn at any size. This scales a sprite so one frame is `world_width` wide in the world,
# and puts its origin at the bottom centre of the frame.
func _fit_sprite(s: Sprite2D, columns: int, rows: int, world_width: float) -> void:
	var frame_w: float = s.texture.get_width() / float(columns)
	var frame_h: float = s.texture.get_height() / float(rows)
	s.scale = Vector2(world_width / frame_w, world_width / frame_w)
	s.offset = Vector2(-frame_w / 2.0, -frame_h)


func _add_person(who: String, area_name: String, tile: Vector2i, radius: float) -> void:
	var id: String = _ensure_person(who)
	var s := Sprite2D.new()
	s.texture = load("res://art/npc_%s.png" % id)
	s.hframes = 4            # sheets are 4 directions x 3 walking frames; frame 0 faces down
	s.vframes = 3
	s.centered = false
	# Scaled so one frame is 16 wide in the world whatever size the art was drawn at.
	var frame_w: float = s.texture.get_width() / 4.0
	var frame_h: float = s.texture.get_height() / 3.0
	s.scale = Vector2(16.0 / frame_w, 16.0 / frame_w)
	s.offset = Vector2(-frame_w / 2.0, -frame_h)
	if who == "Sara":
		holos.append(s)       # a hologram: she hovers over her pad and flickers
	s.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 16)
	s.visible = false
	actors.add_child(s)
	area_sprites.append([s, area_name])
	var here: Dictionary = blocked[area_name]
	here[tile] = true
	things.append({
		"kind": "person", "name": who, "hint": "Talk to %s" % who, "area": area_name,
		"pos": Vector2(tile.x * TILE + 8, tile.y * TILE + 10), "radius": radius, "who": who,
	})


# ---------------------------------------------------------------- pathfinding for residents

func _npc_walkable(area_name: String, t: Vector2i, goal_set: Dictionary) -> bool:
	var data: Dictionary = MapData.AREAS[area_name]
	var floor_rows: Array = data["floor"]
	if t.y < 0 or t.y >= floor_rows.size():
		return false
	var frow: String = floor_rows[t.y]
	if t.x < 0 or t.x >= frow.length():
		return false
	var fch: String = frow[t.x]
	if MapData.SOLID_FLOOR.contains(fch):
		return false
	var obj_rows: Array = data["obj"]
	var orow: String = obj_rows[t.y]
	var och: String = orow[t.x]
	if och != " " and not MapData.OPEN_OBJ.contains(och):
		return false
	var fixed_here: Dictionary = fixed[area_name]
	if fixed_here.has(t):
		return false
	# Residents only step on a lift or airlock pad when they mean to use it.
	var pads: Dictionary = warps[area_name]
	if pads.has(t) and not goal_set.has(t):
		return false
	return true


# Shortest walk from one tile to the nearest of the goal tiles. Returns the tiles to step on, in order.
func find_path(area_name: String, from: Vector2i, goals: Array) -> Array:
	var goal_set := {}
	for g in goals:
		goal_set[g] = true
	if goal_set.has(from):
		return []
	var came := {}
	came[from] = from
	var queue: Array = [from]
	var head := 0
	var found = null
	while head < queue.size():
		var cur: Vector2i = queue[head]
		head += 1
		if goal_set.has(cur):
			found = cur
			break
		for d in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
			var nb: Vector2i = cur + d
			if came.has(nb):
				continue
			if not _npc_walkable(area_name, nb, goal_set):
				continue
			came[nb] = cur
			queue.append(nb)
	if found == null:
		return []
	var path: Array = []
	var at: Vector2i = found
	while at != from:
		path.push_front(at)
		at = came[at]
	return path


# Which neighbouring area to head for first when travelling between two areas.
func next_area(from_area: String, to_area: String) -> String:
	var prev := {}
	prev[from_area] = ""
	var queue: Array = [from_area]
	var head := 0
	while head < queue.size():
		var cur: String = queue[head]
		head += 1
		if cur == to_area:
			break
		var links: Dictionary = area_links[cur]
		for nxt in links:
			if not prev.has(nxt):
				prev[nxt] = cur
				queue.append(nxt)
	if not prev.has(to_area):
		return ""
	var at: String = to_area
	while prev[at] != from_area:
		at = prev[at]
	return at


func pads_to(from_area: String, to_area: String) -> Array:
	var links: Dictionary = area_links[from_area]
	var pads: Array = links.get(to_area, [])
	return pads


# True when the player is standing on (or partly on) a tile of the area they are in.
func player_overlaps_tile(area_name: String, t: Vector2i) -> bool:
	if area_name != current_area:
		return false
	var ppos: Vector2 = player.position
	var feet := Rect2(ppos.x - 6.0, ppos.y - 7.0, 12.0, 8.0)
	return feet.intersects(Rect2(t.x * TILE, t.y * TILE, TILE, TILE))


func _usable(t: Dictionary) -> bool:
	if t["area"] != current_area:
		return false
	var kind: String = t["kind"]
	if kind == "pickup":
		return job_active and not player.carrying
	if kind == "drop":
		return player.carrying
	return true


func _nearest_thing():
	var best = null
	var best_d := 99999.0
	var ppos: Vector2 = player.position
	var from: Vector2 = ppos + Vector2(0, -4)
	for t in things:
		if not _usable(t):
			continue
		var pos: Vector2 = t["pos"]
		var radius: float = t["radius"]
		var d: float = from.distance_to(pos)
		if d <= radius and d < best_d:
			best = t
			best_d = d
	return best


func _interact(t: Dictionary) -> void:
	var kind: String = t["kind"]
	sfx("click")
	if kind == "person":
		_talk(t["who"])
	elif kind == "ore":
		_mine(t)
	elif kind == "smelt_iron":
		smelt_pos = t["pos"]
		_smelt("iron_ore", "iron_bar")
	elif kind == "smelt_copper":
		smelt_pos = t["pos"]
		_smelt("copper_ore", "copper_bar")
	elif kind == "board":
		_read_board()
	elif kind == "wreck":
		_look_at_ship()
	elif kind == "pickup":
		player.set_carrying(true)
		_toast("South lift off the town square, then the yellow pad in the cargo bay")
	elif kind == "drop":
		_deliver_crate()
	elif kind == "bed":
		_say("Your bunk", ["Sleep until morning?"], Callable(self, "_next_day"), "Sleep")
	elif kind == "wardrobe":
		if creator == null:
			_say("Locker", ["A spare uniform, neatly folded. Not your size."])
		else:
			_say("Locker", ["Spare clothes, a comb and a cracked mirror.", "Change how you look?"], Callable(self, "_open_wardrobe"), "Change")
	elif kind == "look":
		var thing_name: String = t["name"]
		var lines: Array = NpcData.LOOKS.get(thing_name, ["Nothing much to see."])
		_say(thing_name, lines)


# Opens the dialogue box, with a portrait and a voice when the speaker is a person.
# on_yes makes the last line a question; on_no (optional) runs if the player declines.
func _say(who: String, lines: Array, on_yes: Callable = Callable(), yes_text: String = "",
		on_no: Callable = Callable(), no_text: String = "Not now") -> void:
	var portrait: Texture2D = null
	dialogue.voice_pitch = 1.0
	if persons.has(who):
		portrait = persons[who]["portrait"]
		dialogue.voice_pitch = float(persons[who]["pitch"])
	# Swap {they}, {them}, {their}... for the player's pronouns (see scripts/player_maker.gd).
	var said: Array = []
	for line in lines:
		said.append(maker.with_pronouns(str(line), appearance) if maker != null else str(line))
	dialogue.start(who, said, on_yes, yes_text, portrait, on_no, no_text)


func _talk(who: String) -> void:
	var st: Dictionary = persons[who]
	if not st["talked_today"]:
		st["talked_today"] = true
		st["friendship"] = int(st["friendship"]) + 1
		_toast("%s  +1 friendship (%d)" % [who, st["friendship"]])
		if who == "Jasper":
			_give("ration", 1)
			_toast("Jasper  +1 friendship, and he hands you a ration pack")

	if not st["met"]:
		st["met"] = true
		_say(who, st["first"])
	elif _board_delivery(who):
		pass
	elif who == "Bram" and _bars_value() > 0:
		_bram_sell()
	elif who == "Bram" and not job_done_today:
		_bram_job()
	elif who == "Tikka" and repair_stage < REPAIRS.size():
		_tikka_repair()
	elif who == "Job" and (job_quest <= 2 or job_quest == 4):
		_job_quest_talk()
	elif who == "Vzz'ket" and job_quest == 3:
		_vzzket_weapon()
	else:
		_say(who, [_next_repeat(who)])


func _next_repeat(who: String) -> String:
	var st: Dictionary = persons[who]
	var repeat: Array = st["repeat"]
	var n: int = st["next"]
	st["next"] = n + 1
	var line: String = repeat[n % repeat.size()]
	return line


# ---------------------------------------------------------------- Bram's job

func _bram_job() -> void:
	if job_active:
		var left: int = JOB_CRATES - job_delivered
		_say("Bram", ["Fabrication shop next door, south lift off the square, yellow pad in the cargo bay. %d to go." % left])
	else:
		_say("Bram", [
			"%d crates from the fabrication shop next door, down to the cargo bay. %d credits each, and %d more for the last."
					% [JOB_CRATES, JOB_PAY_EACH, JOB_BONUS],
			"Interested?",
		], Callable(self, "_accept_job"), "Take the job")


func _accept_job() -> void:
	job_active = true
	job_delivered = 0
	_say("Bram", ["Good. Take the south lift off the square and look for the yellow pad in the cargo bay. One crate at a time."])


func _deliver_crate() -> void:
	player.set_carrying(false)
	job_delivered += 1
	credits += JOB_PAY_EACH
	sfx("coin")
	if job_delivered >= JOB_CRATES:
		credits += JOB_BONUS
		job_active = false
		job_done_today = true
		_toast("Job done  +%d cr  (Bram has more tomorrow)" % (JOB_PAY_EACH + JOB_BONUS))
	else:
		_toast("+%d cr  (%d of %d delivered)" % [JOB_PAY_EACH, job_delivered, JOB_CRATES])


# ---------------------------------------------------------------- ship repair

func _tikka_repair() -> void:
	var r: Dictionary = REPAIRS[repair_stage]
	var cost: int = r["cost"]
	var needs: Dictionary = r["needs"]
	var what: String = "%d credits and %s" % [cost, _needs_text(needs)]
	if credits >= cost and _has_all(needs):
		_say("Tikka", ["Next is the %s. That is %s. Shall I?" % [r["name"], what]],
				Callable(self, "_pay_repair"), "Hand it over")
	else:
		_say("Tikka", [
			"Next is the %s. I need %s." % [r["name"], what],
			"Plates come from iron bars and wire from copper bars. You can make both yourself, on the Crafting page of your pack.",
		])


func _pay_repair() -> void:
	var r: Dictionary = REPAIRS[repair_stage]
	var cost: int = r["cost"]
	var needs: Dictionary = r["needs"]
	credits -= cost
	for item in needs:
		_give(item, -int(needs[item]))
	repair_stage += 1
	sfx("quest")
	wreck_sprite.frame = repair_stage
	_toast("Ship repair %d of %d done" % [repair_stage, REPAIRS.size()])
	if repair_stage >= REPAIRS.size():
		_say("Tikka", [
			"[happy] That's everything. She will fly.",
			"Whether you should is not an engineering question.",
		])
	else:
		_say("Tikka", ["Done. Well, nearly done. Done enough to charge you for. Go and look, she's in the shuttle bay."])


func _look_at_ship() -> void:
	var lines: Array
	if repair_stage == 0:
		lines = ["What is left of it. The fold drive is gone and half the hull went with it.",
				"It isn't going anywhere. Not yet."]
	elif repair_stage == 1:
		lines = ["The hull is sealed. From some angles it looks like a ship again."]
	elif repair_stage == 2:
		lines = ["The fold drive hums when you put a hand on it. It still doesn't know where it is."]
	else:
		lines = ["She's whole. You could leave.", "(Launching comes in a later milestone.)"]
	_say("Your ship", lines)


# ---------------------------------------------------------------- sounds

func _setup_sounds() -> void:
	for sound_name in SOUND_NAMES:
		var p := AudioStreamPlayer.new()
		p.stream = load("res://audio/%s.wav" % sound_name)
		add_child(p)
		sounds[sound_name] = p
	music = AudioStreamPlayer.new()
	music.volume_db = -16.0
	add_child(music)
	music.finished.connect(music.play)      # loop


func _play_music(track: String) -> void:
	if track == music_name:
		return
	music_name = track
	var path: String = "res://audio/music_%s.ogg" % track
	if not ResourceLoader.exists(path):
		path = "res://audio/music_%s.wav" % track
	if not ResourceLoader.exists(path):
		music.stop()
		return
	music.stream = load(path)
	if music_on:
		music.play()


func _toggle_music() -> void:
	music_on = not music_on
	if music_on:
		music.play()
		_toast("Music on")
	else:
		music.stop()
		_toast("Music off  (M turns it back on)")


func sfx(sound_name: String, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	if not sounds.has(sound_name):
		return
	var p: AudioStreamPlayer = sounds[sound_name]
	p.pitch_scale = pitch
	p.volume_db = volume_db
	p.play()


# ---------------------------------------------------------------- items

func _count(item: String) -> int:
	return int(items.get(item, 0))


func count_of(item: String) -> int:
	return _count(item)


# Adds (or with a negative number, removes) items, and keeps the inventory slots in step.
func _give(item: String, n: int) -> void:
	items[item] = maxi(0, _count(item) + n)
	_sync_slots()


# Every item you hold sits in exactly one slot; items you run out of leave their slot.
func _sync_slots() -> void:
	while slots.size() < SLOT_COUNT:
		slots.append("")
	for i in slots.size():
		var held_item: String = slots[i]
		if held_item != "" and (_count(held_item) <= 0 or not ItemData.ITEMS.has(held_item) or slots.find(held_item) != i):
			slots[i] = ""
	for item in items:
		if _count(item) > 0 and ItemData.ITEMS.has(item) and not slots.has(item):
			var free: int = slots.find("")
			if free != -1:
				slots[free] = item


func swap_slots(a: int, b: int) -> void:
	var moved: String = slots[a]
	slots[a] = slots[b]
	slots[b] = moved


func _item_name(item: String) -> String:
	var info: Dictionary = ItemData.ITEMS[item]
	var item_name: String = info["name"]
	return item_name


func _has_all(needs: Dictionary) -> bool:
	for item in needs:
		if _count(item) < int(needs[item]):
			return false
	return true


func _needs_text(needs: Dictionary) -> String:
	var parts := PackedStringArray()
	for item in needs:
		parts.append("%d %s" % [int(needs[item]), _item_name(item).to_lower()])
	return " and ".join(parts)


# Called from the Crafting page of the menu.
func craft(index: int) -> bool:
	var recipe: Dictionary = ItemData.RECIPES[index]
	var needs: Dictionary = recipe["needs"]
	if not _has_all(needs):
		sfx("deny")
		return false
	for item in needs:
		_give(item, -int(needs[item]))
	var makes: String = recipe["makes"]
	_give(makes, int(recipe["n"]))
	sfx("quest", 1.3)
	return true


# ---------------------------------------------------------------- using the selected hotbar item (Space)

func _selected_use() -> String:
	var item: String = slots[selected]
	if item == "":
		return ""
	var info: Dictionary = ItemData.ITEMS[item]
	var use: String = info["use"]
	return use


func _nearest_of_kind(kind: String):
	var best = null
	var best_d := 99999.0
	var ppos: Vector2 = player.position
	var from: Vector2 = ppos + Vector2(0, -4)
	for t in things:
		if t["kind"] != kind or t["area"] != current_area:
			continue
		var pos: Vector2 = t["pos"]
		var radius: float = t["radius"]
		var d: float = from.distance_to(pos)
		if d <= radius and d < best_d:
			best = t
			best_d = d
	return best


func _use_tool() -> void:
	var use: String = _selected_use()
	var item: String = slots[selected]
	if use == "mine":
		# Cut the vein under the mouse pointer if it is in reach, otherwise the nearest one.
		var vein = _thing_under_mouse()
		if vein == null or vein["kind"] != "ore" or not _in_reach(vein):
			vein = _nearest_of_kind("ore")
		if vein != null:
			_mine(vein)
		else:
			sfx("deny")
			_toast("Stand next to an ore vein to use the laser")
	elif use == "weapon":
		if swing_cd > 0.0:
			return
		swing_cd = 0.32
		player.swing(item)
		sfx("swing", randf_range(0.9, 1.1))
		_swing_hits(item)
	elif use == "eat":
		_eat(item)


func _item_icon(item: String) -> int:
	var info: Dictionary = ItemData.ITEMS[item]
	var icon: int = info["icon"]
	return icon


# ---------------------------------------------------------------- mining and smelting

func _mine(t: Dictionary) -> void:
	var node: Dictionary = ore_nodes[int(t["node"])]
	var item: String = node["item"]
	if _count("laser") <= 0:
		sfx("deny")
		_say("Ore vein", ["A seam of ore in solid rock. You would need a mining laser to cut it. Job might have a spare."])
		return
	if _selected_use() != "mine":
		sfx("deny")
		_toast("Select the mining laser on your hotbar (number keys) first")
		return
	if int(node["hits"]) <= 0:
		sfx("deny")
		_toast("Worked out for today")
		return
	node["hits"] = int(node["hits"]) - 1
	if int(node["hits"]) <= 0:
		var s: Sprite2D = node["sprite"]
		s.frame = 1
	_give(item, 1)
	minutes += 10.0           # each cut takes ten minutes
	sfx("zap", randf_range(0.9, 1.1))
	player.fire_laser(t["pos"], _item_icon("laser"))
	var vein_pos: Vector2 = t["pos"]
	_pop_item(item, vein_pos + Vector2(0, -10))
	_toast("+1 %s  (%d)" % [_item_name(item), _count(item)])


func _reset_nodes() -> void:
	for node in ore_nodes:
		node["hits"] = NODE_HITS
		var s: Sprite2D = node["sprite"]
		s.frame = 0


func _smelt(ore: String, bar: String) -> void:
	if job_quest < 2:
		sfx("deny")
		_say("Furnace", ["The furnaces are cold. Job runs ore processing. Ask him about it."])
		return
	if _count(ore) < ORE_PER_BAR:
		sfx("deny")
		_say("Furnace", ["You need %d %s to pour a bar. You have %d." % [ORE_PER_BAR, _item_name(ore).to_lower(), _count(ore)]])
		return
	_say("Furnace", ["Smelt %d %s into 1 %s?" % [ORE_PER_BAR, _item_name(ore).to_lower(), _item_name(bar).to_lower()]],
			Callable(self, "_do_smelt").bind(ore, bar), "Smelt")


func _do_smelt(ore: String, bar: String) -> void:
	_give(ore, -ORE_PER_BAR)
	_give(bar, 1)
	minutes += 20.0
	sfx("smelt")
	_flash(smelt_pos + Vector2(0, 2), Color(1.0, 0.6, 0.25), 2.2)
	_pop_item(bar, smelt_pos + Vector2(0, -14))
	_toast("+1 %s  (%d)" % [_item_name(bar), _count(bar)])
	if job_quest == 2:
		job_quest = 3
		sfx("quest")


# ---------------------------------------------------------------- Job's quest and the weapon

func _job_quest_talk() -> void:
	if job_quest == 0:
		_say("Job", [
			"[happy] Say, you lookin' for work? I got more rock than I got hands.",
			"Take my spare laser. Cut me %d iron ore and %d copper ore out them veins, and I'll show you what we do with it." % [JOB_IRON, JOB_COPPER],
		], Callable(self, "_take_laser"), "Take the laser")
	elif job_quest == 1:
		if _count("iron_ore") >= JOB_IRON and _count("copper_ore") >= JOB_COPPER:
			job_quest = 2
			credits += 40
			sfx("quest")
			_toast("Job's request done  +40 cr")
			_say("Job", [
				"[happy] Well look at that. Clean cuts, too. Here, 40 credits, and you keep the ore, cher.",
				"Smelter's up in ore processing, engineering level, far left. Two ore pours one bar. Bram buys bars.",
				"Once you poured your first, go see Vzz'ket down at the gate. There's old tunnels north of here I want opened, and you ain't goin' in bare-handed.",
			])
		else:
			_say("Job", ["Iron's the red veins, copper's the green. You got %d of %d iron and %d of %d copper."
					% [_count("iron_ore"), JOB_IRON, _count("copper_ore"), JOB_COPPER]])
	elif job_quest == 4:
		if tunnel_kills >= TUNNEL_GOAL:
			job_quest = 5
			credits += 80
			sfx("quest")
			_toast("The north tunnels are open  +80 cr")
			_say("Job", [
				"[happy] I heard the ruckus clear down here. That's the tunnels safe enough to work. Here, 80 credits.",
				"Veins up there ain't been touched in years, and Bram'll buy them shells and hides off you.",
				"[sad] The caverns under the gate, now, that's another matter. Vzz'ket won't hear of it yet, and he's right.",
			])
		else:
			_say("Job", ["Way up's at the top of the dig, north wall. Thin them critters out some. You got %d of %d." % [tunnel_kills, TUNNEL_GOAL]])
	else:
		_say("Job", ["Smelter's in ore processing, engineering level, far left. Two ore, one bar. Then go see Vzz'ket at the gate."])


func _take_laser() -> void:
	_give("laser", 1)
	job_quest = 1
	sfx("quest")
	_toast("Got: mining laser")
	_say("Job", [
		"Point the bright end at the rock. Veins give out after a couple cuts, but they settle back by mornin'.",
		"(Pick the laser on your hotbar with the number keys, then press Space next to a vein.)",
	])


func _vzzket_weapon() -> void:
	_say("Vzz'ket", [
		"[angry] Job wants the north tunnels opened. Bugs and rock lizards. Small, but they bite. You will not go unarmed.",
		"These are old Zaa'sh arms. The spear stabs, far and narrow. The sword swings, near and wide. Choose.",
	], Callable(self, "_choose_weapon").bind("spear"), "Spear", Callable(self, "_choose_weapon").bind("sword"), "Sword")


func _choose_weapon(kind: String) -> void:
	weapon = kind
	_give(kind, 1)
	job_quest = 4
	sfx("quest")
	_toast("Got: Zaa'sh %s" % kind)
	_say("Vzz'ket", ["[sad] It was my clutch-brother's. Bring it back clean.",
			"The way up is at the top of the main dig. Clear out six of them, then tell Job.",
			"(Select it on your hotbar and press Space or click to swing. A ration pack from Jasper mends you.)"])


# ---------------------------------------------------------------- selling to Bram

func _bars_value() -> int:
	var total := 0
	for item in SELL:
		total += _count(item) * int(SELL[item])
	return total


func _bram_sell() -> void:
	_say("Bram", ["[happy] Now those I can move. %d bars, %d shells and hides. I'll give you %d credits for the lot."
			% [_count("iron_bar") + _count("copper_bar"), _count("chitin") + _count("hide"), _bars_value()]],
			Callable(self, "_do_sell"), "Sell all", Callable(self, "_bram_default"), "Keep them")


func _do_sell() -> void:
	var value: int = _bars_value()
	for item in SELL:
		items[item] = 0
	_sync_slots()
	credits += value
	sfx("coin")
	_toast("Sold  +%d cr" % value)


func _bram_default() -> void:
	if not job_done_today:
		_bram_job()
	else:
		_say("Bram", [_next_repeat("Bram")])


# ---------------------------------------------------------------- bulletin board
# One request is posted each day. Take it at the board, then bring the items to whoever asked.

func _board_request() -> Dictionary:
	var req: Dictionary = BOARD[(day - 1) % BOARD.size()]
	return req


func _read_board() -> void:
	var req: Dictionary = _board_request()
	var today: String = "Day %d, %s. Dinner in the mess hall at 18:00, every day." % [day, WEEKDAYS[(day - 1) % 7]]
	if board_done_day == day:
		_say("Bulletin board", [today, "Nothing else is posted today."])
	elif board_taken_day == day:
		_say("Bulletin board", [today, "You took today's request: %s" % req["text"]])
	else:
		_say("Bulletin board", [today, req["text"], "Take this request?"], Callable(self, "_take_request"), "Take it")


func _take_request() -> void:
	board_taken_day = day
	sfx("click")
	_toast("Request taken. It comes down at the end of the day.")


func _board_delivery(who: String) -> bool:
	if board_taken_day != day or board_done_day == day:
		return false
	var req: Dictionary = _board_request()
	var asker: String = req["who"]
	var item: String = req["item"]
	var n: int = req["n"]
	var pay: int = req["pay"]
	if asker != who or _count(item) < n:
		return false
	_give(item, -n)
	credits += pay
	board_done_day = day
	var st: Dictionary = persons[who]
	st["friendship"] = int(st["friendship"]) + 2
	sfx("quest")
	_toast("Request done  +%d cr, +2 friendship" % pay)
	var thanks: String = req["thanks"]
	_say(who, [thanks])
	return true


# What the player is working on, for the line under the clock.
func _objective() -> String:
	var parts := PackedStringArray()
	if job_quest == 1:
		parts.append("Job: iron ore %d/%d, copper ore %d/%d" % [_count("iron_ore"), JOB_IRON, _count("copper_ore"), JOB_COPPER])
	elif job_quest == 2:
		parts.append("Job: smelt a bar in ore processing (Engineering)")
	elif job_quest == 3:
		parts.append("Job: see Vzz'ket at the cavern gate")
	elif job_quest == 4 and tunnel_kills < TUNNEL_GOAL:
		parts.append("Job: clear the north tunnels, top of the main dig (%d/%d)" % [tunnel_kills, TUNNEL_GOAL])
	elif job_quest == 4:
		parts.append("Job: tell him the tunnels are clear")
	if board_taken_day == day and board_done_day != day:
		var req: Dictionary = _board_request()
		var item: String = req["item"]
		parts.append("Board: %d %s for %s" % [int(req["n"]), _item_name(item).to_lower(), req["who"]])
	return "   ".join(parts)


# ---------------------------------------------------------------- combat

func _spawn_enemies() -> void:
	for e in MapData.ENEMIES:
		var kind: String = e[0]
		var enemy_area: String = e[1]
		var en = EnemyScript.new()
		en.setup(self, kind, enemy_area, Vector2(int(e[2]) * TILE + 8, int(e[3]) * TILE + 12))
		en.visible = false
		actors.add_child(en)
		enemies.append(en)


func _reset_enemies() -> void:
	for en in enemies:
		en.reset()
		en.visible = en.area == current_area


# The spear stabs far and narrow; the sword swings near and wide.
func _swing_hits(kind: String) -> void:
	var dir: Vector2 = player.facing()
	var ppos: Vector2 = player.position
	var origin: Vector2 = ppos + Vector2(0, -8)
	var reach: float = 38.0 if kind == "spear" else 26.0
	var half_angle: float = 0.45 if kind == "spear" else 1.25
	for en in enemies:
		if not en.alive or en.area != current_area:
			continue
		var epos: Vector2 = en.position
		var v: Vector2 = epos + Vector2(0, -6) - origin
		if v.length() <= reach and absf(dir.angle_to(v)) <= half_angle:
			en.hurt(WEAPON_DAMAGE, dir)


func enemy_died(en) -> void:
	sfx("die", randf_range(0.9, 1.1))
	var drop: String = en.drop_item()
	var epos: Vector2 = en.position
	_give(drop, 1)
	_pop_item(drop, epos + Vector2(0, -8))
	if en.area == "tunnels" and job_quest == 4:
		tunnel_kills += 1
		if tunnel_kills == TUNNEL_GOAL:
			sfx("quest")
			_toast("The tunnels are quieter. Tell Job.")


func hurt_player(amount: int, from: Vector2) -> void:
	if hurt_cd > 0.0 or dialogue.active or ui.open:
		return
	hurt_cd = 0.9
	hp -= amount
	sfx("hurt")
	var ppos: Vector2 = player.position
	player.knock((ppos - from).normalized() * 14.0)
	player.flash()
	if hp <= 0:
		_collapse()


# Out of health: you wake up back in your quarters, two hours later and a little poorer.
func _collapse() -> void:
	hp = MAX_HP / 2
	var lost: int = credits / 10
	credits -= lost
	minutes = minf(minutes + 120.0, DAY_END - 1.0)
	player.set_carrying(false)
	_go_home()
	_snap_residents()
	_reset_enemies()
	_say("Sara", [
		"[sad] Vzz'ket carried you back from the tunnels. You have been out for two hours.",
		"[angry] You dropped %d credits on the way. Do try not to make a habit of this." % lost,
	])


func _eat(item: String) -> void:
	if hp >= MAX_HP:
		_toast("You're not hurt")
		return
	_give(item, -1)
	hp = mini(MAX_HP, hp + 5)
	sfx("eat")
	_toast("Ration pack six. It restores you, and that is all that can be said for it.")


# ---------------------------------------------------------------- little effects

# An item's picture that floats up and fades (when you gain something).
func _pop_item(item: String, at: Vector2) -> void:
	var info: Dictionary = ItemData.ITEMS[item]
	var icon: int = info["icon"]
	var s := Sprite2D.new()
	s.texture = items_tex
	s.region_enabled = true
	var icon_size: float = items_tex.get_height()     # icons can be any size; shown 16 wide
	s.region_rect = Rect2(icon * icon_size, 0, icon_size, icon_size)
	s.scale = Vector2.ONE * (16.0 / icon_size)
	s.position = at
	top_fx.add_child(s)
	pops.append([s, 0.9, 18.0])


# A burst of light that fades (the furnace when you smelt).
func _flash(at: Vector2, color: Color, size: float) -> void:
	var s := Sprite2D.new()
	s.texture = glow_tex
	s.material = glow_mat
	s.modulate = color
	s.scale = Vector2(size, size)
	s.position = at
	top_fx.add_child(s)
	pops.append([s, 0.7, 0.0])


func _update_pops(delta: float) -> void:
	for i in range(pops.size() - 1, -1, -1):
		var entry: Array = pops[i]
		var s: Sprite2D = entry[0]
		var left: float = float(entry[1]) - delta
		entry[1] = left
		s.position.y -= float(entry[2]) * delta
		s.modulate.a = clampf(left / 0.4, 0.0, 1.0)
		if left <= 0.0:
			s.queue_free()
			pops.remove_at(i)


# ---------------------------------------------------------------- clicking on things

# The thing under the mouse pointer, if there is one.
func _thing_under_mouse():
	var at: Vector2 = get_global_mouse_position()
	for t in things:
		if not _usable(t):
			continue
		var pos: Vector2 = t["pos"]
		var radius: float = t["radius"]
		if radius >= 40.0:
			if at.distance_to(pos) <= radius * 0.6:
				return t
		elif absf(at.x - pos.x) <= 9.0 and at.y - pos.y >= -26.0 and at.y - pos.y <= 8.0:
			return t
	return null


func _in_reach(t: Dictionary) -> bool:
	var ppos: Vector2 = player.position
	var pos: Vector2 = t["pos"]
	var radius: float = t["radius"]
	return (ppos + Vector2(0, -4)).distance_to(pos) <= radius + 6.0


# Interact with what was clicked if it is close enough; otherwise with whatever is nearest.
func _interact_clicked() -> void:
	var t = _thing_under_mouse()
	if t == null:
		_interact_nearest()
	elif _in_reach(t):
		_interact(t)
	else:
		_toast("Too far away")


# ---------------------------------------------------------------- UI and clock

func _build_ui() -> void:
	var hud := CanvasLayer.new()
	hud.layer = 5
	add_child(hud)
	hud_clock = _hud_label(hud, Vector2(4, 2), Vector2(150, 12))
	hud_goal = _hud_label(hud, Vector2(156, 2), Vector2(160, 12))
	hud_goal.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	hud_zone = _hud_label(hud, Vector2(4, 166), Vector2(150, 12))
	hud_zone.add_theme_color_override("font_color", Color("9fdcff"))
	hud_toast = _hud_label(hud, Vector2(4, 14), Vector2(312, 12))
	hud_toast.add_theme_color_override("font_color", Color("ffd27f"))
	hud_quest = _hud_label(hud, Vector2(4, 26), Vector2(312, 12))
	hud_quest.add_theme_color_override("font_color", Color("b8f0b0"))
	hud_hint = _hud_label(hud, Vector2(4, 146), Vector2(312, 12))
	hud_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

	dialogue = DialogueScript.new()
	add_child(dialogue)

	var ui_layer := CanvasLayer.new()
	ui_layer.layer = 8
	add_child(ui_layer)
	ui = UiScript.new()
	ui.world = self
	ui_layer.add_child(ui)

	# The character screen, if the layered player art is installed (art/player/).
	maker = MakerScript.new()
	if maker.load_layers():
		var top_layer := CanvasLayer.new()
		top_layer.layer = 12
		add_child(top_layer)
		creator = CreatorScript.new()
		creator.world = self
		creator.maker = maker
		top_layer.add_child(creator)


func _open_wardrobe() -> void:
	creator.show_for(appearance if not appearance.is_empty() else maker.defaults(), false)


# Called by the character screen when the player is happy with their look.
func set_appearance(look: Dictionary) -> void:
	appearance = maker.tidy(look)
	player.set_sheet(maker.sheet(appearance))
	_save_game()


func _hud_label(parent: Node, pos: Vector2, size: Vector2) -> Label:
	var l := Label.new()
	l.position = pos
	l.size = size
	l.add_theme_font_size_override("font_size", 8)
	l.add_theme_color_override("font_outline_color", Color.BLACK)
	l.add_theme_constant_override("outline_size", 3)
	parent.add_child(l)
	return l


func _toast(msg: String) -> void:
	hud_toast.text = msg
	toast_time = 3.5


func _process(delta: float) -> void:
	var paused: bool = dialogue.active or ui.open or (creator != null and creator.open)
	player.frozen = paused
	tint.color = _light_color()
	_animate()
	_update_pops(delta)

	if not paused:
		minutes += delta / SECONDS_PER_GAME_MINUTE
		if minutes >= DAY_END:
			_next_day()
		for r in residents:
			r.tick(delta, minutes)
		for en in enemies:
			en.tick(delta)
		hurt_cd = maxf(0.0, hurt_cd - delta)
		swing_cd = maxf(0.0, swing_cd - delta)

		# Lifts, the airlock and the mine ramp: step on the pad to travel.
		var here: Dictionary = warps[current_area]
		var tile: Vector2i = _player_tile()
		if here.has(tile):
			var dest: Array = here[tile]
			var dest_area: String = dest[0]
			if dest_area == "tunnels" and weapon == "":
				# Not without a weapon: step back down.
				player.position += Vector2(0, 24)
				_toast("Job: \"Not up there bare-handed, cher. See Vzz'ket first.\"")
				sfx("deny")
			else:
				_go_to(dest_area, Vector2i(int(dest[1]), int(dest[2])))

	var m := int(minutes)
	hud_clock.text = "Day %d   %02d:%02d   %d cr" % [day, m / 60, m % 60, credits]
	hud_zone.text = _zone_name()
	hud_quest.text = _objective()

	var goal: String = "Ship %d/%d" % [repair_stage, REPAIRS.size()]
	if job_active:
		goal = "Crates %d/%d   %s" % [job_delivered, JOB_CRATES, goal]
	hud_goal.text = goal

	if toast_time > 0.0:
		toast_time -= delta
		if toast_time <= 0.0:
			hud_toast.text = ""

	var t = null
	if not paused:
		t = _nearest_thing()
	if t != null:
		hud_hint.text = "[E]  %s" % t["hint"]
	else:
		hud_hint.text = ""


func _next_day() -> void:
	day += 1
	minutes = float(DAY_START)
	job_active = false
	job_delivered = 0
	job_done_today = false
	player.set_carrying(false)
	hp = MAX_HP
	_reset_enemies()
	_reset_nodes()
	for who in persons:
		persons[who]["talked_today"] = false
	_go_home()
	_snap_residents()
	_save_game()
	_toast("Day %d  (saved)" % day)


# ---------------------------------------------------------------- saving
# The game saves each morning. F9 wipes the save.

func _save_game() -> void:
	var cfg := ConfigFile.new()
	cfg.set_value("game", "day", day)
	cfg.set_value("game", "credits", credits)
	cfg.set_value("game", "repair_stage", repair_stage)
	cfg.set_value("game", "items", items)
	cfg.set_value("game", "slots", slots)
	cfg.set_value("game", "selected", selected)
	cfg.set_value("game", "weapon", weapon)
	cfg.set_value("game", "job_quest", job_quest)
	cfg.set_value("game", "tunnel_kills", tunnel_kills)
	cfg.set_value("game", "board_taken_day", board_taken_day)
	cfg.set_value("game", "board_done_day", board_done_day)
	if not appearance.is_empty():
		cfg.set_value("game", "appearance", appearance)
	for who in persons:
		var st: Dictionary = persons[who]
		var section: String = "npc_%s" % st["id"]
		cfg.set_value(section, "met", st["met"])
		cfg.set_value(section, "friendship", st["friendship"])
		cfg.set_value(section, "next", st["next"])
	cfg.save(SAVE_PATH)


func _load_game() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SAVE_PATH) != OK:
		return
	day = int(cfg.get_value("game", "day", 1))
	credits = int(cfg.get_value("game", "credits", 0))
	repair_stage = clampi(int(cfg.get_value("game", "repair_stage", 0)), 0, REPAIRS.size())
	var saved_items = cfg.get_value("game", "items", {})
	if saved_items is Dictionary:
		items = saved_items
	weapon = str(cfg.get_value("game", "weapon", ""))
	# Saves from before the hotbar kept the laser and weapon as flags; turn them into items.
	if bool(cfg.get_value("game", "has_laser", false)):
		items["laser"] = 1
	if weapon != "":
		items[weapon] = 1
	var saved_slots = cfg.get_value("game", "slots", [])
	if saved_slots is Array:
		slots = saved_slots
	selected = clampi(int(cfg.get_value("game", "selected", 0)), 0, 7)
	_sync_slots()
	job_quest = int(cfg.get_value("game", "job_quest", 0))
	tunnel_kills = int(cfg.get_value("game", "tunnel_kills", 0))
	board_taken_day = int(cfg.get_value("game", "board_taken_day", 0))
	board_done_day = int(cfg.get_value("game", "board_done_day", 0))
	var saved_look = cfg.get_value("game", "appearance", {})
	if saved_look is Dictionary and not saved_look.is_empty() and maker != null:
		appearance = maker.tidy(saved_look)
	for who in persons:
		var st: Dictionary = persons[who]
		var section: String = "npc_%s" % st["id"]
		st["met"] = bool(cfg.get_value(section, "met", false))
		st["friendship"] = int(cfg.get_value(section, "friendship", 0))
		st["next"] = int(cfg.get_value(section, "next", 0))
