# Opens the dialogue box, with a portrait and a voice when the speaker is a person.
# on_yes makes the last line a question; on_no (optional) runs if the player declines.
func _say(who: String, lines: Array, on_yes: Callable = Callable(), yes_text: String = "",
		on_no: Callable = Callable(), no_text: String = "Not now", face_of: String = "") -> void:
	# face_of: whose portrait and voice to use when the name shown is a label, e.g. "Tikka (comms)"
	var face: String = face_of if face_of != "" else who
	var portrait: Texture2D = null
	dialogue.voice_pitch = 1.0
	if persons.has(face):
		portrait = persons[face]["portrait"]
		dialogue.voice_pitch = float(persons[face]["pitch"])
	elif face != "" and ResourceLoader.exists("res://art/portrait_%s.png" % face.to_lower()):
		portrait = load(portrait_path(face.to_lower()))
	# Swap {they}, {them}, {their}... for the player's pronouns (see scripts/player_maker.gd).
	var said: Array = []
	for line in lines:
		said.append(maker.with_pronouns(str(line), appearance) if maker != null else str(line))
	dialogue.start(who, said, on_yes, yes_text, portrait, on_no, no_text)


# A question with several answers, listed in the talk box under the last line (a cutscene's choices): on_pick
# gets the number of the one taken. Portrait, voice and pronouns as _say.
func _say_choice(who: String, lines: Array, options: Array, on_pick: Callable, face_of: String = "") -> void:
	var face: String = face_of if face_of != "" else who
	var portrait: Texture2D = null
	dialogue.voice_pitch = 1.0
	if persons.has(face):
		portrait = persons[face]["portrait"]
		dialogue.voice_pitch = float(persons[face]["pitch"])
	elif face != "" and ResourceLoader.exists("res://art/portrait_%s.png" % face.to_lower()):
		portrait = load(portrait_path(face.to_lower()))
	var said: Array = []
	for line in lines:
		said.append(maker.with_pronouns(str(line), appearance) if maker != null else str(line))
	var answers: Array = []
	for o in options:
		answers.append(maker.with_pronouns(str(o), appearance) if maker != null else str(o))
	dialogue.start_choice(who, said, answers, on_pick, portrait)


# Run cb when the dialogue just started runs out of lines (call it right after _say). Used to chain story beats.
func _say_then(cb: Callable) -> void:
	dialogue.on_done = cb


# S.A.R.A.'s rest night (her 8, "Night Shift": you kept watch, sara_rest): Sundays from 23:00 her pads stand by
# until morning, and she can't be talked to. Her one hour off a week, and then some.
func _sara_resting() -> bool:
	return bool(story_flags.get("sara_rest", false)) and (day - 1) % 7 == 6 and minutes >= 23 * 60


func _sara_rest_tick() -> void:
	var resting: bool = _sara_resting()
	for pair in sara_nodes:
		var h = pair[0]
		if resting and h.current_clip != "standby":
			h.play("standby")
		elif not resting and h.current_clip == "standby":
			h.play("wake")


func _talk(who: String) -> void:
	if who == "Sara" and _sara_resting():
		_say("", ["S.A.R.A.'s pad hums softly in standby. A little sign floats over it: BACK AT 06:00. SORRY. (NOT SORRY.)"])
		return
	var st: Dictionary = persons[who]
	var first_today: bool = st["met"] and not st["talked_today"]
	if who == "Sara":
		sfx("sara_holo", 1.0, -4.0)
		_sara_play("greeting" if not st["met"] else ["explain", "talk_both", "nod", "head_tilt", "laugh"].pick_random())
	if not st["met"]:
		_emote(who, &"hello")
	elif not st["talked_today"]:
		_emote(who, &"joy")
	if not st["talked_today"]:
		st["talked_today"] = true
		_add_friendship(who, TALK_POINTS)
		_toast("%s  +%d friendship (%d hearts)" % [who, TALK_POINTS, _hearts(who)])
		if who == "Jasper":
			_give("ration", 1)
			_toast("Jasper  +%d friendship, and he hands you a ration pack" % TALK_POINTS)

	if not st["met"]:
		st["met"] = true
		# The first-meeting lines are spoken at work ("This is my bar", "Welcome to the library"). Met
		# anywhere else, they say hello plainly and keep the proper welcome for their own place.
		if _at_workplace(who):
			_say(who, st["first"])
		else:
			st["intro_due"] = true
			_say(who, [_plain_intro(who)])
	elif bool(st.get("intro_due", false)) and _at_workplace(who):
		st["intro_due"] = false
		_say(who, st["first"])
	elif _board_delivery(who):
		pass
	elif _farewell(who):
		pass
	elif who == "Tar'Besh" and _first_relic() != "":
		_offer_relic("Tar'Besh")
	elif who == "Tikka" and repair_stage < REPAIRS.size() and not _at_workplace(who):
		_tikka_repair()
	elif who == "Job" and (job_quest <= 2 or job_quest == 4):
		_job_quest_talk()
	elif who == "Vzz'ket" and job_quest == 3:
		_vzzket_weapon()
	elif who == "Vzz'ket" and job_quest >= 5 and not caverns_open:
		_cavern_gate()
	elif who == "Sara" and repairs_said_day != day and _repair_to_mention() != "":
		_sara_repairs(_repair_to_mention())
	elif who == "Rusk" and _rusk_cask_talk():
		pass
	elif crew_cross.has(who) and day - int(crew_cross[who]) <= 1:
		crew_cross.erase(who)
		if persons.has(who):
			persons[who]["friendship"] = maxi(0, int(persons[who]["friendship"]) - 2)
		var cross_lines: Dictionary = {
			"Freya": ["[angry] I woke up in Maren's Medbay with a burn on my arm and no idea how the fight ended.",
				"[sad] I said I'd fly with you. I didn't say I'd be left behind. Next time, watch my back."],
			"Ana": ["[angry] You sent me in and you didn't pull me out. I've had captains like that. I left them.",
				"[sad] ...Ask me again when you've got a tether. Or a plan."],
		}
		_say(who, cross_lines.get(who, ["[angry] Don't do that to me again."]))
	elif who == "Freya" and flights >= 2 and not said_covered:
		said_covered = true
		_say("Freya", ["Now you're flying for real, there's something under that tarp at the back of the bay you should see.",
			"An old fighter with a crew deck. She's been there since before me. Bring me parts and I'll bring her back.",
			"And my bench is yours: anything you want fitted to your ship, that's where we do it."])

		_freya_ship_repair()
	elif SHOP_HELLO.has(who) and _in_shop(who):
		_shop_offer(who, first_today)
	elif who == "Sara" and _flag("perk_concierge"):
		_say("Sara", ["[happy] Going somewhere? Any pad of mine, door to door."], Callable(shops, "open").bind("Concierge"),
				"Travel", Callable(self, "_chat").bind("Sara", first_today), "Just talk")
	else:
		_chat(who, first_today)


# Everyday talk: two chats a day, as in Stardew; business (jobs, shops, quests) and birthdays are not counted.
# first_today: the first time you've spoken today (_talk has already marked it), when the day line comes first.
func _chat(who: String, first_today := false) -> void:
	var st: Dictionary = persons[who]
	if int(st.get("talks_today", 0)) >= TALKS_PER_DAY and not _special_day(who):
		_emote(who, &"wait")
		_toast("%s has said all there is to say today." % who)
	elif first_today and _day_line(who) != "":
		st["talks_today"] = int(st.get("talks_today", 0)) + 1
		_say(who, [_day_line(who)])
	else:
		st["talks_today"] = int(st.get("talks_today", 0)) + 1
		var activity_line := _activity_dialogue(who)
		_say(who, [activity_line if activity_line != "" else _next_repeat(who)])


