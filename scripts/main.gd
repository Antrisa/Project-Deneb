# ---------------------------------------------------------------- farming (21 Nov)
# Stardew-style, one tile at a time on the field in the Agri dome (MapData.FARM_FIELDS): dig a tile with the hoe,
# plant seeds on it, water it, and each night a watered crop grows a day. Right-click a ripe crop to pick it.
# One tile is one character wide. The crops are placeholders until the economy chat's crop list.
const FARM_ENERGY := 2              # energy per dig or watering, as in Stardew
const CROPS := {
	"crater_potato": {"days": 4, "stages": 4, "regrow": 0, "item": "crater_potato"},
	"moon_wheat": {"days": 3, "stages": 3, "regrow": 0, "item": "moon_wheat"},
	"star_tomato": {"days": 6, "stages": 4, "regrow": 3, "item": "star_tomato"},
	"nebula_grape": {"days": 8, "stages": 5, "regrow": 3, "item": "nebula_grape"},     # Rusk's 8 (art/farm/crops)
	# fruit trees, from the Sovereign of Hydro-Flora's saplings (24 Nov): art/farm/crops/<id>.png, 48 x 72 a stage
	"moon_peach_tree": {"days": 21, "stages": 4, "regrow": 4, "item": "moon_peach"},
	"star_apple_tree": {"days": 21, "stages": 4, "regrow": 4, "item": "star_apple"},
	"sun_fig_tree": {"days": 21, "stages": 4, "regrow": 4, "item": "sun_fig"},
}


# Farming (23 Nov, Zachary: "just have it all be dirt ... you can till if you want or place objects like the
# hydroponic beds"): every open soil tile ("a") of the Agri dome can be dug, planted, or take a hydroponic bed.
func farmable(tile: Vector2i) -> bool:
	if current_area != "agri":
		return false
	var rows: Array = MapData.AREAS[current_area]["floor"]
	if tile.y < 0 or tile.y >= rows.size():
		return false
	var row: String = rows[tile.y]
	if tile.x < 0 or tile.x >= row.length() or row[tile.x] != "a":
		return false
	if farm.has(tile):
		return true
	return not solid_at(Vector2(tile.x * TILE + 8, tile.y * TILE + 8))


func farm_field() -> Rect2i:
	var f: Array = MapData.FARM_FIELDS.get(current_area, [])
	if f.size() != 4: return Rect2i()
	return Rect2i(int(f[0]), int(f[1]), int(f[2]), int(f[3]))


# The tile a farm tool works on: the one under the mouse if it touches yours, otherwise the one you face.
func farm_target() -> Vector2i:
	var here: Vector2i = _player_tile()
	var m: Vector2 = player.get_global_mouse_position()
	var under := Vector2i(floori(m.x / TILE), floori(m.y / TILE))
	if under != here and absi(under.x - here.x) <= 1 and absi(under.y - here.y) <= 1:
		return under
	var f: Vector2 = player.facing()
	return here + Vector2i(roundi(f.x), roundi(f.y))


# For the field drawing: the tile to outline, or (-1, -1) when no farm tool is in hand.
func farm_cursor() -> Vector2i:
	if not _selected_use() in ["hoe", "water", "plant", "place"] or not farmable(farm_target()):
		return Vector2i(-1, -1)
	return farm_target()


func crop_stage(t: Dictionary) -> int:
	var c: Dictionary = CROPS.get(str(t.get("crop", "")), {})
	if c.is_empty(): return -1
	var days: int = int(c["days"])
	if int(t["age"]) >= days: return int(c["stages"])          # ripe
	return mini(int(c["stages"]) - 1, int(t["age"]) * int(c["stages"]) / days)


# Like Stardew, the hoe and the can always swing (and cost their energy), whatever they hit; only a dug field
# tile changes. Seeds go in only where they can grow, and otherwise nothing happens. (Zachary, 21 Nov: "just let
# the action play".) The equipped tool follows the hands through its action poses.
func _farm_use(use: String, item: String) -> void:
	var tile: Vector2i = farm_target()
	var on_field: bool = farmable(tile)
	if use == "place":
		# A hydroponic bed: set down on open soil, it takes seeds like a dug tile and waters itself every night.
		# A sprinkler (the Sovereign's, 24 Nov) waters the four tiles beside it every morning (_run_sprinklers).
		if on_field and not farm.has(tile):
			if item == "sprinkler":
				farm[tile] = {"crop": "", "age": 0, "watered": -1, "sprinkler": true}
			else:
				farm[tile] = {"crop": "", "age": 0, "watered": -1, "bed": true}
			_give(item, -1)
			sfx("click", 0.7)
			if farm_view != null: farm_view.sync_crops()
		else:
			sfx("deny")
			_toast("Set it down on open soil in the Agri dome")
		return
	if use == "plant":
		if on_field and farm.has(tile) and str(farm[tile]["crop"]) == "" and not bool(farm[tile].get("sprinkler", false)):
			farm[tile]["crop"] = str(ItemData.ITEMS[item].get("crop", ""))
			farm[tile]["age"] = 0
			_give(item, -1)
			sfx("seed_plant")
			if farm_view != null: farm_view.sync_crops()
		return
	if swing_cd > 0.0:
		return
	if use == "water" and can_water <= 0:
		sfx("deny")
		_toast("The can is empty. Fill it at the water tap in the Agri dome.")
		return
	swing_cd = 0.4
	var tier: int = int(ItemData.ITEMS[item].get("tier", 1))
	if not _farm_energy({1: FARM_ENERGY, 2: 1, 3: 2, 4: 3}.get(tier, FARM_ENERGY)): return
	var work: Array = _farm_tiles(tile, tier)
	player.face(Vector2(tile.x * TILE + 8, tile.y * TILE + 12))
	var animated: bool = player.tool_action(_tool_art(item), "hoe" if use == "hoe" else "water")
	if not animated:
		player.show_tool(_item_icon(item))
	if use == "hoe":
		sfx("tool_swing", randf_range(0.95, 1.05), -6.0)
		sfx("hoe_dig", randf_range(0.92, 1.08))
		for wt in work:
			if farmable(wt) and not farm.has(wt):
				farm[wt] = {"crop": "", "age": 0, "watered": -1}
	elif use == "water":
		for wt in work:
			if can_water <= 0:
				break
			can_water -= 1
			if farm.has(wt):
				farm[wt]["watered"] = day
		if can_water == 0:
			_toast("That was the last of the water. Fill up at the water tap.")
		sfx("water_pour")
		var splash := preload("res://scripts/watering_effect.gd").new()
		splash.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 4)
		if animated:
			splash.spout = player.watering_spout
		actors.add_child(splash)
	if farm_view != null: farm_view.sync_crops()


# The tiles one swing works (Tikka's upgrades, 24 Nov): basic and steel the one tile; titanium that tile and the
# next two on in the same direction; Precursor the 3 x 3 square just beyond you.
func _farm_tiles(tile: Vector2i, tier: int) -> Array:
	var step := tile - _player_tile()
	if step == Vector2i.ZERO or (step.x != 0 and step.y != 0):
		var f: Vector2 = player.facing()
		step = Vector2i(roundi(f.x), roundi(f.y))
	if tier == 3:
		return [tile, tile + step, tile + step * 2]
	if tier >= 4:
		var out: Array = []
		var centre: Vector2i = tile + step
		for dy in range(-1, 2):
			for dx in range(-1, 2):
				out.append(centre + Vector2i(dx, dy))
		return out
	return [tile]


func _farm_energy(cost := FARM_ENERGY) -> bool:
	if energy < cost:
		sfx("deny")
		_toast("Too tired. Eat something, or sleep.")
		return false
	energy -= shops.tool_energy(cost)
	return true


# The watering can you carry (the best one, if somehow more than one), or "" with none.
func _held_can() -> String:
	for c in ["precursor_can", "titanium_can", "steel_can", "watering_can"]:
		if _count(c) > 0:
			return c
	return ""


func _can_capacity() -> int:
	var c := _held_can()
	return int(CAN_BY_TIER.get(int(ItemData.ITEMS[c].get("tier", 1)) if c != "" else 1, CAN_CAPACITY))


# E on a ripe crop in front of you (or under the mouse, next to you) picks it.
func _try_harvest() -> bool:
	if not farmable(farm_target()): return false
	var tile: Vector2i = farm_target()
	if not farm.has(tile) or crop_stage(farm[tile]) < 0: return false
	var t: Dictionary = farm[tile]
	var c: Dictionary = CROPS[str(t["crop"])]
	if int(t["age"]) < int(c["days"]):
		_toast("Not ready yet: %d more watered day%s" % [int(c["days"]) - int(t["age"]), "" if int(c["days"]) - int(t["age"]) == 1 else "s"])
		return true
	var got: String = str(c["item"])
	player.face(Vector2(tile.x * TILE + 8, tile.y * TILE + 12))
	if got == "moon_wheat":
		story_flags["moon_wheat_harvested"] = true
		player.tool_action("scythe", "scythe")
	else:
		player.show_pickup(_held_item_picture(got))
	_give(got, 1)
	sfx("harvest")
	_toast("+1 %s" % _item_name(got))
	if int(c["regrow"]) > 0:
		t["age"] = int(c["days"]) - int(c["regrow"])   # fruits again after a few more watered days
	else:
		t["crop"] = ""
		t["age"] = 0
	if farm_view != null: farm_view.sync_crops()
	return true


# Morning: every sprinkler waters the dug tiles beside it (north, east, south, west).
func _run_sprinklers() -> void:
	for tile in farm:
		if not bool(farm[tile].get("sprinkler", false)):
			continue
		for d in [Vector2i.UP, Vector2i.RIGHT, Vector2i.DOWN, Vector2i.LEFT]:
			var n: Vector2i = tile + d
			if farm.has(n) and not bool(farm[n].get("sprinkler", false)):
				farm[n]["watered"] = day
	if farm_view != null: farm_view.sync_crops()


# Overnight: a crop watered today grows a day.
func _grow_crops() -> void:
	for tile in farm:
		var t: Dictionary = farm[tile]
		if str(t["crop"]) != "" and (int(t["watered"]) == day or bool(t.get("bed", false))):
			t["age"] = int(t["age"]) + 1
			# Merrow's 8, Hydro-Boost: hydroponic beds grow a fifth faster (an extra day's growth in every five,
			# the first one up front)
			if bool(t.get("bed", false)) and _flag("perk_hydro_boost"):
				t["boost"] = int(t.get("boost", 0)) + 1
				if int(t["boost"]) % 5 == 1:
					t["age"] = int(t["age"]) + 1
	if farm_view != null: farm_view.sync_crops()


# The water tap in the Agri dome (it was the irrigation valve, which watered every dug tile at once) fills the
# watering can (Zachary, 24 Nov). Watering is by hand, one tile a pour, so hydroponic beds are worth their price.
func _refill_can(t: Dictionary) -> void:
	if _held_can() == "":
		_toast("The tap runs clear and cold. You'll need a watering can.")
		return
	if can_water >= _can_capacity():
		_toast("Your watering can is already full (%d pours)." % _can_capacity())
		return
	garden_busy = true
	player.frozen = true
	var effect := preload("res://scripts/watering_effect.gd").new()
	effect.position = t.pos + Vector2(0, -12)
	actors.add_child(effect)
	sfx("can_refill")
	await get_tree().create_timer(0.8).timeout
	effect.queue_free()
	can_water = _can_capacity()
	garden_busy = false
	player.frozen = false
	_toast("Watering can full: %d pours" % _can_capacity())


# ---------------------------------------------------------------- your first morning (Zachary, 23 Nov)
# The first time you step out of your front door, Bram and Jasper come up the corridor to meet you: a rundown of the
# station, your shipping crate and message pad, then a hoe, a watering can, two hydroponic beds and a bag of seeds.
# It's a scene (HeartEvents.SCENES "welcome", played by scripts/cutscene.gd), outside your apartment in the Agri
# complex. Until 23 Nov it was dialogue with the two of them standing in your flat (Zachary: "they should be
# outside and thats where the cutscene starts").

func _welcome_due() -> bool:
	return not welcomed and current_area == "agri" and cutscene != null and not cutscene.running


func _welcome_visit() -> void:
	welcomed = true
	cutscene.play("welcome")


# ---------------------------------------------------------------- the Custodians (24 Nov)
# Zachary's main story (docs/story/CUSTODIANS.md). The first time you walk into the museum after your first morning,
# Tar'Besh shows you the Sanctum and its three crystals speak to you (StoryScenes "custodians_wake"). Each Custodian
# asks for three bundles (scripts/custodian_data.gd); you give what you have at its crystal, a finished bundle
# fixes its part of the station overnight, and the datapad's Relics page shows the lists.
var custodians_found: Array = []      # the Custodians you can talk to (saved)
var relic_given: Dictionary = {}      # "custodian/bundle/item" -> how many you've given (saved)
var bundles_due: Array = []           # "custodian/bundle": finished today, fixed tonight (saved)
var bundles_done: Array = []          # "custodian/bundle": fixed (saved)


func _custodians_due() -> bool:
	return welcomed and current_area == "museum" and not events_seen.has("custodians_wake") and cutscene != null \
		and not cutscene.running


# The Custodian whose crystal is nearest you here, if you've met it ("" if none).
func _custodian_here() -> String:
	var here: Vector2i = _player_tile()
	var best := ""
	var best_d := 99
	for cid in custodians_found:
		var home: Array = _custodian_home(str(cid))
		if str(home[0]) != current_area:
			continue
		var spot: Vector2i = home[1]
		var d: int = absi(spot.x - here.x) + absi(spot.y - here.y)
		if d < best_d and d <= 4:
			best = str(cid)
			best_d = d
	return best


func bundle_key(cid: String, bid: String) -> String:
	return cid + "/" + bid


func bundle_state(cid: String, bid: String) -> String:
	var key := bundle_key(cid, bid)
	if bundles_done.has(key):
		return "done"
	if bundles_due.has(key):
		return "due"
	return "open"


func _bundle_filled(cid: String, b: Dictionary) -> bool:
	for item in b["items"]:
		if int(relic_given.get("%s/%s/%s" % [cid, str(b["id"]), str(item)], 0)) < int(b["items"][item]):
			return false
	return true


func custodian_complete(cid: String) -> bool:
	var bundles: Array = CustodianData.CUSTODIANS[cid]["bundles"]
	if bundles.is_empty():
		return false
	for b in bundles:
		if bundle_state(cid, str(b["id"])) != "done":
			return false
	return true


func _custodian_crystal(cid: String) -> void:
	var c: Dictionary = CustodianData.CUSTODIANS[cid]
	var voice: String = c["voice"]
	if custodian_complete(cid):
		_say(str(c["name"]), c["done"], Callable(), "", Callable(), "Not now", voice)
		return
	var waiting := true
	for b in c["bundles"]:
		if bundle_state(cid, str(b["id"])) == "open":
			waiting = false
	if waiting:
		_say(str(c["name"]), ["Sleep, Archivist. By morning, the work will be done."], Callable(), "", Callable(), "Not now", voice)
		return
	_say(str(c["name"]), c["hello"], Callable(self, "_give_custodian").bind(cid), "Give what I have", Callable(), "Not now", voice)


# Everything in your pack that this Custodian's open bundles still need goes in. A bundle that's now full is due:
# it's fixed tonight (_custodian_rewards).
func _give_custodian(cid: String) -> void:
	var c: Dictionary = CustodianData.CUSTODIANS[cid]
	var gave := 0
	var finished: Array = []
	for b in c["bundles"]:
		var bid: String = b["id"]
		if bundle_state(cid, bid) != "open":
			continue
		for item in b["items"]:
			var key := "%s/%s/%s" % [cid, bid, str(item)]
			var need: int = int(b["items"][item]) - int(relic_given.get(key, 0))
			var n: int = mini(need, _count(str(item)))
			if n > 0:
				_give(str(item), -n)
				relic_given[key] = int(relic_given.get(key, 0)) + n
				gave += n
		if _bundle_filled(cid, b):
			bundles_due.append(bundle_key(cid, bid))
			finished.append(str(b["name"]))
	var voice: String = c["voice"]
	if gave == 0:
		sfx("deny")
		_say(str(c["name"]), ["You carry nothing I need yet. My list is on your datapad, under Relics."], Callable(), "", Callable(), "Not now", voice)
		if cid == "shepherd":
			_say_then(Callable(self, "_back_to_map"))
		return
	sfx("museum_place")
	var lines: Array = (c["thanks"] as Array).duplicate()
	var blast: bool = cid == "harbinger" and bundles_due.has(bundle_key(cid, "core"))
	for f in finished:
		if blast and str(f) == "Blasting Core":
			continue
		lines.append("[happy] That's the %s complete. Sleep, and in the morning you'll see." % str(f))
	if blast:
		lines.append("[happy] That's everything. Oh, this is exciting. Stand back. Further. A little further than that.")
	_say(str(c["name"]), lines, Callable(), "", Callable(), "Not now", voice)
	if blast:
		_say_then(Callable(self, "_harbinger_blast"))
	elif cid == "shepherd":
		# out in the storm: the lullaby plays at once if that was the last of it; otherwise back to the map
		if bundles_due.has(bundle_key(cid, "lullaby")):
			_say_then(Callable(self, "_storm_lullaby"))
		else:
			_say_then(Callable(self, "_back_to_map"))
	_save_game()


func _bundle(key: String) -> Dictionary:
	var parts := key.split("/")
	for b in CustodianData.CUSTODIANS.get(parts[0], {}).get("bundles", []):
		if str(b["id"]) == parts[1]:
			return b
	return {}


# The night's work: every bundle finished yesterday fixes its part of the station. Returns the bundles fixed.
func _custodian_rewards() -> Array:
	var fixed: Array = []
	for key in bundles_due:
		if bundles_done.has(key):
			continue
		bundles_done.append(key)
		var b: Dictionary = _bundle(str(key))
		if b.is_empty():
			continue
		_custodian_fix(str(b["fixes"]))
		fixed.append(b)
	bundles_due.clear()
	if not fixed.is_empty():
		send_mail("sara_mending", 0)     # the first time: S.A.R.A. notices her station mending itself
	return fixed


func _custodian_fix(what: String) -> void:
	match what:
		"":
			return
		"storage":
			if not station_fixed.has("storage"):
				station_fixed.append("storage")
			_sync_station()
		"suite":
			story_flags["suite_restored"] = true
		"blast":
			story_flags["blast"] = true
			story_flags["east_dome"] = true        # the sea's water reaches the East Complex's garden dome
			send_mail("tarbesh_harbinger", 0)
			_sync_cradles()
		"warden_home":
			story_flags["warden_home"] = true
			send_mail("tarbesh_warden", 0)
			_sync_cradles()
		"storm_ends":
			story_flags["storm_ends"] = true
			send_mail("sara_tidelight", 0)
			_sync_cradles()
		"orchard":
			story_flags["orchard"] = true
			for sapling in ["moon_peach_sapling", "star_apple_sapling", "sun_fig_sapling"]:
				_give(sapling, 2)
		_:
			# sprinklers, orchard, hotel_wing, kiosks, gates, shipyard, storm_plating, braced, primed, blast,
			# storm_ends: what reads each flag is in docs/story/CUSTODIANS.md
			story_flags[what] = true


# For the datapad's Relics page: every Custodian you've found, its bundles, what each needs and has had.
func reliquary_list() -> Array:
	var out: Array = []
	for cid in CustodianData.ORDER:
		if not custodians_found.has(cid):
			continue
		var c: Dictionary = CustodianData.CUSTODIANS[cid]
		var bundles: Array = []
		for b in c["bundles"]:
			var items: Array = []
			for item in b["items"]:
				var given: int = int(relic_given.get("%s/%s/%s" % [cid, str(b["id"]), str(item)], 0))
				var nm: String = str(ItemData.ITEMS[item]["name"]) if ItemData.ITEMS.has(item) else str(item)
				items.append([nm, int(b["items"][item]), given, _count(str(item))])
			bundles.append({"name": b["name"], "items": items, "reward": b["reward"], "state": bundle_state(str(cid), str(b["id"]))})
		out.append({"name": c["name"], "wing": c["wing"], "bundles": bundles, "complete": custodian_complete(str(cid))})
	return out


# The Harbinger (24 Nov): a crystal in the wall of cavern floor 25, whichever layout the floor gets. The first time
# you see it, it speaks to you (StoryScenes "harbinger_found"). Its last bundle sets off the blast that opens the
# sea under the caverns ("harbinger_blast"); overnight the sea, the East Complex's garden dome and the Underground
# Lake open, and the Harbinger's crystal turns up in a Sanctum cradle (_sync_cradles), as the Shepherd's and the
# Warden's will.
const HARBINGER_FLOOR := 25
const SEA_FLOOR := 45                 # the shore of the sea, where the Leviathan waits (MapData.CAVERNS "last")
const CRADLES := {"harbinger": Vector2i(12, 14), "shepherd": Vector2i(12, 20), "warden": Vector2i(13, 11)}
const CRADLE_TINT := {"harbinger": Color("ffb08a"), "shepherd": Color("c9b6ff"), "warden": Color("ffc9a8")}
var harbinger_spot := Vector2i(-1, -1)
var cradle_sprites := {}              # Sanctum cradle tile -> its Sprite2D (_spawn_prop)


func _sea_open() -> bool:
	# old saves that already reached the sea keep it
	return _flag("blast") or leviathan_slain or cav_deepest >= SEA_FLOOR


# The open spot nearest the ladder, three or more tiles from it, with open floor all round.
func _harbinger_spot(info: Dictionary) -> Vector2i:
	var up := Vector2i(int(info["up"][0]), int(info["up"][1]))
	var open := {}
	for sp in info["spots"]:
		open[Vector2i(int(sp[0]), int(sp[1]))] = true
	var best := Vector2i(int(info["spots"][0][0]), int(info["spots"][0][1]))
	var best_d := 9999
	for t in open:
		var d: int = absi(t.x - up.x) + absi(t.y - up.y)
		if d < 4 or d >= best_d:
			continue
		if open.has(t + Vector2i.LEFT) and open.has(t + Vector2i.RIGHT) and open.has(t + Vector2i.DOWN):
			best = t
			best_d = d
	return best


func _place_harbinger(key: String) -> void:
	var t := harbinger_spot
	var sp := Sprite2D.new()
	sp.texture = load("res://art/lunar/crystal_cluster.png")
	sp.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	sp.centered = false
	sp.scale = Vector2.ONE * ART
	sp.offset = Vector2(0, -sp.texture.get_height())
	sp.position = Vector2(t.x * 16 + (16 - sp.texture.get_width() * ART) * 0.5, (t.y + 1) * 16)
	sp.modulate = CRADLE_TINT["harbinger"]
	actors.add_child(sp)
	area_sprites.append([sp, key])
	cav_sprites.append(sp)
	sp.visible = current_area == key
	blocked[key][t] = true
	things.append({"kind": "look", "name": "Precursor crystal", "hint": "Speak", "area": key,
		"pos": Vector2(t.x * 16 + 8, t.y * 16 + 8), "radius": 24.0, "who": "", "cav": true})
	if not custodians_found.has("harbinger"):
		custodians_found.append("harbinger")
		cutscene.play("harbinger_found")


# Where a Custodian's crystal is now: the Sanctum cradle once one found elsewhere is complete.
func _custodian_home(cid: String) -> Array:
	var c: Dictionary = CustodianData.CUSTODIANS[cid]
	if CRADLES.has(cid) and custodian_complete(cid):
		return ["sanctum", CRADLES[cid]]
	if cid == "harbinger":
		return [current_area if cav_floor == HARBINGER_FLOOR else "", harbinger_spot]
	return [str(c["home"]), Vector2i(int(c["spot"][0]), int(c["spot"][1]))]


# The Sanctum's empty cradles fill as the far Custodians come home (their crystals tinted their colour).
func _sync_cradles() -> void:
	for cid in CRADLES:
		var sp: Sprite2D = cradle_sprites.get(CRADLES[cid])
		if sp == null or sp.get_meta("filled", false) or not custodian_complete(str(cid)):
			continue
		sp.set_meta("filled", true)
		var strip: Texture2D = load("res://art/lunar/anim/crystal_pedestal.png")
		var still: Texture2D = load("res://art/lunar/crystal_pedestal.png")
		sp.texture = strip
		sp.hframes = maxi(1, int(round(float(strip.get_width()) / float(still.get_width()))))
		anim_props.append([sp, sp.hframes, randf() * sp.hframes])
		sp.modulate = CRADLE_TINT[cid]


# The vision (24 Nov): once all six Custodians are complete and home in the Sanctum, the next time you walk in.
func _vision_due() -> bool:
	if current_area != "sanctum" or _flag("vision_seen") or cutscene == null or cutscene.running:
		return false
	for cid in CustodianData.ORDER:
		if not custodian_complete(str(cid)):
			return false
	return true


func _harbinger_blast() -> void:
	cutscene.play("harbinger_blast")


# ---------------------------------------------------------------- the Great Storm (24 Nov)
# A stop on the outermost ring of every free flight, in Collective space (ShipRuns.place_storm). Without the
# Forgemaster's storm plating it throws you back. With it, the Shepherd of Storms is there: the storm is a dying
# Starborn she was left to tend ("shepherd_found"). You give her bundles at the stop; the last one plays her lullaby
# ("storm_ends"), and from the next morning the stop is Tidelight, the world the storm hid.
func _storm_arrive() -> void:
	if not _flag("storm_plating"):
		ship_event.open_event({"title": "The Great Storm",
			"text": "Lightning the colour of violets walks across your hull the moment you cross its edge. Every alarm on the ship goes off at once. Your plating isn't made for this.",
			"choices": [{"text": "Pull back out, fast.", "outcomes": [{"text": "You claw your way back out. Behind you the storm folds shut, as if it had never opened. Freya will want to hear about better plating.", "effects": ["-3 hull"]}]}]},
			Callable(self, "_after_run_event"))
		return
	if not custodians_found.has("shepherd"):
		ship_event.close()
		cutscene.play("shepherd_found")
		return
	_say("The Shepherd of Storms", CustodianData.CUSTODIANS["shepherd"]["hello"], Callable(self, "_give_custodian").bind("shepherd"),
		"Give what I have", Callable(self, "_back_to_map"), "Not now", "Shepherd")


func _storm_lullaby() -> void:
	ship_event.close()
	cutscene.play("storm_ends")


func _tidelight_arrive() -> void:
	_say("Tidelight", ["A world locked at the edge of its sun: one side forever burning, one forever dark, and a ring of endless sunset between.",
		"An old Collective beacon still calls from the twilight. Land? It ends today's flight."],
		Callable(self, "_land_on_tidelight"), "Land", Callable(self, "_back_to_map"), "Not now", "")


func _land_on_tidelight() -> void:
	ship_map.close()
	ship_event.close()
	ship_store.close()
	run_stops = []
	sfx("sh_fold")
	_home_at_eight()
	_shuttle_to("tidelight")


# ---------------------------------------------------------------- Tidelight (24 Nov)
# The world past the storm (tools/tidelight.py). You get there in your own ship (its stop on the jump map), or by
# the shuttle from Gate 2 in the Spaceport once the Chancellor has opened the gates; the shuttle on Tidelight's
# landing pad flies you home. It's always sunset there (_light_color). Forage grows back every day, and the Warden of
# Tidelight's crystal stands in the forest clearing in the east.
var forage_taken := {}                # "x,y" -> the day it was picked (saved)
var forage_sprites := {}              # "x,y" -> its Sprite2D on the ground


func _shuttle_to(area: String) -> void:
	sfx("launch")
	minutes = minf(minutes + 20.0, DAY_END - 1.0)
	if area == "tidelight":
		var land: Array = MapData.TIDELIGHT["landing"]
		_go_to("tidelight", Vector2i(int(land[0]), int(land[1])))
		if not events_seen.has("tidelight_arrival"):
			cutscene.play("tidelight_arrival")
	else:
		_go_to("west", SHUTTLE_GATE)
	_snap_residents()


const SHUTTLE_GATE := Vector2i(24, 28)    # where the shuttle sets you down in the Spaceport, by Gate 2


func _forage_key(t: Dictionary) -> String:
	var p: Vector2 = t["pos"]
	return "%d,%d" % [int(p.x) / TILE, int(p.y) / TILE]


func _forage(t: Dictionary) -> void:
	var key := _forage_key(t)
	if int(forage_taken.get(key, -1)) == day:
		return
	forage_taken[key] = day
	_give(str(t["name"]), 1)
	sfx("harvest")
	_toast("+1 %s" % str(ItemData.ITEMS[str(t["name"])]["name"]) if ItemData.ITEMS.has(str(t["name"])) else "Picked")
	_sync_forage()


# Forage lies on the ground as its item's icon, gone once picked until the next day.
func _sync_forage() -> void:
	if forage_sprites.is_empty() and items_tex != null:
		var cell: int = items_tex.get_height()
		for t in things:
			if str(t.get("kind", "")) != "forage" or not ItemData.ITEMS.has(str(t["name"])):
				continue
			var sp := Sprite2D.new()
			sp.texture = items_tex
			sp.region_enabled = true
			sp.region_rect = Rect2(int(ItemData.ITEMS[str(t["name"])]["icon"]) * cell, 0, cell, cell)
			sp.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			sp.scale = Vector2.ONE * (16.0 / float(cell))
			sp.position = t["pos"]
			actors.add_child(sp)
			area_sprites.append([sp, str(t["area"])])
			forage_sprites[_forage_key(t)] = sp
	for key in forage_sprites:
		var sp: Sprite2D = forage_sprites[key]
		sp.modulate.a = 0.0 if int(forage_taken.get(key, -1)) == day else 1.0


func _warden_due() -> bool:
	if current_area != "tidelight" or custodians_found.has("warden") or cutscene == null or cutscene.running:
		return false
	var w: Array = MapData.TIDELIGHT["warden"]
	var here: Vector2i = _player_tile()
	return absi(here.x - int(w[0])) + absi(here.y - int(w[1])) <= 9


# ---------------------------------------------------------------- the Caverns
# Floors under the mine (tools/caverns.py). Each visit to a floor picks one of its band's ten maps and scatters
# rocks, ore and creatures over it. The way down is under a rock: each rock you break has a small chance to show the
# shaft, rising as fewer are left, and the last rock always shows it. Every fifth floor becomes a lift stop.

func _cav_band(n: int) -> String:
	return "rock" if n <= 15 else ("lush" if n <= 30 else "steam")


# Vzz'ket's 8, the Cavern Monster Radar: on each floor S.A.R.A. names what is waiting on the floor below. The
# floor below's creatures are picked then (cav_next), so the warning is true when you get there.
var cav_next := {}
const MOB_NAMES := {"bug": ["bug", "bugs"], "lizard": ["rock lizard", "rock lizards"], "echo_bat": ["echo bat", "echo bats"],
	"spore_crawler": ["spore crawler", "spore crawlers"], "vent_crab": ["vent crab", "vent crabs"]}


func _cav_mob_kinds(n: int) -> Array:
	if int(cav_next.get("floor", -1)) == n:
		return cav_next["kinds"]
	var kinds: Array = CAV_MOBS[_cav_band(n)]
	var out: Array = []
	for i in mini(3 + n / 8, 8):
		out.append(kinds[randi() % kinds.size()])
	return out


func _radar_ping(below: int) -> void:
	if not _flag("perk_monster_radar"):
		return
	if below >= int(MapData.CAVERNS["last"]):
		if not leviathan_slain:
			_toast("S.A.R.A.: below you is the Leviathan. Something that big doesn't need a motion sensor.")
		return
	cav_next = {"floor": below, "kinds": _cav_mob_kinds(below)}
	var counts := {}
	for k in cav_next["kinds"]:
		counts[str(k)] = int(counts.get(str(k), 0)) + 1
	var parts: Array = []
	for k in counts:
		var names: Array = MOB_NAMES.get(k, [k, k + "s"])
		parts.append("%d %s" % [int(counts[k]), str(names[0] if int(counts[k]) == 1 else names[1])])
	_toast("S.A.R.A.: floor %d below: %s." % [below, ", ".join(parts)])


func _cavern_gate() -> void:
	if job_quest < 5:
		_say("Vzz'ket", ["[angry] The caverns stay shut. Job wants the north tunnels cleared first.", "Clear them. Then we will see what you are."])
		return
	if not caverns_open:
		if not mail_days.has("vzzket_caverns"):
			# the tunnels are done, but his letter hasn't come yet (it comes with the next morning's post)
			_say("Vzz'ket", ["Job told me. The tunnels are quiet.", "[angry] Not today. Sleep. I will send word."])
			if not mail_due.has("vzzket_caverns"):
				send_mail("vzzket_caverns", 1)
		else:
			_vzzket_caverns_talk()
		return
	if cav_lift > 0:
		_say("Cavern gate", ["Vzz'ket unbolts the barricade. The old cage lift still runs.", "Take the lift down to floor %d?" % cav_lift],
				Callable(self, "_enter_cavern").bind(cav_lift), "Floor %d" % cav_lift, Callable(self, "_enter_cavern").bind(1), "Floor 1")
	else:
		_say("Cavern gate", ["Vzz'ket unbolts the barricade. A ladder drops away into the dark.", "Climb down into the Caverns?"],
				Callable(self, "_enter_cavern").bind(1), "Climb down")


# After his letter (scripts/mail_data.gd "vzzket_caverns"): Vzz'ket says what is under the gate, then opens it.
# Draft lines by Claude, for Zachary to change.
func _vzzket_caverns_talk() -> void:
	_say("Vzz'ket", [
		"You came. Good. Listen. I will say this once.",
		"Under the gate the rock goes down a long way. Floor under floor. It is never the same twice: the rock moves, and so does what lives in it.",
		"Near the top, bugs and lizards. Lower, the green caves and the spore crawlers. Lower still, the steam, and crabs that cook you while they bite.",
		"[sad] Five of my clutch went down after the first crash. Two came back.",
		"So. Carry food. When you are hurt, climb the ladder. The caverns will be there tomorrow. You might not.",
		"Break the rocks to find the way down. Every fifth floor the old cage lift stops. Reach one and you can ride straight back to it.",
		"[surprised] And if you ever hear water down there... tell me first. Then tell Zaas. He will want to swim in it.",
	])
	_say_then(Callable(self, "_open_caverns"))


func _open_caverns() -> void:
	caverns_open = true
	sfx("quest")
	_toast("The Caverns are open")
	_cavern_gate()


func _enter_cavern(n: int) -> void:
	_clear_cavern()
	var data: Dictionary = MapData.CAVERNS
	var last: int = int(data["last"])
	n = clampi(n, 1, last)
	cav_floor = n
	var band: String = _cav_band(n)
	var key := "cav_45"
	if n < last:
		var keys: Array = data["bands"][band]
		key = keys[randi() % keys.size()]
		if key == cav_key and keys.size() > 1:            # never the same layout twice running
			key = keys[(keys.find(key) + 1) % keys.size()]
	cav_key = key
	var info: Dictionary = data["maps"][key]
	var up: Array = info["up"]
	_go_to(key, Vector2i(int(up[0]), int(up[1])), false)
	sfx("ladder")
	cav_deepest = maxi(cav_deepest, n)
	var note := "The Caverns, floor %d" % n
	if n % 5 == 0 and n > cav_lift and n < last:
		cav_lift = n
		note += "  (the lift stops here now)"
	if n == SEA_FLOOR - 1 and not _sea_open():
		note += ". Below, the rock rings hollow: water, a long way down. Nothing gets through."
	_toast(note)
	if n < last:
		var clear := {}
		if n == HARBINGER_FLOOR and not custodian_complete("harbinger"):
			harbinger_spot = _harbinger_spot(info)
			for dy in range(-1, 2):
				for dx in range(-1, 2):
					clear[harbinger_spot + Vector2i(dx, dy)] = true
		_fill_cavern(key, info, n, band, clear)
		if not clear.is_empty():
			_place_harbinger(key)
		_radar_ping(n + 1)
	elif not leviathan_slain:
		_wake_leviathan(key)
	else:
		_toast("The water is still. Somewhere far out, something is not breathing.")


func _fill_cavern(key: String, info: Dictionary, n: int, band: String, keep_clear: Dictionary = {}) -> void:
	var spots: Array = info["spots"].filter(func(sp): return not keep_clear.has(Vector2i(int(sp[0]), int(sp[1]))))
	spots.shuffle()
	var mob_kinds: Array = _cav_mob_kinds(n)
	var mobs: int = mob_kinds.size()
	var veins: int = randi_range(6, 10)
	cav_rocks = randi_range(40, 55)
	cav_rocks_left = cav_rocks
	cav_shaft = false
	var weights: Array = []                 # [item, weight] for this floor (CAV_VEINS)
	var total := 0.0
	for v in CAV_VEINS:
		if n < int(v[1]) or n > int(v[2]):
			continue
		var edge: float = float(mini(n - int(v[1]), int(v[2]) - n) + 1)
		var w: float = float(v[3]) * clampf(edge / 3.0, 0.34, 1.0)
		weights.append([str(v[0]), w])
		total += w
	var power: Array = CAV_POWER[band]
	var i := 0
	for s in spots:
		var tile := Vector2i(int(s[0]), int(s[1]))
		if i < mobs:
			var en = EnemyScript.new()
			en.setup(self, str(mob_kinds[i]), key, Vector2(tile.x * TILE + 8, tile.y * TILE + 12))
			en.boost(float(power[0]), int(power[1]), float(power[2]))
			actors.add_child(en)
			enemies.append(en)
			cav_enemies.append(en)
			en.visible = true
		elif i < mobs + veins:
			var roll: float = randf() * total
			var item := "stone"
			for w in weights:
				roll -= float(w[1])
				if roll < 0.0:
					item = str(w[0])
					break
			_add_node(item, key, tile, 1, true)
		elif i < mobs + veins + cav_rocks:
			var looks: Array = CAV_STONES.get(band, ["stone"])
			_add_node("stone", key, tile, 1, true, str(looks[randi() % looks.size()]))
		else:
			break
		i += 1
	# A few boulders on spots nothing else took, where a 2 x 2 block of free spots fits.
	var free := {}
	for k in range(i, spots.size()):
		free[Vector2i(int(spots[k][0]), int(spots[k][1]))] = true
	var placed := 0
	var want: int = randi_range(2, 4)
	for k in range(i, spots.size()):
		if placed >= want:
			break
		var t0 := Vector2i(int(spots[k][0]), int(spots[k][1]))
		var block: Array = [t0, t0 + Vector2i(1, 0), t0 + Vector2i(0, 1), t0 + Vector2i(1, 1)]
		if block.all(func(tt): return free.has(tt) and not blocked[key].has(tt)):
			_add_boulder(key, t0, band)
			for tt in block:
				free.erase(tt)
			placed += 1


func _maybe_open_shaft(t: Dictionary, node: Dictionary) -> void:
	if cav_shaft or cav_floor <= 0 or cav_floor >= int(MapData.CAVERNS["last"]):
		return
	if cav_floor == SEA_FLOOR - 1 and not _sea_open():
		return            # the sea is sealed in under floor 44 until the Harbinger's blast
	var chance: float = 0.04 + 0.3 * (1.0 - float(cav_rocks_left) / float(maxi(1, cav_rocks)))
	if cav_rocks_left > 0 and randf() >= chance:
		return
	cav_shaft = true
	var tile: Vector2i = node["tile"]
	var s: Sprite2D = node["sprite"]
	s.visible = false
	var here: Dictionary = blocked[current_area]
	here.erase(tile)
	var fixed_here: Dictionary = fixed[current_area]
	fixed_here.erase(tile)
	things.erase(t)
	var hole := Sprite2D.new()
	hole.texture = load("res://art/lunar/cavern_shaft.png")
	hole.scale = Vector2.ONE * (16.0 / float(hole.texture.get_width()))
	hole.position = Vector2(tile.x * TILE + 8, tile.y * TILE + 8)
	hole.z_index = -1
	actors.add_child(hole)
	area_sprites.append([hole, current_area])
	cav_sprites.append(hole)
	things.append({"kind": "shaft", "name": "Shaft down", "hint": "Climb down to floor %d" % (cav_floor + 1), "area": current_area,
		"pos": Vector2(tile.x * TILE + 8, tile.y * TILE + 8), "radius": 22.0, "who": "", "cav": true})
	sfx("quest")
	_toast("A shaft down! It leads to floor %d." % (cav_floor + 1))


func _leave_caverns() -> void:
	_clear_cavern()
	var gate: Array = MapData.CAVERNS["gate"]
	arrive_sound = "ladder"
	_go_to("mine", Vector2i(int(gate[0]), int(gate[1])))


# Takes away everything placed for the current floor (its rocks, veins, creatures and shaft).
func _clear_cavern() -> void:
	cutting = null
	cav_floor = 0
	if cav_sprites.is_empty() and cav_enemies.is_empty():
		return
	area_sprites = area_sprites.filter(func(pair): return not cav_sprites.has(pair[0]))
	things = things.filter(func(th): return not bool(th.get("cav", false)))
	for sp in cav_sprites:
		sp.queue_free()
	cav_sprites.clear()
	for en in cav_enemies:
		enemies.erase(en)
		en.queue_free()
	cav_enemies.clear()
	ore_nodes.resize(cav_static_nodes)
	if cav_key != "":
		blocked[cav_key] = {}
		fixed[cav_key] = {}


# Floor 45: the Leviathan heaves itself out of the water onto the shore and comes for you. (The Harbinger of
# Destruction is a Custodian, a crystal, not this; Zachary, 22 Nov. "Leviathan" is still a placeholder name.)
func _wake_leviathan(key: String) -> void:
	var spot: Array = MapData.CAVERNS["boss"]
	var en = EnemyScript.new()
	en.setup(self, "leviathan", key, Vector2(int(spot[0]) * TILE + 8, int(spot[1]) * TILE + 12))
	en.boost(1.0, 0, 4.0)
	actors.add_child(en)
	enemies.append(en)
	cav_enemies.append(en)
	en.visible = true
	sfx("hurt", 0.4)
	_say("The Leviathan", ["The black water bulges. Something the size of a shuttle drags itself up onto the shore.",
		"Its eyes are the colour of the power core. It has seen you."])


func _leviathan_slain() -> void:
	leviathan_slain = true
	send_mail("sara_ponds", 1)           # S.A.R.A.: the springs are quiet now, so she can repair the fish ponds
	sfx("quest")
	_money(500, "The Leviathan, defeated")
	_say("Underground ocean", ["The Leviathan sinks back into the dark water, and does not rise again.",
		"For the first time, the ocean is quiet. Zaas is going to want to see this.",
		"You pull a scale the size of a dinner plate from the shingle. (+500 credits)",
		"Somewhere above, water drains away. The old flooded stair under the copper bay will be open now: there is a lake down there, and fish."])


# Doors between rooms: open for whoever is near, shut again behind them. A bedroom with an owner stays
# locked to the player until they have BEDROOM_HEARTS hearts with that owner. A couple's room ("Maren|Owen")
# opens once you are friends with either of them; an owner who has not arrived on the station yet locks nothing.
func _bedroom_locked(owners: String) -> bool:
	if owners == "": return false
	var known := false
	for who in owners.split("|"):
		if not persons.has(who): continue
		known = true
		if int(persons[who]["friendship"]) >= BEDROOM_HEARTS * FRIEND_PER_HEART: return false
	return known

# A sliding door is locked if it's a bedroom you aren't welcome in yet, or a door S.A.R.A. sealed on a broken
# dome she hasn't repaired (owner "repair:<id>").
func _inner_locked(who_owns: String) -> bool:
	if who_owns.begins_with("repair:"):
		return not station_fixed.has(who_owns.substr(7))
	return _bedroom_locked(who_owns)


func _update_inner_doors(delta: float) -> void:
	for d in inner_doors:
		if d.area != current_area: continue
		var c: Vector2 = d.center()
		var reach: float = 22.0 + maxf(d.size_px.x, d.size_px.y) * 0.5
		d.locked = _inner_locked(d.room_owner)
		var player_near: bool = player.position.distance_to(c) < reach
		var want: bool = player_near and not d.locked
		for r in residents:
			if r.area == current_area and r.position.distance_to(c) < reach: want = true
		if player_near and d.locked and not d.has_meta("warned"):
			d.set_meta("warned", true)
			if d.room_owner.begins_with("repair:"):
				var rep: Dictionary = StationRepair.REPAIRS.get(d.room_owner.substr(7), {})
				_toast("Sealed: %s. Right-click it: S.A.R.A. can repair it." % str(rep.get("name", "broken")).to_lower())
			else:
				var names: String = d.room_owner.replace("|", " and ")
				_toast("%s's room — locked. Get to know %s better first." % [names, "them" if "|" in d.room_owner else names])
			sfx("deny")
		elif not player_near and d.has_meta("warned"):
			d.remove_meta("warned")
		var target: float = 1.0 if want else 0.0
		if not is_equal_approx(d.opening, target):
			d.opening = move_toward(d.opening, target, delta * 4.0)
			d.queue_redraw()

