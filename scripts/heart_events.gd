	# ---------------------------------------------------------------- Sesska (Zachary, 24 Nov)
	# A weaver who lost her street and finds a new one. Her 6 unlocks the Cavern-silk coat in her shop (shops.gd
	# "sesska_silk"); her 8 is the NPC Master's Void-Silk Luxury Linens, for the hotel, which does nothing until the
	# hotel takes paying guests (Zachary: "nothing until the hotel is made").
	"sesska_2": {
		"who": "Sesska", "hearts": 2, "title": "Every Seam Giving Up",
		# her shop in the morning: she finally mends your crash jacket (her first line promised to). Letter: the
		# offcuts made you a cap, unless you told her it's only a jacket
		"area": "weaver", "windows": [[[0, 1, 2, 3, 4, 5], "08:00", "12:00"]],
		"player": [7, 10, "u"],
		"cast": [["Sesska", 6, 6, "d"]],
		"steps": [
			["wait", 0.6],
			["say", "", ["Sesska's shop. Bolts of cloth climb every wall, in every colour the moon allows, which is mostly grey, and three colours it doesn't."]],
			["emote", "Sesska", "hello"],
			["say", "Sesska", ["[happy] There you are. You, and that jacket. Come here, come here. Off with it."]],
			["walk", "player", 6, 8], ["face", "player", "u"],
			["say", "Sesska", ["Every seam giving up. I said so the day you landed. I've been waiting until I had cloth to spare. This morning, I have cloth to spare."]],
			["say", "", ["She takes your jacket in all four hands at once: two to hold it up, and two to read it."]],
			["pose", "Sesska", "weave d"],
			["say", "Sesska", ["A scorch here, all down the back: you came in too hot. A tear here: you climbed out of something sharp.",
				"[surprised] And this cuff has been chewed. Something in the mine?"]],
			["emote", "player", "sad"],
			["say", "Sesska", ["[happy] A jacket is a diary that doesn't know it's being read."]],
			["pose", "Sesska", "talk"],
			["say", "Sesska", ["[sad] On Arach Minor my shop had a window onto the street. People walked past with their whole lives on their sleeves, and I mended them.",
				"So. The scorch. I can weave over it, and the jacket looks new. Or I can mend around it, and it stays yours."]],
			["pose", "Sesska", ""],
			["choose", [
				{"text": "Keep the scorch. It's how I got here.", "friendship": 60, "steps": [
					["emote", "Sesska", "love"],
					["say", "Sesska", ["[happy] Good answer. The best mends show."]],
					["mail", "sesska_offcuts", 1]]},
				{"text": "Make it look new.", "friendship": 30, "steps": [
					["say", "Sesska", ["As you like. New is also a story. A shorter one."]],
					["mail", "sesska_offcuts", 1]]},
				{"text": "It's only a jacket. Patch it however.", "steps": [
					["emote", "Sesska", "sad"],
					["say", "Sesska", ["[sad] Only a jacket. Hm. Come back at noon."]],
					["friendship", "Sesska", -20]]}]],
			["pose", "Sesska", "weave d"], ["sfx", "craft"],
			["fade", 1.0, 0.4], ["wait", 0.6], ["fade", 0.0, 0.4],
			["pose", "Sesska", ""],
			["say", "", ["A quarter of an hour later the jacket comes back across the counter. The seams hold. They look like they mean it."]],
			["flag", "sesska_jacket"],
			["walk", "Sesska", 5, 8], ["face", "Sesska", "player"], ["face", "player", "Sesska"], ["wait", 0.6],
		],
	},
