			["walk", "player", 40, 37], ["face", "player", "u"],
			["sara", "greeting"], ["emote", "Sara", "hello"],
			["say", "Sara", ["[happy] Oh good, a pair of hands! Sorry. That came out wrong. Good evening!",
				"Could I borrow you? The lost-property locker under my pad. I can see inside it. I just can't open it."], "S.A.R.A."],
			["sfx", "click"],
			["say", "", ["You crouch and slide the drawer open. It's packed: tags, string, and years of labels in a small, tidy hand."]],
			["sara", "summon_screen"],
			["say", "Sara", ["A knitted glove, child's size. Mira Okafor, six. She cried for an hour the night the Navy left.",
				"A Zaa'sh prayer bead. A pilot who fixed his engine in my bay and never said a word. He left it on the counter.",
				"A cracked datapad with one song on it. Forty years ago. I never learned whose."], "S.A.R.A."],
			["sara", "clasp_hands"],
			["say", "Sara", ["[sad] I remember all of them. Every guest, every face. I've just never had anyone to tell."], "S.A.R.A."],
			["choose", [
				{"text": "Want me to try to get one back to its owner?", "friendship": 60, "steps": [
					["sara", "head_tilt"], ["emote", "Sara", "surprise"],
					["say", "Sara", ["[surprised] You'd do that? ...The glove. Mira would be nearly fifty now.",
						"I'll find where she lives. You find the post. Partners in crime. Lost property crime."], "S.A.R.A."],
					["sara", "laugh"], ["emote", "Sara", "love"]]},
				{"text": "Why not just bin it? Nobody's coming back.", "steps": [
					["sara", "glitch_interrupt"], ["sfx", "zap"], ["emote", "Sara", "sad"],
					["say", "Sara", ["[sad] They might. That's rather the whole—", "...Never mind. Close the drawer, please. Gently."], "S.A.R.A."],
					["friendship", "Sara", -20]]}]],
			["sfx", "click"],
			["sara", "nod"],
			["say", "Sara", ["[happy] Thank you for being my hands tonight. Same time next year? I'm joking. Mostly."], "S.A.R.A."],
			["flag", "sara_lost_property"],
		],
	},
